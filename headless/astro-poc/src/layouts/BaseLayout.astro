---
import '../styles/catalog.css';
import SiteHeader from '../components/SiteHeader.astro';
import SiteDoodles from '../components/SiteDoodles.astro';
import PocMotion from '../components/PocMotion.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { loadHomePage } from '../lib/homePage';
import { resolveActiveNav, type ActiveNavKey } from '../lib/activeNav';
import {
  DEFAULT_SITE_DESCRIPTION,
  DEFAULT_SITE_TITLE,
  canonicalUrl,
  robotsContent,
} from '../lib/siteSeo';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  /** Optional override; default is pathname-derived (M37). */
  activeNav?: ActiveNavKey | null;
  compactBrand?: boolean;
  skipHref?: string;
}
const {
  title = DEFAULT_SITE_TITLE,
  description = DEFAULT_SITE_DESCRIPTION,
  ogImage,
  activeNav,
  compactBrand = false,
  skipHref = '#topic-list',
} = Astro.props;

const { footer } = loadHomePage();
const resolvedNav: ActiveNavKey | null =
  activeNav !== undefined ? activeNav : resolveActiveNav(Astro.url.pathname);
const useCompactBrand = compactBrand || resolvedNav === 'worksheets';
const robots = robotsContent(Astro.url.hostname);
const canonical = canonicalUrl(Astro.url.pathname, Astro.url.search);
---
<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="he_IL" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {/* Wix-documented slot for item-page SEO (<SEO.Tags slot="seo-tags">).
        Blog item pages fill this; main pages use props above as the single
        title/meta source (no "Astro POC" / "Home | …" duplicates). */}
    <slot name="seo-tags" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Assistant:wght@400;600;700&family=Heebo:wght@500;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <a class="skip-link" href={skipHref}>דילוג לתוכן</a>
    <SiteHeader active={resolvedNav} compactBrand={useCompactBrand} />
    <SiteDoodles />
    <slot />
    <SiteFooter footer={footer} />
    {/* POC motion system (branch poc-animations-fix): scroll reveal +
        hover re-draw; honors prefers-reduced-motion, the accessibility
        menu's noam-a11y-motion class, and fine-pointer devices. */}
    <PocMotion />
    <!-- Production entry-gate copy (ndGate); privacy → combined a11y page. No invented legal text. -->
    <script src="/nd-site-gate.js" defer></script>
    <script src="/noam-accessibility.js" defer></script>
  </body>
</html>
