      "blocks": [
        {
          "type": "paragraph",
          "text": "טעות נפוצה היא לשכוח המרה שמועברת. מסמנים את ההמרה הקטנה מעל העמודה הבאה ולא שוכחים אותה.",
          "links": []
        }
      ]
