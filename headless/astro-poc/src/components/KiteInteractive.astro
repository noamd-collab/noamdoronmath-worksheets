---
/**
 * KiteInteractive — the kite landing's hands-on JSXGraph board.
 *
 * Handoff contract (no changes to the protected ConceptLoop engine):
 * - The card's loop root exposes `__loop.state()` = {playing, done, static}
 *   and the engine toggle replays a finished film. We poll that hook; when
 *   the film parks (done), the loop fades out and this board fades in over
 *   the same card area.
 * - "הפעלת ההדגמה מחדש" fades the loop back in and clicks the engine's own
 *   toggle, so replay semantics (lap reset, play) stay engine-owned.
 * - Site motion off / no-JS: no auto handoff. The static frame stays; a
 *   separate "פתחו את הפעילות" button opens the board on demand.
 * - JSXGraph is bundled locally (npm dependency, dynamic import — the chunk
 *   loads only when the board first opens). No CDN, no runtime cost elsewhere.
 */
---

<div class="kite-ix-open-wrap" data-ix-open-wrap hidden>
  <button type="button" class="kite-ix__open" data-ix-open>
    פתחו את הפעילות — גרירת קודקודי הדלתון
  </button>
</div>
<div class="kite-ix" data-interactive="kite-diagonals" hidden>
  <p class="kite-ix__hint" dir="rtl">
    גררו את הקודקודים וגלו: האלכסונים נשארים מאונכים, והשטח תמיד מכפלת האלכסונים חלקי 2.
  </p>
  <div
    class="kite-ix__stage"
    data-ix-stage
  >
    <div
      class="kite-ix__board"
      data-ix-board
      role="img"
      aria-label="דלתון אינטראקטיבי: גוררים את הקודקודים A, B ו־C, והאלכסונים והשטח מתעדכנים"
    ></div>
    <span class="kite-ix__badge" data-ix-badge>נסו בעצמכם!</span>
    <span class="kite-ix__cue" data-ix-cue hidden aria-hidden="true">
      <span class="kite-ix__cue-ring"></span>
      <span class="kite-ix__cue-finger"></span>
    </span>
  </div>
  <p class="kite-ix__readout" dir="rtl" aria-live="polite" data-ix-readout></p>
  <div class="kite-ix__actions">
    <button type="button" class="kite-ix__replay" data-ix-replay>הפעלת ההדגמה מחדש</button>
    <button type="button" class="kite-ix__reset" data-ix-reset>איפוס הדלתון</button>
  </div>
</div>

<style>
  .kite-ix[hidden],
  .kite-ix-open-wrap[hidden] {
    display: none;
  }
  .kite-ix {
    position: relative;
    z-index: 3;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 4px 2px 2px;
    border-radius: 18px;
    opacity: 0;
    transition: opacity 0.45s ease;
  }
  .kite-ix.is-on {
    opacity: 1;
  }
  .kite-ix__hint {
    margin: 0;
    font-size: 15px;
    line-height: 1.55;
    color: #3d4870;
  }
  .kite-ix__board {
    flex: 1 1 auto;
    min-height: 260px;
    border-radius: 18px;
    background: #fbfaf5;
    touch-action: none;
    overflow: hidden;
  }
  .kite-ix__stage {
    position: relative;
    flex: 1 1 auto;
    min-height: 260px;
    display: flex;
  }
  .kite-ix__badge {
    position: absolute;
    top: 10px;
    inset-inline-start: 10px;
    z-index: 4;
    padding: 7px 14px;
    background: #e6a534;
    color: #22305a;
    border: 2px solid #22305a;
    border-radius: 999px;
    box-shadow: 2px 2px 0 #22305a;
    font: 800 15px/1.2 Heebo, 'Heebo Fallback', sans-serif;
    pointer-events: none;
  }
  .kite-ix__cue[hidden] {
    display: none;
  }
  .kite-ix__cue {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 5;
    pointer-events: none;
  }
  .kite-ix__cue-ring {
    position: absolute;
    left: -15px;
    top: -15px;
    width: 30px;
    height: 30px;
    border: 3px solid #e6a534;
    border-radius: 50%;
    opacity: 0;
    animation: kite-ix-pulse 2.6s ease-out 1;
  }
  .kite-ix__cue-finger {
    position: absolute;
    left: 16px;
    top: -7px;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: #22305a;
    box-shadow: 0 1px 5px rgba(34, 48, 90, 0.45);
    opacity: 0;
    animation: kite-ix-nudge 2.6s ease-in-out 1;
  }
  @keyframes kite-ix-pulse {
    0% {
      transform: scale(0.55);
      opacity: 0;
    }
    18% {
      opacity: 1;
    }
    55% {
      transform: scale(1.6);
      opacity: 0.8;
    }
    100% {
      transform: scale(1.9);
      opacity: 0;
    }
  }
  @keyframes kite-ix-nudge {
    0% {
      transform: translate(0, 0);
      opacity: 0;
    }
    15% {
      opacity: 1;
    }
    40% {
      transform: translate(-30px, 0);
    }
    72% {
      transform: translate(-30px, 0);
    }
    100% {
      transform: translate(0, 0);
      opacity: 0;
    }
  }
  :global(html.nd-motion-off) .kite-ix__cue,
  :global(html.noam-a11y-motion) .kite-ix__cue {
    display: none;
  }
  .kite-ix__board :global(.JXGtext) {
    font-family: Heebo, 'Heebo Fallback', sans-serif;
  }
  .kite-ix__readout {
    margin: 0;
    text-align: center;
    font-size: 17px;
    font-weight: 700;
    color: #22305a;
  }
  .kite-ix__readout .kite-ix-math {
    direction: ltr;
    unicode-bidi: isolate;
    white-space: nowrap;
  }
  .kite-ix__actions {
    display: flex;
    gap: 10px;
    justify-content: center;
    flex-wrap: wrap;
  }
  .kite-ix__replay,
  .kite-ix__reset,
  .kite-ix__open {
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 14px;
    border: 2px solid #22305a;
    font: 700 15px/normal Heebo, 'Heebo Fallback', sans-serif;
    cursor: pointer;
  }
  .kite-ix__replay {
    background: #22305a;
    color: #fbfaf5;
    box-shadow: 3px 3px 0 #e6a534;
  }
  .kite-ix__reset {
    background: transparent;
    color: #22305a;
  }
  .kite-ix-open-wrap {
    display: flex;
    justify-content: center;
    margin-top: 10px;
  }
  .kite-ix__open {
    background: #fbfaf5;
    color: #22305a;
    box-shadow: 3px 3px 0 #e6a534;
  }
  :global(html.nd-motion-off) .kite-ix,
  :global(html.noam-a11y-motion) .kite-ix {
    transition: none;
  }
  @media (max-width: 480px) {
    .kite-ix {
      gap: 10px;
    }
    .kite-ix__board {
      min-height: 240px;
    }
    .kite-ix__hint {
      font-size: 14px;
    }
    .kite-ix__readout {
      font-size: 15px;
    }
  }
</style>

<script>
  import { initKiteInteractive } from '../lib/kiteInteractive';
  initKiteInteractive();
</script>
