---
/**
 * percent-of-quantity-grade-6: hands-on 100-square.
 *
 * The quantity is split into 100 equal squares, so each square is 1%.
 * The learner drags across the grid (or uses the slider) to colour N
 * squares and picks the quantity from chips; the readout shows
 * 1% = Q : 100 and N% = N × (Q : 100) — the page's own method.
 *
 *   - opens on the page's example, 45% of 200 = 90
 *   - a short fill demo (once, in view only) runs from 0 to 45
 *   - drag: Pointer Events with setPointerCapture, touch-action: none
 *   - keyboard/SR: a real <input type="range">, aria-live readout
 *   - prefers-reduced-motion / html.noam-a11y-motion: no demo
 */
const QUANTITIES = [200, 150, 300, 80];
const START_Q = 200;
const START_P = 45;
const cells = Array.from({ length: 100 }, (_, i) => i);
---

<div class="pct-explorer" data-pct-explorer data-q={START_Q} data-p={START_P}>
  <div class="pct-explorer__card">
    <p class="pct-explorer__ask">
      כמה זה <bdi data-el="ask-p">{START_P}%</bdi> מתוך <bdi data-el="ask-q">{START_Q}</bdi>?
    </p>

    <div class="pct-chips" role="group" aria-label="בחרו כמות">
      {
        QUANTITIES.map((q) => (
          <button
            type="button"
            class="pct-chip"
            data-q={q}
            aria-pressed={q === START_Q ? 'true' : 'false'}
          >
            {q}
          </button>
        ))
      }
    </div>

    <div class="pct-grid" data-el="grid" aria-hidden="true">
      {cells.map((i) => <span class:list={['pct-cell', i < START_P && 'is-on']} />)}
    </div>

    <div class="pct-readout" dir="ltr">
      <p>1% = <span data-el="q">{START_Q}</span> : 100 = <b class="pct-one" data-el="one">2</b></p>
      <p>
        <span data-el="p">{START_P}</span>% = <span data-el="p2">{START_P}</span> × <span data-el="one2">2</span> =
        <b class="pct-ans" data-el="ans">90</b>
      </p>
    </div>
    <p class="pct-explorer__hint">
      כל משבצת היא 1% מהכמות. גררו על הלוח או הזיזו את הסרגל כדי לצבוע עוד משבצות.
    </p>

    <label class="pct-slider">
      <span class="sr-only">כמה אחוזים לצבוע</span>
      <input type="range" data-el="range" min="0" max="100" step="1" value={START_P} />
    </label>
    <p class="sr-only" aria-live="polite" data-el="live"></p>
  </div>
</div>

<script>
  import { initPercentExplorers } from '../lib/percentExplorer';
  initPercentExplorers();
</script>

<style>
  .pct-explorer {
    margin: 6px 0 20px;
  }
  .pct-explorer__card {
    background: #fff;
    border: 1.5px solid rgba(26, 43, 74, 0.1);
    border-radius: 16px;
    box-shadow: var(--shadow-soft);
    padding: 14px 16px 12px;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .pct-explorer__ask {
    margin: 0;
    font-weight: 800;
    font-size: 1.2rem;
    color: var(--navy);
    text-align: center;
  }
  .pct-chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .pct-chip {
    font: inherit;
    font-weight: 700;
    min-width: 3.4em;
    padding: 4px 12px;
    border-radius: 999px;
    border: 1.5px solid rgba(26, 43, 74, 0.25);
    background: #fff;
    color: var(--navy);
    cursor: pointer;
  }
  .pct-chip[aria-pressed='true'] {
    background: var(--navy);
    border-color: var(--navy);
    color: #fff;
  }
  .pct-chip:focus-visible,
  .pct-slider input:focus-visible {
    outline: 3px solid var(--cobalt);
    outline-offset: 2px;
  }
  .pct-grid {
    display: grid;
    grid-template-columns: repeat(10, 1fr);
    gap: 3px;
    width: min(100%, 300px);
    touch-action: none;
    cursor: pointer;
    user-select: none;
  }
  .pct-cell {
    aspect-ratio: 1;
    border-radius: 4px;
    background: #eef1f5;
    transition: background-color 0.15s ease;
  }
  .pct-cell.is-on {
    background: #e6a534;
  }
  .pct-cell:first-child {
    box-shadow: inset 0 0 0 2px var(--navy);
  }
  .pct-readout {
    direction: ltr;
    unicode-bidi: isolate;
    text-align: center;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
  }
  .pct-readout p {
    margin: 0;
    white-space: nowrap;
  }
  .pct-one {
    color: #1e605e;
  }
  .pct-ans {
    color: #e5735c;
    font-size: 1.3em;
  }
  .pct-explorer__hint {
    margin: 0;
    text-align: center;
    color: var(--muted);
    font-weight: 600;
    max-width: 34em;
  }
  .pct-slider {
    display: block;
    width: min(100%, 300px);
  }
  .pct-slider input[type='range'] {
    width: 100%;
    accent-color: #e6a534;
    height: 28px;
    background: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html:not(.nd-motion-enabled)) .pct-cell {
      transition: none;
    }
  }
  :global(html.noam-a11y-motion) .pct-cell {
    transition: none;
  }
</style>
