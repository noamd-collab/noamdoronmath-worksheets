---
/**
 * Home hero: pick one restored ConceptLoop at random on each visit.
 * Pool = F01–F06 + F21/F26/F38 (same set kept on topic pages after KIMI-ANIM-6).
 * F07–F14 stay off the home hero (thin film cards Noam rejected on topics).
 *
 * Client-side pick (inline, before deferred conceptLoops init):
 *   - SSR shows the first variant so the grid slot is reserved (no CLS)
 *   - script removes the non-picked siblings immediately
 *   - ConceptLoop engine already respects prefers-reduced-motion /
 *     html.noam-a11y-motion (static completed frame, toggle hidden)
 */
import ConceptLoop from './ConceptLoop.astro';

const HOME_LOOP_VARIANTS = [
  'sticks',
  'numberline',
  'tenframes',
  'balance',
  'pattern',
  'bars',
  'triangle',
  'pythagoras',
  'area-model',
] as const;

type HomeLoopVariant = (typeof HOME_LOOP_VARIANTS)[number];
---

<div
  class="home-random-loop"
  data-home-random-loop
  data-home-loop-pool={HOME_LOOP_VARIANTS.join(',')}
>
  {
    HOME_LOOP_VARIANTS.map((variant: HomeLoopVariant, i) => (
      <div
        class:list={['home-random-loop__item', { 'is-active': i === 0 }]}
        data-home-loop-item
        data-variant={variant}
      >
        <ConceptLoop variant={variant} />
      </div>
    ))
  }
</div>
<script is:inline>
  (function () {
    var root =
      document.currentScript && document.currentScript.previousElementSibling;
    if (!root || !root.hasAttribute('data-home-random-loop')) return;
    var items = Array.prototype.slice.call(
      root.querySelectorAll('[data-home-loop-item]'),
    );
    if (!items.length) return;
    var pick = Math.floor(Math.random() * items.length);
    var kept = items[pick];
    for (var i = 0; i < items.length; i++) {
      if (i === pick) {
        items[i].classList.add('is-active');
      } else {
        items[i].remove();
      }
    }
    root.setAttribute('data-picked', kept.getAttribute('data-variant') || '');
    root.setAttribute('data-ready', '');
  })();
</script>

<style>
  /* Reserve the tallest restored film-card so a client pick cannot
     reflow the hero grid (CLS). Width comes from .home-hero placement. */
  .home-random-loop {
    width: 100%;
    min-height: 440px;
  }
  .home-random-loop__item:not(.is-active) {
    display: none;
  }
</style>
