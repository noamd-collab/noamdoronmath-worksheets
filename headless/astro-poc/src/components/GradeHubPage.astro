---
import BaseLayout from '../layouts/BaseLayout.astro';
import LineArtDoodles from './LineArtDoodles.astro';
import MathWidget from './MathWidget.astro';
import type { MathWidgetVariant } from './MathWidget.astro';
import GradeLoopPlayer from './GradeLoopPlayer.astro';
import { loadCatalog } from '../lib/catalog/loadCatalog';
import {
  loadGradeHub,
  siblingGradeHubLinks,
  type GradeHubGrade,
} from '../lib/gradeHubs';
import { localizeSiteHref } from '../lib/sitePages';
import { resolveSiteHrefString } from '../lib/resolveSiteHref';
import { grokLoopsForGrade, visibleGrokLoops } from '../lib/grokLoops';

interface Props {
  grade: GradeHubGrade;
}
const { grade } = Astro.props;
const hub = loadGradeHub(grade);
const siblings = siblingGradeHubLinks(grade);
const familyLabel = grade <= 6 ? 'כיתות יסודי' : 'כיתות חטיבה';
const introIsCta = !!(hub.catalogCta && hub.catalogCta.label === hub.intro);
const hasFaq = hub.faq.length > 0 && !!hub.faqHeading;
const hasTopics = hub.topicSections.some((s) => s.links.length > 0);
const grade1Catalog =
  grade === 1 ? loadCatalog().grades.find((entry) => entry.grade === 1) : undefined;
const grade1Groups = (grade1Catalog?.groups ?? [])
  .map((group) => ({
    key: group.key,
    label: group.label,
    topics: (grade1Catalog?.topics ?? []).filter(
      (topic) => topic.group === group.key && topic.parent === undefined
    ),
  }))
  .filter((group) => group.topics.length > 0);
const faqJsonLd = hasFaq
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: hub.faq.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    }
  : null;

/** Mid-school hubs keep a single MathWidget film; grades 1–6 use one unified Grok player. */
const mathVariant: MathWidgetVariant | null =
  grade === 7
    ? 'triangle'
    : grade === 8
      ? 'exterior'
      : grade === 9
        ? 'areaModel'
        : null;
const mathFamily = grade <= 6 ? 'elem' : 'mid';
const grokGradeLoops = visibleGrokLoops(grokLoopsForGrade(grade));
const useUnifiedGrokPlayer = grade >= 1 && grade <= 6 && grokGradeLoops.length > 0;
---
<BaseLayout
  title={hub.title}
  description={hub.description}
  activeNav="worksheets"
  skipHref="#grade-hub-main"
>
  {faqJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqJsonLd)} />}
  <main class="grade-hub wrap" data-grade={String(grade)} id="grade-hub-main">
    <nav class="grade-hub__siblings" aria-label={familyLabel}>
      {
        siblings.map((s) => (
          <a
            class:list={['grade-tab', s.grade === grade && 'is-current']}
            href={s.href}
            aria-current={s.grade === grade ? 'page' : undefined}
            data-peek={`g:${s.grade}`}
          >
            כיתה {s.label}
          </a>
        ))
      }
    </nav>

    <header
      class:list={['grade-hub__header', 'banner', mathVariant && 'grade-hub__header--loop']}
    >
      <div class="grade-hub__header-main">
        <h1>{hub.h1}</h1>
        {hub.lead && <p class="grade-hub__lead">{hub.lead}</p>}
        {
          hub.lead && hub.catalogCta && (
            <p class="grade-hub__cta-wrap">
              <a class="cta cta--primary grade-hub__cta" href={hub.catalogCta.href} data-peek="ws">
                {hub.catalogCta.label}
              </a>
            </p>
          )
        }
        {
          !hub.lead && !introIsCta && <p class="grade-hub__intro">{hub.intro}</p>
        }
        {
          !hub.lead && hub.catalogCta && (
            <p class="grade-hub__cta-wrap">
              <a class="cta cta--primary grade-hub__cta" href={hub.catalogCta.href} data-peek="ws">
                {hub.catalogCta.label}
              </a>
            </p>
          )
        }
      </div>
      {
        mathVariant && (
          <MathWidget variant={mathVariant} mode="loop" family={mathFamily} />
        )
      }
    </header>
    <LineArtDoodles variant="hub" />

    {
      useUnifiedGrokPlayer && (
        <section
          class="grade-unified-player"
          aria-labelledby="grade-unified-player-title"
          data-grade-unified-player
        >
          <h2 id="grade-unified-player-title" class="grade-hub__section-title">
            המחשות הכיתה
          </h2>
          <GradeLoopPlayer
            entries={grokGradeLoops}
            playerId={`grade-${grade}-player`}
            label="כל המחשות הכיתה"
          />
        </section>
      )
    }

    {
      grade1Groups.length > 0 && (
        <section class="grade-hub__topics" aria-label="קבוצות נושאים">
          <h2 class="grade-hub__section-title">נושאים במאגר</h2>
          {grade1Groups.map((group) => (
            <div class="grade-hub__section">
              <h3 class="grade-hub__section-title">
                <a href={`/worksheets?grade=1&group=${group.key}`}>{group.label}</a>
              </h3>
              <ul class="grade-hub__topic-list">
                {group.topics.map((topic) => (
                  <li>
                    <a href={`/worksheets?grade=1&group=${group.key}&topic=${topic.id}`}>
                      {topic.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    {
      hasTopics && (
        <section class="grade-hub__topics" aria-label="נושאים">
          {hub.topicSections.map((section) => (
            <div class="grade-hub__section">
              {section.heading && <h2 class="grade-hub__section-title">{section.heading}</h2>}
              <ul class="grade-hub__topic-list">
                {section.links.map((link) => (
                  <li>
                    <a
                      href={resolveSiteHrefString(link.productionHref || link.path)}
                      rel="noopener noreferrer"
                      data-topic-path={link.path}
                    >
                      {link.label}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </section>
      )
    }

    {
      hub.lead && !introIsCta && (
        <details class="grade-hub__intro-fold">
          <summary>ההסבר המלא</summary>
          <p class="grade-hub__intro">{hub.intro}</p>
        </details>
      )
    }

    {
      hasFaq && (
        <section class="grade-hub__faq" aria-labelledby="grade-hub-faq-heading">
          <h2 id="grade-hub-faq-heading">{hub.faqHeading}</h2>
          <div class="grade-hub__faq-list">
            {hub.faq.map((item) => (
              <details class="grade-hub__faq-item">
                <summary>{item.question}</summary>
                <p>{item.answer}</p>
              </details>
            ))}
          </div>
        </section>
      )
    }

    {
      hub.whatsapp && (
        <aside class="grade-hub__whatsapp" aria-label={hub.whatsapp.heading}>
          <h2 class="grade-hub__section-title">{hub.whatsapp.heading}</h2>
          <p>{hub.whatsapp.body}</p>
          <p>
            <a href={hub.whatsapp.href} rel="noopener noreferrer">
              {hub.whatsapp.ctaLabel}
            </a>
          </p>
        </aside>
      )
    }

    {
      hub.footerLinks && hub.footerLinks.length > 0 && (
        <nav class="grade-hub__footer-links" aria-label="קישורים נוספים">
          <ul>
            {hub.footerLinks.map((link) => (
              <li>
                <a href={localizeSiteHref(link.href)} rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      hub.contactLine && <p class="grade-hub__contact">{hub.contactLine}</p>
    }

    <p class="grade-hub__terms">
      <a href={localizeSiteHref(hub.terms.href)} rel="noopener noreferrer">{hub.terms.label}</a>
    </p>
  </main>
</BaseLayout>

<style>
  .grade-unified-player {
    margin-block: 28px 16px;
  }
</style>
