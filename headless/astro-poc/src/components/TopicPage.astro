---
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/exact-topic.css';
import TriangleAreaExplorer from './TriangleAreaExplorer.astro';
import ConceptLoop from './ConceptLoop.astro';
import LandingLoop from './LandingLoop.astro';
import DistancePointsLoop from './DistancePointsLoop.astro';
import TriangleAngleSumLoop from './TriangleAngleSumLoop.astro';
import ParallelCointeriorLoop from './ParallelCointeriorLoop.astro';
import StatisticsFrequencyLoop from './StatisticsFrequencyLoop.astro';
import KiteInteractive from './KiteInteractive.astro';
import { loadCatalog } from '../lib/catalog/loadCatalog';
import { worksheetActionLabel } from '../lib/worksheetActions';
import TopicShareLink from './TopicShareLink.astro';
import TopicWorksheetEditions from './TopicWorksheetEditions.astro';
import { topicWorksheetEditionLinks } from '../lib/topicWorksheetEditions';
import { LANDING_LOOP_ANCHORS, componentLandingLoop, topicLandingLoop } from '../lib/landingLoops';
import AdjacentVerticalAnglesLoop from './AdjacentVerticalAnglesLoop.astro';
import {
  loadTopicPage,
  synthesizeBodyFlow,
  updatedLineIsoDate,
  type TopicBodyFlowItem,
  type TopicPageFaqGroup,
} from '../lib/topicPages';
import { localizeSiteHref } from '../lib/sitePages';
import { topicTextParts } from '../lib/topicTextParts';
import { gradeHubLabel, isGradeHubGrade } from '../lib/gradeHubs';
import { resolveSiteHrefString } from '../lib/resolveSiteHref';
import TopicInline from './TopicInline.astro';
import { nextGradeRelatedTopics } from '../lib/topicFamilies';
import {
  educationalLevelForGrade,
  jsonLdTypes,
  learningResourceJsonLd,
} from '../lib/structuredData';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const page = loadTopicPage(slug);
const contentImages = (page.images || []).filter((i) => i.role === 'content-candidate');
const about = page.author.links.find((l) => l.href.includes('aboutus'));
const authorParts = about && page.author.text.includes(about.label)
  ? page.author.text.split(about.label)
  : null;

const beforeUpdateCount =
  page.updatedLinePlacement === 'after-first-faq-group' ? 1 : 0;
const faqBeforeUpdate = page.faqGroups.slice(0, beforeUpdateCount);
const faqAfterUpdate = page.faqGroups.slice(beforeUpdateCount);
const bodyFlow: TopicBodyFlowItem[] = synthesizeBodyFlow(page);
const NOWRAP_MATH = new Set(['S = (d1 · d2) : 2', '(6 · 8) : 2 = 24', '(10 · 6) : 2 = 30']);

/**
 * Keep a whole formula on one line (the isolate stays inside the span), and
 * keep each ⟨n¦d⟩ fraction marker in one part so TopicInline can stack it.
 */
function textParts(text: string): { text: string; nowrap: boolean }[] {
  return topicTextParts(text, NOWRAP_MATH);
}

/** Group flow so H2 sections nest following paragraphs/lists; CTAs stay ordered siblings. */
type BodyUnit =
  | { kind: 'intro'; text: string }
  | { kind: 'cta'; item: Extract<TopicBodyFlowItem, { type: 'cta' }> }
  | {
      kind: 'section';
      heading: string;
      blocks: Extract<TopicBodyFlowItem, { type: 'paragraph' | 'list' }>[];
    }
  | { kind: 'orphan'; item: Extract<TopicBodyFlowItem, { type: 'paragraph' | 'list' }> };

function groupBodyFlow(flow: TopicBodyFlowItem[]): BodyUnit[] {
  const units: BodyUnit[] = [];
  let current: {
    heading: string;
    blocks: Extract<TopicBodyFlowItem, { type: 'paragraph' | 'list' }>[];
  } | null = null;
  const flush = () => {
    if (current) {
      units.push({ kind: 'section', heading: current.heading, blocks: current.blocks });
      current = null;
    }
  };
  for (const b of flow) {
    if (b.type === 'paragraph' && b.role === 'intro') {
      flush();
      units.push({ kind: 'intro', text: b.text });
      continue;
    }
    if (b.type === 'cta') {
      flush();
      units.push({ kind: 'cta', item: b });
      continue;
    }
    if (b.type === 'heading') {
      flush();
      current = { heading: b.text, blocks: [] };
      continue;
    }
    if (b.type === 'paragraph' || b.type === 'list') {
      if (current) current.blocks.push(b);
      else units.push({ kind: 'orphan', item: b });
    }
  }
  flush();
  return units;
}

const bodyUnits = groupBodyFlow(bodyFlow);
const gradeCrumbLabel = isGradeHubGrade(page.grade)
  ? `כיתה ${gradeHubLabel(page.grade)}`
  : `כיתה ${page.grade}`;
const topicCrumbs = [
  { name: 'בית', path: '/' },
  { name: gradeCrumbLabel, path: page.gradeHubHref },
  { name: page.h1, path: page.path },
];
const nextGradeTopics = nextGradeRelatedTopics(page.slug, page.grade);
const topicJsonLdExtras = jsonLdTypes(page.jsonLd).includes('LearningResource')
  ? []
  : [
      learningResourceJsonLd({
        name: page.h1,
        path: page.path,
        description: page.description,
        educationalLevel: educationalLevelForGrade(page.grade),
        dateModified: updatedLineIsoDate(page.updatedLine),
      }),
    ];

/* FAMILIES-B1: a family ConceptLoop (F01–F06, F21, F26, F38) stays in the
   card beside the intro. Other families get a CSS LandingLoop. F07–F14 film
   variants stay off topic pages (KIMI-ANIM-6). triangle-area-grade-7 keeps
   its explorer and also gets a CSS loop — the explorer glides once.
   analytic-geometry-grade-9 mounts DistancePointsLoop in this same slot.
   triangle-quadrilateral-angle-sum-grade-7 mounts the provided HTML film
   (its own controls and angle readouts stay inside the iframe).
   parallel-lines-angles-grade-8 mounts the co-interior angles film.
   statistics-data-frequency-grade-8 mounts the silent statistics film. */
const landingLoop = topicLandingLoop(page);
const loopVariant = landingLoop.kind === 'concept' ? landingLoop.variant : undefined;
const componentLoop = componentLandingLoop(slug);
const cssVariant = landingLoop.kind === 'css' && !componentLoop ? landingLoop.variant : undefined;
const demoAnchor = LANDING_LOOP_ANCHORS[slug];
const filmLoop = landingLoop.kind === 'film';
const bareFilm =
  filmLoop &&
  (landingLoop.marker === 'triangle-angle-sum-vertex-descent' ||
    landingLoop.marker === 'parallel-cointerior-angles' ||
    landingLoop.marker === 'statistics-frequency');
const hasDemo = landingLoop.kind === 'concept' || landingLoop.kind === 'css' || filmLoop;
const bodyStart = bodyUnits.findIndex((unit) => unit.kind !== 'intro' && unit.kind !== 'cta');
const heroEnd = bodyStart === -1 ? bodyUnits.length : bodyStart;
const heroUnits = hasDemo ? bodyUnits.slice(0, heroEnd) : [];
const flowUnits = hasDemo ? bodyUnits.slice(heroEnd) : bodyUnits;
const catalog = loadCatalog();
const topicId = page.catalogCta?.catalogTopicId ?? null;
function editionsForTopicId(catTopicId: number | null | undefined, backHref?: string) {
  return topicWorksheetEditionLinks(catalog, page.grade, catTopicId,
    resolveSiteHrefString(backHref || page.catalogCta.href));
}

function levelsForTopicId(catTopicId: number | null | undefined, backHref?: string) {
  return editionsForTopicId(catTopicId, backHref)[0]?.levels || [];
}

const topicEditions = editionsForTopicId(topicId, page.catalogCta?.href);
const topicLevels = topicEditions[0]?.levels || [];

function ctaTargetHref(cta: { label: string; href: string; catalogTopicId?: number | null }, targetId: string) {
  const levels = levelsForTopicId(cta.catalogTopicId ?? topicId, cta.href);
  if (cta.label.includes('רמה ב')) {
    return levels.find((l) => l.key === 'b')?.href || `#${targetId}`;
  }
  if (cta.label.includes('מצוינות')) {
    return levels.find((l) => l.key === 'c' || l.key === 'c2')?.href || `#${targetId}`;
  }
  if (levels.length === 1) {
    return levels[0].href;
  }
  return `#${targetId}`;
}

function faqHeadingId(groupIndex: number) {
  return groupIndex === 0 ? 'topic-faq-heading' : `topic-faq-heading-${groupIndex}`;
}
---
<BaseLayout
  title={page.title}
  description={page.description}
  ogImage={page.ogImage || undefined}
  crumbs={topicCrumbs}
  seoPath={page.path}
  activeNav="worksheets"
  skipHref="#topic-page-main"
>
  <script type="application/ld+json" set:html={JSON.stringify(page.jsonLd)} />
  {topicJsonLdExtras.map((node) => (
    <script type="application/ld+json" set:html={JSON.stringify(node)} />
  ))}

  <main
    class="topic-page exact-topic"
    data-grade={String(page.grade)}
    id="topic-page-main"
    data-topic-slug={page.slug}
  >
    <nav class="topic-page__crumbs" aria-label="מיקום">
      <a href="/">בית</a>
      <span aria-hidden="true">/</span>
      <a href={page.gradeHubHref}>{gradeCrumbLabel}</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{page.h1}</span>
    </nav>
    <div data-doodle="pencil" class="exact-topic-pencil">
      <button type="button" class="exact-doodle-btn" aria-label="הנפשת השרבוט">
        <img src="/design-exact/assets/doodles/orbit-pencil.webp" alt="" width="400" height="400" decoding="async" />
      </button>
    </div>

    {
      (page.preH1Ctas || []).map((cta, idx) => {
        const preEditions = editionsForTopicId(cta.catalogTopicId ?? topicId, cta.href);
        const targetId = idx === 0 && !hasDemo ? 'topic-levels' : `topic-levels-pre-${idx}`;
        const directHref = ctaTargetHref(cta, targetId);
        return (
          <div class="topic-page__cta-group">
            <p class="topic-page__cta-row topic-page__cta-row--pre-h1" data-flow="cta" data-pre-h1-cta data-catalog-ctas>
              <a
                class="cta cta--mid topic-page__cta"
                href={directHref}
                data-catalog-href={resolveSiteHrefString(cta.href)}
                data-catalog-topic={
                  cta.catalogTopicId != null ? String(cta.catalogTopicId) : undefined
                }
              >
                {worksheetActionLabel(cta.label, directHref)}
              </a>
            </p>
            {preEditions.length > 0 && (directHref.startsWith('#') || preEditions.length > 1) && (
              <TopicWorksheetEditions id={targetId} editions={preEditions} />
            )}
          </div>
        );
      })
    }

    <header class="topic-page__header">
      <h1>{page.h1}</h1>
      <TopicShareLink path={page.path} />
    </header>

    <div data-body-flow>
      {hasDemo && (
        <div class="exact-topic-hero">
          <div
            class:list={['exact-topic-demo', bareFilm && 'exact-topic-demo--bare', landingLoop.kind === 'film' && landingLoop.marker === 'statistics-frequency' && 'exact-topic-demo--stats-film']}
            id={demoAnchor}
            data-landing-loop={loopVariant ? landingLoop.marker : undefined}
            style={`background:${bareFilm ? '#fbfaf5' : page.grade >= 7 ? '#e3f1ec' : '#f8ebe0'}`}
          >
            {slug === 'triangle-area-grade-7' && <TriangleAreaExplorer />}
            {loopVariant && <ConceptLoop variant={loopVariant} />}
            {cssVariant && <LandingLoop variant={cssVariant} />}
            {componentLoop === 'adjacent-vertical-angles' && <AdjacentVerticalAnglesLoop marker={componentLoop} />}
            {landingLoop.kind === 'film' && landingLoop.marker === 'distance-between-points' && (
              <DistancePointsLoop src={landingLoop.src} marker={landingLoop.marker} />
            )}
            {landingLoop.kind === 'film' && landingLoop.marker === 'triangle-angle-sum-vertex-descent' && (
              <TriangleAngleSumLoop src={landingLoop.src} marker={landingLoop.marker} />
            )}
            {landingLoop.kind === 'film' && landingLoop.marker === 'parallel-cointerior-angles' && (
              <ParallelCointeriorLoop src={landingLoop.src} marker={landingLoop.marker} />
            )}
            {landingLoop.kind === 'film' && landingLoop.marker === 'statistics-frequency' && (
              <StatisticsFrequencyLoop src={landingLoop.src} marker={landingLoop.marker} />
            )}
            {slug === 'kite-grade-9' && <KiteInteractive />}
          </div>
          <div class="exact-topic-copy">
            {heroUnits.map((unit) => {
              if (unit.kind === 'intro') return (
                <p class="topic-page__intro" data-flow="paragraph" data-role="intro"><TopicInline text={unit.text} /></p>
              );
              if (unit.kind === 'cta') {
                const directHref = ctaTargetHref(unit.item, 'topic-levels');
                return (
                  <p class="topic-page__cta-row" data-flow="cta" data-catalog-ctas>
                    <a
                      class="cta cta--mid topic-page__cta"
                      href={directHref}
                      data-catalog-href={resolveSiteHrefString(unit.item.href)}
                      data-catalog-topic={unit.item.catalogTopicId != null ? String(unit.item.catalogTopicId) : undefined}
                      target={directHref.startsWith('#') ? undefined : '_blank'}
                      rel={directHref.startsWith('#') ? undefined : 'noopener noreferrer'}
                    >{worksheetActionLabel(unit.item.label, directHref)}</a>
                  </p>
                );
              }
              return null;
            })}
            {topicLevels.length > 0 && (
              <TopicWorksheetEditions id="topic-levels" editions={topicEditions} />
            )}
          </div>
        </div>
      )}
      <div class="topic-page__body">
      {
        flowUnits.map((unit) => {
          if (unit.kind === 'intro') {
            return (
              <p class="topic-page__intro" data-flow="paragraph" data-role="intro">
                {textParts(unit.text).map((part) =>
                  part.nowrap ? <span class="topic-math-nowrap"><TopicInline text={part.text} /></span> : <TopicInline text={part.text} />,
                )}
              </p>
            );
          }
          if (unit.kind === 'cta') {
            const block = unit.item;
            const flowEditions = editionsForTopicId(block.catalogTopicId ?? topicId, block.href);
            const targetId = !hasDemo && topicLevels.length > 0 && block.catalogTopicId === topicId
              ? 'topic-levels'
              : `topic-levels-${block.catalogTopicId ?? 'main'}`;
            const directHref = ctaTargetHref(block, targetId);
            return (
              <div class="topic-page__cta-group" data-flow="cta" data-catalog-ctas>
                <p class="topic-page__cta-row">
                  <a
                    class="cta cta--mid topic-page__cta"
                    href={directHref}
                    data-catalog-href={resolveSiteHrefString(block.href)}
                    data-catalog-topic={
                      block.catalogTopicId != null ? String(block.catalogTopicId) : undefined
                    }
                    target={directHref.startsWith('#') ? undefined : '_blank'}
                    rel={directHref.startsWith('#') ? undefined : 'noopener noreferrer'}
                  >
                    {worksheetActionLabel(block.label, directHref)}
                  </a>
                </p>
                {flowEditions.length > 0 && (directHref.startsWith('#') || flowEditions.length > 1) && (
                  <TopicWorksheetEditions id={targetId} editions={flowEditions} />
                )}
              </div>
            );
          }
          if (unit.kind === 'section') {
            return (
              <section class="topic-page__section" data-flow="heading">
                <h2>{unit.heading}</h2>
                {unit.blocks.map((block) => {
                  if (block.type === 'paragraph') {
                    const cls =
                      block.role === 'self-check' ? 'topic-page__self-check' : undefined;
                    return (
                      <p class={cls} data-flow="paragraph" data-role={block.role || 'body'}>
                        {textParts(block.text).map((part) =>
                          part.nowrap ? <span class="topic-math-nowrap"><TopicInline text={part.text} /></span> : <TopicInline text={part.text} />,
                        )}
                      </p>
                    );
                  }
                  if (block.type === 'list') {
                    return block.ordered ? (
                      <ol data-flow="list">
                        {block.items.map((item) => (
                          <li set:text={item} />
                        ))}
                      </ol>
                    ) : (
                      <ul data-flow="list">
                        {block.items.map((item) => (
                          <li set:text={item} />
                        ))}
                      </ul>
                    );
                  }
                  return null;
                })}
              </section>
            );
          }
          if (unit.kind === 'orphan') {
            const block = unit.item;
            if (block.type === 'paragraph') {
              const cls = block.role === 'self-check' ? 'topic-page__self-check' : undefined;
              return (
                <p class={cls} data-flow="paragraph" data-role={block.role || 'body'}>
                  {textParts(block.text).map((part) =>
                    part.nowrap ? <span class="topic-math-nowrap"><TopicInline text={part.text} /></span> : <TopicInline text={part.text} />,
                  )}
                </p>
              );
            }
            if (block.type === 'list') {
              return block.ordered ? (
                <ol data-flow="list">
                  {block.items.map((item) => (
                    <li set:text={item} />
                  ))}
                </ol>
              ) : (
                <ul data-flow="list">
                  {block.items.map((item) => (
                    <li set:text={item} />
                  ))}
                </ul>
              );
            }
          }
          return null;
        })
      }
      </div>
    </div>

    {
      contentImages.length > 0 && (
        <figure class="topic-page__figure">
          {contentImages.map((img) => (
            <img src={img.src} alt={img.alt || page.h1} loading="lazy" decoding="async" />
          ))}
        </figure>
      )
    }

    {
      faqBeforeUpdate.map((group: TopicPageFaqGroup, gi: number) => (
        <section class="topic-page__faq" aria-labelledby={faqHeadingId(gi)} data-faq-group={String(gi)}>
          <h2 id={faqHeadingId(gi)}>{group.heading}</h2>
          <div class="topic-page__faq-list">
            {group.items.map((item) => (
              <div class="topic-page__faq-item" data-faq-item>
                <h3>{item.question}</h3>
                <p>{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      ))
    }

    {
      page.updatedLine && (
        <p class="topic-page__updated" data-updated-line>
          {page.updatedLine}
        </p>
      )
    }

    <p class="topic-page__author">
      {
        authorParts && about ? (
          <>
            {authorParts[0]}
            <a href={localizeSiteHref(about.href)} rel="noopener noreferrer">
              {about.label}
            </a>
            {authorParts.slice(1).join(about.label)}
          </>
        ) : (
          <>
            {page.author.text}
            {about && (
              <>
                {' '}
                <a href={localizeSiteHref(about.href)} rel="noopener noreferrer">
                  ({about.label})
                </a>
              </>
            )}
          </>
        )
      }
    </p>

    {
      page.relatedTopics.length > 0 && (
        <nav class="topic-page__related" aria-label="נושאים קשורים">
          <h2 class="topic-page__related-title">נושאים קשורים</h2>
          <ul>
            {page.relatedTopics.map((rel) => (
              <li>
                <a
                  href={resolveSiteHrefString(rel.productionHref || rel.path)}
                  rel="noopener noreferrer"
                  data-topic-path={rel.path}
                >
                  {rel.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      nextGradeTopics.length > 0 && (
        <nav class="topic-page__related topic-page__next-grade" aria-label="בכיתה הבאה">
          <h2 class="topic-page__related-title">בכיתה הבאה</h2>
          <ul>
            {nextGradeTopics.map((rel) => (
              <li>
                <a href={resolveSiteHrefString(rel.productionHref || rel.path)} rel="noopener noreferrer">
                  {rel.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }

    {
      faqAfterUpdate.map((group: TopicPageFaqGroup, oi: number) => {
        const gi = beforeUpdateCount + oi;
        return (
          <section class="topic-page__faq" aria-labelledby={faqHeadingId(gi)} data-faq-group={String(gi)}>
            <h2 id={faqHeadingId(gi)}>{group.heading}</h2>
            <div class="topic-page__faq-list">
              {group.items.map((item) => (
                <div class="topic-page__faq-item" data-faq-item>
                  <h3>{item.question}</h3>
                  <p>{item.answer}</p>
                </div>
              ))}
            </div>
          </section>
        );
      })
    }

    <p class="topic-page__terms">
      <a href={localizeSiteHref(page.terms.href)} rel="noopener noreferrer">
        {page.terms.label}
      </a>
    </p>
  </main>
  <script is:inline>
    (function () {
      document.addEventListener('click', function (e) {
        var link = e.target && e.target.closest ? e.target.closest('a.topic-page__cta[href^="#topic-levels"]') : null;
        if (!link) return;
        var hash = link.getAttribute('href') || '';
        var target = hash ? document.getElementById(hash.slice(1)) : null;
        if (!target) return;
        e.preventDefault();
        target.scrollIntoView({ behavior: 'smooth', block: 'center' });
        target.classList.add('is-highlighted');
        var first = target.querySelector('a.exact-topic-level');
        if (first) first.focus({ preventScroll: true });
        setTimeout(function () {
          target.classList.remove('is-highlighted');
        }, 2200);
      });

      function setupSelfCheckReveal() {
        var sections = document.querySelectorAll('.topic-page__section');
        sections.forEach(function (sec) {
          var h2 = sec.querySelector('h2');
          var heading = h2 ? (h2.textContent || '').trim() : '';
          var isCheckSection =
            heading.indexOf('בדקו') !== -1 ||
            heading.indexOf('בדיקה') !== -1 ||
            /\?$/.test(heading) ||
            /^(חשבו|פתרו|מהו|באיזה|מצאו)/.test(heading);
          var paras = sec.querySelectorAll(':scope > p');
          paras.forEach(function (p, idx) {
            if (p.dataset.selfCheckReady === '1') return;
            var raw = (p.textContent || '')
              .replace(/[\u200b\u200e\u200f\ufeff\u2066\u2067\u2068\u2069]/g, '')
              .trim();
            // Case 1: single paragraph containing both question and "תשובה:"
            if (raw.indexOf('בדקו את עצמכם') !== -1 && /תשובה\s*:/.test(raw)) {
              p.dataset.selfCheckReady = '1';
              var walker = document.createTreeWalker(p, NodeFilter.SHOW_TEXT, null);
              var targetNode = null;
              var matchIdx = -1;
              while (walker.nextNode()) {
                var val = walker.currentNode.nodeValue || '';
                var m = val.match(/תשובה\s*:/);
                if (m && m.index !== undefined) {
                  targetNode = walker.currentNode;
                  matchIdx = m.index;
                  break;
                }
              }
              if (targetNode && matchIdx >= 0) {
                var answerTextNode = targetNode.splitText(matchIdx);
                var span = document.createElement('span');
                span.className = 'topic-page__answer-reveal';
                span.hidden = true;
                var nodesToMove = [];
                var cur = answerTextNode;
                while (cur) {
                  nodesToMove.push(cur);
                  cur = cur.nextSibling;
                }
                nodesToMove.forEach(function (n) { span.appendChild(n); });
                p.appendChild(span);
                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'topic-page__reveal-btn';
                btn.setAttribute('aria-expanded', 'false');
                btn.textContent = 'הצג תשובה';
                btn.addEventListener('click', function () {
                  var open = span.hidden;
                  span.hidden = !open;
                  btn.setAttribute('aria-expanded', String(open));
                  btn.textContent = open ? 'הסתר תשובה' : 'הצג תשובה';
                });
                p.insertAdjacentElement('afterend', btn);
              }
              return;
            }
            // Case 2: answer paragraph inside a self-check section
            if (!isCheckSection) return;
            var isMeta =
              /^(?:בדף העבודה|לפני:|תחילת הפרק:|קישורים קשורים|אחרי:)/.test(raw);
            if (isMeta) return;
            var isAnswerPara =
              /^(?:ה?תשובה(?:\s+היא)?[\s:—–-]|אם\s+ספרתם\b)/.test(raw) ||
              (idx === 1 && paras.length >= 2 && !/bad/.test(raw));
            if (isAnswerPara && idx >= 1) {
              p.dataset.selfCheckReady = '1';
              p.classList.add('topic-page__answer-hidden');
              var btn2 = document.createElement('button');
              btn2.type = 'button';
              btn2.className = 'topic-page__reveal-btn';
              btn2.setAttribute('aria-expanded', 'false');
              btn2.textContent = 'הצג תשובה';
              btn2.addEventListener('click', function () {
                var hiddenNow = p.classList.toggle('topic-page__answer-hidden');
                var expanded = !hiddenNow;
                btn2.setAttribute('aria-expanded', String(expanded));
                btn2.textContent = expanded ? 'הסתר תשובה' : 'הצג תשובה';
              });
              p.insertAdjacentElement('beforebegin', btn2);
            }
          });
        });
      }
      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', setupSelfCheckReveal, { once: true });
      } else {
        setupSelfCheckReveal();
      }
    })();
  </script>
</BaseLayout>
