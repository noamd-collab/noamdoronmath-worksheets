---
/**
 * KIMI-LOOPS-K3 — Brilliant-style self-playing math film loops.
 *
 * Three variants, each explains ONE idea in a 9–11 s seamless loop:
 *   triangle    (grade 7) — same base & height → same area; S = a·h/2 = 12
 *   pythagoras  (grade 8) — squares on 3-4-5 legs; 9 + 16 tiles fill c² = 25
 *   area-model  (grade 9) — (x+3)(x+2) area model → x² + 5x + 6
 *
 * Behaviour (driven by ../lib/conceptLoops.ts):
 *   - plays only while in view (IntersectionObserver), pauses off-screen
 *     and resumes from the same point; stops on the completed state after
 *     4 laps; small pause/play toggle; prefers-reduced-motion and
 *     html.noam-a11y-motion show the completed state as a static frame.
 *
 * Markup below is the REST state of each loop (what render(0) produces),
 * so the card is meaningful before/without JS. Transient pieces start at
 * opacity 0 and are driven per-frame by the engine.
 */
export interface Props {
  variant:
    | 'triangle'
    | 'pythagoras'
    | 'area-model'
    | 'sticks'
    | 'numberline'
    | 'tenframes'
    | 'balance'
    | 'pattern'
    | 'bars'
    | 'ruler'
    | 'array'
    | 'polygon'
    | 'data'
    | 'baseten'
    | 'cookies'
    | 'fraction'
    | 'transform';
}
const { variant } = Astro.props;

const ariaLabels: Record<string, string> = {
  triangle:
    'הדגמה: מלבן 6×4 שווה 24; אלכסון מראה שהמשולש הוא חצי ממנו — S = a·h/2 = 12. הקודקוד מחליק על קו מקביל לבסיס, והשטח נשאר 12.',
  pythagoras:
    'הדגמה: משולש ישר-זווית 3-4-5. הריבועונים של a² ושל b² עוברים וממלאים את הריבוע של c². c = 5.',
  'area-model':
    'הדגמה: מלבן (x+3) על (x+2) מתחלק לארבעה תאים: x² ועוד 2x ועוד 3x ועוד 6, ומתאחד ל־x² + 5x + 6.',
  sticks:
    'הדגמה: 34 מקלות נאספים לשלוש אגודות של עשר ועוד ארבעה בודדים — 34 = 30 + 4.',
  numberline:
    'הדגמה: 47 ו־52 על ישר המספרים. 47 קטן מ־52, ו־47 מעוגל ל־50 כי הוא רחוק 3 מ־50 ו־7 מ־40.',
  tenframes:
    'הדגמה: במסגרת העשר, 7 ועוד 5 — שלושה משלימים לעשר ושניים נשארים: 7 + 5 = 12.',
  balance:
    'הדגמה: מאזניים עם 3 + □ מול 8. מורידים 3 משני הצדדים, המאזניים מתייצבים, ו־□ = 5.',
  pattern:
    'הדגמה: תבנית הריבועים 2, 5, 8, 11 גדלה ב־3 בכל שלב. השלב החמישי הוא 14.',
  bars:
    'הדגמה: מודל פסים — פס של 12 לדנה, פס של 12 ועוד 5 לרון, ויחד 12 + 17 = 29.',
  ruler: 'הדגמה: סרגל של מטר אחד מתחלק לעשרה קטעים של 10 ס״מ — 1 m = 100 cm.',
  array:
    'הדגמה: 4 קבוצות של 3 נקודות מתיישרות למערך 4 × 3, המערך מסתובב ל־3 × 4 — אותן 12 נקודות.',
  polygon: 'הדגמה: מחומש נבנה צלע אחר צלע, והמונים מראים שמספר הצלעות שווה למספר הקודקודים.',
  data: 'הדגמה: סימני ספירה בטבלה הופכים לעמודות ואז לדיאגרמת עוגה — אותם 16 נתונים בשלושה ייצוגים.',
  baseten:
    'הדגמה: 38 + 25 בקוביות בסיס עשר — 8 ועוד 5 הם 13 יחידות, עשר מתאחדות למוט, ומתקבל 63.',
  cookies: 'הדגמה: 14 עוגיות מחולקות ל־4 צלחות — 3 בכל צלחת ו־2 נשארות: 14 = 4 × 3 + 2.',
  fraction: 'הדגמה: עוגה נחתכת לארבעה חלקים שווים ואחד נצבע — אותו רבע מופיע גם על פס וגם על ישר.',
  transform:
    'הדגמה: משולש משתקף סביב ישר, מסתובב 90 מעלות סביב נקודה ומוזז — הצורה נשארת חופפת.',
};

/* fixed top-strip problem text per variant (families layout);
   formula-like strips are rendered LTR */
const topTexts: Record<string, { text: string; ltr?: boolean }> = {
  sticks: { text: 'כמה מקלות?' },
  tenframes: { text: '7 + 5 = ?', ltr: true },
  balance: { text: '3 + □ = 8', ltr: true },
  pattern: { text: 'מה מספר הריבועים בשלב 5?' },
  bars: { text: 'לדנה 12 מדבקות. לרון 5 מדבקות יותר מלדנה. כמה מדבקות יש להם יחד?' },
  ruler: { text: 'כמה ס״מ יש במטר?' },
  array: { text: '4 קבוצות של 3 — כמה נקודות?' },
  polygon: { text: 'כמה צלעות וכמה קודקודים?' },
  baseten: { text: '38 + 25 = ?', ltr: true },
  cookies: { text: 'כמה עוגיות בכל צלחת? ומה נשאר?' },
  fraction: { text: 'איזה חלק של העוגה צבוע?' },
};
const top = topTexts[variant];

/* ——— Pythagoras tile geometry (viewBox units). The engine reads the
   data-home-* / data-target-* attributes — single source of truth. ——— */
const ROT_C = 36.87; // degrees: the c-square is rotated by atan(3/4)
const A0 = { x: 280, y: 192 }; // top of a-leg / c-square origin corner
const uv = { x: 20.8, y: 15.6 }; // c-square cell step along the hypotenuse
const nv = { x: 15.6, y: -20.8 }; // c-square cell step along the outward normal
const cCell = (i: number, j: number) => ({
  x: A0.x + uv.x * (i + 0.5) + nv.x * (j + 0.5),
  y: A0.y + uv.y * (i + 0.5) + nv.y * (j + 0.5),
});
const r2 = (n: number) => Math.round(n * 100) / 100;
const blueCells = [...[0, 1, 2, 3, 4].map((i) => ({ i, j: 0 })), ...[0, 1, 2, 3].map((i) => ({ i, j: 1 }))];
const purpCells = [
  { i: 4, j: 1 },
  ...[0, 1, 2, 3, 4].map((i) => ({ i, j: 2 })),
  ...[0, 1, 2, 3, 4].map((i) => ({ i, j: 3 })),
  ...[0, 1, 2, 3, 4].map((i) => ({ i, j: 4 })),
];
const tilesA = blueCells.map((c, k) => ({
  home: { x: 215 + 26 * (k % 3), y: 205 + 26 * Math.floor(k / 3) },
  target: cCell(c.i, c.j),
}));
const tilesB = purpCells.map((c, k) => ({
  home: { x: 293 + 26 * (k % 4), y: 283 + 26 * Math.floor(k / 4) },
  target: cCell(c.i, c.j),
}));

/* ——— Area-model mini squares (the "6" cell): 2 cols × 3 rows ——— */
const minis = [0, 1, 2, 3, 4, 5].map((k) => ({
  x: 309 + (k % 2) * 36,
  y: 176 + Math.floor(k / 2) * 38,
}));

/* ═══════ F01 sticks — 34 sticks: 6×6 grid → 3 bundles of 10 + 4 singles ═══════ */
const STICK_HOME = (i: number) => ({ x: 340 + (i % 6) * 30 + 10, y: 86 + Math.floor(i / 6) * 38, w: 10, h: 26 });
const STICK_TARGET = (i: number) =>
  i < 30
    ? { x: 62 + (i % 10) * 8, y: 86 + Math.floor(i / 10) * 66, w: 6, h: 36 } // bundles in the tens column
    : { x: 174 + (i - 30) * 9, y: 86, w: 6, h: 36 }; // singles in the ones column
const sticks = Array.from({ length: 34 }, (_, i) => ({ home: STICK_HOME(i), target: STICK_TARGET(i) }));

/* ═══════ F02 number line — 0..100, ticks every 10 (4.4 px/unit) ═══════ */
const NL_X = (v: number) => 60 + v * 4.4;
const nlTicks = Array.from({ length: 11 }, (_, i) => ({ v: i * 10, x: NL_X(i * 10) }));

/* ═══════ F03 ten frames — two 2×5 frames; 7 blue, 5 purple ═══════ */
const TF_CELL = (frame: number, cell: number) => ({
  x: 125 + (cell % 5) * 30,
  y: (frame === 0 ? 85 : 195) + Math.floor(cell / 5) * 30,
});
const tfBlue = Array.from({ length: 7 }, (_, i) => TF_CELL(0, i)); // frame A, row-major LTR
const tfPurple = Array.from({ length: 5 }, (_, k) => ({
  home: { x: 340 + k * 34, y: 100 }, // outside row, right of the frames
  target: k < 3 ? TF_CELL(0, 7 + k) : TF_CELL(1, k - 3), // 3 complete the ten, 2 go to frame B
}));

/* ═══════ F04 balance — 3 + □ = 8 ═══════ */
const balCubesL = [0, 1, 2].map((i) => ({ x: 96 + i * 18, y: 174 })); // left pan
const balCubesR = Array.from({ length: 8 }, (_, i) => ({ x: 382 + (i % 4) * 18, y: 174 - Math.floor(i / 4) * 18 }));
const BAL_RISE_R = [4, 5, 6]; // top-row cubes that lift off the right pan
const balBoxMinis = Array.from({ length: 5 }, (_, i) => ({ x: 154 + (i % 3) * 11, y: 178 - Math.floor(i / 3) * 11 }));

/* ═══════ F05 pattern — stage n: column of 2 + (n−1) columns of 3, LTR ═══════ */
const PAT_SQ = 14;
const patStageX = (k: number) => 50 + (k - 1) * 100;
const patSquares = (k: number) => {
  const out: { x: number; y: number }[] = [];
  const x0 = patStageX(k);
  for (let r = 0; r < 2; r++) out.push({ x: x0, y: 204 - 16 * r }); // the pair
  for (let c = 1; c < k; c++) for (let r = 0; r < 3; r++) out.push({ x: x0 + 16 * c, y: 204 - 16 * r });
  return out;
};
const patStages = [1, 2, 3, 4].map((k) => ({
  k,
  squares: patSquares(k),
  cx: patStageX(k) + (16 * k - 2) / 2, // centre of the stage, for the number row
}));
const pat5copy = patSquares(4); // slides +100px into the dashed stage-5 slot
const pat5new = [0, 1, 2].map((r) => ({ x: 514, y: 204 - 16 * r })); // new orange column

/* ═══════ F06 bars — unit 16px; bars anchored at the right edge x=460 ═══════ */
const BAR_R = 460;

/* ═══════ F07 ruler — 1 m bar = 100 cm (4.4 px/cm) ═══════ */
const RUL_X0 = 60;
const RUL_SEG = Array.from({ length: 10 }, (_, i) => ({ x: RUL_X0 + i * 44, n: (i + 1) * 10 }));

/* ═══════ F08 array — 4 clusters of 3 → 4×3 array → rotate to 3×4 ═══════ */
const ARR_CENTER = { x: 251, y: 258 };
const arrHome = (k: number, j: number) => ({
  x: 90 + k * 95 + [-12, 12, 0][j],
  y: 90 + [-11, -11, 13][j],
});
const arrCell = (i: number) => ({ x: 217 + (i % 3) * 34, y: 207 + Math.floor(i / 3) * 34 });
const arrDots = Array.from({ length: 12 }, (_, i) => ({
  home: arrHome(Math.floor(i / 3), i % 3),
  cell: arrCell(i),
}));

/* ═══════ F09 polygon — pentagon built side by side, counters tick together ═══════ */
const PENT = Array.from({ length: 5 }, (_, k) => {
  const a = (-90 + k * 72) * (Math.PI / 180);
  return { x: 280 + 95 * Math.cos(a), y: 170 + 95 * Math.sin(a) };
});

/* ═══════ F10 data — tally 8/5/3 → bars → pie (total 16) ═══════ */
const DATA_ROWS = [
  { name: 'תפוחים', v: 8, color: 'rgba(30,136,229,0.55)', stroke: 'var(--cobalt)' },
  { name: 'בננות', v: 5, color: 'rgba(124,58,237,0.5)', stroke: '#7c3aed' },
  { name: 'ענבים', v: 3, color: 'rgba(234,88,12,0.5)', stroke: '#ea580c' },
];
const PIE = (() => {
  const total = 16;
  let a0 = -90;
  return DATA_ROWS.map((r) => {
    const a1 = a0 + (r.v / total) * 360;
    const large = a1 - a0 > 180 ? 1 : 0;
    const rad = (d: number) => (d * Math.PI) / 180;
    const p0 = { x: 490 + 70 * Math.cos(rad(a0)), y: 175 + 70 * Math.sin(rad(a0)) };
    const p1 = { x: 490 + 70 * Math.cos(rad(a1)), y: 175 + 70 * Math.sin(rad(a1)) };
    const mid = rad((a0 + a1) / 2);
    const slice = `M490 175 L${p0.x.toFixed(1)} ${p0.y.toFixed(1)} A70 70 0 ${large} 1 ${p1.x.toFixed(1)} ${p1.y.toFixed(1)} Z`;
    const label = { x: 490 + 40 * Math.cos(mid), y: 175 + 40 * Math.sin(mid) };
    a0 = a1;
    return { slice, label, v: r.v };
  });
})();

/* ═══════ F11 base-ten — 38 + 25 = 63 ═══════ */
const bt38 = {
  rods: [120, 140, 160].map((x) => ({ x, y: 90 })),
  ones: Array.from({ length: 8 }, (_, i) => ({ x: 190 + (i % 2) * 18, y: 90 + Math.floor(i / 2) * 18 })),
};
const bt25 = {
  rods: [380, 400].map((x) => ({ x, y: 90 })),
  ones: Array.from({ length: 5 }, (_, i) => ({ x: 430 + (i % 3) * 18, y: 90 + Math.floor(i / 3) * 18 })),
};
// gather slots for the 13 ones in the middle, then 10 merge into a rod
const btGather = Array.from({ length: 13 }, (_, i) => ({ x: 200 + (i % 7) * 20, y: 236 + Math.floor(i / 7) * 20 }));

/* ═══════ F12 cookies — 14 cookies onto 4 plates: 3 each, 2 left ═══════ */
const ckTray = Array.from({ length: 14 }, (_, i) => ({ x: 80 + i * 30, y: 70 }));
const ckPlates = [130, 230, 330, 430].map((x) => ({ x, y: 205 }));
const ckSeat = (i: number) => {
  const plate = i % 4;
  const seat = Math.floor(i / 4); // 0,1,2
  return { x: ckPlates[plate].x - 18 + seat * 18, y: 198 };
};

/* ═══════ F13 fraction — 1/4 on a cake, a bar and a number line ═══════ */
const FR_BAR = { x: 330, y: 110, w: 180, h: 40 };

/* ═══════ F14 transform — ghost triangle, copy reflects/rotates/translates ═══════ */
const TR_GHOST = [
  { x: 120, y: 90 },
  { x: 60, y: 190 },
  { x: 190, y: 190 },
];
const TR_PTS = (pts: { x: number; y: number }[]) => pts.map((p) => `${r2(p.x)},${r2(p.y)}`).join(' ');
const TR_AXIS = 260;
const TR_PIVOT = { x: 400, y: 90 }; // = reflected A
const TR_MOVE = { dx: 40, dy: 60 }; // keeps the copy inside the card
---

<div class="concept-loop" data-loop={variant}>
  <div class="concept-loop__card">
    <button
      type="button"
      class="concept-loop__toggle"
      data-el="toggle"
      aria-label="השהיית ההדגמה"
    >
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <g data-el="ic-pause">
          <rect x="3" y="2.5" width="3.4" height="11" rx="1.2"></rect>
          <rect x="9.6" y="2.5" width="3.4" height="11" rx="1.2"></rect>
        </g>
        <path data-el="ic-play" d="M4 2.2 L13.4 8 L4 13.8 Z" style="display:none"></path>
      </svg>
    </button>

    {
      /* families F01–F06: fixed problem strip that never moves */
      top && (
        <p class="concept-loop__top" dir={top.ltr ? 'ltr' : undefined}>
          {top.text}
        </p>
      )
    }
    {
      /* numberline: the question matches the current phase (B1-FIXES) */
      variant === 'numberline' && (
        <p class="concept-loop__top cl-topswap">
          <span class="cl-topsz" aria-hidden="true">לאן מעגלים את 47?</span>
          <span class="cl-tops" data-el="topa">מי גדול יותר?</span>
          <span class="cl-tops" data-el="topb">לאן מעגלים את 47?</span>
        </p>
      )
    }
    {
      /* data: one question per representation phase */
      variant === 'data' && (
        <p class="concept-loop__top cl-topswap">
          <span class="cl-topsz" aria-hidden="true">ואותם נתונים — בעוגה?</span>
          <span class="cl-tops" data-el="top0">איך סופרים בטבלה?</span>
          <span class="cl-tops" data-el="top1">איך זה נראה בעמודות?</span>
          <span class="cl-tops" data-el="top2">ואותם נתונים — בעוגה?</span>
        </p>
      )
    }
    {
      /* transform: one question per transformation phase */
      variant === 'transform' && (
        <p class="concept-loop__top cl-topswap">
          <span class="cl-topsz" aria-hidden="true">ומה זו הזזה?</span>
          <span class="cl-tops" data-el="top0">מה זה שיקוף?</span>
          <span class="cl-tops" data-el="top1">ומה זה סיבוב?</span>
          <span class="cl-tops" data-el="top2">ומה זו הזזה?</span>
        </p>
      )
    }

    {
      variant === 'triangle' && (
        <svg
          class="concept-loop__svg"
          viewBox="0 0 560 330"
          role="img"
          aria-label={ariaLabels[variant]}
        >
          {/* persistent rest state: frame + rail + base + height + labels */}
          <rect data-el="frame" class="cl-frame" x="132" y="78" width="276" height="184" rx="4" />
          {/* the dashed parallel line the apex slides on (wider than the base) */}
          <line data-el="rail" class="cl-rail" x1="72" y1="78" x2="468" y2="78" />
          {/* faint base-line extension — appears only during the slide */}
          <line data-el="basext" class="cl-rail" x1="72" y1="262" x2="468" y2="262" />
          <line data-el="base" class="cl-line" x1="132" y1="262" x2="408" y2="262" />
          <text data-el="lbl-a" class="cl-t cl-num" x="270" y="285" text-anchor="middle">
            a = 6
          </text>
          <line data-el="height" class="cl-dash" x1="408" y1="262" x2="408" y2="78" />
          <text data-el="lbl-h" class="cl-t cl-num" x="420" y="172">
            h = 4
          </text>

          {/* the half-story: "6·4 = 24", then a diagonal cuts the rectangle */}
          <text data-el="lbl24" class="cl-t cl-num cl-big" x="195" y="135" text-anchor="middle">
            6·4 = 24
          </text>
          <line data-el="diag" class="cl-line" x1="132" y1="262" x2="408" y2="78" pathLength="1" />

          {/* one triangle: starts as the right half of the rectangle
              (apex at the top-right corner), then shears along the rail */}
          <path data-el="tri-fill" class="cl-fill-a" d="M132 262 L408 262 L408 78 Z" />
          <line data-el="tri-line-l" class="cl-line cl-stroke-a" x1="132" y1="262" x2="408" y2="78" pathLength="1" />
          <line data-el="tri-line-r" class="cl-line cl-stroke-a" x1="408" y1="262" x2="408" y2="78" pathLength="1" />
          <circle data-el="apex-dot" class="cl-apex" cx="408" cy="78" r="6" />
        </svg>
      )
    }

    {
      variant === 'pythagoras' && (
        <svg
          class="concept-loop__svg"
          viewBox="0 0 560 400"
          role="img"
          aria-label={ariaLabels[variant]}
        >
          {/* persistent: the bare right triangle + right-angle mark + leg labels */}
          <path data-el="tri" class="cl-line" d="M280 270 L280 192 L384 270 Z" pathLength="1" />
          <path data-el="ra" class="cl-line-thin" d="M280 256 L294 256 L294 270" />
          <text data-el="lbl-a" class="cl-t cl-num" x="192" y="236" text-anchor="end">
            a = 3
          </text>
          <text data-el="lbl-b" class="cl-t cl-num" x="332" y="394" text-anchor="middle">
            b = 4
          </text>

          {/* squares on the sides */}
          <rect data-el="sq-a" class="cl-line cl-stroke-a" x="202" y="192" width="78" height="78" pathLength="1" />
          <rect data-el="sq-b" class="cl-line cl-stroke-b" x="280" y="270" width="104" height="104" pathLength="1" />
          <path data-el="sq-c" class="cl-dash-strong" d="M280 192 L384 270 L462 166 L358 88 Z" pathLength="1" />
          <text data-el="lbl-c" class="cl-t cl-num" x="470" y="172">
            c = ?
          </text>

          {/* 9 blue tiles (a²) then 16 purple tiles (b²) */}
          <g data-el="tiles-a">
            {tilesA.map((t) => (
              <rect
                class="cl-tile cl-tile-a"
                x="-11"
                y="-11"
                width="22"
                height="22"
                rx="3"
                data-home={`${t.home.x},${t.home.y}`}
                data-target={`${r2(t.target.x)},${r2(t.target.y)}`}
                data-rot={String(ROT_C)}
                transform={`translate(${t.home.x} ${t.home.y})`}
              />
            ))}
          </g>
          <g data-el="tiles-b">
            {tilesB.map((t) => (
              <rect
                class="cl-tile cl-tile-b"
                x="-11"
                y="-11"
                width="22"
                height="22"
                rx="3"
                data-home={`${t.home.x},${t.home.y}`}
                data-target={`${r2(t.target.x)},${r2(t.target.y)}`}
                data-rot={String(ROT_C)}
                transform={`translate(${t.home.x} ${t.home.y})`}
              />
            ))}
          </g>
        </svg>
      )
    }

    {
      variant === 'area-model' && (
        <svg
          class="concept-loop__svg"
          viewBox="0 0 560 340"
          role="img"
          aria-label={ariaLabels[variant]}
        >
          {/* persistent: outer rectangle + edge labels */}
          <rect data-el="rect" class="cl-line" x="194" y="60" width="186" height="224" pathLength="1" />
