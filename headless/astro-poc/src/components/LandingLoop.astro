---
/**
 * One reusable loop for landing pages that do not already mount ConceptLoop.
 * The card size comes from aspect-ratio, so the slot does not shift.
 * Reduced motion, html.nd-motion-off, and html.noam-a11y-motion hold a
 * finished frame. A tiny observer pauses the loop while it is off-screen.
 */
import AbsoluteValueFilm from './AbsoluteValueFilm.astro';
import LessonFilm from './LessonFilm.astro';
import SimilarityLoop from './SimilarityLoop.astro';
import LessonLoop from './LessonLoop.astro';
import { isLessonLoop } from '../lib/lessonLoops';
import LoopFormula from './LoopFormula.astro';
import LoopSketch from './LoopSketch.astro';
import {
  CSS_LOOP_IDEAS,
  FORMULA_LOOP_VARIANTS,
  LESSON_FILM_VARIANTS,
  type CssLoopVariant,
} from '../lib/landingLoops';

interface Props {
  variant: CssLoopVariant;
}
const { variant } = Astro.props;
const lesson = isLessonLoop(variant);
const similarity = variant === 'similar' || variant === 'similar-area' || variant === 'similar-aa';
const formula = (FORMULA_LOOP_VARIANTS as readonly string[]).includes(variant);
const isLessonFilm = (LESSON_FILM_VARIANTS as readonly string[]).includes(variant);
---

{variant === 'absolute' ? (
  <AbsoluteValueFilm />
) : isLessonFilm ? (
  <LessonFilm variant={variant} />
) : (
<div
  class:list={['ll', `ll--${variant}`, (lesson || similarity) && 'll--lesson']}
  dir="ltr"
  data-landing-loop={variant}
  data-css-loop
  data-loop-idea={CSS_LOOP_IDEAS[variant]}
>
  {<button class="ll-pause" type="button" disabled aria-label="השהיית ההמחשה" aria-pressed="false">השהיה</button>}
  <div class="ll-content" aria-hidden={lesson || similarity ? undefined : "true"}>{variant === 'similar' || variant === 'similar-area' || variant === 'similar-aa' ? <SimilarityLoop variant={variant}/> : isLessonLoop(variant) ? <LessonLoop variant={variant} /> : formula ? <LoopFormula variant={variant} /> : <LoopSketch variant={variant} />}</div>
</div>
)}

<script>
  document.querySelectorAll<HTMLButtonElement>('.ll-pause').forEach(button => {
    button.addEventListener('click', () => {
      const paused = button.closest('.ll')!.classList.toggle('ll--paused');
      button.setAttribute('aria-pressed', String(paused));
      button.setAttribute('aria-label', paused ? 'המשך ההמחשה' : 'השהיית ההמחשה');
      button.textContent = paused ? 'המשך' : 'השהיה';
    });
    button.disabled = false;
  });
  const root = document.documentElement;
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  const stopped =
    reduce ||
    root.classList.contains('nd-motion-off') ||
    root.classList.contains('noam-a11y-motion');
  if (!stopped && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      for (const entry of entries) {
        entry.target.classList.toggle('ll--off', !entry.isIntersecting);
      }
    }, { rootMargin: '64px' });
    document.querySelectorAll('.ll').forEach((node) => io.observe(node));
  }
</script>

<style>
  .ll {
    display: block;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;

    position: relative;
    container-type: inline-size;
    contain: layout;
    pointer-events: none;
    direction: ltr;
    background: #fff;
    border: 2.5px solid #22305a;
    border-radius: 24px;
    overflow: hidden;
  }
  .ll-content {position:relative;aspect-ratio:480 / 280;}
  .ll--lesson .ll-content {aspect-ratio:auto;}
  .ll-pause { display:block; margin:8px 8px 0 auto; min-height:44px; min-width:64px; border:1px solid #22305a; border-radius:10px; background:white; color:#22305a; font:700 14px Heebo,sans-serif; pointer-events:auto; cursor:pointer; }
  .ll-pause:focus-visible {outline:3px solid #e6a534;outline-offset:2px;}
  .ll--paused :global(*) {animation-play-state:paused!important;}
  @media(prefers-reduced-motion:reduce) {.ll-pause {display:none;}}
  :global(html.nd-motion-off) .ll-pause, :global(html.noam-a11y-motion) .ll-pause {display:none;}

  .ll :global(.ll-math) {
    unicode-bidi: isolate;
    direction: ltr;
    white-space: nowrap;
  }
  .ll--off,
  .ll--off :global(*) { animation-play-state: paused !important; }

  @media (prefers-reduced-motion: reduce) {
    .ll,
    .ll :global(*) { animation: none !important; }
  }
  :global(html.nd-motion-off) .ll,
  :global(html.nd-motion-off) .ll :global(*),
  :global(html.noam-a11y-motion) .ll,
  :global(html.noam-a11y-motion) .ll :global(*) {
    animation: none !important;
  }
</style>
