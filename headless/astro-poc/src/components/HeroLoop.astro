---
import ConceptLoop from './ConceptLoop.astro';
import { HERO_ROTATION } from '../lib/heroRotation';
/* Keep in sync with SPECS in ../lib/conceptLoops.ts. Default stays triangle for no-JS/SEO.
   The pool is the inventory the grade player still reconciles against.
   The homepage renders only DEFAULT; the other hero loops are fetched on shuffle. */
const HERO_POOL = [
  'triangle', 'pythagoras', 'area-model', 'sticks', 'numberline', 'tenframes',
  'balance', 'pattern', 'bars', 'ruler', 'array', 'polygon', 'data',
  'baseten', 'cookies', 'fraction', 'transform',
  'angle-sum', 'para-rect', 'angle-kinds', 'frac-product',
  'slope', 'add-within', 'similar', 'order-ops',
  'sup-angles', 'share-12', 'corr-angles', 'mean-cols',
  'pct-25', 'diff-sq', 'clock-3', 'peri-rect',
  'signed-jump', 'prime-rect', 'sas-snap', 'obtuse-ht',
  'box-vol', 'trap-area', 'odd-pair', 'birds-sub',
  'circ-unroll', 'rect-count', 'l-split', 'quad-tree',
  'tri-sort', 'parab', 'ratio-beads', 'neighbors',
  'signed-ops', 'clock-span', 'exterior', 'para-perp',
  'quarter-12', 'two-coins', 'map-scale', 'unit-frac',
  'coord-walk', 'coins-12', 'cyl-stack', 'tenth-cell',
  'equiv-half', 'half-eq', 'sq-stretch', 'area-x4',
  'cube-8', 'place-123', 'jumps-4', 'apples-5',
  'topic-card', 'mark-250', 'quad-gate', 'two-diag',
] as const;
const DEFAULT = 'triangle';
const known = new Set<string>(HERO_POOL);
for (const item of HERO_ROTATION) {
  if (!known.has(item.variant)) throw new Error(`Unknown hero loop: ${item.variant}`);
}
if (HERO_ROTATION[0]?.variant !== DEFAULT) throw new Error('Default hero loop must stay triangle');
---
<div class="hero-loop" data-hero-loop>
  <div data-hero-loop-current>
    <ConceptLoop variant={DEFAULT} />
  </div>
</div>
<style>
  .hero-loop .concept-loop__svg {
    aspect-ratio: 560 / 340;
  }
</style>
