---
import type { HomePageContent } from '../lib/homePage';

interface Props {
  footer: HomePageContent['footer'];
  /** Preview hosts only — never claim “preview only” on the live domain. */
  showPreviewNote?: boolean;
}
const { footer, showPreviewNote = false } = Astro.props;

/**
 * Brand social URLs — verified only (do not invent):
 * - Instagram: git 2156c6d (Noam); HTTP 200 → login redirect for /noamdoronmath/
 * - Facebook: git 2156c6d (Noam); HTTP 200 → profile "נועם דורון מתמטיקה" id 61593749281930
 * - WhatsApp: home-page.json + live CTA / grade hubs / blog; HTTP 200
 * Missing (not in repo, not in live/.co.il footer/header): TikTok.
 * YouTube in high-school-math.json is עובד לב ארי (third-party) — not brand; omitted.
 */
const socialLinks = [
  {
    href: 'https://www.instagram.com/noamdoronmath/',
    label: 'אינסטגרם של נועם דורון מתמטיקה',
    network: 'instagram' as const,
  },
  {
    href: 'https://www.facebook.com/profile.php?id=61593749281930',
    label: 'פייסבוק של נועם דורון מתמטיקה',
    network: 'facebook' as const,
  },
  {
    href: 'https://chat.whatsapp.com/DOepmlK5bKxCBbbGMusLdF?mode=gi_t',
    label: 'הצטרפות לקבוצת הוואטסאפ של נועם דורון מתמטיקה',
    network: 'whatsapp' as const,
  },
];
---
<footer class="site-footer" data-home-footer>
  <div class="site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__brand-name">{footer.brandName}</p>
      <p class="site-footer__brand-blurb">{footer.brandBlurb}</p>
      <ul class="site-footer__social" aria-label="רשתות חברתיות">
        {
          socialLinks.map((item) => (
            <li>
              <a
                href={item.href}
                target="_blank"
                rel="noopener"
                aria-label={item.label}
                data-footer-social={item.network}
                data-peek={item.network}
              >
                {item.network === 'instagram' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                    <rect
                      x="4"
                      y="4"
                      width="16"
                      height="16"
                      rx="4"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    ></rect>
                    <circle
                      cx="12"
                      cy="12"
                      r="3.5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                    ></circle>
                    <circle cx="17" cy="7" r="1" fill="currentColor"></circle>
                  </svg>
                )}
                {item.network === 'facebook' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                    <path
                      fill="currentColor"
                      d="M14.2 20v-6.2h2.1l.3-2.4h-2.4V9.9c0-.7.2-1.2 1.2-1.2h1.3V6.6c-.2 0-1-.1-1.9-.1-1.9 0-3.2 1.2-3.2 3.3v1.6H9.4v2.4h2.2V20h2.6Z"
                    ></path>
                  </svg>
                )}
                {item.network === 'whatsapp' && (
                  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true" focusable="false">
                    <path
                      fill="currentColor"
                      d="M12 3.1A8.4 8.4 0 0 0 4.7 15.4L3.5 20.3l5-1.3A8.4 8.4 0 1 0 12 3.1Zm0 1.7a6.7 6.7 0 0 1 5.7 10.1 6.7 6.7 0 0 1-9.4 2l-.4-.2-2.6.7.7-2.5-.2-.4A6.7 6.7 0 0 1 12 4.8Zm3.7 9.6c-.2.5-1 .9-1.4 1-.4.1-.8.2-2.6-.5-2.2-.9-3.6-3.1-3.7-3.3-.1-.2-.9-1.2-.9-2.2s.6-1.6.8-1.8c.2-.2.4-.3.6-.3h.4c.1 0 .3 0 .4.3.2.4.6 1.4.6 1.5.1.1.1.3 0 .4l-.3.5c-.1.1-.2.3-.1.5.1.2.5.8 1.1 1.3.8.7 1.4.9 1.6 1 .2.1.3.1.5-.1l.6-.7c.1-.2.3-.2.5-.1.2.1 1.3.6 1.5.7.2.1.4.2.4.3 0 .1 0 .6-.2 1.1Z"
                    ></path>
                  </svg>
                )}
              </a>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="site-footer__contact">
      <h2 class="site-footer__heading">{footer.contactHeading}</h2>
      <p>{footer.contactBody}</p>
      <a class="site-footer__email" href={`mailto:${footer.email}`}>{footer.email}</a>
    </div>

    <nav class="site-footer__quick" aria-label={footer.quickNavHeading}>
      <h2 class="site-footer__heading">{footer.quickNavHeading}</h2>
      <ul>
        {
          footer.quickNav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <nav class="site-footer__legal" aria-label="מידע נוסף">
      <h2 class="site-footer__heading">מידע נוסף</h2>
      <ul>
        {
          footer.legal.map((item) => (
            <li>
              {item.href ? (
                <a href={item.href}>{item.label}</a>
              ) : (
                <span
                  class="site-footer__legal-gap"
                  data-legal-gap={item.knownGap ? 'privacy' : undefined}
                >
                  {item.label}
                  {item.knownGap && (
                    <span class="site-footer__gap-mark"> (פער ידוע — אין יעד תקף בתצוגה)</span>
                  )}
                </span>
              )}
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="site-footer__meta">
    <p>{footer.copyright}</p>
    <p class="site-footer__disclaimer">{footer.disclaimer}</p>
    <p class="site-footer__privacy-note">{footer.privacyNote}</p>
    {showPreviewNote && footer.previewNote ? (
      <p class="home-foot">{footer.previewNote}</p>
    ) : null}
  </div>
</footer>

<style>
  .site-footer__quick a,
  .site-footer__legal a,
  .site-footer__email {
    display: inline-block;
    box-sizing: border-box;
    min-height: 44px;
    min-width: 44px;
    max-width: 100%;
    padding-block: 12px;
    overflow-wrap: anywhere;
  }

  .site-footer__social a:focus-visible {
    outline: 3px solid var(--ink);
    outline-offset: 4px;
  }
</style>
