---
/**
 * POC motion system (branch poc-animations-fix) — scroll reveal for
 * below-the-fold content + hover re-draw for the line art.
 * Rendered by BaseLayout right after <slot />. Inline on purpose: no
 * extra request, runs on every full page load (MPA).
 */
---

<script is:inline>
  (function () {
    'use strict';
    var REVEAL_SEL = [
      '.card',
      '.home-grade',
      '.home-value',
      '.home-whatsapp',
      '.home-learning',
      '.grade-hub__topic-list a',
      '.grade-hub__faq-item',
      '.topic-page__section',
      '.topic-page__faq-item',
      '.topic-page__figure',
      '.blog-archive__card',
      '.blog-post__figure',
      '.blog-post__faq-item',
      '.blog-post__recent-item',
      '.site-page__figure',
    ].join(',');

    function motionAllowed() {
      return (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        !document.documentElement.classList.contains('noam-a11y-motion')
      );
    }

    function setup() {
      if (!motionAllowed()) return; // content stays fully visible, static
      var vh = window.innerHeight;
      var pending = [];
      Array.prototype.forEach.call(
        document.querySelectorAll(REVEAL_SEL),
        function (el) {
          var r = el.getBoundingClientRect();
          if (r.height === 0) return;
          // Never hide anything in (or near) the first viewport: LCP/CLS safe.
          if (r.top < vh * 0.92) return;
          el.classList.add('poc-reveal');
          pending.push(el);
        }
      );
      // Gentle stagger among revealed siblings.
      pending.forEach(function (el) {
        var sibs = el.parentElement
          ? Array.prototype.filter.call(el.parentElement.children, function (c) {
              return c.classList && c.classList.contains('poc-reveal');
            })
          : [el];
        var i = sibs.indexOf(el);
        el.style.setProperty('--reveal-delay', Math.min(Math.max(i, 0), 5) * 70 + 'ms');
      });
      if (!pending.length) return;
      if (!('IntersectionObserver' in window)) {
        pending.forEach(function (el) { el.classList.add('is-in'); });
        return;
      }
      var io = new IntersectionObserver(
        function (entries) {
          entries.forEach(function (e) {
            if (e.isIntersecting) {
              e.target.classList.add('is-in');
              io.unobserve(e.target);
            }
          });
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.01 }
      );
      pending.forEach(function (el) { io.observe(el); });
    }

    function revealDataAttrs() {
      var nodes = document.querySelectorAll('[data-pop], [data-draw]');
      if (!nodes.length) return;
      function finish(el) {
        el.classList.add('is-revealed');
        el.style.opacity = '1';
        el.style.transform = '';
      }
      if (!motionAllowed()) {
        Array.prototype.forEach.call(nodes, finish);
        return;
      }
      Array.prototype.forEach.call(nodes, function (el) {
        var delay = parseInt(el.getAttribute('data-pop') || el.getAttribute('data-draw') || '0', 10) || 0;
        if ('IntersectionObserver' in window) {
          var io = new IntersectionObserver(
            function (entries) {
              entries.forEach(function (e) {
                if (!e.isIntersecting) return;
                setTimeout(function () {
                  el.animate(
                    [
                      { opacity: 0, transform: 'translateY(8px)' },
                      { opacity: 1, transform: 'none' },
                    ],
                    { duration: 520, easing: 'cubic-bezier(.2,.8,.3,1.2)', fill: 'forwards' }
                  );
                  finish(el);
                }, delay);
                io.unobserve(el);
              });
            },
            { threshold: 0.2 }
          );
          io.observe(el);
        } else {
          finish(el);
        }
      });
      setTimeout(function () {
        Array.prototype.forEach.call(nodes, function (el) {
          if (!el.classList.contains('is-revealed')) finish(el);
        });
      }, 2500);
    }

    function logoWiggle() {
      var logo = document.querySelector('[data-logo-brand] .site-brand__logo');
      if (!logo || !motionAllowed()) return;
      function play() {
        if (document.hidden || !motionAllowed()) return;
        logo.animate(
          [
            { transform: 'translateY(-10px) rotate(-6deg) scale(1.06, 0.96)' },
            { transform: 'rotate(4deg) scale(0.96, 1.04)' },
            { transform: 'rotate(-2deg)' },
            { transform: 'none' },
          ],
          { duration: 800, easing: 'ease-in-out' }
        );
      }
      // Landing bounce once
      logo.animate(
        [
          { transform: 'translateY(-40px) rotate(-12deg) scale(0.7)' },
          { transform: 'translateY(4px) rotate(3deg) scale(1.05)', offset: 0.6 },
          { transform: 'none' },
        ],
        { duration: 900, easing: 'cubic-bezier(.3,1.3,.5,1)' }
      );
      setInterval(play, 7000);
      var brand = logo.closest('[data-logo-brand]');
      if (brand) {
        brand.addEventListener('mouseenter', play);
        brand.addEventListener('click', play);
      }
    }

    function boot() {
      setup();
      revealDataAttrs();
      logoWiggle();
    }

    if (document.readyState === 'loading')
      document.addEventListener('DOMContentLoaded', boot, { once: true });
    else boot();

    // Hover re-draw — like the live site's hover-triggered SMIL. Restart the
    // draw-in animation when the pointer enters a line-art strip or the home
    // hero. Skipped when motion is disabled, and on touch-only devices
    // (where a tap fires mouseover and would re-draw unexpectedly).
    function retriggerDraw(container) {
      Array.prototype.forEach.call(
        container.querySelectorAll('.hero-draw'),
        function (p) {
          p.style.animation = 'none';
          void p.getBoundingClientRect();
          p.style.animation = '';
        }
      );
    }
    var fineHover = window.matchMedia('(hover: hover) and (pointer: fine)');
    document.addEventListener('mouseover', function (e) {
      if (!motionAllowed() || !fineHover.matches || !e.target.closest) return;
      var entered =
        e.target.closest('[data-line-draw]') ||
        e.target.closest('.home-hero');
      if (!entered) return;
      var from = e.relatedTarget && e.relatedTarget.closest ? e.relatedTarget.closest('[data-line-draw], .home-hero') : null;
      if (from === entered) return;
      retriggerDraw(entered);
    });
  })();
</script>
