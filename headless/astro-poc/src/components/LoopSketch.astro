        <g class="sk-unroll">
          <rect class="sk-box" x="210" y="70" width="200" height="90" rx="6"></rect>
        </g>
        <circle class="sk-ring mv mv-40" style="--from:translate(-200px,71.83px) scale(1.445,0.503)" cx="310" cy="38.17" r="31.83"></circle>
        <circle class="sk-ring mv mv-40" style="--from:translate(-200px,-11.83px) scale(1.445,0.503);--d:.3s" cx="310" cy="191.83" r="31.83"></circle>
        <text class="sk-math" x="310" y="122" font-size="18" text-anchor="middle">2πr × h</text>
      </>
    )}

    {variant === 'solids' && (
      <>
        <polygon class="sk-box" points="70,110 180,60 300,110 180,160"></polygon>
        <polygon class="sk-box" points="70,110 180,160 180,220 70,170"></polygon>
