        <circle cx="150" cy="110" r="4" class="sk-ink-dot"></circle>
        <text class="sk-math" x="168" y="100" font-size="16">r</text>
        <text class="sk-math" x="300" y="84" font-size="22">d = 2r</text>
        <text class="sk-math" x="300" y="122" font-size="22">C = 2πr</text>
      </>
    )}

    {variant === 'round-solid' && (
      <>
        <ellipse class="sk-ring" cx="150" cy="56" rx="70" ry="18"></ellipse>
        <line class="sk-ink" x1="80" y1="56" x2="80" y2="176"></line>
        <line class="sk-ink" x1="220" y1="56" x2="220" y2="176"></line>
        <ellipse class="sk-ring" cx="150" cy="176" rx="70" ry="18"></ellipse>
        <ellipse class="sk-disc" cx="150" cy="146" rx="64" ry="14"></ellipse>
        <ellipse class="sk-disc" cx="150" cy="116" rx="64" ry="14"></ellipse>
        <ellipse class="sk-disc" cx="150" cy="86" rx="64" ry="14"></ellipse>
        <g class="sk-stack">
          <rect class="sk-stage" x="0" y="0" width="480" height="280"></rect>
          <ellipse class="sk-disc" cx="150" cy="176" rx="64" ry="14"></ellipse>
        </g>
      </>
    )}

    {variant === 'cone' && (
      <>
        <ellipse class="sk-ring" cx="340" cy="206" rx="56" ry="11"></ellipse>
        {[
          { y: 174, n: 1 },
          { y: 142, n: 2 },
          { y: 110, n: 3 },
        ].map((band) => (
          <g class={`sk-cn-band sk-cn-band--${band.n}`}>
            <rect class="sk-stage" x="0" y="0" width="480" height="280"></rect>
            <rect fill="#9fd3c7" x="284" y={band.y} width="112" height="32"></rect>
            <text class="sk-math" x="414" y={band.y + 22} font-size="16">{band.n}</text>
          </g>
        ))}
        <line class="sk-ghost" x1="284" y1="174" x2="396" y2="174"></line>
        <line class="sk-ghost" x1="284" y1="142" x2="396" y2="142"></line>
        <line class="sk-ink" x1="284" y1="110" x2="284" y2="206"></line>
        <line class="sk-ink" x1="396" y1="110" x2="396" y2="206"></line>
        <ellipse class="sk-ink" cx="340" cy="110" rx="56" ry="11"></ellipse>
        <g class="sk-cn-pour">
          <rect class="sk-stage" x="0" y="0" width="480" height="280"></rect>
          <path class="sk-ring" d="M54 110 L110 206 L166 110 Z"></path>
          <path class="sk-cn-water" fill="#9fd3c7" d="M54 110 L110 206 L166 110 Z"></path>
