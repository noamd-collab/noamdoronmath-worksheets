---
/**
 * Geometric loops. One transformation or comparison per topic.
 * Motion is transform/opacity only. The caption is the idea.
 */
import { CSS_LOOP_IDEAS, MINUS, captionMathHtml, signedLabel, type CssLoopVariant } from '../lib/landingLoops';

interface Props {
  variant: CssLoopVariant;
}
const { variant } = Astro.props;
const idea = CSS_LOOP_IDEAS[variant];
const areaCells = Array.from({ length: 15 }, (_, i) => ({
  i,
  x: 260 + (i % 3) * 36,
  y: 18 + Math.floor(i / 3) * 36,
}));
const quadSigns = [
  { t: `(+, +)`, x: 330, y: 78 },
  { t: `(${MINUS}, +)`, x: 70, y: 78 },
  { t: `(${MINUS}, ${MINUS})`, x: 70, y: 168 },
  { t: `(+, ${MINUS})`, x: 330, y: 168 },
];
/* count-mark: seven balloons, counted from the right as a Hebrew reader does. */
const balloons = Array.from({ length: 7 }, (_, i) => ({
  n: i + 1,
  x: 408 - i * 56,
  color: ['#e5735c', '#e6a534', '#d7efe8'][i % 3],
}));
/* frac-div: two wholes, four quarters each. */
const quarters = Array.from({ length: 8 }, (_, i) => ({
  n: i + 1,
  x: 120 + (i % 4) * 60,
  y: i < 4 ? 72 : 132,
}));
/* Ten frames fill left to right, top row first, like the tenframes film. */
const frameCells = (x: number, y: number, cell: number) =>
  Array.from({ length: 10 }, (_, i) => ({
    i,
    cx: x + cell / 2 + (i % 5) * cell,
    cy: y + cell / 2 + Math.floor(i / 5) * cell,
  }));
const frameGrid = (x: number, y: number, cell: number) => [
  ...[1, 2, 3, 4].map((c) => ({ x1: x + c * cell, y1: y, x2: x + c * cell, y2: y + 2 * cell })),
  { x1: x, y1: y + cell, x2: x + 5 * cell, y2: y + cell },
];
/* sub-via-10: 15 is a full frame and 5 more. The 5 go first, then 2 of the ten. */
const svFrames = [{ x: 72, y: 86 }, { x: 258, y: 86 }];
const svTen = frameCells(72, 86, 30);
const svFive = frameCells(258, 86, 30).slice(0, 5);
/* split-ways: 6 split three ways, from small to big. */
const splitRows = [1, 2, 3].map((k, r) => ({
  k,
  y: 62 + r * 62,
  left: Array.from({ length: k }, (_, i) => 64 + i * 34),
  right: Array.from({ length: 6 - k }, (_, i) => 64 + (k + i) * 34 + 24),
}));
/* bonds-10-20: 6 + 4 fills one frame; 13 + 7 fills the second frame of 20,
   which sits under the first so both completed frames line up. */
const bondFrames = [{ x: 164, y: 34 }, { x: 24, y: 122 }, { x: 164, y: 122 }];
const bondSix = frameCells(164, 34, 26);
const bondTen = frameCells(24, 122, 26);
const bondThirteen = frameCells(164, 122, 26);
