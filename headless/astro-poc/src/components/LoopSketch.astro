        <line class="sk-teal mv mv-40" style="stroke-width:6;--from:translateX(-200px)" x1="340" y1="162" x2="380" y2="52"></line>
      </>
    )}

    {variant === 'rect' && (
      <>
        <rect class="sk-box" x="90" y="40" width="280" height="140"></rect>
        <path class="sk-gold mv" style="--from:translate(-16px,-16px);--fo:0" d="M90 70 V40 H120"></path>
        <path class="sk-gold mv" style="--from:translate(16px,-16px);--fo:0;--d:.15s" d="M370 70 V40 H340"></path>
        <path class="sk-gold mv" style="--from:translate(-16px,16px);--fo:0;--d:.3s" d="M90 150 V180 H120"></path>
        <path class="sk-gold mv" style="--from:translate(16px,16px);--fo:0;--d:.45s" d="M370 150 V180 H340"></path>
