    {variant === 'percent' && (
      <>
        <rect class="sk-track" x="48" y="72" width="384" height="48" rx="16"></rect>
        <g class="sk-pq-fill">
          <rect class="sk-stage" x="0" y="0" width="480" height="280"></rect>
          <rect class="sk-fill" x="48" y="72" width="96" height="48" rx="16"></rect>
        </g>
        <line class="sk-ink" x1="144" y1="72" x2="144" y2="120"></line>
        <line class="sk-ink" x1="240" y1="72" x2="240" y2="120"></line>
        <line class="sk-ink" x1="336" y1="72" x2="336" y2="120"></line>
        <text class="sk-math sk-pq-pct" x="96" y="103" font-size="18" text-anchor="middle">25%</text>
