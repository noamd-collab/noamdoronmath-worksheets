          <rect class="sk-box sk-box--gold" x="240" y="48" width="120" height="120"></rect>
          <text class="sk-math" x="300" y="116" font-size="28" text-anchor="middle">4</text>
        </g>
        <text class="sk-math sk-in sk-d2" x="240" y="206" font-size="28" text-anchor="middle">6 + 4 = 10</text>
      </>
    )}

    {variant === 'quads' && (
      <>
        <rect class="sk-ghost-box" x="140" y="52" width="200" height="110"></rect>
