        <text class="sk-math sk-pd-left" x="200" y="154" font-size="18" text-anchor="middle">200</text>
        <text class="sk-math sk-pd-eq" x="200" y="204" font-size="22" text-anchor="middle">250 {MINUS} 50 = 200</text>
      </>
    )}

    {variant === 'angles' && (
      <>
        <line class="sk-ink" x1="70" y1="130" x2="410" y2="130"></line>
        <line class="sk-ink" x1="140" y1="40" x2="340" y2="210"></line>
