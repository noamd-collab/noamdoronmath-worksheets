        <line class="sk-gold" x1="305" y1="143" x2="315" y2="160"></line>
        <line class="sk-gold" x1="165" y1="160" x2="175" y2="143"></line>
        <line class="sk-gold" x1="165" y1="62" x2="175" y2="79"></line>
        <g class="sk-rh-dv">
