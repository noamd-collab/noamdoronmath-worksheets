---
import {
  CAT_FILM_AI_NOTE,
  CAT_FILM_POSTER,
  CAT_FILM_TITLE,
  INSTAGRAM_PROFILE_URL,
  featuredReelUrl,
} from '../lib/instagramReel';

const reelUrl = featuredReelUrl();
---
<section
  class="ig-feature"
  dir="rtl"
  lang="he"
  data-home-instagram
  data-ig-state={reelUrl ? 'reel' : 'fallback'}
  aria-labelledby="ig-feature-title"
>
  <h2 id="ig-feature-title" class="ig-feature__title"><span class="ig-feature__line">נועם דורון </span><span class="ig-feature__line">מתמטיקה</span><span class="ig-feature__sep"> - </span><span class="ig-feature__slogan">לא משננים, מבינים.<svg viewBox="0 0 120 16" preserveAspectRatio="none" aria-hidden="true" focusable="false"><path d="M3 9 Q 18 2, 33 9 T 63 9 T 93 9 T 117 7" fill="none" stroke="#e5735c" stroke-width="4" stroke-linecap="round"></path></svg></span></h2>
  <div class="cat-film" data-cat-film>
    <h3 id="cat-film-title" class="cat-film__title">{CAT_FILM_TITLE}</h3>
    <p class="cat-film__note">{CAT_FILM_AI_NOTE}</p>
    {reelUrl ? (
      <div class="ig-feature__embed" data-ig-reel>
        <blockquote
          class="instagram-media"
          data-instgrm-permalink={reelUrl}
          data-instgrm-version="14"
        >
          <a href={reelUrl} target="_blank" rel="noopener">
            <img class="cat-film__poster" src={CAT_FILM_POSTER} alt="" width="1080" height="1920" loading="lazy" decoding="async">
            <span class="cat-film__watch">צפייה בסרטון באינסטגרם<span class="ig-feature__sr"> (נפתח בחלון חדש)</span></span>
          </a>
        </blockquote>
      </div>
    ) : (
      <a class="ig-feature__card" href={INSTAGRAM_PROFILE_URL} target="_blank" rel="noopener">
        <span class="ig-feature__mark" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="36" height="36" focusable="false">
            <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="1.8"></rect>
            <circle cx="12" cy="12" r="4" fill="none" stroke="currentColor" stroke-width="1.8"></circle>
            <circle cx="17.2" cy="6.8" r="1.1" fill="currentColor"></circle>
          </svg>
        </span>
        <span class="ig-feature__badge">אינסטגרם</span>
        <span class="ig-feature__card-title">הסרטון החדש בדרך</span>
        <span class="ig-feature__card-text">עולה עכשיו. בינתיים, העמוד שלנו פתוח.</span>
        <span class="ig-feature__go">כניסה לעמוד<span class="ig-feature__sr"> (נפתח בחלון חדש)</span></span>
      </a>
    )}
  </div>
  <p class="ig-feature__profile">
    <a href={INSTAGRAM_PROFILE_URL} target="_blank" rel="noopener">לעמוד האינסטגרם שלנו<span class="ig-feature__sr"> (נפתח בחלון חדש)</span></a>
  </p>
</section>
{reelUrl && (
  <script is:inline>
    (function () {
      var root = document.querySelector('[data-ig-reel]');
      if (!root) return;
      var started = false;
      function load() {
        if (started) return;
        started = true;
        var existing = window.instgrm && window.instgrm.Embeds;
        if (existing) {
          existing.process();
          return;
        }
        var script = document.createElement('script');
        script.async = true;
        script.src = 'https://www.instagram.com/embed.js';
        document.body.appendChild(script);
      }
      if (!('IntersectionObserver' in window)) {
        window.addEventListener('load', load, { once: true });
        return;
      }
      var watcher = new IntersectionObserver(function (entries) {
        for (var i = 0; i < entries.length; i++) {
          if (entries[i].isIntersecting) {
            watcher.disconnect();
            load();
            return;
          }
        }
      }, { rootMargin: '240px 0px' });
      watcher.observe(root);
    })();
  </script>
)}
<style>
  .ig-feature {
    max-width: 1200px;
    margin-inline: auto;
    padding-block: 8px 80px;
    padding-inline: 24px;
    box-sizing: border-box;
    text-align: center;
  }
  .ig-feature__title {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    margin: 0 auto 20px;
    max-width: 18em;
    font-family: 'Secular One', 'Secular One Fallback', sans-serif;
    font-weight: 400;
    font-size: clamp(32px, 7.2vw, 52px);
    line-height: 1.12;
    color: #22305a;
    text-wrap: balance;
  }
  .ig-feature__line {
    display: block;
    white-space: nowrap;
  }
  .ig-feature__sep {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .ig-feature__slogan {
    position: relative;
    display: inline-block;
    max-width: 100%;
    font-size: clamp(22px, 5.6vw, 40px);
    color: #2a7c7a;
    white-space: nowrap;
  }
  .ig-feature__slogan svg {
    position: absolute;
    inset-inline: -4%;
    bottom: -8px;
    width: 108%;
    height: 12px;
    overflow: visible;
  }
  .cat-film {
    width: min(100%, 36em);
    margin-inline: auto;
  }
  .cat-film__title {
    max-width: 16em;
    margin: 0 auto 6px;
    font-family: 'Secular One', 'Secular One Fallback', sans-serif;
    font-weight: 400;
    font-size: clamp(22px, 4.4vw, 30px);
    line-height: 1.25;
    color: #22305a;
    text-wrap: balance;
  }
  .cat-film__note {
    margin: 0 0 12px;
    font-size: 14px;
    line-height: 1.4;
    color: #3d4870;
  }
  .ig-feature__embed,
  .ig-feature__card {
    width: 100%;
    max-width: 340px;
    margin-inline: auto;
    box-sizing: border-box;
  }
  .ig-feature__embed {
    background: #fff;
    border: 2px solid #22305a;
    border-radius: 18px 6px 20px 8px / 8px 20px 6px 18px;
    box-shadow: 4px 4px 0 #e6a534;
    overflow: hidden;
  }
  .ig-feature__embed :global(.instagram-media) {
    width: 100% !important;
    min-width: 0 !important;
    max-width: 340px !important;
    margin: 0 auto !important;
    background: #fff;
  }
  .cat-film__poster {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 9 / 16;
    object-fit: cover;
    background: #fbfaf5;
  }
  .cat-film__watch {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    padding: 8px 12px;
    font-weight: 700;
    font-size: 16px;
    color: #1e605e;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ig-feature__embed a {
    display: block;
    color: inherit;
    text-decoration: none;
  }
  .ig-feature__card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    padding: 28px 22px 24px;
    background: #fff;
    color: #22305a;
    text-decoration: none;
    border: 2px solid #22305a;
    border-radius: 18px 6px 20px 8px / 8px 20px 6px 18px;
    box-shadow: 4px 4px 0 #e6a534;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .ig-feature__card:hover {
    transform: translateY(-3px);
    box-shadow: 6px 6px 0 #e5735c;
  }
  .ig-feature__mark {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 18px;
    color: #22305a;
    background: #f4e7c3;
    border: 2px solid #22305a;
  }
  .ig-feature__badge {
    display: inline-block;
    margin-top: 6px;
    background: #e6a534;
    color: #22305a;
    border: 1.5px solid #22305a;
    border-radius: 999px;
    padding: 4px 12px;
    font-weight: 800;
    font-size: 15px;
    line-height: 1.4;
  }
  .ig-feature__card-title {
    font-family: 'Secular One', 'Secular One Fallback', sans-serif;
    font-size: clamp(26px, 3vw, 34px);
    line-height: 1.2;
  }
  .ig-feature__card-text {
    max-width: 26ch;
    font-size: 18px;
    line-height: 1.55;
    color: #3d4870;
  }
  .ig-feature__go {
    margin-top: 4px;
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    font-weight: 700;
    font-size: 16px;
    color: #1e605e;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ig-feature__profile {
    margin: 18px 0 0;
  }
  .ig-feature__profile a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 44px;
    min-width: 44px;
    padding: 8px 18px;
    font-weight: 700;
    font-size: 18px;
    color: #1e605e;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .ig-feature a:focus-visible {
    outline: 3px solid #2a7c7a;
    outline-offset: 3px;
  }
  .ig-feature__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  html.nd-motion-off .ig-feature__card,
  html.noam-a11y-motion .ig-feature__card,
  html[data-nd-motion='off'] .ig-feature__card {
    transition: none;
  }
  html.nd-motion-off .ig-feature__card:hover,
  html.noam-a11y-motion .ig-feature__card:hover,
  html[data-nd-motion='off'] .ig-feature__card:hover {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .ig-feature__card {
      transition: none;
    }
    .ig-feature__card:hover {
      transform: none;
    }
  }
</style>
