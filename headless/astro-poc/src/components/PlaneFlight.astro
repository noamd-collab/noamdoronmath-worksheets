---
/**
 * PlaneFlight — paper plane along a calm route in hero gutters/margins.
 * Enters under the header, arcs around the ConceptLoop card and hero copy
 * (never across them), loops once in open space, rests at a clear end spot.
 *
 * - Background layer (z-index 0), pointer-events none.
 * - Path from live layout rects (card + copy).
 * - ~15s flight, once per session; rAF.
 * - prefers-reduced-motion / html.noam-a11y-motion: static end, no trail.
 */
---

<div class="plane-layer" aria-hidden="true">
  <svg class="plane-svg" preserveAspectRatio="none">
    <path class="plane-trail" fill="none" />
    <g class="plane-icon">
      <path d="M0 -7 L20 0 L0 7 L4 0 Z" fill="var(--cobalt)" stroke="var(--cobalt-dark)" stroke-width="1" stroke-linejoin="round" />
    </g>
  </svg>
</div>

<style>
  .plane-layer {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 720px;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .plane-svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .plane-trail {
    stroke: var(--cobalt);
    stroke-width: 2.5;
    stroke-linecap: round;
    opacity: 0.55;
  }
  @media (max-width: 767px) {
    .plane-layer {
      height: 640px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plane-trail {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var layer = document.querySelector('.plane-layer');
    if (!layer) return;
    var reduced =
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      document.documentElement.classList.contains('noam-a11y-motion');
    var svg = layer.querySelector('.plane-svg');
    var trail = layer.querySelector('.plane-trail');
    var icon = layer.querySelector('.plane-icon');
    var layerRect = layer.getBoundingClientRect();
    var W = layerRect.width;
    var H = layerRect.height;
    var mobile = W < 768;
    // Grow the layer to cover the full hero so under-card routes aren't clipped.
    var heroEl = document.querySelector('.home-hero');
    if (heroEl) {
      var needH = heroEl.getBoundingClientRect().bottom - layerRect.top + 48;
      if (needH > H) {
        layer.style.height = Math.ceil(needH) + 'px';
        H = Math.ceil(needH);
        layerRect = layer.getBoundingClientRect();
      }
    }
    svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);

    function boxOf(el) {
      if (!el) return null;
      var r = el.getBoundingClientRect();
      if (r.width < 8 || r.height < 8) return null;
      return {
        left: r.left - layerRect.left,
        right: r.right - layerRect.left,
        top: r.top - layerRect.top,
        bottom: r.bottom - layerRect.top,
      };
    }

    var card =
      boxOf(document.querySelector('.home-hero .hero-loop')) ||
      boxOf(document.querySelector('.home-hero .concept-loop'));
    var copy = boxOf(document.querySelector('.home-hero__copy'));
    var PAD = mobile ? 18 : 26;

    /** Build a smooth path through waypoints with tight controls (no big bows). */
    function pathThrough(points) {
      if (!points.length) return '';
      var d = 'M ' + Math.round(points[0][0]) + ',' + Math.round(points[0][1]);
      for (var i = 1; i < points.length; i++) {
        var prev = points[i - 1];
        var cur = points[i];
        var mx = (prev[0] + cur[0]) / 2;
        var my = (prev[1] + cur[1]) / 2;
        // Keep controls on the segment so the curve cannot swing into neighbors.
        d +=
          ' C ' +
          Math.round(prev[0] * 0.35 + mx * 0.65) +
          ',' +
          Math.round(prev[1] * 0.35 + my * 0.65) +
          ' ' +
          Math.round(cur[0] * 0.35 + mx * 0.65) +
          ',' +
          Math.round(cur[1] * 0.35 + my * 0.65) +
          ' ' +
          Math.round(cur[0]) +
          ',' +
          Math.round(cur[1]);
      }
      return d;
    }

    var points;
    if (!mobile && card && copy) {
      var ceiling = Math.max(36, Math.min(card.top, copy.top) - PAD);
      var gL = card.right + PAD;
      var gR = copy.left - PAD;
      var hasGutter = gR - gL >= 40;
      var gutterX = hasGutter ? (gL + gR) / 2 : null;
      var rightX = Math.min(W - 18, Math.max(copy.right + PAD, W * 0.93));
      var leftX = Math.max(14, Math.min(card.left - PAD, W * 0.06));
      var endX = rightX;
      var endY = Math.min(H - 36, Math.max(ceiling + 12, copy.top + 28));
      var dipY = hasGutter
        ? Math.max(ceiling + 56, Math.min(Math.min(card.bottom, copy.bottom) - PAD, H - 80))
        : ceiling;

      points = [
        [W * 0.1, -28],
        [leftX, ceiling * 0.55],
        [leftX + 24, ceiling + 4],
      ];
      if (hasGutter) {
        var gSpan = (gR - gL) / 2;
        points.push([gutterX - gSpan * 0.35, ceiling - 6]);
        points.push([gutterX + 4, ceiling + 10]);
        points.push([gutterX - 6, ceiling + (dipY - ceiling) * 0.55]);
        points.push([gutterX + 5, dipY]);
        points.push([gutterX - 4, ceiling + (dipY - ceiling) * 0.4]);
        points.push([gutterX + 2, ceiling + 8]);
      } else {
        points.push([W * 0.4, ceiling - 8]);
        points.push([W * 0.55, ceiling + 6]);
      }
      points.push([rightX - 12, ceiling - 4]);
      points.push([rightX, ceiling + 6]);
      // small loop in the right margin (x stays ≥ rightX - 2)
      var lr = Math.min(26, Math.max(14, W - rightX - 4));
      points.push([rightX + lr * 0.45, ceiling - lr * 0.85]);
      points.push([rightX + lr, ceiling + 2]);
      points.push([rightX + lr * 0.25, ceiling + lr * 0.75]);
      points.push([rightX + 2, ceiling + 8]);
      points.push([endX, endY]);
    } else if (mobile && copy && card) {
      var gapTop = copy.bottom + PAD;
      var gapBot = card.top - PAD;
      var gapOk = gapBot - gapTop >= 24;
      var leftX = 14;
      var rightX = W - 16;
      if (gapOk) {
        var gapY = (gapTop + gapBot) / 2;
        points = [
          [W * 0.12, -22],
          [leftX, Math.max(40, copy.top - 14)],
          [leftX, gapY],
          [W * 0.5, gapY],
          [rightX, gapY],
        ];
      } else {
        // No gap — left margin outside both boxes, then under the card.
        var marginX = Math.max(4, Math.min(leftX, card.left - PAD, copy.left - PAD));
        var underY = Math.min(H - 16, card.bottom + Math.max(PAD, 28));
        points = [
          [W * 0.12, -22],
          [marginX, Math.max(36, copy.top - 12)],
          [marginX, Math.min(copy.bottom, card.top) - 4],
          [marginX, underY],
          [W * 0.55, underY],
          [rightX, underY],
        ];
      }
    } else {
      points = [
        [W * 0.1, -24],
        [W * 0.25, 64],
        [W * 0.55, 72],
        [W * 0.8, 68],
        [W - 36, 90],
      ];
    }

    var d = pathThrough(points);
    var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', d);
    var len = 0;
    try {
      len = path.getTotalLength();
    } catch (e) {
      return;
    }
    var scale = mobile ? 0.62 : 1;

    function place(p, tangent) {
      var deg = (Math.atan2(tangent.y, tangent.x) * 180) / Math.PI;
      icon.setAttribute(
        'transform',
        'translate(' + p.x + ' ' + p.y + ') rotate(' + deg + ') scale(' + scale + ')'
      );
    }
    function pointAt(t) {
      var p = path.getPointAtLength(len * t);
      var p2 = path.getPointAtLength(Math.min(len, len * t + 2));
      return { p: p, tangent: { x: p2.x - p.x, y: p2.y - p.y } };
    }

    if (reduced) {
      var endPt = pointAt(1);
      place(endPt.p, endPt.tangent);
      trail.style.display = 'none';
      return;
    }
    if (sessionStorage.getItem('plane-flown-v1')) {
      var e2 = pointAt(1);
      place(e2.p, e2.tangent);
      trail.style.display = 'none';
      return;
    }

    trail.setAttribute('d', d);
    var DURATION = 15000;
    var start = null;
    function ease(t) {
      return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
    }
    function frame(ts) {
      if (start === null) start = ts + 700;
      var t = Math.min(1, Math.max(0, (ts - start) / DURATION));
      var s = pointAt(ease(t));
      place(s.p, s.tangent);
      var reveal = Math.max(0, Math.min(1, ease(t) * 1.04));
      trail.style.strokeDasharray = '14 12';
      trail.style.strokeDashoffset = String(len * (1 - reveal));
      if (t >= 1) {
        try {
          sessionStorage.setItem('plane-flown-v1', '1');
        } catch (e) {}
        var fadeStart = ts;
        (function fadeOut(now) {
          var fade = Math.min(1, (now - fadeStart) / 1600);
          trail.style.opacity = String(0.55 * (1 - fade));
          if (fade < 1) requestAnimationFrame(fadeOut);
        })(ts);
        return;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
</script>
