---
/**
 * PlaneFlight — soft, flowing paper-plane trail through hero gutters.
 * Smooth cubic Beziers weave around the ConceptLoop card and hero copy
 * (never across them), with a gentle loop, then rest at a clear end spot.
 *
 * - Background layer (z-index 0), pointer-events none.
 * - Path from live layout rects (card + copy); hit-checked before use.
 * - ~15s flight, once per session; rAF.
 * - prefers-reduced-motion / html.noam-a11y-motion: static end, no trail.
 */
---

<div class="plane-layer" aria-hidden="true">
  <svg class="plane-svg" preserveAspectRatio="none">
    <path class="plane-trail" fill="none" />
    <g class="plane-icon">
      <path d="M0 -7 L20 0 L0 7 L4 0 Z" fill="var(--cobalt)" stroke="var(--cobalt-dark)" stroke-width="1" stroke-linejoin="round" />
    </g>
  </svg>
</div>

<style>
  .plane-layer {
    position: absolute;
    inset-inline: 0;
    top: 0;
    height: 720px;
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  .plane-svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  .plane-trail {
    stroke: var(--cobalt);
    stroke-width: 2.5;
    stroke-linecap: round;
    stroke-linejoin: round;
    opacity: 0.55;
  }
  @media (max-width: 767px) {
    .plane-layer {
      height: 640px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .plane-trail {
      display: none;
    }
  }
</style>

<script>
  (function () {
    var layer = document.querySelector('.plane-layer');
    if (!layer) return;
    var reduced =
      window.matchMedia('(prefers-reduced-motion: reduce)').matches ||
      document.documentElement.classList.contains('noam-a11y-motion');
    var svg = layer.querySelector('.plane-svg');
    var trail = layer.querySelector('.plane-trail');
    var icon = layer.querySelector('.plane-icon');
    var layerRect = layer.getBoundingClientRect();
    var W = layerRect.width;
    var H = layerRect.height;
    var mobile = W < 768;
    var heroEl = document.querySelector('.home-hero');
    if (heroEl) {
      var needH = heroEl.getBoundingClientRect().bottom - layerRect.top + 48;
      if (needH > H) {
        layer.style.height = Math.ceil(needH) + 'px';
        H = Math.ceil(needH);
        layerRect = layer.getBoundingClientRect();
      }
    }
    svg.setAttribute('viewBox', '0 0 ' + W + ' ' + H);

    function boxOf(el) {
      if (!el) return null;
      var r = el.getBoundingClientRect();
      if (r.width < 8 || r.height < 8) return null;
      return {
        left: r.left - layerRect.left,
        right: r.right - layerRect.left,
        top: r.top - layerRect.top,
        bottom: r.bottom - layerRect.top,
      };
    }
    function r(n) {
      return Math.round(n);
    }
    function C(c1x, c1y, c2x, c2y, x, y) {
      return ' C ' + r(c1x) + ',' + r(c1y) + ' ' + r(c2x) + ',' + r(c2y) + ' ' + r(x) + ',' + r(y);
    }
    function clamp(v, a, b) {
      return Math.max(a, Math.min(b, v));
    }

    var card =
      boxOf(document.querySelector('.home-hero .hero-loop')) ||
      boxOf(document.querySelector('.home-hero .concept-loop'));
    var copy = boxOf(document.querySelector('.home-hero__copy'));
    var PAD = mobile ? 22 : 36;

    function pathHits(dAttr, boxes) {
      var p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      p.setAttribute('d', dAttr);
      var len = 0;
      try {
        len = p.getTotalLength();
      } catch (e) {
        return true;
      }
      if (!len) return true;
      var inset = 8;
      for (var i = 0; i <= 80; i++) {
        var pt = p.getPointAtLength((len * i) / 80);
        for (var j = 0; j < boxes.length; j++) {
          var b = boxes[j];
          if (
            pt.x >= b.left + inset &&
            pt.x <= b.right - inset &&
            pt.y >= b.top + inset &&
            pt.y <= b.bottom - inset
          ) {
            return true;
          }
        }
      }
      return false;
    }

    var obstacles = [card, copy].filter(Boolean);
    var d;

    if (!mobile && card && copy) {
      // Sky band above both boxes; gutter dive keeps x in (card.right+PAD, copy.left-PAD).
      var sky = Math.max(28, Math.min(card.top, copy.top) - PAD);
      var gL = card.right + PAD;
      var gR = copy.left - PAD;
      var hasGutter = gR - gL >= 44;
      var gx = hasGutter ? (gL + gR) / 2 : (card.right + copy.left) / 2;
      var lx = clamp(Math.min(card.left - PAD, W * 0.08), 12, 40);
      // Right margin strictly outside the copy
      var rx = Math.max(copy.right + PAD, W - 36);
      if (rx > W - 10) rx = W - 12;
      var room = W - rx;
      var loopR = clamp(room * 0.85, 18, 36);
      var endX = rx + loopR * 0.15;
      var endY = sky + 18;
      // Stay above the copy whenever x is inside its span
      var yOver = Math.min(sky, copy.top - PAD);

      function build(dipDepth) {
        var dip = sky + dipDepth;
        var out =
          'M ' + r(W * 0.07) + ',-28' +
          C(W * 0.0, 42, lx - 8, sky * 0.35, lx + 16, sky + 4) +
          // long soft wave over the card (above it)
          C(lx + 100, sky - 30, gx - 90, sky + 34, gx - 4, sky + 2);
        if (hasGutter && dipDepth > 0) {
          out +=
            C(clamp(gx + 12, gL, gR), sky + dipDepth * 0.45, clamp(gx - 12, gL, gR), dip - 6, gx, dip) +
            C(clamp(gx + 14, gL, gR), dip - dipDepth * 0.4, clamp(gx - 8, gL, gR), sky + 28, gx + 2, sky);
        }
        // glide across above the hero text with a soft sine-like bend
        out +=
          C(gx + 40, yOver - 24, (copy.left + copy.right) / 2, yOver + 26, copy.right - 40, yOver - 4) +
          C(copy.right - 10, yOver - 18, rx - 8, yOver + 8, rx, yOver) +
          // petal loop entirely in the right margin (x ≥ rx)
          C(rx + loopR, yOver - loopR * 0.9, rx + loopR * 1.05, yOver + loopR * 0.55, rx + loopR * 0.25, yOver + loopR * 0.85) +
          C(rx + 2, yOver + loopR * 0.55, rx + 4, yOver + 8, endX, endY);
        return out;
      }

      // Prefer a soft gutter arc; fall back to shallower, then no dive.
      d = build(hasGutter ? 95 : 0);
      if (pathHits(d, obstacles)) d = build(hasGutter ? 55 : 0);
      if (pathHits(d, obstacles)) d = build(0);
    } else if (mobile && copy && card) {
      var gapTop = copy.bottom + PAD;
      var gapBot = card.top - PAD;
      var gapOk = gapBot - gapTop >= 28;
      var marginX = clamp(Math.min(card.left, copy.left) - PAD, 4, 14);
      var rightX = W - 12;
      if (gapOk) {
        var gapY = (gapTop + gapBot) / 2;
        d =
          'M ' + r(W * 0.16) + ',-22' +
          C(W * 0.02, 40, marginX + 20, copy.top - 6, marginX + 4, gapY - 22) +
          C(marginX - 8, gapY + 18, W * 0.4, gapY - 20, W * 0.62, gapY + 12) +
          C(W * 0.82, gapY + 22, rightX + 6, gapY - 24, rightX - 2, gapY);
      } else {
        var underY = clamp(card.bottom + PAD, card.bottom + 28, H - 12);
        d =
          'M ' + r(W * 0.16) + ',-22' +
          C(marginX - 10, 55, marginX + 18, copy.top + 40, marginX + 2, copy.bottom - 10) +
          C(marginX - 14, card.top + 50, marginX + 16, underY - 40, marginX + 6, underY) +
          C(W * 0.38, underY + 18, W * 0.68, underY - 16, rightX, underY + 2);
      }
      if (pathHits(d, obstacles)) {
        d =
          'M ' + r(W * 0.14) + ',-20' +
          C(W * 0.04, 36, W * 0.3, 62, W * 0.52, 44) +
          C(W * 0.72, 28, W * 0.88, 72, W - 18, 96);
      }
    } else {
      d =
        'M ' + r(W * 0.1) + ',-24' +
        C(W * 0.2, 55, W * 0.45, 78, W * 0.65, 60) +
        C(W * 0.82, 42, W * 0.9, 85, W - 36, 95);
    }

    var path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', d);
    var len = 0;
    try {
      len = path.getTotalLength();
    } catch (e) {
      return;
    }
    var scale = mobile ? 0.62 : 1;

    function place(p, tangent) {
      var deg = (Math.atan2(tangent.y, tangent.x) * 180) / Math.PI;
      icon.setAttribute(
        'transform',
        'translate(' + p.x + ' ' + p.y + ') rotate(' + deg + ') scale(' + scale + ')'
      );
    }
    function pointAt(t) {
      var p = path.getPointAtLength(len * t);
      var p2 = path.getPointAtLength(Math.min(len, len * t + 2));
      return { p: p, tangent: { x: p2.x - p.x, y: p2.y - p.y } };
    }

    if (reduced) {
      var endPt = pointAt(1);
      place(endPt.p, endPt.tangent);
      trail.style.display = 'none';
      return;
    }
    if (sessionStorage.getItem('plane-flown-v1')) {
      var e2 = pointAt(1);
      place(e2.p, e2.tangent);
      trail.style.display = 'none';
      return;
    }

    trail.setAttribute('d', d);
    var DURATION = 15000;
    var start = null;
    function ease(t) {
      return t < 0.5 ? 2 * t * t : -1 + (4 - 2 * t) * t;
    }
    function frame(ts) {
      if (start === null) start = ts + 700;
      var t = Math.min(1, Math.max(0, (ts - start) / DURATION));
      var s = pointAt(ease(t));
      place(s.p, s.tangent);
      var reveal = Math.max(0, Math.min(1, ease(t) * 1.04));
      // Continuous stroke draw (no boxy dash segments)
      trail.style.strokeDasharray = String(len);
      trail.style.strokeDashoffset = String(len * (1 - reveal));
      if (t >= 1) {
        try {
          sessionStorage.setItem('plane-flown-v1', '1');
        } catch (e) {}
        var fadeStart = ts;
        (function fadeOut(now) {
          var fade = Math.min(1, (now - fadeStart) / 1600);
          trail.style.opacity = String(0.55 * (1 - fade));
          if (fade < 1) requestAnimationFrame(fadeOut);
        })(ts);
        return;
      }
      requestAnimationFrame(frame);
    }
    requestAnimationFrame(frame);
  })();
</script>
