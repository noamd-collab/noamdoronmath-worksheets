---
/**
 * Brand lockup — design handoff: ~68px logo height, transform-origin for wiggle.
 */
interface Props {
  href?: string;
  compact?: boolean;
}
const { href = '/', compact = false } = Astro.props;
---
<a
  class:list={['site-brand', compact && 'site-brand--compact']}
  href={href}
  aria-label="נועם דורון מתמטיקה — דף הבית"
  data-logo-brand
>
  <img
    class="site-brand__logo"
    src="/brand/noam-doron-math-logo-cropped.png"
    alt="נועם דורון מתמטיקה"
    width="160"
    height="68"
    decoding="async"
  />
</a>

<style>
  .site-brand {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    background: transparent;
    border: 0;
    border-radius: 0;
    box-shadow: none;
  }
  .site-brand__logo {
    display: block;
    height: 68px;
    width: auto;
    max-width: min(200px, 42vw);
    background: transparent;
    transform-origin: 30% 80%;
  }
  .site-brand--compact .site-brand__logo {
    height: 52px;
  }
  @media (max-width: 640px) {
    .site-brand__logo {
      height: 56px;
    }
  }
</style>
