---
/**
 * Formula loops. Each exponent sits in <sup> immediately after its base.
 * Formulas are LTR-isolated so an RTL page cannot pull the superscript away.
 */
import { CSS_LOOP_IDEAS, MINUS, POWERS_ROWS, captionMathHtml, type CssLoopVariant } from '../lib/landingLoops';

interface Props {
  variant: CssLoopVariant;
}
const { variant } = Astro.props;
const even = POWERS_ROWS[0];
const plain = POWERS_ROWS[1];
const odd = POWERS_ROWS[2];
/* Section 4 of the 10.11.2026 audit: a small picture beside the formula moves
   into its finished place. Rest style is the finished picture. */
const PICTURE_VARIANTS = ['powers', 'exp-rules', 'order', 'signed-mul', 'signed-div', 'proof', 'quad-factor', 'frac-recip'];
const picture = PICTURE_VARIANTS.includes(variant);
const PICTURE_VIEWBOX: Record<string, string> = {
  powers: '0 20 180 180',
  'exp-rules': '0 50 170 110',
  order: '0 15 160 175',
  'signed-mul': '0 30 180 150',
  'signed-div': '50 15 130 165',
  proof: '0 30 180 135',
  'quad-factor': '0 25 180 185',
  'frac-recip': '0 30 180 145',
};
const orderSlot = (s: number) => ({ x: 20 + (s % 7) * 20, y: 150 + Math.floor(s / 7) * 26 });
const orderChips = Array.from({ length: 12 }, (_, j) => {
  const rest = orderSlot(j);
  const from = { x: 20 + (j % 4) * 20, y: 30 + Math.floor(j / 4) * 28 };
  return { ...rest, dx: from.x - rest.x, dy: from.y - rest.y, d: Math.floor(j / 4) * 0.25 };
});
const orderPair = [0, 1].map((k) => {
  const rest = orderSlot(12 + k);
  return { ...rest, dx: 130 + k * 20 - rest.x, dy: 30 - rest.y };
});
const lineTicks = [-6, -4, -2, 0, 2, 4, 6].map((n) => 90 + n * 12);
---

<div class:list={['lf', picture && 'lf--pic']}>
  {variant === 'powers' && (
    <div class="ll-compare">
      <div class="ll-row ll-row-0">
        <p class="ll-eq" dir="ltr"><span class="ll-parens">{even.base}</span><sup>{even.sup}</sup>{` = ${even.result}`}</p>
        <p class="ll-expn" dir="ltr">{even.expand}</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml(even.caption)}></p>
      </div>
      <div class="ll-row ll-row-1">
        <p class="ll-eq" dir="ltr"><span class="ll-sign">{MINUS}</span>3<sup>2</sup> = <span class="ll-sign">{MINUS}</span>9</p>
        <p class="ll-expn" dir="ltr"><span class="ll-sign">{MINUS}</span>(3 × 3)</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml(plain.caption)}></p>
      </div>
      <div class="ll-row ll-row-2">
        <p class="ll-eq" dir="ltr"><span class="ll-parens">{odd.base}</span><sup>{odd.sup}</sup>{` = ${odd.result}`}</p>
        <p class="ll-expn" dir="ltr">{odd.expand}</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml(odd.caption)}></p>
      </div>
    </div>
  )}

  {variant === 'exp-rules' && (
    <div class="ll-stack">
      <p class="ll-eq" dir="ltr">2<sup class="ll-hot">3</sup> × 2<sup class="ll-hot ll-d1">2</sup> = 2<sup class="ll-hot ll-d2">5</sup></p>
      <p class="ll-expn" dir="ltr">3 + 2 = 5</p>
      <p class="ll-cap" dir="rtl" set:html={captionMathHtml(CSS_LOOP_IDEAS['exp-rules'])}></p>
    </div>
  )}

  {variant === 'roots' && (
    <div class="ll-stack">
      <div class="ll-cells" aria-hidden="true">
        {Array.from({ length: 9 }, (_, i) => <i class="ll-cell" style={`--i:${i};--dx:${(i - (i % 3)) * 8}cqi;--dy:${-Math.floor(i / 3) * 8}cqi`}></i>)}
      </div>
      <p class="ll-eq" dir="ltr">3<sup>2</sup> = 9</p>
      <p class="ll-eq ll-late" dir="ltr">√9 = 3</p>
      <p class="ll-cap" dir="rtl" set:html={captionMathHtml(CSS_LOOP_IDEAS.roots)}></p>
    </div>
  )}

  {variant === 'order' && (
    <div class="ll-stack">
      <p class="ll-eq" dir="ltr">{MINUS}2 + <span class="ll-hot">3 × ({MINUS}4)</span></p>
      <p class="ll-eq ll-late" dir="ltr">{MINUS}2 + ({MINUS}12) = {MINUS}14</p>
      <p class="ll-cap" dir="rtl" set:html={captionMathHtml(CSS_LOOP_IDEAS.order)}></p>
    </div>
  )}

  {variant === 'signed-mul' && (
    <div class="ll-compare ll-compare--two">
      <div class="ll-row ll-row-0">
        <p class="ll-eq" dir="ltr">({MINUS}2) × ({MINUS}3) = 6</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('שני מינוסים נותנים פלוס')}></p>
      </div>
      <div class="ll-row ll-row-1">
        <p class="ll-eq" dir="ltr">({MINUS}2) × 3 = {MINUS}6</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('סימנים שונים נותנים מינוס')}></p>
      </div>
    </div>
  )}

  {variant === 'signed-div' && (
    <div class="ll-compare ll-compare--two">
      <div class="ll-row ll-row-0">
        <p class="ll-eq" dir="ltr">({MINUS}8) : ({MINUS}2) = 4</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('סימנים זהים נותנים פלוס')}></p>
      </div>
      <div class="ll-row ll-row-1">
        <p class="ll-eq" dir="ltr">({MINUS}8) : 2 = {MINUS}4</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('סימנים שונים נותנים מינוס')}></p>
      </div>
    </div>
  )}

  {variant === 'proof' && (
    <div class="ll-compare">
      <div class="ll-row ll-row-0">
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('נתון')}></p>
        <p class="ll-eq" dir="ltr">α = β</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('שתי זוויות צמודות שוות')}></p>
      </div>
      <div class="ll-row ll-row-1">
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('נימוק')}></p>
        <p class="ll-eq" dir="ltr">α + β = 180°</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('זוויות צמודות')}></p>
      </div>
      <div class="ll-row ll-row-2">
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('לכן')}></p>
        <p class="ll-eq" dir="ltr">α = β = 90°</p>
        <p class="ll-cap" dir="rtl" set:html={captionMathHtml('כל אחת מהן ישרה')}></p>
      </div>
    </div>
  )}

  {variant === 'quad-factor' && (
    <div class="ll-stack">
      <p class="ll-eq" dir="ltr">x<sup>2</sup> {MINUS} 5x + 6 = 0</p>
      <p class="ll-eq ll-late" dir="ltr">(x {MINUS} 2) × (x {MINUS} 3) = 0</p>
      <p class="ll-eq ll-late" dir="ltr">x = 2 , x = 3</p>
      <p class="ll-cap" dir="rtl" set:html={captionMathHtml(CSS_LOOP_IDEAS['quad-factor'])}></p>
    </div>
  )}

  {variant === 'frac-recip' && (
    <div class="ll-stack">
      <p class="ll-eq" dir="ltr"><span class="ll-frac"><span class="ll-frac__n">1</span><span class="ll-frac__d">2</span></span> : <span class="ll-frac"><span class="ll-frac__n">1</span><span class="ll-frac__d">4</span></span></p>
      <p class="ll-eq ll-rc" dir="ltr">= <span class="ll-frac"><span class="ll-frac__n">1</span><span class="ll-frac__d">2</span></span> <span class="ll-rc-op"><span class="ll-rc-div">:</span><span class="ll-rc-mul">×</span></span> <span class="ll-frac ll-rc-flip"><span class="ll-frac__n"><span class="ll-rc-up">4</span></span><span class="ll-frac__d"><span class="ll-rc-down">1</span></span></span> <span class="ll-rc-ans">= 2</span></p>
      <p class="ll-cap" dir="rtl" set:html={captionMathHtml(CSS_LOOP_IDEAS['frac-recip'])}></p>
    </div>
  )}

  {variant === 'tools' && (
    <div class="ll-screen">
      <p class="ll-eq ll-on-dark" dir="ltr">2 × <span class="ll-parens">(3 + 1)</span></p>
      <p class="ll-eq ll-on-dark ll-late" dir="ltr">2 × 4 = 8</p>
      <p class="ll-cap ll-cap--light" dir="rtl" set:html={captionMathHtml(CSS_LOOP_IDEAS.tools)}></p>
    </div>
  )}
  {picture && (
    <svg class="lf-pic" viewBox={PICTURE_VIEWBOX[variant]} aria-hidden="true" focusable="false">
      {variant === 'powers' && (
        <>
          <rect class="lf-bar" x="30" y="42" width="30" height="8" rx="3"></rect>
          <rect class="lf-bar lf-mv" style="--mvt:12s;--from:translate(50px,0) rotate(-90deg)" x="41" y="31" width="8" height="30" rx="3"></rect>
          <rect class="lf-bar" x="30" y="106" width="30" height="8" rx="3"></rect>
          {Array.from({ length: 9 }, (_, i) => (
            <rect class="lf-cell lf-mv lf-mv-40" style={`--mvt:12s;--from:scale(0);--d:${i * 0.05}s`} x={80 + (i % 3) * 12} y={94 + Math.floor(i / 3) * 12} width="10" height="10" rx="2"></rect>
          ))}
          <rect class="lf-bar" x="30" y="170" width="30" height="8" rx="3"></rect>
          <rect class="lf-bar lf-mv lf-mv-60" style="--mvt:12s;--d:1s;--from:translate(50px,0) rotate(-90deg)" x="41" y="159" width="8" height="30" rx="3"></rect>
          <rect class="lf-bar" x="130" y="170" width="30" height="8" rx="3"></rect>
        </>
      )}
      {variant === 'exp-rules' && (
        <>
          {[12, 42, 72].map((x) => (
            <g>
              <rect class="lf-tile" x={x} y="70" width="26" height="26" rx="4"></rect>
              <text class="lf-t lf-t--on" x={x + 13} y="88">2</text>
            </g>
          ))}
          {[102, 132].map((x, k) => (
            <g class="lf-mv lf-mv-20" style={`--from:translate(-90px,50px);--d:${k * 0.2}s`}>
              <rect class="lf-tile lf-tile--gold" x={x} y="70" width="26" height="26" rx="4"></rect>
              <text class="lf-t" x={x + 13} y="88">2</text>
            </g>
          ))}
        </>
      )}
      {variant === 'order' && (
        <>
          {orderChips.map((c) => (
            <circle class="lf-chip lf-mv lf-mv-20" style={`--from:translate(${c.dx}px,${c.dy}px);--d:${c.d}s`} cx={c.x} cy={c.y} r="7"></circle>
          ))}
          {orderPair.map((c) => (
            <circle class="lf-chip lf-chip--b lf-mv lf-mv-60" style={`--from:translate(${c.dx}px,${c.dy}px)`} cx={c.x} cy={c.y} r="7"></circle>
          ))}
        </>
      )}
      {variant === 'signed-mul' && (
        <>
          {[60, 150].map((y) => (
            <g>
              <line class="lf-ink" x1="10" y1={y} x2="170" y2={y}></line>
              {lineTicks.map((x) => <line class="lf-ink lf-ink--thin" x1={x} y1={y - 5} x2={x} y2={y + 5}></line>)}
              <text class="lf-t" x="90" y={y + 22}>0</text>
            </g>
          ))}
          <text class="lf-t" x="162" y="82">6</text>
          <text class="lf-t" x="18" y="172">{MINUS}6</text>
          {[0, 1, 2].map((k) => (
            <line class="lf-hop lf-mv" style={`--from:translateX(${24 * k}px);--d:${k * 0.35}s`} x1={90 - 24 * (k + 1) + 3} y1="140" x2={90 - 24 * k - 3} y2="140"></line>
          ))}
          <circle class="lf-dot lf-mv" style="--from:translateX(72px);--d:.7s" cx="18" cy="150" r="5"></circle>
          {[0, 1, 2].map((k) => (
            <line class="lf-hop lf-mv lf-mv-40 lf-mv--vb" style={`--from:scaleX(-1);--org:90px 0px;--d:${k * 0.15}s`} x1={90 + 24 * k + 3} y1="50" x2={90 + 24 * (k + 1) - 3} y2="50"></line>
          ))}
          <circle class="lf-dot lf-mv lf-mv-40 lf-mv--vb" style="--from:scaleX(-1);--org:90px 0px;--d:.3s" cx="162" cy="60" r="5"></circle>
        </>
      )}
      {variant === 'signed-div' && (
        <>
          {[50, 150].map((y) => (
            <g>
              <line class="lf-ink" x1="60" y1={y} x2="170" y2={y}></line>
              {[70, 110, 150].map((x) => <line class="lf-ink lf-ink--thin" x1={x} y1={y - 5} x2={x} y2={y + 5}></line>)}
            </g>
          ))}
          <text class="lf-t" x="70" y="30">{MINUS}8</text>
          <text class="lf-t" x="150" y="30">0</text>
          <rect class="lf-ghost" x="70" y="34" width="80" height="10" rx="2"></rect>
          {[0, 1, 2, 3].map((k) => (
            <g>
              <rect class="lf-piece lf-mv" style={`--from:translate(${-5 * k}px,-30px);--d:${k * 0.3}s`} x={70 + 25 * k} y="64" width="20" height="10" rx="2"></rect>
              <text class="lf-t lf-t--small" x={80 + 25 * k} y="92">{k + 1}</text>
            </g>
          ))}
          <rect class="lf-bar" x="70" y="134" width="40" height="10" rx="2"></rect>
          <rect class="lf-bar lf-mv lf-mv-40" style="--from:translate(40px,-24px);--d:.8s" x="70" y="158" width="40" height="10" rx="2"></rect>
          <text class="lf-t lf-t--small" x="128" y="142">{MINUS}4</text>
          <text class="lf-t lf-t--small" x="128" y="167">{MINUS}4</text>
        </>
      )}
      {variant === 'proof' && (
        <>
          <path class="lf-wedge" d="M90 150 L40 150 A50 50 0 0 1 90 100 Z"></path>
          <path class="lf-wedge lf-wedge--coral lf-mv lf-mv-40 lf-mv--vb" style="--mvt:12s;--from:scaleX(-1);--org:90px 0px;--fo:0" d="M90 150 L90 100 A50 50 0 0 1 140 150 Z"></path>
          <line class="lf-ink" x1="10" y1="150" x2="170" y2="150"></line>
          <line class="lf-ray lf-mv" style="--mvt:12s;--from:scaleY(0);--org:50% 100%" x1="90" y1="150" x2="90" y2="40"></line>
          <path class="lf-ink lf-ink--thin lf-mv lf-mv-60" style="--mvt:12s;--d:1s;--from:scale(0);--org:0 100%" d="M90 132 H108 V150"></path>
          <text class="lf-t" x="52" y="128">α</text>
          <text class="lf-t" x="126" y="128">β</text>
        </>
      )}
      {variant === 'quad-factor' && (
        <>
          <line class="lf-ink" x1="10" y1="150" x2="170" y2="150"></line>
          <line class="lf-ink" x1="10" y1="30" x2="10" y2="205"></line>
          <path class="lf-curve lf-mv" style="--from:translateY(-40px);--fo:0" d="M74 60.4 Q110 319.6 146 60.4"></path>
          <circle class="lf-dot lf-mv lf-mv-40" style="--from:translateX(20px)" cx="90" cy="150" r="6"></circle>
          <circle class="lf-dot lf-mv lf-mv-40" style="--from:translateX(-20px)" cx="130" cy="150" r="6"></circle>
          <text class="lf-t" x="84" y="136">2</text>
          <text class="lf-t" x="136" y="136">3</text>
        </>
      )}
      {variant === 'frac-recip' && (
        <>
          <rect class="lf-half" x="10" y="60" width="80" height="34"></rect>
          <rect class="lf-piece lf-mv lf-mv-20" style="--from:translateY(80px)" x="10" y="60" width="40" height="34"></rect>
          <rect class="lf-piece lf-mv lf-mv-40" style="--from:translate(-40px,80px)" x="50" y="60" width="40" height="34"></rect>
          <rect class="lf-ghost" x="10" y="60" width="160" height="34"></rect>
          {[50, 90, 130].map((x) => <line class="lf-ink lf-ink--thin" x1={x} y1="60" x2={x} y2="94"></line>)}
          <text class="lf-t" x="30" y="50">1</text>
          <text class="lf-t" x="70" y="50">2</text>
        </>
      )}
    </svg>
  )}
</div>

<style>
  .lf {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .ll-compare, .ll-stack, .ll-screen {
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 1.5%;
    padding: 5% 6% 4%;
  }
  .ll-row { opacity: 0.4; }
  .ll-eq, .ll-expn, .ll-cap {
    margin: 0;
    font-family: Heebo, 'Heebo Fallback', sans-serif;
    line-height: 1.15;
  }
  .ll-eq, .ll-expn {
    direction: ltr;
    unicode-bidi: isolate;
    text-align: start;
  }
  .ll-eq {
    font-size: 6.4cqi;
    font-weight: 800;
    color: #22305a;
  }
  .ll-expn {
    font-size: 4.3cqi;
    font-weight: 700;
    color: #1e605e;
  }
  .ll-cap {
    direction: rtl;
    unicode-bidi: isolate;
    text-align: start;
    font-size: 3.5cqi;
    font-weight: 700;
    color: #5a6588;
  }
  .ll-eq sup {
    display: inline-block;
    font-size: 0.55em;
    line-height: 1;
    margin: 0;
    padding: 0;
    vertical-align: baseline;
    position: relative;
    top: -0.55em;
  }
  .ll-parens, .ll-sign, .ll-hot {
    background: #fdf1d8;
    border-radius: 0.28em;
  }
  .ll-sign { background: #fde4df; }
  .ll-cells {
    display: grid;
    grid-template-columns: repeat(3, 7cqi);
    gap: 1cqi;
    margin-bottom: 1%;
  }
  .ll-cell {
    display: block;
    width: 7cqi;
    height: 7cqi;
    border-radius: 0.4cqi;
    background: #e5735c;
    opacity: 1;
  }
  .ll-screen {
    margin: 5%;
    width: auto;
    height: auto;
    border-radius: 8cqi;
    background: #22305a;
  }
  .ll-on-dark { color: #fbfaf5; }
  .ll-cap--light { color: #d7efe8; }
  .ll-screen .ll-parens { background: #3d4d78; }
  .ll-frac {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    vertical-align: middle;
    line-height: 1;
    margin-inline: 0.12em;
    direction: ltr;
    unicode-bidi: isolate;
  }
  .ll-frac__n { border-bottom: 0.08em solid currentColor; padding: 0 0.14em 0.04em; }
  .ll-frac__d { padding: 0.04em 0.14em 0; }

  /* frac-recip. The rest style is the finished frame: × and the flipped
     divisor. In the loop the copy starts as ":" over the same divisor, then
     only the divisor flips: its 1 and 4 trade places across the bar. */
  .ll-rc-op { display: inline-grid; }
  .ll-rc-op > span { grid-area: 1 / 1; }
  .ll-rc-div { opacity: 0; }
  .ll-rc-flip { background: #fdf1d8; border-radius: 0.28em; }
  .ll-rc-up, .ll-rc-down { display: inline-block; }
  .ll-rc { animation: ll-rc-line 8s ease-in-out infinite; }
  .ll-rc-div { animation: ll-rc-div 8s ease-in-out infinite; }
  .ll-rc-mul { animation: ll-rc-mul 8s ease-in-out infinite; }
  .ll-rc-up { animation: ll-rc-up 8s ease-in-out infinite; }
  .ll-rc-down { animation: ll-rc-down 8s ease-in-out infinite; }
  .ll-rc-ans { animation: ll-rc-ans 8s ease-in-out infinite; }

  @keyframes ll-rc-line {
    0%, 8% { opacity: 0; }
    14%, 90% { opacity: 1; }
    95%, 100% { opacity: 0; }
  }
  @keyframes ll-rc-div {
    0%, 22% { opacity: 1; }
    28%, 96% { opacity: 0; }
    100% { opacity: 1; }
  }
  @keyframes ll-rc-mul {
    0%, 22% { opacity: 0; }
    28%, 96% { opacity: 1; }
    100% { opacity: 0; }
  }
  @keyframes ll-rc-up {
    0%, 28% { transform: translateY(1.16em); }
    40%, 96% { transform: translateY(0); }
    100% { transform: translateY(1.16em); }
  }
  @keyframes ll-rc-down {
    0%, 28% { transform: translateY(-1.16em); }
    40%, 96% { transform: translateY(0); }
    100% { transform: translateY(-1.16em); }
  }
  @keyframes ll-rc-ans {
    0%, 46% { opacity: 0; }
    52%, 90% { opacity: 1; }
    95%, 100% { opacity: 0; }
  }

  .ll-row-0 { animation: ll-focus 12s ease-in-out infinite; }
  .ll-row-1 { animation: ll-focus 12s ease-in-out infinite; animation-delay: 4s; }
  .ll-row-2 { animation: ll-focus 12s ease-in-out infinite; animation-delay: 8s; }
  .ll-compare--two .ll-row-0,
  .ll-compare--two .ll-row-1 { animation-duration: 8s; }
  .ll-compare--two .ll-row-1 { animation-delay: 4s; }

  .ll-hot { animation: ll-pop 8s ease-in-out infinite; }
  .ll-d1 { animation-delay: 0.6s; }
  .ll-d2 { animation-delay: 1.4s; }
  .ll-late { opacity: 1; animation: ll-in 8s ease-in-out infinite; }
  .ll-cell { animation: ll-fold 8s ease-in-out infinite backwards; animation-delay: calc(var(--i) * 0.06s); }

  @keyframes ll-focus {
    0%, 28% { opacity: 1; }
    34%, 100% { opacity: 0.38; }
  }
  @keyframes ll-pop {
    0%, 12% { opacity: 0.35; }
    28%, 78% { opacity: 1; }
    100% { opacity: 0.35; }
  }
  @keyframes ll-in {
    0%, 36% { opacity: 0.25; }
    48%, 82% { opacity: 1; }
    100% { opacity: 0.25; }
  }
  /* Picture beside the formula, in the empty half of the card. */
