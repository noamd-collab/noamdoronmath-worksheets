---
import LessonMath from './LessonMath.astro';
import { lessonMathParts } from '../lib/lessonMath';
interface Props { value: string }
const { value } = Astro.props;
const textWidth = (text: string) => [...text].reduce((width, char) => width + (
  /\s/.test(char) ? .2 : /[.,]/.test(char) ? .28 : /[()]/.test(char) ? .38 : /[+−=<>⇔×÷]/.test(char) ? .7 : .6
), 0);
// Fit each complete statement to its own container, including a narrow mobile
// step beside the step number. A stacked fraction uses the wider operand.
const statements = value.split(';').map(text => text.trim()).filter(Boolean).map(text => ({
  text,
  width: .4 + lessonMathParts(text).reduce((width, part) => width + (typeof part === 'string'
    ? textWidth(part)
    : Math.max(textWidth(part.numerator), textWidth(part.denominator)) + .7), 0),
}));
---
<span class="math-lines" dir="ltr">
  {statements.map(({text,width}) => <span class="math-statement" style={`--statement-width:${width}`}><LessonMath value={text}/></span>)}
</span>
<style>
  .math-lines {display:flex;flex-direction:column;align-items:center;gap:.2em;width:100%;min-width:0;container-type:inline-size;direction:ltr;unicode-bidi:isolate;}
  .math-statement {display:inline-flex;white-space:nowrap;overflow-wrap:normal;word-break:normal;flex:none;font-size:min(1em,calc(100cqi / var(--statement-width)));line-height:1.5;}
</style>
