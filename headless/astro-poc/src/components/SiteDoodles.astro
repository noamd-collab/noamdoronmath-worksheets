---
/**
 * DOODLES-45 — site-wide decorative motifs (illustration webp only).
 * Selection is pathname-seeded in src/lib/doodles/selectSiteDoodles.ts.
 * Homepage skips this layer (HeroIllustrations owns that surface).
 *
 * ≤1200px: in-flow centered row — ALL selected motifs (incl. former gutter-only).
 * >1200px: fixed outer gutters only (2–3 motifs) — never mid-content slots.
 */
import {
  selectSiteDoodles,
  shouldSkipSiteDoodles,
  type DoodleMotif,
} from '../lib/doodles/selectSiteDoodles';
import manifest from '../data/doodles.manifest.json';

const pathname = Astro.url.pathname;
const motifs = (manifest.motifs || []) as DoodleMotif[];
const placements =
  shouldSkipSiteDoodles(pathname) || motifs.length === 0
    ? []
    : selectSiteDoodles(pathname, motifs);

/** Among strip-visible motifs, alternate start/end so they never stack. */
let stripOrdinal = 0;
const decorated = placements.map((p) => {
  let stripSide: 'start' | 'end' | null = null;
  if (p.mobileVisible) {
    stripSide = stripOrdinal % 2 === 0 ? 'start' : 'end';
    stripOrdinal += 1;
  }
  return { ...p, stripSide };
});
---

{
  decorated.length > 0 && (
    <div class="site-doodles" aria-hidden="true" data-site-doodles data-path={pathname}>
      {decorated.map((p) => (
        <img
          class:list={[
            'site-doodle',
            `site-doodle--${p.slot}`,
            p.mobileVisible ? 'site-doodle--strip' : 'site-doodle--gutter-only',
            p.stripSide ? `site-doodle--s-${p.stripSide}` : null,
          ]}
          src={p.src}
          alt=""
          width="160"
          height="160"
          decoding="async"
          loading="lazy"
          data-doodle-id={p.id}
          data-strip-side={p.stripSide || undefined}
          style={`--doodle-scale:${p.scale};--doodle-rotate:${p.rotate}deg`}
        />
      ))}
    </div>
  )
}

<style>
  .site-doodles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    overflow: hidden;
  }

  /*
   * KIMI-ANIM-6: margin doodles were shipping tiny (~72–120px) and with
   * animation:none — never got the HeroIllustrations float. Restore a
   * readable gutter size + gentle idle motion (transform only).
   */
  .site-doodle {
    position: absolute;
    display: block;
    width: clamp(140px, 14vw, 200px);
    height: auto;
    max-width: 220px;
    opacity: 0.88;
    transform: translateY(0) scale(var(--doodle-scale, 1))
      rotate(var(--doodle-rotate, 0deg));
    transform-origin: center center;
    animation: site-doodle-float 7s ease-in-out infinite;
    will-change: transform;
  }
  .site-doodle--tr {
    animation-duration: 8.2s;
    animation-delay: 0.7s;
  }
  .site-doodle--bl {
    animation-duration: 7.6s;
    animation-delay: 1.1s;
  }
  .site-doodle--br {
    animation-duration: 8.8s;
    animation-delay: 0.35s;
  }
  .site-doodle--ml {
    animation-duration: 7.3s;
    animation-delay: 0.9s;
  }
  .site-doodle--mr {
    animation-duration: 8s;
    animation-delay: 1.4s;
  }

  @keyframes site-doodle-float {
    0%,
    100% {
      transform: translateY(0) scale(var(--doodle-scale, 1))
        rotate(var(--doodle-rotate, 0deg));
    }
    50% {
      transform: translateY(-12px) scale(var(--doodle-scale, 1))
        rotate(var(--doodle-rotate, 0deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-doodle {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .site-doodle {
    animation: none !important;
  }

  /*
   * Wide desktop gutters only — content shell ≈1100px.
   * Place OUTSIDE half-width 560px so motifs sit in true margins (>1200vw).
   */
  .site-doodle--tl {
    top: 150px;
    left: max(6px, calc(50% - 640px));
  }
  .site-doodle--tr {
    /* Below RTL brand/logo hit-box (~32–130) and basad */
    top: 168px;
    right: max(6px, calc(50% - 640px));
  }
  .site-doodle--bl {
    bottom: 80px;
    left: max(6px, calc(50% - 640px));
  }
  .site-doodle--br {
    bottom: 100px;
    right: max(6px, calc(50% - 640px));
  }
  /* Mid slots unused by selector but keep as extreme edges if ever assigned */
  .site-doodle--ml {
    top: 40%;
    left: max(6px, calc(50% - 640px));
  }
  .site-doodle--mr {
    top: 46%;
    right: max(6px, calc(50% - 640px));
  }

  /*
   * ≤1200 / mobile: gutters gone — show ALL selected motifs in a clear
   * in-flow row (KIMI-ANIM-6: do not hide gutter-only on small screens).
   * Sized to read at 390px; float kept; never covers page text/buttons.
   */
  @media (max-width: 1200px) {
    .site-doodles {
      position: relative !important;
      inset: auto !important;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 14px 18px;
      height: auto;
      min-height: 148px;
      width: 100%;
      z-index: 0;
      margin: 8px 0 12px;
      padding: 10px 12px;
      overflow: visible;
      pointer-events: none;
    }
    .site-doodle--gutter-only {
      display: block !important;
    }
    .site-doodle,
    .site-doodle--strip,
    .site-doodle--gutter-only {
      position: relative !important;
      width: clamp(120px, 30vw, 150px) !important;
      max-width: 150px !important;
      height: auto !important;
      opacity: 0.92;
      top: auto !important;
      bottom: auto !important;
      left: auto !important;
      right: auto !important;
    }
  }
  @media (max-width: 640px) {
    .site-doodles {
      min-height: 132px;
      gap: 10px 14px;
      padding: 8px 10px;
    }
    .site-doodle,
    .site-doodle--strip,
    .site-doodle--gutter-only {
      width: clamp(112px, 34vw, 140px) !important;
      max-width: 140px !important;
    }
  }

  @media print {
    .site-doodles {
      display: none !important;
    }
  }
</style>
