---
/**
 * Full-page edge-margin doodles (home + every BaseLayout page).
 * Fixed L/R columns, φ vertical spacing, half-bleed off the edge
 * (parent clips — no horizontal scroll). Animated bob+wobble.
 * Mobile: thin 24–36px edges, half tucked, never over text.
 */
import { selectDenseMargins } from '../lib/doodles/selectDenseMargins';
import type { DoodleMotif } from '../lib/doodles/selectSiteDoodles';
import manifest from '../data/doodles.manifest.json';

const pathname = Astro.url.pathname;
const motifs = (manifest.motifs || []) as DoodleMotif[];
const placements =
  motifs.length === 0 ? [] : selectDenseMargins(pathname, motifs);
---

{
  placements.length > 0 && (
    <div
      class="site-doodles"
      aria-hidden="true"
      data-site-doodles
      data-site-doodles-edges
      data-path={pathname}
    >
      {placements.map((p) => (
        <img
          class:list={[
            'site-doodle',
            'site-doodle--float',
            p.side === 'start' ? 'site-doodle--start' : 'site-doodle--end',
          ]}
          src={p.src}
          alt=""
          width={p.sizePx}
          height={p.sizePx}
          decoding="async"
          loading="lazy"
          data-doodle-id={p.id}
          data-doodle-side={p.side}
          style={[
            `top:${p.topPct}%`,
            `--d-size:${Math.round(p.sizePx * p.scale)}px`,
            `--m-size:${p.mobileSizePx}px`,
            `--doodle-rotate:${p.rotate}deg`,
            `--doodle-op:${p.opacity}`,
            `--doodle-delay:${p.delay}s`,
            `--doodle-dur:${p.duration}s`,
            `--doodle-bob:${p.bobPx}px`,
            `--doodle-wobble:${p.wobbleDeg}deg`,
          ].join(';')}
        />
      ))}
    </div>
  )
}

<style>
  /*
   * Fixed edge layer — clips bleed so half-off doodles never cause H-scroll.
   * z-index 0: behind text/CTAs (content is relative z-1+).
   */
  .site-doodles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    overflow: hidden; /* clip the bleed */
  }

  .site-doodle {
    position: absolute;
    display: block;
    width: var(--d-size, 96px);
    max-width: min(160px, 12vw);
    height: auto;
    opacity: var(--doodle-op, 0.75);
    transform: translateY(-50%) rotate(var(--doodle-rotate, 0deg));
    transform-origin: center center;
    left: auto;
    right: auto;
    /* Center on top% so φ bands sit correctly */
    margin-top: 0;
  }

  /* Bleed ~40% off the page edge (logical for RTL) */
  .site-doodle--start {
    inset-inline-start: -36px;
    inset-inline-end: auto;
  }
  .site-doodle--end {
    inset-inline-end: -36px;
    inset-inline-start: auto;
  }

  .site-doodle--float {
    animation: site-doodle-bob-wobble var(--doodle-dur, 6.5s) ease-in-out infinite;
    animation-delay: var(--doodle-delay, 0s);
    will-change: transform;
  }

  @keyframes site-doodle-bob-wobble {
    0%,
    100% {
      transform: translateY(-50%) translateY(0)
        rotate(calc(var(--doodle-rotate, 0deg) - var(--doodle-wobble, 4deg)));
    }
    50% {
      transform: translateY(-50%) translateY(calc(-1 * var(--doodle-bob, 6px)))
        rotate(calc(var(--doodle-rotate, 0deg) + var(--doodle-wobble, 4deg)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-doodle--float {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .site-doodle--float,
  :global(html.nd-motion-off) .site-doodle--float {
    animation: none !important;
  }

  /* Mid widths: keep edge gutters (no flex strip) — slightly less bleed */
  @media (max-width: 1200px) {
    .site-doodle--start {
      inset-inline-start: -28px;
    }
    .site-doodle--end {
      inset-inline-end: -28px;
    }
    .site-doodle {
      max-width: min(120px, 14vw);
    }
  }

  /*
   * Mobile: thin side edges, 24–36px, ~half tucked off-screen.
   * Stay behind text (z-0); never cover tap targets.
   */
  @media (max-width: 767px) {
    .site-doodle {
      width: var(--m-size, 28px) !important;
      max-width: 36px !important;
      opacity: calc(var(--doodle-op, 0.7) * 0.9);
    }
    .site-doodle--start {
      inset-inline-start: -14px;
    }
    .site-doodle--end {
      inset-inline-end: -14px;
    }
  }

  @media print {
    .site-doodles {
      display: none !important;
    }
  }
</style>
