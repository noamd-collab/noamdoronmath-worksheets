---
/**
 * DOODLES-45 / KIMI-ANIM-6 — dense notebook margin columns.
 * Uses ALL catalog motifs in alternating start/end gutters (desktop)
 * and a dense in-flow wrap on ≤1200 tablet. Hidden ≤767 (section scatters).
 * EVERY gutter doodle bobs+wobbles; off under reduced-motion / a11y.
 */
import { selectDenseMargins } from '../lib/doodles/selectDenseMargins';
import type { DoodleMotif } from '../lib/doodles/selectSiteDoodles';
import manifest from '../data/doodles.manifest.json';

const pathname = Astro.url.pathname;
const motifs = (manifest.motifs || []) as DoodleMotif[];
const placements =
  motifs.length === 0
    ? []
    : selectDenseMargins(pathname, motifs, { mobileCount: 4 });
---

{
  placements.length > 0 && (
    <div
      class="site-doodles"
      aria-hidden="true"
      data-site-doodles
      data-site-doodles-dense
      data-path={pathname}
    >
      {placements.map((p) => (
        <img
          class:list={[
            'site-doodle',
            'site-doodle--float',
            p.side === 'start' ? 'site-doodle--start' : 'site-doodle--end',
            p.mobileVisible ? 'site-doodle--strip' : 'site-doodle--gutter-only',
          ]}
          src={p.src}
          alt=""
          width={p.sizePx}
          height={p.sizePx}
          decoding="async"
          loading="lazy"
          data-doodle-id={p.id}
          data-doodle-side={p.side}
          style={[
            `top:${p.topPct}%`,
            `width:${Math.round(p.sizePx * p.scale)}px`,
            `--doodle-rotate:${p.rotate}deg`,
            `--doodle-op:${p.opacity}`,
            `--doodle-delay:${p.delay}s`,
            `--doodle-dur:${p.duration}s`,
            `--doodle-bob:${p.bobPx}px`,
            `--doodle-wobble:${p.wobbleDeg}deg`,
          ].join(';')}
        />
      ))}
    </div>
  )
}

<style>
  .site-doodles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    overflow: visible;
  }

  .site-doodle {
    position: absolute;
    display: block;
    height: auto;
    max-width: min(200px, 14vw);
    opacity: var(--doodle-op, 0.88);
    transform: translateY(0) rotate(var(--doodle-rotate, 0deg));
    transform-origin: center center;
    /* reset physical sides — RTL-safe logical placement below */
    left: auto;
    right: auto;
  }
  /* Outside ~1100px content shell — logical margins for RTL Hebrew */
  .site-doodle--start {
    inset-inline-start: max(4px, calc(50% - 640px));
    inset-inline-end: auto;
  }
  .site-doodle--end {
    inset-inline-end: max(4px, calc(50% - 640px));
    inset-inline-start: auto;
  }
  .site-doodle--float {
    animation: site-doodle-bob-wobble var(--doodle-dur, 6.5s) ease-in-out infinite;
    animation-delay: var(--doodle-delay, 0s);
    will-change: transform;
  }

  @keyframes site-doodle-bob-wobble {
    0%,
    100% {
      transform: translateY(0)
        rotate(calc(var(--doodle-rotate, 0deg) - var(--doodle-wobble, 4deg)));
    }
    50% {
      transform: translateY(calc(-1 * var(--doodle-bob, 6px)))
        rotate(calc(var(--doodle-rotate, 0deg) + var(--doodle-wobble, 4deg)));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-doodle--float {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .site-doodle--float,
  :global(html.nd-motion-off) .site-doodle--float {
    animation: none !important;
  }

  /*
   * ≤1200 tablet: dense in-flow wrap — show every motif (notebook density).
   * Phones (≤767): hidden — organic absolute scatters live in page sections
   * (HomeSectionDoodle / MobileNotebookCorners). No neat flex/grid strip.
   */
  @media (max-width: 1200px) {
    .site-doodles {
      position: relative !important;
      inset: auto !important;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px 12px;
      height: auto;
      min-height: 96px;
      width: 100%;
      z-index: 0;
      margin: 6px 0 10px;
      padding: 8px 10px;
      overflow: visible;
    }
    .site-doodle--gutter-only {
      display: block !important;
    }
    .site-doodle,
    .site-doodle--strip,
    .site-doodle--gutter-only,
    .site-doodle--start,
    .site-doodle--end {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      inset: auto !important;
      width: clamp(64px, 18vw, 96px) !important;
      max-width: 96px !important;
    }
  }
  /* Phone: kill the header strip — section scatters own the notebook look */
  @media (max-width: 767px) {
    .site-doodles {
      display: none !important;
    }
  }

  @media print {
    .site-doodles {
      display: none !important;
    }
  }
</style>
