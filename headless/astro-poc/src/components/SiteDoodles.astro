---
/**
 * DOODLES-45 / KIMI-ANIM-6 — dense notebook margin columns.
 * Uses ALL catalog motifs in alternating start/end gutters (desktop)
 * and a dense in-flow wrap on ≤1200 / mobile. Homepage included.
 * Subset floats; off under reduced-motion / noam-a11y-motion.
 */
import { selectDenseMargins } from '../lib/doodles/selectDenseMargins';
import type { DoodleMotif } from '../lib/doodles/selectSiteDoodles';
import manifest from '../data/doodles.manifest.json';

const pathname = Astro.url.pathname;
const motifs = (manifest.motifs || []) as DoodleMotif[];
const placements =
  motifs.length === 0 ? [] : selectDenseMargins(pathname, motifs, { mobileCount: 6 });
---

{
  placements.length > 0 && (
    <div
      class="site-doodles"
      aria-hidden="true"
      data-site-doodles
      data-site-doodles-dense
      data-path={pathname}
    >
      {placements.map((p) => (
        <img
          class:list={[
            'site-doodle',
            `site-doodle--${p.side}`,
            p.mobileVisible ? 'site-doodle--strip' : 'site-doodle--gutter-only',
            p.float ? 'site-doodle--float' : null,
          ]}
          src={p.src}
          alt=""
          width={p.sizePx}
          height={p.sizePx}
          decoding="async"
          loading="lazy"
          data-doodle-id={p.id}
          data-doodle-side={p.side}
          style={`--doodle-size:${p.sizePx}px;--doodle-scale:${p.scale};--doodle-rotate:${p.rotate}deg;--doodle-top:${p.topPct}%;--doodle-op:${p.opacity};--doodle-delay:${p.delay}s`}
        />
      ))}
    </div>
  )
}

<style>
  .site-doodles {
    position: fixed;
    inset: 0;
    pointer-events: none;
    user-select: none;
    z-index: 1;
    overflow: hidden;
  }

  .site-doodle {
    position: absolute;
    display: block;
    width: calc(var(--doodle-size, 140px) * var(--doodle-scale, 1));
    max-width: 200px;
    height: auto;
    opacity: var(--doodle-op, 0.88);
    top: var(--doodle-top, 20%);
    transform: translateY(0) rotate(var(--doodle-rotate, 0deg));
    transform-origin: center center;
  }
  /* Outside ~1100px content shell */
  .site-doodle--start {
    left: max(4px, calc(50% - 640px));
    right: auto;
  }
  .site-doodle--end {
    right: max(4px, calc(50% - 640px));
    left: auto;
  }
  .site-doodle--float {
    animation: site-doodle-float 7.4s ease-in-out infinite;
    animation-delay: var(--doodle-delay, 0s);
    will-change: transform;
  }

  @keyframes site-doodle-float {
    0%,
    100% {
      transform: translateY(0) rotate(var(--doodle-rotate, 0deg));
    }
    50% {
      transform: translateY(-12px) rotate(var(--doodle-rotate, 0deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .site-doodle--float {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .site-doodle--float {
    animation: none !important;
  }

  /*
   * ≤1200 / mobile: dense in-flow wrap — ALL strip-visible motifs,
   * gutter-only also shown (notebook density on small screens too).
   */
  @media (max-width: 1200px) {
    .site-doodles {
      position: relative !important;
      inset: auto !important;
      display: flex;
      flex-wrap: wrap;
      justify-content: center;
      align-items: center;
      gap: 8px 12px;
      height: auto;
      min-height: 120px;
      width: 100%;
      z-index: 0;
      margin: 6px 0 10px;
      padding: 8px 10px;
      overflow: visible;
    }
    .site-doodle--gutter-only {
      display: block !important;
    }
    .site-doodle,
    .site-doodle--strip,
    .site-doodle--gutter-only {
      position: relative !important;
      top: auto !important;
      left: auto !important;
      right: auto !important;
      width: clamp(72px, 22vw, 110px) !important;
      max-width: 110px !important;
    }
  }
  @media (max-width: 640px) {
    .site-doodles {
      min-height: 100px;
      gap: 6px 8px;
      padding: 6px 8px;
    }
    .site-doodle,
    .site-doodle--strip,
    .site-doodle--gutter-only {
      width: clamp(64px, 26vw, 96px) !important;
      max-width: 96px !important;
    }
  }

  @media print {
    .site-doodles {
      display: none !important;
    }
  }
</style>
