---
/**
 * Design v2 home FX: tile interactions + auto 2.6s, sleeping-cat ZZZ,
 * boat waves, WA boat idle, learning-card plane. Honors motion modes.
 */
---
<script>
  import { readMotionMode, motionSlowFactor } from '../lib/design/motionMode';

  type BusyAnchor = HTMLAnchorElement & { __tbusy?: boolean };

  function meowSound() {
    try {
      const AC = window.AudioContext || (window as unknown as { webkitAudioContext: typeof AudioContext }).webkitAudioContext;
      const C = new AC();
      const t = C.currentTime;
      const o = C.createOscillator();
      const f = C.createBiquadFilter();
      const g = C.createGain();
      o.type = 'sawtooth';
      f.type = 'bandpass';
      f.Q.value = 3;
      o.frequency.setValueAtTime(520, t);
      o.frequency.linearRampToValueAtTime(880, t + 0.12);
      o.frequency.linearRampToValueAtTime(760, t + 0.3);
      o.frequency.exponentialRampToValueAtTime(420, t + 0.55);
      f.frequency.setValueAtTime(900, t);
      f.frequency.linearRampToValueAtTime(1800, t + 0.15);
      f.frequency.linearRampToValueAtTime(700, t + 0.55);
      g.gain.setValueAtTime(0, t);
      g.gain.linearRampToValueAtTime(0.18, t + 0.05);
      g.gain.linearRampToValueAtTime(0.12, t + 0.3);
      g.gain.exponentialRampToValueAtTime(0.001, t + 0.6);
      o.connect(f);
      f.connect(g);
      g.connect(C.destination);
      o.start(t);
      o.stop(t + 0.62);
    } catch {
      /* ignore */
    }
  }

  function tileTouch(a: BusyAnchor, l: string) {
    if (!a || a.__tbusy || readMotionMode() === 'כבוי') return;
    const img = a.querySelector('[data-tileimg]') as HTMLElement | null;
    let an: Animation | null = null;

    if (l === 'ב׳') {
      const lid = a.querySelector('[data-wink]');
      if (lid)
        an = lid.animate(
          [
            { transform: 'scaleY(0)' },
            { transform: 'scaleY(1)', offset: 0.25 },
            { transform: 'scaleY(1)', offset: 0.6 },
            { transform: 'scaleY(0)' },
          ],
          { duration: 520, easing: 'ease-in-out' }
        );
      img?.animate(
        [{ transform: 'none' }, { transform: 'rotate(-4deg)', offset: 0.4 }, { transform: 'none' }],
        { duration: 520, easing: 'ease-in-out' }
      );
    }
    if (l === 'ג׳') {
      const b = a.querySelector('[data-meow]');
      if (b)
        an = b.animate(
          [
            { opacity: 0, transform: 'scale(.4) rotate(-8deg)' },
            { opacity: 1, transform: 'scale(1.08) rotate(3deg)', offset: 0.15 },
            { opacity: 1, transform: 'scale(1) rotate(0)', offset: 0.25 },
            { opacity: 1, transform: 'scale(1)', offset: 0.8 },
            { opacity: 0, transform: 'scale(.9) translateY(-6px)' },
          ],
          { duration: 1300, easing: 'ease-out' }
        );
      img?.animate(
        [
          { transform: 'none' },
          { transform: 'translateY(-4px) scale(1.04,.97)', offset: 0.15 },
          { transform: 'none', offset: 0.35 },
        ],
        { duration: 1300 }
      );
    }
    if (l === 'ד׳' && img) {
      an = img.animate(
        [
          { transform: 'none' },
          { transform: 'translate(-6px,-40px) rotate(-10deg)', offset: 0.3 },
          { transform: 'translate(8px,-90px) rotate(8deg)', offset: 0.55 },
          { transform: 'translate(-4px,-60px) rotate(-6deg)', offset: 0.75 },
          { transform: 'none' },
        ],
        { duration: 1600, easing: 'cubic-bezier(.45,.05,.35,1)' }
      );
    }
    if (l === 'ה׳' && img) {
      img.animate(
        [
          { transform: 'none' },
          { transform: 'scale(1.1) rotate(-3deg)', offset: 0.15 },
          { transform: 'scale(1.1) rotate(-3deg)', offset: 0.5 },
          { transform: 'none', offset: 0.7 },
          { transform: 'none' },
        ],
        { duration: 2200, easing: 'ease-in-out' }
      );
      const lid = a.querySelector('[data-wink]');
      lid?.animate(
        [
          { transform: 'scaleY(0)' },
          { transform: 'scaleY(1)', offset: 0.3 },
          { transform: 'scaleY(1)', offset: 0.6 },
          { transform: 'scaleY(0)' },
        ],
        { duration: 520, delay: 520, easing: 'ease-in-out' }
      );
      const bs = [...a.querySelectorAll('[data-bub]')];
      const P: [number, number][] = [
        [-6, -58],
        [4, -80],
        [-10, -44],
      ];
      bs.forEach((b, i) => {
        const [dx, dy] = P[i];
        const x = b.animate(
          [
            { opacity: 0, transform: 'translate(0,0) scale(.3)' },
            {
              opacity: 1,
              transform: `translate(${-3 + dx * 0.3}px,${dy * 0.3}px) scale(1)`,
              offset: 0.25,
            },
            {
              opacity: 0.9,
              transform: `translate(${dx}px,${dy * 0.7}px) scale(1.1)`,
              offset: 0.7,
            },
            {
              opacity: 0,
              transform: `translate(${dx * 0.6}px,${dy}px) scale(1.2)`,
            },
          ],
          { duration: 1100, delay: 1150 + i * 180, easing: 'ease-out' }
        );
        if (i === bs.length - 1) an = x;
      });
    }
    if (l === 'ו׳') {
      const ice = a.querySelector('[data-ice]');
      const pd = a.querySelector('[data-puddle]');
      const T = 4200;
      if (ice)
        an = ice.animate(
          [{ opacity: 0 }, { opacity: 1, offset: 0.1 }, { opacity: 1, offset: 0.7 }, { opacity: 0 }],
          { duration: T, easing: 'ease-in-out' }
        );
      img?.animate(
        [
          { transform: 'none' },
          { transform: 'scale(1.03,.98)', offset: 0.06 },
          { transform: 'translateX(-1px)', offset: 0.09 },
          { transform: 'translateX(1px)', offset: 0.12 },
          { transform: 'none', offset: 0.15 },
          { transform: 'none' },
        ],
        { duration: T }
      );
      a.querySelectorAll('[data-drop]').forEach((d, i) =>
        d.animate(
          [
            { opacity: 0, transform: 'translateY(0) scale(.5)' },
            { opacity: 1, transform: 'translateY(0) scale(1)', offset: 0.3 },
            { opacity: 1, transform: 'translateY(14px) scale(1,1.2)', offset: 0.8 },
            { opacity: 0, transform: 'translateY(20px) scale(1.4,.6)' },
          ],
          { duration: 800, delay: 700 + i * 260, iterations: 3, easing: 'ease-in' }
        )
      );
      pd?.animate(
        [
          { opacity: 0, transform: 'scaleX(0)' },
          { opacity: 0, transform: 'scaleX(0)', offset: 0.2 },
          { opacity: 1, transform: 'scaleX(1)', offset: 0.75 },
          { opacity: 0, transform: 'scaleX(1.1)' },
        ],
        { duration: T, easing: 'ease-out' }
      );
    }
    if (l === 'mid') {
      const T = 3200;
      const lamp = a.querySelector('[data-lamp]');
      const sm = a.querySelector('[data-smoke]');
      const gb = a.querySelector('[data-gbody]');
      const arms = a.querySelector('[data-garms]');
      lamp?.animate(
        [
          { transform: 'none' },
          { transform: 'rotate(-6deg)', offset: 0.04 },
          { transform: 'rotate(6deg)', offset: 0.08 },
          { transform: 'rotate(-4deg)', offset: 0.12 },
          { transform: 'none', offset: 0.16 },
          { transform: 'none', offset: 0.86 },
          { transform: 'scale(1.08)', offset: 0.92 },
          { transform: 'none' },
        ],
        { duration: T }
      );
      sm?.animate(
        [
          { strokeDashoffset: 1, opacity: 0.9 },
          { strokeDashoffset: 1, offset: 0.06 },
          { strokeDashoffset: 0, opacity: 0.9, offset: 0.22 },
          { strokeDashoffset: 0, opacity: 0, offset: 0.36 },
          { strokeDashoffset: 0, opacity: 0, offset: 0.8 },
          { strokeDashoffset: 0, opacity: 0.8, offset: 0.86 },
          { strokeDashoffset: -1, opacity: 0 },
        ],
        { duration: T, easing: 'ease-out' }
      );
      if (gb)
        an = gb.animate(
          [
            { opacity: 0, transform: 'translateY(18px) scale(.1) rotate(-30deg)' },
            {
              opacity: 0,
              transform: 'translateY(18px) scale(.1) rotate(-30deg)',
              offset: 0.15,
            },
            {
              opacity: 1,
              transform: 'translateY(-4px) scale(1.12) rotate(6deg)',
              offset: 0.3,
            },
            { opacity: 1, transform: 'translateY(0) scale(1) rotate(0)', offset: 0.38 },
            {
              opacity: 1,
              transform: 'translateY(-4px) scale(1) rotate(-2deg)',
              offset: 0.55,
            },
            { opacity: 1, transform: 'translateY(0) scale(1) rotate(2deg)', offset: 0.72 },
            { opacity: 1, transform: 'translateY(0) scale(1)', offset: 0.8 },
            { opacity: 0, transform: 'translateY(20px) scale(.08,.3) rotate(40deg)' },
          ],
          { duration: T, easing: 'ease-in-out' }
        );
      arms?.animate(
        [
          { transform: 'none' },
          { transform: 'none', offset: 0.38 },
          { transform: 'rotate(-8deg)', offset: 0.46 },
          { transform: 'rotate(8deg)', offset: 0.54 },
          { transform: 'rotate(-8deg)', offset: 0.62 },
          { transform: 'none', offset: 0.7 },
          { transform: 'none' },
        ],
        { duration: T }
      );
      a.querySelectorAll('[data-geye]').forEach((e) =>
        e.animate(
          [
            { transform: 'scaleY(1)' },
            { transform: 'scaleY(1)', offset: 0.6 },
            { transform: 'scaleY(.1)', offset: 0.63 },
            { transform: 'scaleY(1)', offset: 0.66 },
            { transform: 'scaleY(1)' },
          ],
          { duration: T }
        )
      );
      a.querySelectorAll('[data-gspark] circle').forEach((c, i) =>
        c.animate(
          [
            { opacity: 0, transform: 'scale(0)' },
            { opacity: 0, offset: 0.26 + i * 0.03 },
            { opacity: 1, transform: 'scale(1.4)', offset: 0.34 + i * 0.03 },
            { opacity: 0, transform: 'scale(0)', offset: 0.5 + i * 0.03 },
            { opacity: 0 },
          ],
          { duration: T }
        )
      );
      a.querySelectorAll('[data-geye], [data-gspark] circle').forEach((e) => {
        const he = e as HTMLElement;
        he.style.transformBox = 'fill-box';
        he.style.transformOrigin = 'center';
      });
    }
    if (an) {
      a.__tbusy = true;
      an.onfinish = () => {
        a.__tbusy = false;
      };
    }
  }

  function flyPlane(p: HTMLElement | null, slow: number) {
    if (!p || (p as HTMLElement & { __fly?: boolean }).__fly) return;
    (p as HTMLElement & { __fly?: boolean }).__fly = true;
    const segs: [number, number][][] = [
      [
        [0, 0],
        [40, -18.6],
        [95, -30],
        [120, -5],
      ],
      [
        [120, -5],
        [140, 15],
        [120, 50],
        [90, 40],
      ],
      [
        [90, 40],
        [60, 30],
        [70, -10],
        [120, -25],
      ],
      [
        [120, -25],
        [200, -50],
        [320, -40],
        [460, -110],
      ],
    ];
    const bz = (a: number[], b: number[], c: number[], d: number[], t: number) => {
      const u = 1 - t;
      return [0, 1].map(
        (k) => u * u * u * a[k] + 3 * u * u * t * b[k] + 3 * u * t * t * c[k] + t * t * t * d[k]
      );
    };
    const dz = (a: number[], b: number[], c: number[], d: number[], t: number) => {
      const u = 1 - t;
      return [0, 1].map(
        (k) =>
          3 * u * u * (b[k] - a[k]) + 6 * u * t * (c[k] - b[k]) + 3 * t * t * (d[k] - c[k])
      );
    };
    const N = 18;
    const FL = 0.7;
    const kf: Keyframe[] = [];
    segs.forEach((s, si) => {
      for (let i = si ? 1 : 0; i <= N; i++) {
        const t = i / N;
        const [x, y] = bz(s[0], s[1], s[2], s[3], t);
        const [dx, dy] = dz(s[0], s[1], s[2], s[3], t);
        const ang = (Math.atan2(dy, dx) * 180) / Math.PI + 25;
        const o = ((si + t) / segs.length) * FL;
        kf.push({
          transform: `translate(${x.toFixed(1)}px,${y.toFixed(1)}px) rotate(${ang.toFixed(1)}deg)`,
          opacity: o > FL - 0.04 ? Math.max(0, (FL - o) / 0.04) : 1,
          offset: +o.toFixed(4),
        });
      }
    });
    kf[0].transform = 'none';
    kf.push(
      { transform: 'none', opacity: 0, offset: 0.72 },
      { transform: 'none', opacity: 0, offset: 0.9 },
      { transform: 'none', opacity: 1, offset: 1 }
    );
    p.style.transformOrigin = 'center';
    p.animate(kf, { duration: 9000 * slow, iterations: Infinity, delay: 1200, easing: 'linear' });
  }

  function boot() {
    const root = document.querySelector('[data-home-page]');
    if (!root) return;
    if (readMotionMode() === 'כבוי') return;
    const slow = motionSlowFactor();

    root.querySelectorAll<HTMLElement>('[data-zzz]').forEach((zz) => {
      zz.animate(
        [
          { opacity: 0, transform: 'translate(0,6px) scale(.6)' },
          { opacity: 1, transform: 'translate(3px,0) scale(1)', offset: 0.3 },
          { opacity: 1, transform: 'translate(8px,-8px) rotate(-8deg)', offset: 0.7 },
          { opacity: 0, transform: 'translate(12px,-16px) rotate(-12deg) scale(1.1)' },
        ],
        {
          duration: 2400 * slow,
          delay: +(zz.dataset.zzz || 0) * 600 * slow,
          iterations: Infinity,
          easing: 'ease-out',
        }
      );
    });

    root.querySelectorAll('[data-water]').forEach((w) => {
      w.firstElementChild?.animate([{ transform: 'translateX(0)' }, { transform: 'translateX(-50%)' }], {
        duration: 2600 * slow,
        iterations: Infinity,
      });
      (w.parentElement as HTMLElement | null)?.animate(
        [{ backgroundPosition: '0px 0px' }, { backgroundPosition: '0px -2px' }],
        { duration: 1300 * slow, iterations: Infinity, direction: 'alternate', easing: 'ease-in-out' }
      );
    });

    const waBoat = root.querySelector('[data-doodle="boat"]') as HTMLElement | null;
    if (waBoat) {
      waBoat.style.transformOrigin = 'center bottom';
      waBoat.animate(
        [
          { transform: 'translate(0,0) rotate(-3deg)' },
          { transform: 'translate(18px,-6px) rotate(3deg)', offset: 0.25 },
          { transform: 'translate(36px,0) rotate(-3deg)', offset: 0.5 },
          { transform: 'translate(54px,-6px) rotate(3deg)', offset: 0.75 },
          { transform: 'translate(70px,0) rotate(-2deg)' },
        ],
        {
          duration: 6000 * slow,
          iterations: Infinity,
          direction: 'alternate',
          easing: 'ease-in-out',
        }
      );
    }

    const learnPlane = root.querySelector('[data-plane]') as HTMLElement | null;
    flyPlane(learnPlane, slow);

    const underline = root.querySelector('[data-grades-wave]') as SVGPathElement | null;
    underline?.animate([{ strokeDashoffset: 1 }, { strokeDashoffset: 0 }], {
      duration: 700 * slow,
      delay: 500 * slow,
      fill: 'forwards',
      easing: 'ease-out',
    });

    root.querySelectorAll<BusyAnchor>('a[data-tl]').forEach((a) => {
      const l = a.dataset.tl || '';
      a.addEventListener('mouseenter', () => tileTouch(a, l));
      a.addEventListener(
        'touchstart',
        () => tileTouch(a, l),
        { passive: true }
      );
      if (l === 'ג׳') {
        a.addEventListener('click', () => meowSound());
      }
    });

    let tileI = 0;
    setInterval(() => {
      if (document.hidden || readMotionMode() === 'כבוי') return;
      const ts = [...root.querySelectorAll<BusyAnchor>('a[data-tl]')].filter((a) => {
        if (a.dataset.tl === 'א׳' || a.__tbusy) return false;
        const b = a.getBoundingClientRect();
        return b.top < innerHeight - 40 && b.bottom > 60;
      });
      if (!ts.length) return;
      tileI = (tileI + 1) % ts.length;
      const a = ts[tileI];
      tileTouch(a, a.dataset.tl || '');
    }, 2600);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
</script>
