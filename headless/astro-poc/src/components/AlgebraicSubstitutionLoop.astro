---
/**
 * Grade 7 algebraic-substitution lesson.
 * The examples, pacing, and controls stay in
 * public/loops/algebraic-substitution-grade-7.html.
 * This wrapper only frames that file in the topic demo slot.
 * It does not press Play: the lesson stays paused until the student starts it.
 */
interface Props {
  src: string;
  marker: string;
}
const { src, marker } = Astro.props;
const frameSrc = `${src}?embed=1`;
---

<div class="substitution-loop" data-substitution-loop data-landing-loop={marker}>
  <iframe
    class="substitution-loop__frame"
    src={frameSrc}
    title="בודקים שוויון בהצבה"
    loading="eager"
    scrolling="no"
    data-substitution-frame
  ></iframe>
</div>

<script>
  function boot(root) {
    const frame = root.querySelector('[data-substitution-frame]');
    if (!frame) return;

    function fit() {
      let doc;
      try { doc = frame.contentDocument; } catch { return; }
      const main = doc?.querySelector('main');
      if (!main) return;
      const h = Math.ceil(main.getBoundingClientRect().height);
      if (h > 200 && Math.abs(frame.clientHeight - h) > 2) frame.style.height = `${h}px`;
    }

    function motionOff() {
      const html = document.documentElement;
      return window.matchMedia('(prefers-reduced-motion: reduce)').matches
        || html.classList.contains('nd-motion-off')
        || html.classList.contains('noam-a11y-motion');
    }

    function holdStill() {
      if (!motionOff()) return;
      try { frame.contentWindow?.substitutionLesson?.pause?.(); } catch { return; }
    }

    let watching = false;
    function onReady() {
      let doc;
      try { doc = frame.contentDocument; } catch { return; }
      if (!doc?.querySelector('main')) return;
      fit();
      holdStill();
      if (watching || !('ResizeObserver' in window)) return;
      watching = true;
      const observer = new ResizeObserver(fit);
      observer.observe(frame);
      if (doc.body) observer.observe(doc.body);
    }

    frame.addEventListener('load', onReady);
    onReady();

    new MutationObserver(() => { holdStill(); fit(); }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }

  document.querySelectorAll('[data-substitution-loop]').forEach(boot);
</script>

<style>
  .substitution-loop {
    display: block;
    width: 100%;
    min-width: 0;
    container-type: inline-size;
    background: #fbfaf5;
  }
  .substitution-loop__frame {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
    background: #fbfaf5;
    /* Phone target before the lesson reports its own height. */
    height: 800px;
    min-height: 320px;
    overflow: hidden;
  }
  @container (min-width: 720px) {
    .substitution-loop__frame { height: 560px; }
  }
</style>
