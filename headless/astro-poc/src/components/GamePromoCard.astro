---
import { PUBLIC_LESSON_PATH } from '../lib/publicLesson';
import { PYTHAGORAS_GAME_PATH } from '../lib/pythagorasGame';
---
<section class="exact-game-promo">
  <a class="exact-game-promo__card" href={PUBLIC_LESSON_PATH} data-home-game-promo>
    <span class="exact-game-promo__shot exact-game-promo__shot--kefel">
      <img
        src="/games/kefel-mekutsar-card.webp"
        width="960"
        height="508"
        alt="ריבוע (a−b)² מהמשחק, מחולק ל־(a−b)² ולמלבני החיסור"
        hidden
      />
      <svg class="exact-game-promo__mark exact-formula-new__svg" viewBox="0 0 402 320" aria-hidden="true" focusable="false">
        <rect x="88" y="42" width="240" height="240" rx="11" fill="#fff" stroke="#17233f" stroke-width="2.5"></rect>
        <rect x="93.5" y="47.5" width="144" height="144" rx="6" fill="#1a8a80"></rect>
        <text class="exact-tile-label" x="165" y="120" fill="#fff">(a−b)²</text>
        <rect x="240.5" y="47.5" width="82" height="144" rx="6" fill="#f0b429"></rect>
        <text class="exact-tile-label exact-tile-label--mid" x="281" y="120" fill="#222e44">b(a−b)</text>
        <rect x="93.5" y="194.5" width="144" height="82" rx="6" fill="#f0b429"></rect>
        <text class="exact-tile-label exact-tile-label--mid" x="165" y="236" fill="#222e44">b(a−b)</text>
        <rect x="240.5" y="194.5" width="82" height="82" rx="6" fill="#e8684a"></rect>
        <text class="exact-tile-label" x="281" y="236" fill="#17233f">b²</text>
        <text x="208" y="22" fill="#22305a" style="font-size:18px;font-weight:700">(a−b)² = a² − 2ab + b²</text>
      </svg>
    </span>
    <span class="exact-game-promo__copy">
      <span class="exact-game-promo__badge">חדש!</span>
      <h2 class="exact-game-promo__title">נסו את המשחק החדש!</h2>
      <p class="exact-game-promo__text">נוסחת הכפל המקוצר השנייה <bdi dir="ltr">(a−b)²</bdi>, עם אליהו. אהבתם?</p>
      <span class="exact-game-promo__go">למשחק</span>
    </span>
  </a>
  <div class="exact-game-promo__slot" id="pythagoras-promo" data-pop="160">
    <a class="exact-game-promo__card exact-game-promo__card--beta" href={PYTHAGORAS_GAME_PATH} data-home-pythagoras-promo>
      <span class="exact-game-promo__shot" aria-hidden="true">
        <svg class="exact-game-promo__mark exact-pyth exact-live-pop" viewBox="48 -28 316 364" aria-hidden="true" focusable="false">
          <g fill="none" stroke-linecap="round" stroke-width="1.6">
            <path d="M80 96V168 M76 96H84 M76 168H84" stroke="#1a8a80"></path>
            <path d="M168 282H264 M168 278V286 M264 278V286" stroke="#e8684a"></path>
            <path d="M247.2 -9.6L343.2 62.4 M244.8 -6.4L249.6 -12.8 M340.8 65.6L345.6 59.2" stroke="#334155"></path>
          </g>
          <g class="exact-dim-pill" transform="rotate(-90 69 132)">
            <rect x="48" y="123" width="42" height="18" rx="6"></rect>
            <text class="exact-dim" x="69" y="132" fill="#1a8a80">a=3</text>
          </g>
          <g class="exact-dim-pill">
            <rect x="195" y="273" width="42" height="18" rx="6"></rect>
            <text class="exact-dim" x="216" y="282" fill="#a84434">b=4</text>
          </g>
          <g class="exact-dim-pill" transform="rotate(36.87 295.2 26.4)">
            <rect x="274.2" y="17.4" width="42" height="18" rx="6"></rect>
            <text class="exact-dim" x="295.2" y="26.4" fill="#334155">c=5</text>
          </g>
          <g class="exact-pyth-a">
            <rect x="96" y="96" width="72" height="72" rx="5" fill="#fff" stroke="#17233f" stroke-width="1.6"></rect>
            <rect x="98" y="98" width="68" height="68" rx="4" fill="#1a8a80"></rect>
            <text x="132" y="132" fill="#fff">a² = 9</text>
          </g>
          <g class="exact-pyth-b">
            <rect x="168" y="168" width="96" height="96" rx="5" fill="#fff" stroke="#17233f" stroke-width="1.6"></rect>
            <rect x="170" y="170" width="92" height="92" rx="4" fill="#e8684a"></rect>
            <text x="216" y="216" fill="#17233f">b² = 16</text>
          </g>
          <g class="exact-pyth-c">
            <polygon points="168,96 264,168 336,72 240,0" fill="#fff" stroke="#17233f" stroke-width="1.6" stroke-linejoin="round"></polygon>
            <rect x="2" y="-118" width="116" height="116" rx="4" fill="#f0b429" transform="translate(168 96) rotate(36.86989765)"></rect>
            <text x="252" y="84" fill="#17233f">c² = 25</text>
          </g>
          <polygon points="168,168 168,96 264,168" fill="#fff" stroke="#334155" stroke-width="1.5" stroke-linejoin="round"></polygon>
          <polyline points="168,148 188,148 188,168" fill="none" stroke="#334155" stroke-width="1.2" stroke-linejoin="round"></polyline>
          <g class="exact-handle" transform="translate(168 168)">
            <circle class="exact-ring" r="10" fill="none" stroke="#1a8a80" stroke-width="2"></circle>
            <circle class="exact-ring exact-ring--b" r="10" fill="none" stroke="#1a8a80" stroke-width="1.4"></circle>
            <circle r="10" fill="#fff" stroke="#17233f" stroke-width="3"></circle>
            <circle r="3.4" fill="#1a8a80"></circle>
          </g>
          <text class="exact-pyth-summary" x="206" y="315" fill="#22305a">a² + b² = c²</text>
        </svg>
      </span>
      <span class="exact-game-promo__copy">
        <span class="exact-game-promo__badge">בטא</span>
        <h2 class="exact-game-promo__title">משחק פיתגורס כבר כאן!</h2>
        <p class="exact-game-promo__text">גרסת בטא. שיעור קצר עם אליהו על משפט פיתגורס.</p>
        <span class="exact-game-promo__go">למשחק</span>
      </span>
    </a>
  </div>
</section>
<style>
  .exact-game-promo{max-width:1200px;margin:0 auto;padding:0 24px 64px;}
  .exact-game-promo__card{
    display:flex;align-items:stretch;gap:0;background:#fff;color:#22305a;text-decoration:none;
    border:2px solid #22305a;border-radius:18px 6px 20px 8px / 8px 20px 6px 18px;
    box-shadow:4px 4px 0 #e6a534;overflow:hidden;
    transition:transform .2s ease,box-shadow .2s ease;
  }
  .exact-game-promo__card:hover{transform:translateY(-3px);box-shadow:6px 6px 0 #e5735c;}
  .exact-game-promo__card:focus-visible{outline:3px solid #2a7c7a;outline-offset:3px;}
  .exact-game-promo__shot{
    flex:1 1 46%;min-width:0;display:flex;align-items:center;justify-content:center;background:#f7f6f2;
    border-inline-end:2px solid #22305a;
  }
  .exact-game-promo__shot--kefel{padding:14px 12px;}
  .exact-game-promo__shot img[hidden]{display:none!important;}
  .exact-game-promo__shot img{display:block;width:100%;height:auto;}
  .exact-game-promo__copy{
    flex:1 1 54%;min-width:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;
    gap:10px;padding:28px 28px 24px;
  }
  .exact-game-promo__badge{
    display:inline-block;background:#e6a534;color:#22305a;border:1.5px solid #22305a;border-radius:999px;
    padding:4px 12px;font-weight:800;font-size:15px;line-height:1.4;transform:rotate(-2deg);
  }
  .exact-game-promo__title{
    margin:0;font-family:'Secular One',sans-serif;font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.15;
  }
  .exact-game-promo__text{margin:0;font-size:18px;line-height:1.55;color:#3d4870;max-width:28ch;}
  .exact-game-promo__go{
    margin-top:6px;font-weight:700;font-size:16px;color:#1e605e;text-decoration:underline;text-underline-offset:4px;
  }
  .exact-game-promo__slot{margin-top:18px;}
  .exact-game-promo__card--beta{box-shadow:4px 4px 0 #e5735c;}
  .exact-game-promo__card--beta:hover{box-shadow:6px 6px 0 #e5735c;}
  .exact-game-promo__card--beta .exact-game-promo__shot{
    flex:1 1 48%;min-width:0;justify-content:center;align-items:center;padding:14px 12px;
    background:#f4e7c3;
  }
  .exact-game-promo__mark{display:block;width:min(100%,420px);height:auto;max-width:100%;}
  .exact-pyth,.exact-formula-new__svg{direction:ltr;unicode-bidi:isolate;}
  .exact-pyth text,.exact-formula-new__svg text{
    font-family:'Secular One',Heebo,sans-serif;font-weight:400;font-size:15px;
    text-anchor:middle;dominant-baseline:central;
  }
  .exact-pyth-a text,.exact-pyth-b text,.exact-pyth-c text{font-size:16px;}
  .exact-pyth .exact-dim{font-size:12px;}
  .exact-pyth .exact-pyth-summary{font-size:18px;}
  .exact-live-pop{transform-box:fill-box;transform-origin:center;animation:exact-live-in .95s cubic-bezier(.22,.82,.2,1) both;}
  .exact-pyth-glow{opacity:.22;animation:exact-pyth-glow 2.8s ease-in-out infinite;}
  .exact-ring{
    transform-box:fill-box;transform-origin:center;
    animation:exact-ring 1.7s ease-out infinite;
  }
  .exact-ring--b{animation-delay:.85s;}
  .exact-handle{pointer-events:none;}
  @keyframes exact-live-in{
    0%{transform:scale(0);opacity:0;}
    62%{transform:scale(1.05);opacity:1;}
    100%{transform:scale(1);opacity:1;}
  }
  @keyframes exact-pyth-glow{
    0%,100%{opacity:.16;}
    50%{opacity:.62;}
  }
  @keyframes exact-ring{
    0%{transform:scale(1);opacity:.75;}
    100%{transform:scale(2.15);opacity:0;}
  }
  @media(max-width:700px){
    .exact-game-promo{padding:0 14px 40px;}
    .exact-game-promo__card{flex-direction:column;}
    .exact-game-promo__shot{border-inline-end:0;border-bottom:2px solid #22305a;}
    .exact-game-promo__card--beta .exact-game-promo__shot{flex-basis:auto;padding:14px 12px 8px;}
    .exact-game-promo__copy{padding:18px 16px 20px;}
    .exact-game-promo__text{font-size:17px;}
  }
  @media(prefers-reduced-motion:reduce){
    :global(html:not(.nd-motion-enabled)) .exact-game-promo__card{transition:none;}
    :global(html:not(.nd-motion-enabled)) .exact-game-promo__card:hover{transform:none;}
  }
  html.nd-motion-off .exact-game-promo__card,
  html.noam-a11y-motion .exact-game-promo__card{transition:none;}
  html.nd-motion-off .exact-game-promo__card:hover,
  html.noam-a11y-motion .exact-game-promo__card:hover{transform:none;}
  .exact-formula-new__svg{display:block;width:100%;max-width:100%;height:auto;}
  .exact-formula-new__svg .exact-tile-label{font-size:22px;}
  .exact-formula-new__svg .exact-tile-label--mid{font-size:16px;}
  .exact-dim-pill rect{fill:#faf9f6;stroke:none;}
  /* Reduced motion slows the drawings. It does not remove them. */
  @media(prefers-reduced-motion:reduce){
    :global(html:not(.nd-motion-enabled)) .exact-live-pop{animation-duration:3.1s;}
    :global(html:not(.nd-motion-enabled)) .exact-pyth-glow{animation-duration:8s;}
    :global(html:not(.nd-motion-enabled)) .exact-ring{animation-duration:4.8s;}
  }
  html.nd-motion-off .exact-live-pop,
  html.noam-a11y-motion .exact-live-pop{animation-duration:3.1s;}
  html.nd-motion-off .exact-pyth-glow,
  html.noam-a11y-motion .exact-pyth-glow,
  html.nd-motion-off .exact-ring,
  html.noam-a11y-motion .exact-ring{animation-duration:8s;}
</style>
