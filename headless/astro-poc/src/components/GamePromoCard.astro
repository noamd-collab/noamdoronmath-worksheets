---
import { PUBLIC_LESSON_PATH } from '../lib/publicLesson';
import { PYTHAGORAS_GAME_PATH } from '../lib/pythagorasGame';
---
<section class="exact-game-promo">
  <a class="exact-game-promo__card" href={PUBLIC_LESSON_PATH} data-home-game-promo>
    <span class="exact-game-promo__shot">
      <img
        src="/games/kefel-mekutsar-card.webp"
        width="960"
        height="508"
        alt="ריבוע (a+b) מהמשחק, מחולק ל־a² בירוק, b² באדום ושני מלבני ab צהובים"
        loading="lazy"
        decoding="async"
      />
    </span>
    <span class="exact-game-promo__copy">
      <span class="exact-game-promo__badge">חדש!</span>
      <h2 class="exact-game-promo__title">נסו את המשחק החדש!</h2>
      <p class="exact-game-promo__text">נוסחת הכפל המקוצר השנייה, עם אליהו. אהבתם?</p>
      <span class="exact-game-promo__go">למשחק</span>
    </span>
  </a>
  <div class="exact-game-promo__slot" id="pythagoras-promo" data-pop="160">
    <a class="exact-game-promo__card exact-game-promo__card--beta" href={PYTHAGORAS_GAME_PATH} data-home-pythagoras-promo>
      <span class="exact-game-promo__shot" aria-hidden="true">
        <svg class="exact-game-promo__mark exact-pyth" viewBox="78 -16 280 300" aria-hidden="true" focusable="false">
          <g class="exact-live-pop exact-pyth-a">
            <rect class="exact-pyth-glow" x="96" y="96" width="72" height="72" fill="none" stroke="#15756f" stroke-width="10"></rect>
            <rect x="96" y="96" width="72" height="72" rx="4" fill="#15756f" stroke="#17233f" stroke-width="2.5"></rect>
            <text x="132" y="132" fill="#fff">a²</text>
          </g>
          <g class="exact-live-pop exact-pyth-b">
            <rect class="exact-pyth-glow" x="168" y="168" width="96" height="96" fill="none" stroke="#c44e3a" stroke-width="11"></rect>
            <rect x="168" y="168" width="96" height="96" rx="4" fill="#c44e3a" stroke="#17233f" stroke-width="2.5"></rect>
            <text x="216" y="216" fill="#fff">b²</text>
          </g>
          <g class="exact-live-pop exact-pyth-c">
            <polygon class="exact-pyth-glow" points="168,96 264,168 336,72 240,0" fill="none" stroke="#e6a534" stroke-width="12" stroke-linejoin="round"></polygon>
            <polygon points="168,96 264,168 336,72 240,0" fill="#f0b429" stroke="#17233f" stroke-width="2.5" stroke-linejoin="round"></polygon>
            <text x="252" y="84" fill="#17233f">c²</text>
          </g>
          <polygon points="168,168 168,96 264,168" fill="#fff6df" stroke="#17233f" stroke-width="3.5" stroke-linejoin="round"></polygon>
          <polyline points="168,156 180,156 180,168" fill="none" stroke="#17233f" stroke-width="2.5" stroke-linejoin="round"></polyline>
          <text class="exact-pyth-side" x="184" y="124" fill="#0f5f58">a</text>
          <text class="exact-pyth-side" x="218" y="158" fill="#a84434">b</text>
          <text class="exact-pyth-side" x="204" y="148" fill="#8a5a00">c</text>
        </svg>
      </span>
      <span class="exact-game-promo__copy">
        <span class="exact-game-promo__badge">בטא</span>
        <h2 class="exact-game-promo__title">משחק פיתגורס כבר כאן!</h2>
        <p class="exact-game-promo__text">גרסת בטא. שיעור קצר עם אליהו על משפט פיתגורס.</p>
        <span class="exact-game-promo__go">למשחק</span>
      </span>
    </a>
  </div>
  <div class="exact-formula-new" id="new-algebra-formulas" data-pop="280">
    <p class="exact-formula-new__lead">
      <span class="exact-formula-new__badge">חדש!</span>
      <span class="exact-formula-new__kicker">נוסחאות לכיתה ט׳</span>
    </p>
    <div class="exact-formula-new__links">
      <a class="exact-formula-new__link" href="/binomial-square-grade-9">
        <span class="exact-formula-new__art">
          <svg class="exact-formula-new__svg" viewBox="0 0 400 368" aria-hidden="true" focusable="false">
            <text class="exact-dim" x="242" y="14" fill="#17233f">a+b=10</text>
            <line x1="112" y1="26" x2="372" y2="26" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="112" y1="20" x2="112" y2="32" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="372" y1="20" x2="372" y2="32" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <text class="exact-dim" x="190" y="48" fill="#15756f">a=6</text>
            <text class="exact-dim" x="320" y="48" fill="#a84434">b=4</text>
            <line x1="112" y1="62" x2="268" y2="62" stroke="#15756f" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="268" y1="62" x2="372" y2="62" stroke="#c44e3a" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="112" y1="56" x2="112" y2="68" stroke="#15756f" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="268" y1="56" x2="268" y2="68" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="372" y1="56" x2="372" y2="68" stroke="#c44e3a" stroke-width="2.5" stroke-linecap="round"></line>
            <text class="exact-dim" x="16" y="216" fill="#17233f" transform="rotate(-90 16 216)">a+b=10</text>
            <line x1="34" y1="86" x2="34" y2="346" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="28" y1="86" x2="40" y2="86" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="28" y1="346" x2="40" y2="346" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <text class="exact-dim" x="56" y="164" fill="#15756f" transform="rotate(-90 56 164)">a=6</text>
            <text class="exact-dim" x="56" y="294" fill="#a84434" transform="rotate(-90 56 294)">b=4</text>
            <line x1="76" y1="86" x2="76" y2="242" stroke="#15756f" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="76" y1="242" x2="76" y2="346" stroke="#c44e3a" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="70" y1="86" x2="82" y2="86" stroke="#15756f" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="70" y1="242" x2="82" y2="242" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="70" y1="346" x2="82" y2="346" stroke="#c44e3a" stroke-width="2.5" stroke-linecap="round"></line>
            <rect x="106" y="80" width="272" height="272" rx="12" fill="#fffdf8" stroke="#17233f" stroke-width="3"></rect>
            <g class="exact-live-pop" style="transform-origin:100% 100%;animation-delay:.05s">
              <rect class="exact-pyth-glow" x="112" y="86" width="152" height="152" rx="8" fill="none" stroke="#15756f" stroke-width="10"></rect>
              <rect x="112" y="86" width="152" height="152" rx="8" fill="#15756f"></rect>
              <text class="exact-tile-label" x="188" y="162" fill="#fff">a² = 36</text>
            </g>
            <g class="exact-live-pop" style="transform-origin:0% 100%;animation-delay:.22s">
              <rect class="exact-pyth-glow" x="272" y="86" width="100" height="152" rx="8" fill="none" stroke="#e6a534" stroke-width="10"></rect>
              <rect x="272" y="86" width="100" height="152" rx="8" fill="#f0b429"></rect>
              <text class="exact-tile-label exact-tile-label--mid" x="322" y="162" fill="#17233f">ba = 24</text>
            </g>
            <g class="exact-live-pop" style="transform-origin:100% 0%;animation-delay:.4s">
              <rect class="exact-pyth-glow" x="112" y="246" width="152" height="100" rx="8" fill="none" stroke="#e6a534" stroke-width="10"></rect>
              <rect x="112" y="246" width="152" height="100" rx="8" fill="#f0b429"></rect>
              <text class="exact-tile-label exact-tile-label--mid" x="188" y="296" fill="#17233f">ab = 24</text>
            </g>
            <g class="exact-live-pop" style="transform-origin:0% 0%;animation-delay:.58s">
              <rect class="exact-pyth-glow" x="272" y="246" width="100" height="100" rx="8" fill="none" stroke="#c44e3a" stroke-width="10"></rect>
              <rect x="272" y="246" width="100" height="100" rx="8" fill="#c44e3a"></rect>
              <text class="exact-tile-label" x="322" y="296" fill="#fff">b² = 16</text>
            </g>
            <g class="exact-handle" transform="translate(268 242)">
              <circle class="exact-ring" r="18" fill="none" stroke="#15756f" stroke-width="3"></circle>
              <circle class="exact-ring exact-ring--b" r="18" fill="none" stroke="#15756f" stroke-width="2"></circle>
              <circle cy="3" r="16" fill="rgba(23,35,63,.16)"></circle>
              <circle r="15" fill="#fff" stroke="#17233f" stroke-width="4"></circle>
              <circle r="5.5" fill="#15756f"></circle>
            </g>
          </svg>
        </span>
        <span class="exact-formula-new__copy">
          <span class="exact-formula-new__formula" dir="ltr">(a+b)²</span>
          <span class="exact-formula-new__name">דו־איבר בריבוע</span>
          <span class="exact-formula-new__hint">ריבוע הסכום וההפרש</span>
        </span>
      </a>
      <a class="exact-formula-new__link" href="/difference-of-squares-grade-9">
        <span class="exact-formula-new__art">
          <svg class="exact-formula-new__svg" viewBox="0 0 400 368" aria-hidden="true" focusable="false">
            <text class="exact-dim" x="232" y="22" fill="#17233f">a=6</text>
            <line x1="112" y1="40" x2="352" y2="40" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="112" y1="34" x2="112" y2="46" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="352" y1="34" x2="352" y2="46" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <text class="exact-dim" x="16" y="206" fill="#17233f" transform="rotate(-90 16 206)">a=6</text>
            <line x1="34" y1="86" x2="34" y2="326" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="28" y1="86" x2="40" y2="86" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="28" y1="326" x2="40" y2="326" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <text class="exact-dim exact-dim--sm" x="56" y="126" fill="#15756f" transform="rotate(-90 56 126)">a−b=2</text>
            <text class="exact-dim" x="56" y="246" fill="#a84434" transform="rotate(-90 56 246)">b=4</text>
            <line x1="76" y1="86" x2="76" y2="166" stroke="#15756f" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="76" y1="166" x2="76" y2="326" stroke="#c44e3a" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="70" y1="86" x2="82" y2="86" stroke="#15756f" stroke-width="2.5" stroke-linecap="round"></line>
            <line x1="70" y1="166" x2="82" y2="166" stroke="#17233f" stroke-width="2" stroke-linecap="round"></line>
            <line x1="70" y1="326" x2="82" y2="326" stroke="#c44e3a" stroke-width="2.5" stroke-linecap="round"></line>
            <rect x="106" y="80" width="252" height="252" rx="12" fill="#fffdf8" stroke="#17233f" stroke-width="3"></rect>
            <g class="exact-live-pop" style="transform-origin:33% 100%;animation-delay:.08s">
              <rect class="exact-pyth-glow" x="112" y="86" width="240" height="76" rx="8" fill="none" stroke="#15756f" stroke-width="10"></rect>
              <rect x="112" y="86" width="240" height="76" rx="8" fill="#15756f"></rect>
              <text class="exact-tile-label exact-tile-label--mid" x="232" y="124" fill="#fff">a·(a−b) = 12</text>
            </g>
            <g class="exact-live-pop" style="transform-origin:100% 0%;animation-delay:.28s">
              <rect class="exact-pyth-glow" x="112" y="166" width="76" height="160" rx="8" fill="none" stroke="#e6a534" stroke-width="10"></rect>
              <rect x="112" y="166" width="76" height="160" rx="8" fill="#f0b429"></rect>
              <text class="exact-tile-label exact-tile-label--turn" x="150" y="246" fill="#17233f" transform="rotate(-90 150 246)">b·(a−b) = 8</text>
            </g>
            <g class="exact-live-pop" style="transform-origin:0% 0%;animation-delay:.48s">
              <rect class="exact-pyth-glow" x="192" y="166" width="160" height="160" rx="8" fill="none" stroke="#c44e3a" stroke-width="10"></rect>
              <rect x="192" y="166" width="160" height="160" rx="8" fill="#c44e3a"></rect>
              <text class="exact-tile-label" x="272" y="246" fill="#fff">b² = 16</text>
            </g>
            <g class="exact-handle" transform="translate(190 164)">
              <circle class="exact-ring" r="18" fill="none" stroke="#15756f" stroke-width="3"></circle>
              <circle class="exact-ring exact-ring--b" r="18" fill="none" stroke="#15756f" stroke-width="2"></circle>
              <circle cy="3" r="16" fill="rgba(23,35,63,.16)"></circle>
              <circle r="15" fill="#fff" stroke="#17233f" stroke-width="4"></circle>
              <circle r="5.5" fill="#15756f"></circle>
            </g>
          </svg>
        </span>
        <span class="exact-formula-new__copy">
          <span class="exact-formula-new__formula" dir="ltr">a²−b²</span>
          <span class="exact-formula-new__name">הפרש ריבועים</span>
          <span class="exact-formula-new__hint">נוסחת הפרש הריבועים</span>
        </span>
      </a>
    </div>
  </div>
</section>
<style>
  .exact-game-promo{max-width:1200px;margin:0 auto;padding:0 24px 64px;}
  .exact-game-promo__card{
    display:flex;align-items:stretch;gap:0;background:#fff;color:#22305a;text-decoration:none;
    border:2px solid #22305a;border-radius:18px 6px 20px 8px / 8px 20px 6px 18px;
    box-shadow:4px 4px 0 #e6a534;overflow:hidden;
    transition:transform .2s ease,box-shadow .2s ease;
  }
  .exact-game-promo__card:hover{transform:translateY(-3px);box-shadow:6px 6px 0 #e5735c;}
  .exact-game-promo__card:focus-visible{outline:3px solid #2a7c7a;outline-offset:3px;}
  .exact-game-promo__shot{
    flex:1 1 46%;min-width:0;display:flex;align-items:center;background:#f7f6f2;
    border-inline-end:2px solid #22305a;
  }
  .exact-game-promo__shot img{display:block;width:100%;height:auto;}
  .exact-game-promo__copy{
    flex:1 1 54%;min-width:0;display:flex;flex-direction:column;align-items:flex-start;justify-content:center;
    gap:10px;padding:28px 28px 24px;
  }
  .exact-game-promo__badge{
    display:inline-block;background:#e6a534;color:#22305a;border:1.5px solid #22305a;border-radius:999px;
    padding:4px 12px;font-weight:800;font-size:15px;line-height:1.4;transform:rotate(-2deg);
  }
  .exact-game-promo__title{
    margin:0;font-family:'Secular One',sans-serif;font-weight:400;font-size:clamp(28px,3.2vw,40px);line-height:1.15;
  }
  .exact-game-promo__text{margin:0;font-size:18px;line-height:1.55;color:#3d4870;max-width:28ch;}
  .exact-game-promo__go{
    margin-top:6px;font-weight:700;font-size:16px;color:#1e605e;text-decoration:underline;text-underline-offset:4px;
  }
  .exact-game-promo__slot{margin-top:18px;}
  .exact-game-promo__card--beta .exact-game-promo__shot{
    flex:1 1 48%;min-width:0;justify-content:center;align-items:center;padding:14px 12px;
    background:
      radial-gradient(120px 90px at 18% 28%, rgba(21,117,111,.18), transparent 70%),
      radial-gradient(140px 110px at 78% 76%, rgba(196,78,58,.14), transparent 72%),
      radial-gradient(110px 80px at 62% 16%, rgba(240,180,41,.24), transparent 70%),
      #fbfaf5;
  }
  .exact-game-promo__mark{display:block;width:min(100%,420px);height:auto;max-width:100%;}
  .exact-pyth,.exact-formula-new__svg{direction:ltr;unicode-bidi:isolate;}
  .exact-pyth text,.exact-formula-new__svg text{
    font-family:'Secular One',Heebo,sans-serif;font-weight:400;font-size:15px;
    text-anchor:middle;dominant-baseline:central;
  }
  .exact-pyth-a text{font-size:22px;}
  .exact-pyth-b text,.exact-pyth-c text{font-size:26px;}
  .exact-pyth-side{font-size:16px;}
  .exact-live-pop{transform-box:fill-box;transform-origin:center;animation:exact-live-in .95s cubic-bezier(.22,.82,.2,1) both;}
  .exact-pyth-a{transform-origin:100% 50%;animation-delay:.08s;}
  .exact-pyth-b{transform-origin:50% 0%;animation-delay:.32s;}
  .exact-pyth-c{transform-origin:28.6% 78.6%;animation-delay:.56s;}
  .exact-pyth-glow{opacity:.22;animation:exact-pyth-glow 2.8s ease-in-out infinite;}
  .exact-ring{
    transform-box:fill-box;transform-origin:center;
    animation:exact-ring 1.7s ease-out infinite;
  }
  .exact-ring--b{animation-delay:.85s;}
  .exact-handle{pointer-events:none;}
  @keyframes exact-live-in{
    0%{transform:scale(0);opacity:0;}
    62%{transform:scale(1.05);opacity:1;}
    100%{transform:scale(1);opacity:1;}
  }
  @keyframes exact-pyth-glow{
    0%,100%{opacity:.16;}
    50%{opacity:.62;}
  }
  @keyframes exact-ring{
    0%{transform:scale(1);opacity:.75;}
    100%{transform:scale(2.15);opacity:0;}
  }
  @media(max-width:700px){
    .exact-game-promo{padding:0 14px 40px;}
    .exact-game-promo__card{flex-direction:column;}
    .exact-game-promo__shot{border-inline-end:0;border-bottom:2px solid #22305a;}
    .exact-game-promo__card--beta .exact-game-promo__shot{flex-basis:auto;padding:14px 12px 8px;}
    .exact-game-promo__copy{padding:18px 16px 20px;}
    .exact-game-promo__text{font-size:17px;}
  }
  @media(prefers-reduced-motion:reduce){
    .exact-game-promo__card{transition:none;}
    .exact-game-promo__card:hover{transform:none;}
  }
  html.nd-motion-off .exact-game-promo__card,
  html.noam-a11y-motion .exact-game-promo__card{transition:none;}
  html.nd-motion-off .exact-game-promo__card:hover,
  html.noam-a11y-motion .exact-game-promo__card:hover{transform:none;}
  .exact-formula-new{
    margin-top:18px;background:#fff;color:#22305a;
    border:2px solid #22305a;border-radius:16px 6px 18px 8px / 8px 18px 6px 16px;
    box-shadow:3px 3px 0 #e6a534;padding:14px 16px 16px;overflow:hidden;
  }
  .exact-formula-new__lead{display:flex;align-items:center;gap:10px;margin:0 0 12px;min-width:0;}
  .exact-formula-new__badge{
    display:inline-block;background:#e6a534;color:#22305a;border:1.5px solid #22305a;border-radius:999px;
    padding:4px 12px;font-weight:800;font-size:15px;line-height:1.4;flex:0 0 auto;
    animation:exact-new-pulse 2.4s ease-in-out infinite;
  }
  .exact-formula-new__kicker{font-family:'Secular One',sans-serif;font-weight:400;font-size:22px;line-height:1.2;min-width:0;}
  .exact-formula-new__links{display:grid;grid-template-columns:minmax(0,1fr);gap:12px;}
  .exact-formula-new__link{
    display:flex;flex-direction:column;align-items:stretch;gap:8px;min-width:0;
    padding:8px 8px 12px;border-radius:12px;
    color:#22305a;text-decoration:none;background:#fbfaf5;overflow:hidden;
  }
  .exact-formula-new__link:hover{background:#f4e7c3;}
  .exact-formula-new__link:focus-visible{outline:3px solid #2a7c7a;outline-offset:3px;}
  .exact-formula-new__art{display:block;width:100%;max-width:min(100%,420px);min-width:0;margin-inline:auto;}
  .exact-formula-new__svg{display:block;width:100%;max-width:100%;height:auto;}
  .exact-formula-new__svg .exact-tile-label{font-size:22px;}
  .exact-formula-new__svg .exact-tile-label--mid{font-size:16px;}
  .exact-formula-new__svg .exact-tile-label--turn{font-size:14px;}
  .exact-formula-new__svg .exact-dim--sm{font-size:13px;}
  .exact-formula-new__copy{min-width:0;display:flex;flex-direction:column;align-items:center;text-align:center;gap:2px;padding-inline:6px;}
  .exact-formula-new__formula{direction:ltr;unicode-bidi:isolate;font-weight:800;font-size:20px;line-height:1.2;}
  .exact-formula-new__name{font-weight:700;font-size:16px;color:#1e605e;text-decoration:underline;text-underline-offset:3px;}
  .exact-formula-new__hint{font-size:14px;line-height:1.4;color:#3d4870;}
  @keyframes exact-new-pulse{
    0%,100%{transform:rotate(-2deg) scale(1);}
    50%{transform:rotate(-2deg) scale(1.06);}
  }
  @media(min-width:760px){
    .exact-formula-new__links{grid-template-columns:minmax(0,1fr) minmax(0,1fr);}
  }
  @media(max-width:700px){
    .exact-formula-new__kicker{font-size:20px;}
  }
  /* Reduced motion slows the drawings. It does not remove them. */
  @media(prefers-reduced-motion:reduce){
    .exact-live-pop{animation-duration:3.1s;}
    .exact-pyth-glow{animation-duration:8s;}
    .exact-ring{animation-duration:4.8s;}
    .exact-formula-new__badge{animation-duration:7.2s;}
  }
  html.nd-motion-off .exact-live-pop,
  html.noam-a11y-motion .exact-live-pop{animation-duration:3.1s;}
  html.nd-motion-off .exact-pyth-glow,
  html.noam-a11y-motion .exact-pyth-glow,
  html.nd-motion-off .exact-ring,
