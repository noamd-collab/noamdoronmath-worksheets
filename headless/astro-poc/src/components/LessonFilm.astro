---
/**
 * Rich lesson films for pages with no old ConceptLoop.
 * The protected engine stays untouched. This card uses the same
 * classes; lessonFilms.ts drives the motion.
 */
import { MINUS } from '../lib/landingLoops';

interface Props {
  variant: string;
}
const { variant } = Astro.props;

const showRoots = variant === 'roots';
const showIneq = variant === 'ineq';
const showExp = variant === 'exp-rules';
const showPowers = variant === 'powers';
const showMedian = variant === 'median';
const showCoord = variant === 'coord-app';
const showRead = variant === 'read-graph';
const showSystems = variant === 'systems';
const showCone = variant === 'cone';
const showCyl = variant === 'cyl-area';
const showPrism = variant === 'prism-area' || variant === 'prism-vol';
const showMul = variant === 'signed-mul';
const showDiv = variant === 'signed-div';
const showQuad = variant === 'quad-eq' || variant === 'quad-factor';
const showQuadIneq = variant === 'quad-ineq';
const showRect = variant === 'rect';
const showTriangles = variant === 'triangles';
const showSide = variant === 'side-angle';
const showParallel = variant === 'parallel-more';

const curve = (
  samples: number,
  x0: number,
  x1: number,
  yOf: (x: number) => number,
  ox: number,
  oy: number,
  sx: number,
  sy: number,
) => {
  let d = '';
  for (let i = 0; i <= samples; i++) {
    const x = x0 + ((x1 - x0) * i) / samples;
    const X = ox + x * sx;
    const Y = oy - yOf(x) * sy;
    d += `${i ? 'L' : 'M'}${X.toFixed(1)} ${Y.toFixed(1)}`;
  }
  return d;
};
const quadD = curve(48, 0, 5, (x) => (x - 2) * (x - 3), 70, 250, 78, 22);
const ineqD = curve(48, -4, 4, (x) => x * x, 280, 240, 52, 6);
const shade = (x0: number, x1: number) => {
  const ox = 280;
  const oy = 240;
  const sx = 52;
  const sy = 6;
  const pts: string[] = [];
  for (let i = 0; i <= 8; i++) {
    const x = x0 + ((x1 - x0) * i) / 8;
    pts.push(`${(ox + x * sx).toFixed(1)},${(oy - x * x * sy).toFixed(1)}`);
  }
  const y9 = oy - 9 * sy;
  pts.push(`${(ox + x1 * sx).toFixed(1)},${y9}`);
  pts.push(`${(ox + x0 * sx).toFixed(1)},${y9}`);
  return pts.join(' ');
};

const XN = (n: number) => 270 + n * 30;
const lineY = 186;
const hop = (a: number, b: number, lift: number) => {
  const x1 = XN(a);
  const x2 = XN(b);
  const mid = (x1 + x2) / 2;
  return `M ${x1} ${lineY - 8} Q ${mid} ${lineY - 8 - lift} ${x2} ${lineY - 8}`;
};
const mulLeft = [hop(0, -2, 46), hop(-2, -4, 46), hop(-4, -6, 46)];
const mulRight = [hop(0, 2, 46), hop(2, 4, 46), hop(4, 6, 46)];
const divLeft = [0, -2, -4, -6].map((n) => hop(n, n - 2, 40));
const divAgain = [0, -2, -4, -6].map((n) => hop(n, n - 2, 62));
const ticks = [-8, -6, -4, -2, 0, 2, 4, 6, 8];

const sector = (() => {
  const cx = 500;
  const cy = 168;
  const r = 44;
  const a0 = -0.4;
  const a1 = 2.2;
  const x0 = cx + r * Math.cos(a0);
  const y0 = cy + r * Math.sin(a0);
  const x1 = cx + r * Math.cos(a1);
  const y1 = cy + r * Math.sin(a1);
  return `M ${cx} ${cy} L ${x0.toFixed(1)} ${y0.toFixed(1)} A ${r} ${r} 0 0 1 ${x1.toFixed(1)} ${y1.toFixed(1)} Z`;
})();

const aria: Record<string, string> = {
  roots: 'ריבוע 3 על 3 הוא 9, ולכן שורש 9 הוא 3',
  ineq: 'עיגול ריק ב־2, והקרן הפתוחה יוצאת מקצה העיגול',
  'exp-rules': '2 בריבוע כפול 2 בשלישית הם חמישה גורמים, כלומר 2 בחזקת 5',
  powers: 'סוגריים ב־(−3) בריבוע נותנים 9, בלי סוגריים מתקבל מינוס 9, ובשלישית מינוס 27',
  median: 'התיכון חוצה את הצלע, השטחים שווים, והתיכונים נפגשים ביחס 2 ל־1',
  'coord-app': 'המשולש A מינוס 3 1, B 2 1, C 2 4. האורכים 5 ו־3 והשטח 7.5',
  'read-graph': 'רוכב נוסע שעתיים ל־30 קילומטר, עוצר שעה, וחוזר. המהירויות 15, 0 ו־15',
  systems: 'הישרים נפגשים ב־(2, 3), והנקודה מקיימת את שתי המשוואות',
  cone: 'נפח החרוט הוא שליש מגליל עם אותו בסיס וגובה, והפריסה היא עיגול וגזרה',
  'cyl-area': 'פריסת הגליל: שני עיגולים ומלבן ברוחב 2 פאי r ובגובה h',
  'prism-area': 'פריסת מנסרה: שני משולשים ושלושה מלבנים. שטח הבסיס 6 והנפח 30',
  'prism-vol': 'פריסת מנסרה: שני משולשים ושלושה מלבנים. שטח הבסיס 6 והנפח 30',
  'signed-mul': 'שלוש קפיצות של מינוס 2 מגיעות למינוס 6, ושלוש קפיצות הפוכות מגיעות ל־6',
  'signed-div': 'מינוס 8 לחלק למינוס 2 נותן 4, ומינוס 8 לחלק ל־2 נותן מינוס 4',
  'quad-eq': 'הפרבולה חותכת את ציר x ב־2 וב־3, והפירוק הוא (x פחות 2) כפול (x פחות 3)',
  'quad-factor': 'הפרבולה חותכת את ציר x ב־2 וב־3, והפירוק הוא (x פחות 2) כפול (x פחות 3)',
  'quad-ineq': 'x בריבוע גדול מ־9 מחוץ לשורשים, x קטן ממינוס 3 או x גדול מ־3',
  rect: 'במלבן 6 על 8 כל הזוויות ישרות ושני האלכסונים שווים ל־10',
  triangles: 'הקודקוד זז, המעלות מתעדכנות, וסכום הזוויות נשאר 180',
  'side-angle': 'מול הצלע הארוכה יותר נמצאת הזווית הגדולה יותר',
  'parallel-more': 'מתחלפות פנימיות, מתחלפות חיצוניות, חד צדדיות שסכומן 180, קודקודיות וצמודות',
};
---

<div class="concept-loop" data-lesson={variant}>
  <div
    class="concept-loop__card"
    role="button"
    tabindex="0"
    aria-label="השהיית הנפשה"
    aria-pressed="false"
    data-pause-card
  >
    <button type="button" class="concept-loop__toggle" data-el="toggle" tabindex="-1" aria-hidden="true">
      <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
        <g data-el="ic-pause">
          <rect x="3" y="2.5" width="3.4" height="11" rx="1.2"></rect>
          <rect x="9.6" y="2.5" width="3.4" height="11" rx="1.2"></rect>
        </g>
        <path data-el="ic-play" d="M4 2.2 L13.4 8 L4 13.8 Z" style="display:none"></path>
      </svg>
    </button>

    {showRoots && (
      <>
        <p class="concept-loop__top cl-topswap">
          <span class="cl-topsz" aria-hidden="true">כמה משבצות יש בריבוע של 3 על 3?</span>
          <span class="cl-tops" data-el="top0">כמה משבצות יש בריבוע של&nbsp;<bdi dir="ltr" class="ll-math">3</bdi>&nbsp;על&nbsp;<bdi dir="ltr" class="ll-math">3</bdi>?</span>
          <span class="cl-tops" data-el="top1" style="opacity:0">אז מהו <bdi dir="ltr" class="ll-math">√9</bdi>?</span>
        </p>
        <svg class="concept-loop__svg" viewBox="0 0 560 280" role="img" aria-label={aria.roots}>
          {Array.from({ length: 9 }, (_, i) => (
            <rect
              data-el={`cell-${i}`}
              x={78 + (i % 3) * 44}
              y={78 + Math.floor(i / 3) * 44}
              width="44"
              height="44"
              class="lf-cell"
              style="opacity:0"
            />
          ))}
          <g data-el="side" style="opacity:0">
            <text class="cl-t cl-num lf-big" x="48" y="156" text-anchor="middle">3</text>
            <text class="cl-t cl-num lf-big" x="144" y="232" text-anchor="middle">3</text>
          </g>
          <text class="cl-t cl-num lf-big" data-el="eq-sq" x="390" y="108" text-anchor="middle" style="opacity:0">3² = 9</text>
          <path class="cl-stroke-a" data-el="rad-path" d="M250 176 L274 206 L304 148 L332 148" pathLength="1" fill="none" stroke-dashoffset="1" />
          <text class="cl-t cl-num lf-big" data-el="rad" x="308" y="174" text-anchor="start" style="opacity:0">9</text>
          <text class="cl-t cl-num lf-big cl-ok" data-el="eq-root" x="400" y="258" text-anchor="middle" style="opacity:0">√9 = 3</text>
        </svg>
      </>
    )}

    {showIneq && (
      <>
        <p class="concept-loop__top">איפה <bdi dir="ltr" class="ll-math">x &gt; 2</bdi> על הישר?</p>
        <p class="lf-note" data-el="note" style="opacity:0">עיגול ריק: <bdi dir="ltr" class="ll-math">2</bdi>&nbsp;לא כלול</p>
        <svg class="concept-loop__svg" viewBox="0 0 560 230" role="img" aria-label={aria.ineq}>
          <line class="cl-line" x1="48" y1="150" x2="520" y2="150" />
          {[0, 1, 2, 3, 4, 5, 6].map((n) => (
            <g>
              <line class="cl-line-thin" x1={80 + n * 64} y1="140" x2={80 + n * 64} y2="160" />
              <text class="cl-t cl-num" x={80 + n * 64} y="186" text-anchor="middle">{n}</text>
            </g>
          ))}
          <circle data-el="hole" cx="208" cy="150" r="11" fill="#fff" stroke="#2a7c7a" stroke-width="2.5" style="opacity:0" />
          <path data-el="ray" d="M228 150 H488" pathLength="1" fill="none" stroke="#2a7c7a" stroke-width="5" stroke-linecap="round" stroke-dashoffset="1" style="opacity:0" />
          <polygon data-el="head" points="488,140 512,150 488,160" fill="#2a7c7a" style="opacity:0" />
        </svg>
        <p class="lf-answer cl-ok" data-el="eq" style="opacity:0"><bdi dir="ltr" class="ll-math">x &gt; 2</bdi></p>
      </>
    )}

    {showExp && (
      <>
        <p class="concept-loop__top cl-topswap">
          <span class="cl-topsz" aria-hidden="true">הקבוצות נפגשות למכפלה אחת של חמישה גורמים</span>
          <span class="cl-tops" data-el="top0">איך נפתחים <bdi dir="ltr" class="ll-math">2²</bdi> ו־<bdi dir="ltr" class="ll-math">2³</bdi> לגורמים?</span>
          <span class="cl-tops" data-el="top1" style="opacity:0">הקבוצות נפגשות למכפלה אחת</span>
          <span class="cl-tops" data-el="top2" style="opacity:0">לכן <bdi dir="ltr" class="ll-math">2² × 2³ = 2⁵</bdi></span>
        </p>
        <svg class="concept-loop__svg" viewBox="0 0 560 280" role="img" aria-label={aria['exp-rules']}>
          <text class="cl-t cl-num lf-big cl-tc-a" data-el="powL" x="110" y="62" text-anchor="middle">2²</text>
          <text class="cl-t cl-num lf-big cl-tc-b" data-el="powR" x="420" y="62" text-anchor="middle">2³</text>
          {['pL0', 'pL1'].map((name) => (
            <g data-el={name} class="cl-tc-a" style="opacity:0">
              <text class="cl-t cl-num lf-big cl-tc-a" text-anchor="middle" dominant-baseline="central">{name === 'pL0' ? '(' : ')'}</text>
            </g>
          ))}
          {['pR0', 'pR1'].map((name) => (
            <g data-el={name} class="cl-tc-b" style="opacity:0">
              <text class="cl-t cl-num lf-big cl-tc-b" text-anchor="middle" dominant-baseline="central">{name === 'pR0' ? '(' : ')'}</text>
            </g>
          ))}
          {['2', '2', '2', '2', '2'].map((digit, i) => (
            <g data-el={`f${i}`} style="opacity:0">
              <text class:list={['cl-t', 'cl-num', 'lf-big', i < 2 ? 'cl-tc-a' : 'cl-tc-b']} text-anchor="middle" dominant-baseline="central">{digit}</text>
            </g>
          ))}
          {[0, 1, 2, 3].map((i) => (
            <g data-el={`m${i}`} style="opacity:0">
              <text class:list={['cl-t', 'cl-num', 'lf-mid', i === 0 ? 'cl-tc-a' : i >= 2 ? 'cl-tc-b' : '']} text-anchor="middle" dominant-baseline="central">×</text>
            </g>
          ))}
          {['1', '2', '3', '4', '5'].map((digit, i) => (
            <g data-el={`c${i}`} style="opacity:0">
              <text class:list={['cl-t', 'cl-num', i === 4 ? 'cl-ok' : '']} text-anchor="middle" dominant-baseline="central">{digit}</text>
            </g>
          ))}
          <text class="cl-t cl-num lf-big" data-el="plus" x="280" y="214" text-anchor="middle" style="opacity:0">2 + 3 = 5</text>
          <text class="cl-t cl-num lf-big cl-ok" data-el="result" x="280" y="258" text-anchor="middle" style="opacity:0">2² × 2³ = 2⁵</text>
        </svg>
      </>
    )}

    {showPowers && (
      <>
        <p class="concept-loop__top cl-topswap">
          <span class="cl-topsz" aria-hidden="true">מה ההבדל בין סוגריים לבין המינוס בחוץ?</span>
          <span class="cl-tops" data-el="top0">מהו <bdi dir="ltr" class="ll-math">({MINUS}3)²</bdi>?</span>
          <span class="cl-tops" data-el="top1" style="opacity:0">ומהו <bdi dir="ltr" class="ll-math">{MINUS}3²</bdi> בלי סוגריים?</span>
          <span class="cl-tops" data-el="top2" style="opacity:0">ומהו <bdi dir="ltr" class="ll-math">({MINUS}3)³</bdi>?</span>
        </p>
        <svg class="concept-loop__svg" viewBox="0 0 560 280" role="img" aria-label={aria.powers}>
          <g data-el="row-0" style="opacity:0">
            <text class="cl-t cl-num lf-mid" x="28" y="78">({MINUS}3)²</text>
          </g>
          <text class="cl-t cl-num lf-mid" data-el="ex-0" x="168" y="78" style="opacity:0">= ({MINUS}3) × ({MINUS}3)</text>
          <text class="cl-t cl-num lf-big cl-ok" data-el="ans-0" x="520" y="78" text-anchor="end" style="opacity:0">= 9</text>
          <g data-el="row-1" style="opacity:0">
            <text class="cl-t cl-num lf-mid" x="28" y="148">{MINUS}3²</text>
          </g>
          <text class="cl-t cl-num lf-mid" data-el="ex-1" x="168" y="148" style="opacity:0">= {MINUS}(3 × 3)</text>
          <text class="cl-t cl-num lf-big cl-ok" data-el="ans-1" x="520" y="148" text-anchor="end" style="opacity:0">= {MINUS}9</text>
          <g data-el="row-2" style="opacity:0">
            <text class="cl-t cl-num lf-mid" x="28" y="218">({MINUS}3)³</text>
          </g>
          <text class="cl-t cl-num lf-mid" data-el="ex-2" x="168" y="218" style="opacity:0">= ({MINUS}3) × ({MINUS}3) × ({MINUS}3)</text>
          <text class="cl-t cl-num lf-big cl-ok" data-el="ans-2" x="520" y="218" text-anchor="end" style="opacity:0">= {MINUS}27</text>
        </svg>
      </>
    )}

    {showMedian && (
      <>
        <p class="concept-loop__top cl-topswap">
          <span class="cl-topsz" aria-hidden="true">איפה נפגשים שלושת התיכונים?</span>
          <span class="cl-tops" data-el="top0">איפה אמצע הצלע?</span>
          <span class="cl-tops" data-el="top1" style="opacity:0">האם שני השטחים שווים?</span>
          <span class="cl-tops" data-el="top2" style="opacity:0">באיזה יחס נפגשים התיכונים?</span>
        </p>
        <svg class="concept-loop__svg" viewBox="0 0 560 320" role="img" aria-label={aria.median}>
          <polygon data-el="area1" points="280,48 80,250 280,250" class="cl-fill-a" style="opacity:0" />
          <polygon data-el="area2" points="280,48 280,250 480,250" class="cl-fill-b" style="opacity:0" />
          <polygon points="280,48 80,250 480,250" fill="none" stroke="#22305a" stroke-width="2.5" />
          <g data-el="ticks" style="opacity:0">
            <line class="cl-line" x1="180" y1="242" x2="180" y2="258" />
            <line class="cl-line" x1="380" y1="242" x2="380" y2="258" />
          </g>
          <circle data-el="m-dot" cx="280" cy="250" r="5.5" class="cl-pt-a" style="opacity:0" />
          <path data-el="med-a" d="M280 48 L280 250" class="cl-stroke-a" pathLength="1" fill="none" stroke-dashoffset="1" style="opacity:0" />
          <path data-el="med-b" d="M80 250 L380 149" class="cl-stroke-b" pathLength="1" fill="none" stroke-dashoffset="1" style="opacity:0" />
          <path data-el="med-c" d="M480 250 L180 149" class="lf-stroke-c" pathLength="1" fill="none" stroke-dashoffset="1" style="opacity:0" />
          <circle data-el="g-dot" cx="280" cy="182.67" r="6.5" class="cl-ok" stroke="#fff" stroke-width="2" style="opacity:0" />
          <text class="cl-t" x="280" y="36" text-anchor="middle">A</text>
          <text class="cl-t" x="64" y="272" text-anchor="middle">B</text>
          <text class="cl-t" x="496" y="272" text-anchor="middle">C</text>
          <text class="cl-t" x="298" y="274" text-anchor="start">M</text>
          <text class="cl-t" data-el="same" x="280" y="308" text-anchor="middle" direction="rtl" style="opacity:0">שטחים שווים</text>
          <text class="cl-t cl-num cl-ok" data-el="ratio" x="308" y="176" style="opacity:0">AG:GM = 2:1</text>
        </svg>
      </>
    )}

    {showCoord && (
      <>
        <p class="concept-loop__top cl-topswap">
          <span class="cl-topsz" aria-hidden="true">מה האורכים, ומה השטח?</span>
          <span class="cl-tops" data-el="top0">איפה <bdi dir="ltr" class="ll-math">A({MINUS}3, 1), B(2, 1), C(2, 4)</bdi>?</span>
          <span class="cl-tops" data-el="top1" style="opacity:0">סופרים יחידות על הניצבים</span>
          <span class="cl-tops" data-el="top2" style="opacity:0">מה השטח?</span>
        </p>
        <svg class="concept-loop__svg" viewBox="0 0 560 300" role="img" aria-label={aria['coord-app']}>
          <line class="cl-line" x1="70" y1="210" x2="500" y2="210" />
          <line class="cl-line" x1="250" y1="250" x2="250" y2="28" />
          <polygon points="490,204 500,210 490,216" fill="#22305a" />
          <polygon points="244,38 250,28 256,38" fill="#22305a" />
          {[-4, -3, -2, -1, 1, 2, 3, 4, 5].map((n) => (
            <line class="cl-line-thin" x1={250 + n * 36} y1="204" x2={250 + n * 36} y2="216" />
          ))}
          {[1, 2, 3, 4, 5].map((n) => (
            <line class="cl-line-thin" x1="244" y1={210 - n * 36} x2="256" y2={210 - n * 36} />
          ))}
          <text class="cl-t cl-num" x="142" y="232" text-anchor="middle">{MINUS}3</text>
          <text class="cl-t cl-num" x="322" y="232" text-anchor="middle">2</text>
          <text class="cl-t cl-num" x="228" y="170" text-anchor="end">1</text>
          <text class="cl-t cl-num" x="228" y="70" text-anchor="end">4</text>
          <path data-el="ab" d="M142 174 H322" class="cl-stroke-a" pathLength="1" fill="none" stroke-dashoffset="1" style="opacity:0" />
          <path data-el="bc" d="M322 174 V66" class="cl-stroke-a" pathLength="1" fill="none" stroke-dashoffset="1" style="opacity:0" />
          <path data-el="ca" d="M322 66 L142 174" class="cl-line" pathLength="1" stroke-dashoffset="1" style="opacity:0" />
          <path d="M310 174 H322 V162" fill="none" stroke="#22305a" stroke-width="2" />
          {[1, 2, 3, 4, 5].map((n) => (
            <text class="cl-t cl-num" data-el={`ab-${n}`} x={142 + (n - 0.5) * 36} y="158" text-anchor="middle" style="opacity:0">{n}</text>
          ))}
          {[1, 2, 3].map((n) => (
            <text class="cl-t cl-num" data-el={`bc-${n}`} x="346" y={174 - (n - 0.5) * 36} text-anchor="start" dominant-baseline="central" style="opacity:0">{n}</text>
          ))}
          <text class="cl-t cl-num lf-big cl-ok" data-el="lenAB" x="232" y="198" text-anchor="middle" style="opacity:0">5</text>
          <text class="cl-t cl-num lf-big cl-ok" data-el="lenBC" x="404" y="120" text-anchor="middle" style="opacity:0">3</text>
          <circle data-el="ptA" cx="142" cy="174" r="6" class="cl-pt-a" style="opacity:0" />
          <circle data-el="ptB" cx="322" cy="174" r="6" class="cl-pt-b" style="opacity:0" />
