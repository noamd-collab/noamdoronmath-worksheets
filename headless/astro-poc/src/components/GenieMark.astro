---
/** Decorative AI genie for mid-school grade tiles (design v2 §12). */
---
<svg
  data-genie
  viewBox="0 0 64 80"
  aria-hidden="true"
  class="home-grade__genie"
>
  <path
    data-smoke
    pathLength="1"
    d="M32 80 C 22 70, 42 62, 30 52 C 22 46, 38 40, 32 32"
    fill="none"
    stroke="#cfe6e4"
    stroke-width="3.5"
    stroke-linecap="round"
    stroke-dasharray="1"
    stroke-dashoffset="1"
    opacity=".9"></path>
  <g data-gbody opacity="0" style="transform-origin:32px 80px;">
    <path
      d="M32 78 C 25 70, 39 63, 31 55 C 21 49, 20 40, 25 35 L 39 35 C 44 40, 44 49, 35 54"
      fill="#9fdcd4"
      stroke="#fbfaf5"
      stroke-width="1.5"
      stroke-linejoin="round"></path>
    <g data-garms style="transform-origin:32px 38px;">
      <path
        d="M24 39 C 17 37, 14 31, 17 26"
        fill="none"
        stroke="#9fdcd4"
        stroke-width="3.5"
        stroke-linecap="round"></path>
      <path
        d="M40 39 C 47 37, 50 31, 47 26"
        fill="none"
        stroke="#9fdcd4"
        stroke-width="3.5"
        stroke-linecap="round"></path>
    </g>
    <circle cx="32" cy="23" r="11" fill="#9fdcd4" stroke="#fbfaf5" stroke-width="1.5"></circle>
    <circle cx="32" cy="10.5" r="2.6" fill="#e6a534"></circle>
    <circle data-geye cx="28" cy="22" r="1.9" fill="#22305a"></circle>
    <circle data-geye cx="36" cy="22" r="1.9" fill="#22305a"></circle>
    <path
      d="M28 26.5 Q32 30 36 26.5"
      fill="none"
      stroke="#22305a"
      stroke-width="1.6"
      stroke-linecap="round"></path>
    <text
      x="32"
      y="46"
      text-anchor="middle"
      direction="ltr"
      style="font:800 8px Heebo;fill:#22305a;">AI</text>
  </g>
  <g data-gspark fill="#f2c46b">
    <circle cx="10" cy="30" r="2" opacity="0"></circle>
    <circle cx="56" cy="22" r="2.4" opacity="0"></circle>
    <circle cx="14" cy="10" r="1.6" opacity="0"></circle>
    <circle cx="52" cy="46" r="1.6" opacity="0"></circle>
  </g>
</svg>
