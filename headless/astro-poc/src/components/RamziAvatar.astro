---
// Bundled at build time: Wix hosting runs on Cloudflare Workers, where node:fs
// and process.cwd() are not available at request time.
const avatarSvgs = import.meta.glob<string>('../../public/design-exact/assets/avatar/ramzi-A-*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

export interface Props {
  mood?: 'idle' | 'thinking' | 'hint' | 'success' | 'error';
  size?: number;
}

const { mood = 'idle', size = 44 } = Astro.props;
const px = Number.isFinite(size) && size > 0 ? size : 44;
const raw = avatarSvgs[`../../public/design-exact/assets/avatar/ramzi-A-${mood}.svg`];
if (raw === undefined) throw new Error(`RamziAvatar: no avatar for mood "${mood}"`);
const svg = raw.replace(/<metadata>[\s\S]*?<\/metadata>/, '');
---

<ramzi-avatar
  mood={mood}
  size={px}
  asset-base="/design-exact/assets/avatar"
  aria-hidden="true"
  style={`width:${px}px;height:${px}px;flex:none;display:inline-flex`}
>
  <Fragment set:html={svg} />
</ramzi-avatar>

<script>
  import { defineRamziAvatar } from './ramzi/ramzi-avatar';
  defineRamziAvatar();
</script>
