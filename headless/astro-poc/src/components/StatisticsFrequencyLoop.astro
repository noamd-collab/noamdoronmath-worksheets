---
/**
 * Grade 8 statistics film: collecting data, frequency, relative frequency.
 * The page serves a silent autoplay cut of public/loops/statistics-frequency.html:
 * the animation starts on load, does not loop, and the only control is pause/resume.
 * The narrated mp3 stays in public/loops/statistics-frequency/ and is not requested.
 * This wrapper only frames that file and fits the frame to the player.
 */
interface Props {
  src: string;
  marker: string;
}
const { src, marker } = Astro.props;
const frameSrc = `${src}?embed=1`;
---

<div class="stats-film" data-stats-film data-landing-loop={marker}>
  <iframe
    class="stats-film__frame"
    src={frameSrc}
    title="סטטיסטיקה: איסוף מידע, שכיחות ושכיחות יחסית"
    loading="eager"
    scrolling="no"
    data-stats-frame
  ></iframe>
</div>

<script>
  function boot(root: HTMLElement) {
    const foundFrame = root.querySelector<HTMLIFrameElement>('[data-stats-frame]');
    if (!foundFrame) return;
    const frame: HTMLIFrameElement = foundFrame;

    function fit() {
      let doc: Document | null = null;
      try { doc = frame.contentDocument; } catch { return; }
      const shell = doc?.getElementById('player-shell');
      if (!shell) return;
      const h = Math.ceil(shell.getBoundingClientRect().height);
      if (h > 200 && Math.abs(frame.clientHeight - h) > 2) frame.style.height = `${h}px`;
    }

    // The player pauses itself when the site's Stop Animations control is on.
    let watching = false;
    function onReady() {
      let doc: Document | null = null;
      try { doc = frame.contentDocument; } catch { return; }
      const shell = doc?.getElementById('player-shell');
      if (!shell) return;
      fit();
      if (watching || !('ResizeObserver' in window)) return;
      watching = true;
      const observer = new ResizeObserver(fit);
      observer.observe(frame);
      observer.observe(shell);
    }

    frame.addEventListener('load', onReady);
    onReady();
  }

  document.querySelectorAll<HTMLElement>('[data-stats-film]').forEach(boot);
</script>

<style>
  .stats-film {
    display: block;
    width: 100%;
    min-width: 0;
    container-type: inline-size;
    background: #fbfaf5;
  }
  .stats-film__frame {
    display: block;
    width: 100%;
    max-width: 100%;
    border: 0;
    background: #fbfaf5;
    /* 16:9 stage plus the single pause/resume row.
       The script replaces this estimate with the player's measured height. */
    height: 420px;
    height: calc(100cqi * 9 / 16 + 84px);
    min-height: 160px;
    overflow: hidden;
  }
</style>
