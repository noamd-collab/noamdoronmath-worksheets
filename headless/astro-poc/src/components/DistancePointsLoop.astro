---
/**
 * Grade 9 analytic-geometry landing film.
 * The SVG and its script stay in public/loops/distance-between-points.html,
 * byte-for-byte. This wrapper only:
 *   - scales the 16:9 stage to the slot (smaller paint on a phone)
 *   - hides the file's own controls via its ?capture=1 mode
 *   - clicks Play so it auto-starts, and Replay so it loops
 *   - pauses while off-screen or in a hidden tab
 *   - holds the final frame for reduced motion / the a11y motion switch
 *   - draws one pause control, matching the topic-loop corner toggle
 */
interface Props {
  src: string;
  marker: string;
}
const { src, marker } = Astro.props;
const frameSrc = `${src}?capture=1&t=0`;
---

<div
  class="distance-loop"
  data-distance-loop
  data-landing-loop={marker}
  data-loop-idea="המרחק בין שתי נקודות הוא אלכסון של הפרש ה־x והפרש ה־y"
>
  <iframe
    class="distance-loop__frame"
    src={frameSrc}
    title="המרחק בין שתי נקודות — אנימציה רציפה"
    loading="eager"
    tabindex="-1"
    data-distance-frame
  ></iframe>
  <button
    type="button"
    class="distance-loop__pause"
    data-distance-pause
    data-state="playing"
    aria-pressed="false"
    aria-label="השהיית הנפשה"
  >
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <g class="distance-loop__ic-pause">
        <rect x="3" y="2.5" width="3.4" height="11" rx="1.2"></rect>
        <rect x="9.6" y="2.5" width="3.4" height="11" rx="1.2"></rect>
      </g>
      <path class="distance-loop__ic-play" d="M4 2.2 L13.4 8 L4 13.8 Z"></path>
    </svg>
  </button>
</div>

<script>
  const PAUSE_KEY = 'k3-pause:distance-between-points';

  function boot(root) {
    const frame = root.querySelector('[data-distance-frame]');
    const button = root.querySelector('[data-distance-pause]');
    if (!frame || !button) return;

    let userPaused = false;
    try { userPaused = sessionStorage.getItem(PAUSE_KEY) === '1'; } catch { /* optional */ }
    let inView = true;
    let booted = false;
    let shown = '';

    const motionQuery = window.matchMedia('(prefers-reduced-motion: reduce)');
    function motionOff() {
      const html = document.documentElement;
      return motionQuery.matches
        || html.classList.contains('nd-motion-off')
        || html.classList.contains('noam-a11y-motion');
    }
    function win() {
      try { return frame.contentWindow; } catch { return null; }
    }
    function doc() {
      try { return frame.contentDocument; } catch { return null; }
    }
    function playBtn() { return doc()?.getElementById('playButton'); }
    function replayBtn() { return doc()?.getElementById('replayButton'); }
    function isPlaying() {
      return (playBtn()?.textContent || '').includes('השהיה');
    }
    function atEnd() {
      const w = win();
      if (!w || typeof w.currentTime !== 'number') return false;
      const dur = w.animationDuration || 19;
      return w.currentTime >= dur - 0.001;
    }
    function showFinal() {
      const w = win();
      const seek = doc()?.getElementById('seek');
      if (!w || !seek || typeof w.renderAt !== 'function') return;
      if (isPlaying()) playBtn()?.click();
      if (typeof w.currentTime === 'number' && w.currentTime >= (w.animationDuration || 19) - 0.001) return;
      seek.value = String(w.animationDuration || 19);
      seek.dispatchEvent(new Event('input', { bubbles: true }));
    }
    function syncButton() {
      const off = motionOff();
      const playing = !off && isPlaying();
      const next = off ? 'off' : playing ? 'playing' : 'paused';
      if (next === shown) return;
      shown = next;
      button.hidden = off;
      button.dataset.state = playing ? 'playing' : 'paused';
      const paused = !playing;
      button.setAttribute('aria-pressed', paused ? 'true' : 'false');
      button.setAttribute('aria-label', paused ? 'הפעלת הנפשה' : 'השהיית הנפשה');
    }
    function onReady() {
      if (booted) return;
      const w = win();
      const d = doc();
      if (!w || !d || typeof w.renderAt !== 'function') return;
      booted = true;
      d.documentElement.style.overflow = 'hidden';
      d.body.style.overflow = 'hidden';
      d.body.classList.add('capture');
      const controls = d.querySelector('.controls');
      if (controls) controls.style.setProperty('display', 'none', 'important');
      // The phone slot is a few hundred pixels wide. contain:paint keeps the
      // 1920×1080 SVG from promoting a full-size layer. Timing is untouched.
      if (window.matchMedia('(max-width: 720px)').matches) {
        const style = d.createElement('style');
        style.textContent = 'svg{contain:paint}';
        d.head.appendChild(style);
      }
      syncButton();
    }

    frame.addEventListener('load', onReady);
    // A tiny static file can finish loading before this module runs.
    onReady();

    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => {
        inView = entries.some((entry) => entry.isIntersecting);
      }, { rootMargin: '64px' });
      io.observe(root);
    }

    button.addEventListener('click', () => {
      if (motionOff()) return;
      // Before the film is ready, toggle the wish. After that, a click
      // pauses when it is moving and resumes when it is stopped.
      userPaused = booted ? isPlaying() : !userPaused;
      try {
        if (userPaused) sessionStorage.setItem(PAUSE_KEY, '1');
        else sessionStorage.removeItem(PAUSE_KEY);
      } catch { /* optional */ }
      shown = '';
    });

    function pump() {
      if (booted) {
        const visible = inView && document.visibilityState !== 'hidden';
        if (motionOff()) showFinal();
        else if (userPaused || !visible) {
          if (isPlaying()) playBtn()?.click();
        } else if (!isPlaying()) {
          if (atEnd()) replayBtn()?.click();
          else playBtn()?.click();
        }
        syncButton();
      }
      requestAnimationFrame(pump);
    }
    requestAnimationFrame(pump);

    motionQuery.addEventListener('change', () => { shown = ''; });
    new MutationObserver(() => { shown = ''; }).observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['class'],
    });
  }

  document.querySelectorAll('[data-distance-loop]').forEach(boot);
</script>

<style>
  .distance-loop {
    display: block;
    width: 100%;
    max-width: 520px;
    margin-inline: auto;
    aspect-ratio: 16 / 9;
    position: relative;
    background: #F7FBFF;
    contain: layout;
  }
  .distance-loop__frame {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    background: #F7FBFF;
    pointer-events: none;
  }
  /* Same corner toggle as ConceptLoop's topic-page pause indicator. */
  .distance-loop__pause {
    position: absolute;
    inset-inline-start: auto;
    inset-inline-end: 10px;
    top: 8px;
    z-index: 2;
    width: 14px;
    height: 14px;
    padding: 0;
    border: none;
    background: transparent;
    border-radius: 0;
    opacity: 0.65;
    cursor: pointer;
    color: #22305a;
  }
  .distance-loop__pause svg {
    display: block;
    width: 14px;
    height: 14px;
    fill: currentColor;
  }
  .distance-loop__pause[data-state='playing'] .distance-loop__ic-play,
  .distance-loop__pause[data-state='paused'] .distance-loop__ic-pause {
    display: none;
  }
  .distance-loop:hover .distance-loop__pause,
  .distance-loop__pause:focus-visible {
    opacity: 1;
  }
  .distance-loop__pause::before {
    content: '';
    position: absolute;
    inset: -12px;
  }
  .distance-loop__pause:focus-visible {
    outline: 3px solid #22305a;
    outline-offset: 2px;
  }
  .distance-loop__pause[hidden] {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .distance-loop__pause { display: none; }
  }
  :global(html.nd-motion-off) .distance-loop__pause,
  :global(html.noam-a11y-motion) .distance-loop__pause {
    display: none;
  }
  @media (max-width: 720px) {
    .distance-loop { max-width: none; }
  }
</style>
