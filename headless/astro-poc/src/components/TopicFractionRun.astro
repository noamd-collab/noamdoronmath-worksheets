---
import StackedFraction from './StackedFraction.astro';
import { splitFractionMarkers, spokenFraction } from '../lib/topicFractionMarkers';

interface Props {
  text: string;
}

const { text } = Astro.props;
const parts = splitFractionMarkers(text || '');
---

{
  parts.map((part) =>
    part.kind === 'text' ? (
      part.text
    ) : (
      <span class="topic-frac" role="img" aria-label={spokenFraction(part.n, part.d)}>
        <span aria-hidden="true">
          <StackedFraction n={part.n} d={part.d} />
        </span>
      </span>
    ),
  )
}
