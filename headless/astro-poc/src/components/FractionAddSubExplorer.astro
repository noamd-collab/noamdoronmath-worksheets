---
/**
 * Fraction add / subtract explorer for two grade-5 topic pages
 * (engine: ../lib/fractionAddSubExplorer.ts).
 *
 *   add-subtract-fractions-grade-5  opens on 1/2 + 1/3 = 5/6
 *   common-denominator-grade-5      opens on 1/6 + 1/8, where 6 and 8 give 24
 *
 * Two strips, one per fraction, with +/− steppers for each numerator and
 * denominator and a +/− toggle for the operation. The strips are re-divided
 * into the common denominator, the parts are joined or taken away, and the
 * result is reduced and written in Hebrew. The first frame is rendered here,
 * complete, so the card stands before the script runs; the script replays
 * the steps unless motion is reduced.
 */
import {
  BELOW_ZERO_TEXT,
  DEFAULT_START,
  MINUS,
  START,
  VW,
  belowZeroBlocks,
  canStep,
  combine,
  scene,
  secondLarger,
  sentence,
  smallestHint,
} from '../lib/fractionAddSubExplorer';

interface Props {
  slug: string;
}
const { slug } = Astro.props;
const V = START[slug] ?? DEFAULT_START;
const op = 'add';
const r = combine(V, op);
const sc = scene(V, op);
const step = (k: 'a' | 'b' | 'c' | 'd', dir: 1 | -1) => !canStep(V, op, k, dir);
---

<div class="fs-explorer" data-fraction-add-sub data-slug={slug} data-op="add">
  <div class="fs-card">
    <p class="fs-ask">מחלקים את שני הפסים לחלקים באותו גודל, ורק אז מחברים או מחסרים.</p>
    <div class="fs-controls" dir="ltr">
      <span class="fs-frac fs-frac--a">
        <span class="fs-step">
          <button type="button" data-step="a:-1" aria-label="הקטנת המונה של השבר הראשון" disabled={step('a', -1)}>{MINUS}</button>
          <b data-el="a">{V.a}</b>
          <button type="button" data-step="a:1" aria-label="הגדלת המונה של השבר הראשון" disabled={step('a', 1)}>+</button>
        </span>
        <span class="fs-vinculum" />
        <span class="fs-step">
          <button type="button" data-step="b:-1" aria-label="הקטנת המכנה של השבר הראשון" disabled={step('b', -1)}>{MINUS}</button>
          <b data-el="b">{V.b}</b>
          <button type="button" data-step="b:1" aria-label="הגדלת המכנה של השבר הראשון" disabled={step('b', 1)}>+</button>
        </span>
      </span>
      <span class="fs-ops" role="group" aria-label="בחירת הפעולה">
        <button type="button" data-op="add" aria-pressed="true" aria-label="חיבור">+</button>
        <button type="button" data-op="sub" aria-pressed="false" aria-label="חיסור" disabled={secondLarger(V)}>{MINUS}</button>
      </span>
      <span class="fs-frac fs-frac--b">
        <span class="fs-step">
          <button type="button" data-step="c:-1" aria-label="הקטנת המונה של השבר השני" disabled={step('c', -1)}>{MINUS}</button>
          <b data-el="c">{V.c}</b>
          <button type="button" data-step="c:1" aria-label="הגדלת המונה של השבר השני" disabled={step('c', 1)}>+</button>
        </span>
        <span class="fs-vinculum" />
        <span class="fs-step">
          <button type="button" data-step="d:-1" aria-label="הקטנת המכנה של השבר השני" disabled={step('d', -1)}>{MINUS}</button>
          <b data-el="d">{V.d}</b>
          <button type="button" data-step="d:1" aria-label="הגדלת המכנה של השבר השני" disabled={step('d', 1)}>+</button>
        </span>
      </span>
    </div>

    <svg class="fs-svg" viewBox={`0 0 ${VW} ${sc.height}`} data-phase="3" aria-hidden="true" focusable="false">
      <g data-el="layer">
        {
          sc.shapes.map((s) =>
            s.k === 'rect' ? (
              <rect x={s.x} y={s.y} width={s.w} height={s.h} class={s.cls} />
            ) : s.k === 'line' ? (
              <line x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} class={s.cls} />
            ) : (
              <text x={s.x} y={s.y} text-anchor="middle" class={s.cls}>
                {s.text}
              </text>
            ),
          )
        }
      </g>
    </svg>

    <p class="fs-readout" dir="ltr">
      <span class="fs-q fs-q--a"><span data-el="a">{V.a}</span><span data-el="b">{V.b}</span></span>
      <span data-el="sign">+</span>
      <span class="fs-q fs-q--b"><span data-el="c">{V.c}</span><span data-el="d">{V.d}</span></span>
      <span>=</span>
      <span class="fs-q fs-q--a"><span data-el="an">{r.an}</span><span data-el="L">{r.L}</span></span>
      <span data-el="sign">+</span>
      <span class="fs-q fs-q--b"><span data-el="cn">{r.cn}</span><span data-el="L">{r.L}</span></span>
      <span>=</span>
      <span class="fs-q fs-ans"><span data-el="n">{r.n}</span><span data-el="L">{r.L}</span></span>
      <span data-el="reduced" class="fs-more" hidden={r.rn === r.n || r.n === 0 || r.rm === 1}>
        <span>=</span>
        <span class="fs-q fs-ans"><span data-el="rn">{r.rn}</span><span data-el="rm">{r.rm}</span></span>
      </span>
      <span data-el="mixed" class="fs-more" hidden={r.whole === 0 || r.pn === 0}>
        <span>=</span>
        <b class="fs-whole fs-ans" data-el="whole">{r.whole}</b>
        <span class="fs-q fs-ans"><span data-el="pn">{r.pn}</span><span data-el="pm">{r.pm}</span></span>
      </span>
      <span data-el="whole-only" class="fs-more" hidden={!(r.whole > 0 && r.pn === 0)}>
        <span>=</span>
        <b class="fs-whole fs-ans" data-el="whole">{r.whole}</b>
      </span>
    </p>
    <p class="fs-words" data-el="words">{sentence(V, op, r)}</p>
    <p class="fs-hint" data-el="smallest" hidden={!r.smallerThanProduct}>{smallestHint(V, r)}</p>
    <p class="fs-hint fs-hint--block" data-el="blocked" hidden={!belowZeroBlocks(V, op)}>{BELOW_ZERO_TEXT}</p>
    <p class="sr-only" aria-live="polite" data-el="live" />
  </div>
</div>

<script>
  import { initFractionAddSubExplorers } from '../lib/fractionAddSubExplorer';
  initFractionAddSubExplorers();
</script>

<style>
  .fs-explorer {
    margin: 6px 0 20px;
  }
  .fs-card {
    background: #fff;
    border: 1.5px solid rgba(26, 43, 74, 0.1);
    border-radius: 16px;
    box-shadow: var(--shadow-soft);
    padding: 14px 16px 12px;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  .fs-ask {
    margin: 0;
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--navy);
    text-align: center;
    text-wrap: balance;
  }

  /* steppers and the operation toggle */
  .fs-controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 10px 14px;
    direction: ltr;
  }
  .fs-frac {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .fs-frac--a b {
    color: #b7791f;
  }
  .fs-frac--b b {
    color: #1e605e;
  }
  .fs-step {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .fs-step b {
    min-width: 1.2em;
    text-align: center;
    font-size: 1.5rem;
    font-weight: 800;
  }
  .fs-step button,
  .fs-ops button {
    font: inherit;
    font-weight: 800;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1.5px solid rgba(26, 43, 74, 0.25);
    background: #fff;
    color: var(--navy);
    cursor: pointer;
    line-height: 1;
  }
  .fs-step button:disabled,
  .fs-ops button:disabled {
    opacity: 0.3;
    cursor: default;
  }
  .fs-step button:focus-visible,
  .fs-ops button:focus-visible {
    outline: 3px solid var(--cobalt);
    outline-offset: 2px;
  }
  .fs-vinculum {
    display: block;
    width: 40px;
    height: 2.5px;
    background: var(--navy);
    border-radius: 2px;
  }
  .fs-ops {
    display: inline-flex;
    gap: 6px;
    padding: 4px;
    border-radius: 999px;
    background: rgba(26, 43, 74, 0.06);
  }
  .fs-ops button {
    font-size: 1.3rem;
  }
  .fs-ops button[aria-pressed='true'] {
    background: var(--navy);
    color: #fff;
    border-color: var(--navy);
  }
  /* phones: both fractions and the toggle stay on one row */
  @media (max-width: 430px) {
    .fs-controls {
      gap: 8px 6px;
    }
    .fs-step {
      gap: 4px;
    }
    .fs-step b {
      font-size: 1.3rem;
    }
    .fs-step button {
      width: 32px;
      height: 32px;
    }
    .fs-ops {
      gap: 4px;
      padding: 3px;
    }
    .fs-ops button {
      width: 30px;
      height: 30px;
      font-size: 1.15rem;
    }
    .fs-vinculum {
      width: 34px;
    }
  }

  /* the strips */
  .fs-svg {
    display: block;
    width: min(100%, 340px);
    height: auto;
    overflow: visible;
  }
  .fs-svg :global(text) {
    font-family: inherit;
    font-weight: 700;
    font-size: 14px;
    fill: var(--navy);
  }
  .fs-svg :global(.fs-op) {
    font-size: 19px;
    font-weight: 800;
  }
  .fs-svg :global(.fs-step) {
    font-weight: 800;
  }
  .fs-svg :global(.fs-words) {
    font-size: 15px;
    font-weight: 800;
    fill: #e5735c;
  }
  .fs-svg :global(.fs-la) {
    fill: #b7791f;
    stroke: #b7791f;
  }
  .fs-svg :global(.fs-lb) {
    fill: #1e605e;
    stroke: #1e605e;
  }
  .fs-svg :global(.fs-lr) {
    fill: #e5735c;
    stroke: #e5735c;
  }
  .fs-svg :global(text.fs-la),
  .fs-svg :global(text.fs-lb),
  .fs-svg :global(text.fs-lr) {
    stroke: none;
  }
  .fs-svg :global(.fs-bar) {
    stroke: var(--navy);
    stroke-width: 2;
  }
  .fs-svg :global(.fs-a) {
    fill: rgba(230, 165, 52, 0.55);
  }
  .fs-svg :global(.fs-b) {
    fill: rgba(30, 96, 94, 0.4);
  }
  .fs-svg :global(.fs-gone) {
    fill: rgba(255, 255, 255, 0.78);
  }
  .fs-svg :global(.fs-x) {
    stroke: #b23a2a;
    stroke-width: 1.5;
  }
  .fs-svg :global(.fs-grid) {
    stroke: var(--navy);
    stroke-width: 1.5;
  }
  .fs-svg :global(.fs-fine) {
    stroke: rgba(26, 43, 74, 0.45);
    stroke-width: 1;
  }
  .fs-svg :global(.fs-frame) {
    fill: none;
    stroke: var(--navy);
    stroke-width: 2;
  }
  .fs-svg :global(.fs-result) {
    fill: none;
    stroke: #e5735c;
    stroke-width: 3;
  }

  /* the steps: 0 strips, 1 re-divided, 2 combined, 3 named */
  .fs-svg :global(.ph1),
  .fs-svg :global(.ph2),
  .fs-svg :global(.ph3) {
    opacity: 0;
    transition: opacity 0.45s ease, transform 0.45s ease;
  }
  .fs-svg :global(rect.ph2) {
    transform: translateY(-8px);
  }
  .fs-svg[data-phase='1'] :global(.ph1),
  .fs-svg[data-phase='2'] :global(.ph1),
  .fs-svg[data-phase='2'] :global(.ph2),
  .fs-svg[data-phase='3'] :global(.ph1),
  .fs-svg[data-phase='3'] :global(.ph2),
  .fs-svg[data-phase='3'] :global(.ph3) {
    opacity: 1;
  }
  .fs-svg[data-phase='2'] :global(rect.ph2),
  .fs-svg[data-phase='3'] :global(rect.ph2) {
    transform: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .fs-svg :global(.ph1),
    .fs-svg :global(.ph2),
    .fs-svg :global(.ph3) {
      transition: none;
      opacity: 1;
      transform: none;
    }
  }
  :global(html.noam-a11y-motion) .fs-svg :global(.ph1),
  :global(html.noam-a11y-motion) .fs-svg :global(.ph2),
  :global(html.noam-a11y-motion) .fs-svg :global(.ph3) {
    transition: none;
    opacity: 1;
    transform: none;
  }

  /* readout */
  .fs-readout {
    margin: 0;
    direction: ltr;
    unicode-bidi: isolate;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 1.15rem;
    font-weight: 700;
    color: var(--navy);
  }
  .fs-more {
    display: inline-flex;
    align-items: center;
    gap: 8px;
  }
  .fs-more[hidden] {
    display: none;
  }
  .fs-q {
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    line-height: 1.15;
  }
  .fs-q > span:first-child {
    border-bottom: 2px solid currentColor;
    padding: 0 3px;
  }
  .fs-q--a {
    color: #b7791f;
  }
  .fs-q--b {
    color: #1e605e;
  }
  .fs-ans {
    color: #e5735c;
  }
  .fs-whole {
    font-size: 1.35rem;
  }
  .fs-words {
    margin: 0;
    text-align: center;
    font-weight: 800;
    font-size: 1.1rem;
    color: var(--navy);
    text-wrap: balance;
  }
  .fs-hint {
    margin: 0;
    text-align: center;
    color: var(--muted);
    font-weight: 600;
    max-width: 34em;
  }
  .fs-hint--block {
    color: #b23a2a;
  }
  .fs-hint[hidden] {
    display: none;
  }
</style>
