---
import { lessonMathParts } from '../lib/lessonMath';
interface Props { value: string }
const { value } = Astro.props;
const parts = lessonMathParts(value);
const hasFraction = parts.some(part => typeof part !== 'string');
---
{hasFraction ? <span class="expression" role="math" dir="ltr" aria-label={value}>
  <span aria-hidden="true">{parts.map(part => typeof part === 'string'
    ? <span class="term">{part}</span>
    : <span class="fraction"><span class="numerator">{part.numerator}</span><span class="denominator">{part.denominator}</span></span>)}</span>
</span> : <bdi dir="ltr">{value}</bdi>}
<style>
  .expression { direction:ltr; unicode-bidi:isolate; font-size:inherit; color:inherit; }
  .term { white-space:pre; }
  .fraction { display:inline-grid; grid-template-rows:auto auto; vertical-align:middle; text-align:center; margin:0 .12em; line-height:1.35; }
  .numerator,.denominator { display:block; padding:.08em .2em; white-space:nowrap; }
  .numerator { border-bottom:1.5px solid currentColor; }
</style>
