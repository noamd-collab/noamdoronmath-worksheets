---
import { lessonMathParts } from '../lib/lessonMath';
interface Props { value: string }
const { value } = Astro.props;
const parts = lessonMathParts(value);
const hasFraction = parts.some(part => typeof part !== 'string');
---
{hasFraction ? <math xmlns="http://www.w3.org/1998/Math/MathML" dir="ltr" displaystyle="true" aria-label={value}>
  <mrow>{parts.map(part => typeof part === 'string'
    ? <mtext>{part}</mtext>
    : <mfrac><mtext>{part.numerator}</mtext><mtext>{part.denominator}</mtext></mfrac>)}</mrow>
</math> : <bdi dir="ltr">{value}</bdi>}
<style>
  math { direction:ltr; unicode-bidi:isolate; vertical-align:middle; font-size:inherit; color:inherit; }
  mtext { font-family:Heebo,sans-serif; font-weight:700; white-space:pre; }
</style>
