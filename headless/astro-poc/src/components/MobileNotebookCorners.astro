---
/**
 * Mobile+desktop organic φ scatter for topic pages (absolute, no strip).
 * Every doodle bobs + wobbles when motion is allowed.
 */
import manifest from '../data/doodles.manifest.json';
import { selectNotebookScatter } from '../lib/doodles/selectNotebookScatter';
import MathScribbles from './MathScribbles.astro';
import type { DoodleMotif } from '../lib/doodles/selectSiteDoodles';

export interface Props {
  seed: string;
  preferred?: string[];
  count?: number;
}

const { seed, preferred = [], count = 5 } = Astro.props;
const motifs = (manifest.motifs || []) as DoodleMotif[];
const scatter = selectNotebookScatter(seed, motifs, {
  preferred,
  count: Math.min(6, Math.max(4, count)),
  scribbleCount: 3,
});
---

{
  scatter.motifs.length > 0 && (
    <div
      class="mobile-nb-corners"
      aria-hidden="true"
      data-mobile-nb-corners
      data-notebook-seed={seed}
    >
      {scatter.motifs.map((m) => (
        <img
          class="mobile-nb-corner mobile-nb-corner--motion"
          src={m.src}
          alt=""
          width={m.sizePx}
          height={m.sizePx}
          decoding="async"
          loading="lazy"
          data-doodle-id={m.id}
          data-nb-side={m.side}
          style={[
            `--d-size:${m.sizePx}px`,
            `--m-size:${m.mobileSizePx}px`,
            `--r:${m.rotate}deg`,
            `--d-op:${m.opacity}`,
            `--m-op:${m.mobileOpacity}`,
            `--d-delay:${m.delay}s`,
            `--d-dur:${m.duration}s`,
            `--d-bob:${m.bobPx}px`,
            `--d-wobble:${m.wobbleDeg}deg`,
            `--x:${m.xPct}%`,
            `--y:${m.yPct}%`,
          ].join(';')}
        />
      ))}
      <MathScribbles items={scatter.scribbles} organicMobile />
    </div>
  )
}

<style>
  .mobile-nb-corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    overflow: visible;
  }
  .mobile-nb-corner {
    position: absolute;
    display: block;
    left: var(--x, 38.2%);
    top: var(--y, 61.8%);
    width: var(--d-size, 45px);
    max-width: min(120px, 22vw);
    height: auto;
    opacity: var(--d-op, 0.75);
    transform: translate(-50%, -50%) rotate(var(--r, 0deg));
    z-index: 0;
  }
  .mobile-nb-corner--motion {
    animation: topic-nb-bob-wobble var(--d-dur, 6.5s) ease-in-out infinite;
    animation-delay: var(--d-delay, 0s);
    will-change: transform;
  }
  @keyframes topic-nb-bob-wobble {
    0%,
    100% {
      transform: translate(-50%, -50%) translateY(0)
        rotate(calc(var(--r, 0deg) - var(--d-wobble, 4deg)));
    }
    50% {
      transform: translate(-50%, -50%) translateY(calc(-1 * var(--d-bob, 6px)))
        rotate(calc(var(--r, 0deg) + var(--d-wobble, 4deg)));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nb-corner--motion {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .mobile-nb-corner--motion,
  :global(html.nd-motion-off) .mobile-nb-corner--motion {
    animation: none !important;
  }
  @media (max-width: 767px) {
    .mobile-nb-corner {
      width: var(--m-size, 36px);
      max-width: 73px;
      opacity: var(--m-op, 0.7);
    }
  }
  /* Topic pages: keep φ scatter on desktop too (SiteDoodles gutters are separate) */
  @media print {
    .mobile-nb-corners {
      display: none !important;
    }
  }
</style>
