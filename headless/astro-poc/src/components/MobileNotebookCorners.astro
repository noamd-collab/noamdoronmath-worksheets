---
/**
 * Topic-page marginalia (absolute edge gutters, no strip).
 * Diagonal φ descent; every doodle bobs + wobbles when motion is allowed.
 */
import manifest from '../data/doodles.manifest.json';
import { selectNotebookScatter } from '../lib/doodles/selectNotebookScatter';
import MathScribbles from './MathScribbles.astro';
import type { DoodleMotif } from '../lib/doodles/selectSiteDoodles';

export interface Props {
  seed: string;
  preferred?: string[];
  count?: number;
}

const { seed, preferred = [], count = 3 } = Astro.props;
const motifs = (manifest.motifs || []) as DoodleMotif[];
const scatter = selectNotebookScatter(seed, motifs, {
  preferred,
  count: Math.min(4, Math.max(2, count)),
  scribbleCount: 2,
});
---

{
  scatter.motifs.length > 0 && (
    <div
      class="mobile-nb-corners"
      aria-hidden="true"
      data-mobile-nb-corners
      data-notebook-seed={seed}
    >
      {scatter.motifs.map((m, i) => (
        <img
          class:list={[
            'mobile-nb-corner',
            'mobile-nb-corner--motion',
            m.side === 'start' ? 'mobile-nb-corner--start' : 'mobile-nb-corner--end',
            i < 2 ? 'mobile-nb-corner--mobile-show' : 'mobile-nb-corner--mobile-hide',
          ]}
          src={m.src}
          alt=""
          width={m.sizePx}
          height={m.sizePx}
          decoding="async"
          loading="lazy"
          data-doodle-id={m.id}
          data-nb-side={m.side}
          style={[
            `--d-size:${m.sizePx}px`,
            `--m-size:${m.mobileSizePx}px`,
            `--r:${m.rotate}deg`,
            `--d-op:${m.opacity}`,
            `--m-op:${m.mobileOpacity}`,
            `--d-delay:${m.delay}s`,
            `--d-dur:${m.duration}s`,
            `--d-bob:${m.bobPx}px`,
            `--d-wobble:${m.wobbleDeg}deg`,
            `--inline-inset:${m.inlineInsetPct}%`,
            `--y:${m.yPct}%`,
          ].join(';')}
        />
      ))}
      <MathScribbles items={scatter.scribbles} organicMobile />
    </div>
  )
}

<style>
  .mobile-nb-corners {
    position: absolute;
    inset: 0;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    overflow: visible;
  }
  .mobile-nb-corner {
    position: absolute;
    display: block;
    inset-block-start: var(--y, 38.2%);
    width: var(--d-size, 45px);
    max-width: min(96px, 12vw);
    height: auto;
    opacity: var(--d-op, 0.75);
    transform: translateY(-50%) rotate(var(--r, 0deg));
    z-index: 0;
  }
  .mobile-nb-corner--start {
    inset-inline-start: var(--inline-inset, 4%);
    inset-inline-end: auto;
  }
  .mobile-nb-corner--end {
    inset-inline-end: var(--inline-inset, 4%);
    inset-inline-start: auto;
  }
  .mobile-nb-corner--motion {
    animation: topic-nb-bob-wobble var(--d-dur, 6.5s) ease-in-out infinite;
    animation-delay: var(--d-delay, 0s);
    will-change: transform;
  }
  @keyframes topic-nb-bob-wobble {
    0%,
    100% {
      transform: translateY(-50%) translateY(0)
        rotate(calc(var(--r, 0deg) - var(--d-wobble, 4deg)));
    }
    50% {
      transform: translateY(-50%) translateY(calc(-1 * var(--d-bob, 6px)))
        rotate(calc(var(--r, 0deg) + var(--d-wobble, 4deg)));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-nb-corner--motion {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .mobile-nb-corner--motion,
  :global(html.nd-motion-off) .mobile-nb-corner--motion {
    animation: none !important;
  }
  @media (max-width: 767px) {
    .mobile-nb-corner--mobile-hide {
      display: none !important;
    }
    .mobile-nb-corner--mobile-show {
      width: var(--m-size, 24px);
      max-width: 39px;
      opacity: var(--m-op, 0.7);
    }
    .mobile-nb-corner--mobile-show.mobile-nb-corner--start {
      inset-inline-start: -6px;
    }
    .mobile-nb-corner--mobile-show.mobile-nb-corner--end {
      inset-inline-end: -6px;
    }
  }
  @media print {
    .mobile-nb-corners {
      display: none !important;
    }
  }
</style>
