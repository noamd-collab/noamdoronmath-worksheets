---
import ConceptLoop from './ConceptLoop.astro';
import type { Props as ConceptLoopProps } from './ConceptLoop.astro';
import { gradeHubLabel, type GradeHubGrade } from '../lib/gradeHubs';
import {
  GRADE_LOOP_HOLD_S,
  gradeLoopCopy,
  gradeLoopMathParts,
  type GradeLoopEntry,
} from '../lib/gradeLoopPools';
import { splitSupFractions } from '../lib/stackedFraction';

interface Props {
  grade: GradeHubGrade;
  pool: GradeLoopEntry[];
  defaultVariant: string;
}
type Variant = ConceptLoopProps['variant'];

const { grade, pool, defaultVariant } = Astro.props;
const gradeLabel = gradeHubLabel(grade);
const gradeTag = `הדגמה · כיתה ${gradeLabel}`;
const defaultEntry: GradeLoopEntry = pool.find((entry) => entry.variant === defaultVariant) ?? {
  variant: defaultVariant,
  label: 'הדגמה מתמטית',
  href: `/worksheets?grade=${grade}`,
  ...gradeLoopCopy(defaultVariant),
  hold: GRADE_LOOP_HOLD_S[defaultVariant],
};
const mathParts = gradeLoopMathParts(defaultEntry.mathLine);
const others = pool.filter((entry) => entry.variant !== defaultVariant);
const isCatalog = defaultEntry.href.startsWith('/worksheets');
---
{/* No-JS/SEO render the same default loop as before, plus the static grade
    tag; later variants stay inert in templates. Auto-scrolling the player into
    view on mobile is an open item for a later stage. */}
<div class="grade-loop" data-grade-loop role="group" aria-label={gradeTag}>
  <p class="grade-loop__grade" data-grade-loop-grade>{gradeTag}</p>
  <div data-grade-loop-current>
    <ConceptLoop variant={defaultVariant as Variant} />
  </div>
  <div class="grade-loop__progress" data-grade-loop-progress aria-hidden="true" hidden>
    <span class="grade-loop__progress-fill" data-grade-loop-progress-fill></span>
  </div>
  {
    others.map((entry) => (
      <template data-grade-loop-variant={entry.variant}>
        <ConceptLoop variant={entry.variant as Variant} />
      </template>
    ))
  }
  <script type="application/json" data-grade-loop-pool set:html={JSON.stringify(pool)} />
  <div class="grade-loop__bar">
    <div class="grade-loop__text" data-grade-loop-text aria-live="polite">
      <p class="grade-loop__domain" data-grade-loop-domain>{defaultEntry.domain}</p>
      <p class="grade-loop__title" data-grade-loop-label>{defaultEntry.claim}</p>
      <p class="grade-loop__math" data-grade-loop-math>
        {mathParts.map((part) =>
          part.math ? (
            <bdi dir="ltr">
              {splitSupFractions(part.text).map((piece) =>
                piece.kind === 'frac' ? (
                  <span class:list={['cl-frac', defaultEntry.variant === 'tenth-cell' && 'cl-frac--tight']}>
                    <span class="cl-frac__n">{piece.n}</span>
                    <span class="cl-frac__d">{piece.d}</span>
                  </span>
                ) : (
                  piece.text
                )
              )}
            </bdi>
          ) : (
            part.text
          )
        )}
      </p>
      <p class="grade-loop__explain" data-grade-loop-explain>{defaultEntry.explain}</p>
      <a
        class="grade-loop__link"
        data-grade-loop-link
        href={defaultEntry.href}
        data-peek={isCatalog ? 'ws' : 'topic'}
      >
        לדפי העבודה בנושא ←
      </a>
    </div>
    {
      others.length > 0 && (
        <div class="grade-loop__controls">
          <button
            type="button"
            class="grade-loop__pause"
            data-grade-loop-pause
            data-state="playing"
            aria-label="השהיית ההדגמות"
            hidden
          >
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
              <g class="grade-loop__ic-pause">
                <rect x="3" y="2.5" width="3.4" height="11" rx="1.2" />
                <rect x="9.6" y="2.5" width="3.4" height="11" rx="1.2" />
              </g>
              <path class="grade-loop__ic-play" d="M4 2.2 L13.4 8 L4 13.8 Z" />
            </svg>
          </button>
          <button
            type="button"
            class="grade-loop__next"
            data-grade-loop-next
            aria-label="ללולאה הבאה"
            hidden
          >
            ללולאה הבאה ←
          </button>
        </div>
      )
    }
  </div>
</div>

<script>
  import { initConceptLoops } from '../lib/conceptLoops';
  import { gradeLoopMathParts, type GradeLoopEntry as Entry } from '../lib/gradeLoopPools';
  import { splitSupFractions } from '../lib/stackedFraction';
  import {
    GRADE_LOOP_FALLBACK_END_S,
    createGradeLoopRotation,
    createGradeLoopSlowClock,
  } from '../lib/gradeLoopRotation';

  type LoopState = { playing: boolean; done: boolean; static: boolean };
  type Loop = HTMLElement & {
    __loop?: { seek(t: number): void; pause(): void; play(): void; state(): LoopState };
  };

  const TICK_MS = 500;

  function bootGradeLoop(root: HTMLElement) {
    if (root.dataset.gradeLoopReady === 'ready') return;
    const current = root.querySelector<HTMLElement>('[data-grade-loop-current]');
    const domain = root.querySelector<HTMLElement>('[data-grade-loop-domain]');
    const label = root.querySelector<HTMLElement>('[data-grade-loop-label]');
    const math = root.querySelector<HTMLElement>('[data-grade-loop-math]');
    const explain = root.querySelector<HTMLElement>('[data-grade-loop-explain]');
    const link = root.querySelector<HTMLAnchorElement>('[data-grade-loop-link]');
    const progress = root.querySelector<HTMLElement>('[data-grade-loop-progress]');
    const fill = root.querySelector<HTMLElement>('[data-grade-loop-progress-fill]');
    const pauseButton = root.querySelector<HTMLButtonElement>('[data-grade-loop-pause]');
    const nextButton = root.querySelector<HTMLButtonElement>('[data-grade-loop-next]');
    const initial = current?.querySelector<Loop>('[data-loop]');
    let pool: Entry[] = [];
    try {
      pool = JSON.parse(root.querySelector('[data-grade-loop-pool]')?.textContent || '[]');
    } catch { /* A broken pool keeps the static default loop. */ }
    if (!current || !initial?.dataset.loop || pool.length < 2) return;
    root.dataset.gradeLoopReady = 'ready';

    const entries = new Map(pool.map((entry) => [entry.variant, entry] as const));
    const originals = new Map<string, HTMLElement>();
    const mounted = new Map<string, Loop>([[initial.dataset.loop, initial]]);
    const adapted = new WeakSet<Loop>();
    const wasStatic = new WeakMap<Loop, boolean>();
    const cache = document.createElement('div');
    cache.hidden = true;
    cache.style.display = 'none';
    cache.setAttribute('aria-hidden', 'true');
    cache.dataset.gradeLoopCache = '';
    root.append(cache);

    root.querySelectorAll<HTMLTemplateElement>('template[data-grade-loop-variant]').forEach((template) => {
      const variant = template.dataset.gradeLoopVariant;
      const source = template.content.querySelector<HTMLElement>('[data-loop]');
      if (variant && source) originals.set(variant, source);
    });

    const activeLoop = () => current.querySelector<Loop>('[data-loop]');
    const pauseKey = (loop: Loop) => `k3-pause:${loop.dataset.loop || ''}`;
    const manuallyPaused = (loop: Loop) => {
      try { return sessionStorage.getItem(pauseKey(loop)) === '1'; } catch { return false; }
    };
    function rememberPause(loop: Loop, paused: boolean) {
      try {
        if (paused) sessionStorage.setItem(pauseKey(loop), '1');
        else sessionStorage.removeItem(pauseKey(loop));
      } catch { /* Session storage is optional, as in the existing pause card. */ }
    }

    function describe(variant: string) {
      const entry = entries.get(variant);
      if (!entry) return;
      if (domain) domain.textContent = entry.domain;
      if (label) label.textContent = entry.claim;
      if (math) {
        math.textContent = '';
        math.append(...gradeLoopMathParts(entry.mathLine).map((part) => {
          if (!part.math) return part.text;
          const run = document.createElement('bdi');
          run.dir = 'ltr';
          for (const piece of splitSupFractions(part.text)) {
            if (piece.kind === 'text') {
              run.append(piece.text);
              continue;
            }
            const frac = document.createElement('span');
            frac.className = entry.variant === 'tenth-cell' ? 'cl-frac cl-frac--tight' : 'cl-frac';
            const num = document.createElement('span');
            num.className = 'cl-frac__n';
            num.textContent = piece.n;
            const den = document.createElement('span');
            den.className = 'cl-frac__d';
            den.textContent = piece.d;
            frac.append(num, den);
            run.append(frac);
          }
          return run;
        }));
      }
      if (explain) explain.textContent = entry.explain;
      if (link) {
        link.href = entry.href;
        link.dataset.peek = entry.href.startsWith('/worksheets') ? 'ws' : 'topic';
      }
    }

    // Use the unchanged engine's toggle, not a second animation clock.
    function restoreManualPause(loop: Loop) {
      const state = loop.__loop?.state();
      const toggle = loop.querySelector<HTMLButtonElement>('[data-el="toggle"]');
      if (!state || state.static || !toggle || !manuallyPaused(loop)) return;
      if (!state.playing) toggle.click();
      toggle.click();
    }

    // A revisited loop starts again from zero; a parked one replays.
    function restartLoop(loop: Loop) {
      const state = loop.__loop?.state();
      if (!state || state.static || manuallyPaused(loop)) return;
      if (state.done) {
        loop.querySelector<HTMLButtonElement>('[data-el="toggle"]')?.click();
        return;
      }
      loop.__loop?.seek(0);
      loop.__loop?.play();
    }

    function syncActiveCard() {
      const loop = activeLoop();
      if (!loop || !adapted.has(loop)) return; // Initial card keeps its original adapter.
      const card = loop.querySelector<HTMLElement>('[data-pause-card]');
      const state = loop.__loop?.state();
      if (!card || !state) return;
      const motionResumed = wasStatic.get(loop) && !state.static;
      wasStatic.set(loop, state.static);
      if (motionResumed) restoreManualPause(loop);
      const paused = !loop.__loop?.state().playing && !state.static;
      card.classList.toggle('is-paused', paused);
      card.setAttribute('aria-pressed', String(paused));
      card.setAttribute('aria-label', paused ? 'הפעלת הנפשה' : 'השהיית הנפשה');
      card.setAttribute('aria-disabled', String(state.static));
      card.tabIndex = state.static ? -1 : 0;
    }

    function activateCard(loop: Loop) {
      const state = loop.__loop?.state();
      if (!state || state.static) return;
      loop.querySelector<HTMLButtonElement>('[data-el="toggle"]')?.click();
      rememberPause(loop, !loop.__loop?.state().playing);
      syncActiveCard();
    }

    // One delegated adapter for later template mounts only. The initial
    // ConceptLoop already owns its click, keyboard and session logic.
    current.addEventListener('click', (event) => {
      const loop = activeLoop();
      const target = event.target instanceof Element ? event.target : null;
      if (!loop || !adapted.has(loop) || !target?.closest('[data-pause-card]')) return;
      if (target.closest('[data-el="toggle"]')) {
        rememberPause(loop, !loop.__loop?.state().playing);
        syncActiveCard();
      } else activateCard(loop);
    });
    current.addEventListener('keydown', (event) => {
      const loop = activeLoop();
      const target = event.target instanceof Element ? event.target : null;
      if (!loop || !adapted.has(loop) || !target?.closest('[data-pause-card]')) return;
      if (event.key === 'Enter' || event.key === ' ' || event.key === 'Spacebar') {
        event.preventDefault();
        activateCard(loop);
      }
    });

    // The diagram card starts its own loop at 35% of its box. That card sits
    // under the player label, so the taller player is only ~27% on screen when
    // the diagram is already playing. A 0.35 threshold on the player left the
    // rotation clock frozen: the slow clock still ran the demo to its hold
    // frame, then nothing advanced. 0.15 stays under that coupling, on every
    // grade landing that uses this player.
    let inView = !('IntersectionObserver' in window);
    if (!inView) {
      new IntersectionObserver((records) => {
        inView = records[0].isIntersecting;
      }, { threshold: 0.15 }).observe(root);
    }

    function resetProgress() {
      if (!fill) return;
      fill.style.transition = 'none';
      fill.style.transform = 'scaleX(0)';
      void fill.offsetWidth;
      fill.style.transition = '';
    }

    const rotation = createGradeLoopRotation(
      {
        inView: () => inView,
        pageHidden: () => document.hidden,
        state: (variant) => mounted.get(variant)?.__loop?.state(),
        manuallyPaused: (variant) => {
          const loop = mounted.get(variant);
          return loop ? manuallyPaused(loop) : false;
        },
        mount(variant, firstVisit) {
          let next = mounted.get(variant);
          if (!next) {
            const source = originals.get(variant);
            if (!source) return;
            next = source.cloneNode(true) as Loop;
            mounted.set(variant, next);
            adapted.add(next);
          }
          // The engine has no destroy API. Each variant is initialized once
          // and kept connected, hidden and paused while inactive.
          const prior = activeLoop();
          const hadFocus = !!prior?.contains(document.activeElement);
          prior?.__loop?.pause();
          if (prior) cache.append(prior);
          current.append(next);
          if (firstVisit) initConceptLoops();
          restoreManualPause(next);
          if (!firstVisit) restartLoop(next);
          slow.reset(endOf(variant));
          wasStatic.set(next, next.__loop?.state().static || false);
          describe(variant);
          resetProgress();
          syncActiveCard();
          syncControls();
          if (hadFocus) next.querySelector<HTMLElement>('[data-pause-card]')?.focus();
        },
        // The slowed loop ends on SPECS.hold, the engine's own completed frame
        // (where it parks and what reduced motion shows); by duration every
        // lap has faded out. Without a known hold time the loop simply swaps
        // at 15 s (approved fallback).
        hold(variant) {
          const loop = mounted.get(variant);
          const hold = entries.get(variant)?.hold;
          if (!loop?.__loop || typeof hold !== 'number') return;
          loop.__loop.seek(hold);
          loop.__loop.pause();
        },
      },
      pool.map((entry) => entry.variant),
      initial.dataset.loop
    );

    // ×1.8 without touching the engine: it keeps playing (so its state, pause
    // card and off-screen stop are unchanged), and this frame loop re-seeks it
    // to t_real / 1.8 after each engine frame. Its lap never reaches duration,
    // so it never parks; at the completed frame the rotation holds it to 15 s.
    const endOf = (variant: string) => entries.get(variant)?.hold ?? GRADE_LOOP_FALLBACK_END_S;
    const slow = createGradeLoopSlowClock({
      running() {
        const loop = activeLoop();
        const state = loop?.__loop?.state();
        return !!loop && !!state && state.playing && !state.static && !rotation.held() && !manuallyPaused(loop) && inView;
      },
      seek: (t) => activeLoop()?.__loop?.seek(t),
      ended: () => rotation.hold(),
    });
    slow.reset(endOf(initial.dataset.loop));

    // Reduced motion: no frame loop and no seek, only the static frame.
    let frameId = 0;
    let lastFrame = 0;
    function slowFrame(now: number) {
      const state = activeLoop()?.__loop?.state();
      if (!state || state.static) {
        frameId = 0;
        // When motion comes back the engine restarts from zero; so does this clock.
        const variant = activeLoop()?.dataset.loop;
        if (variant) slow.reset(endOf(variant));
        return;
      }
      slow.frame(now - lastFrame);
      lastFrame = now;
      frameId = requestAnimationFrame(slowFrame);
    }
    function runSlowClock() {
      const state = activeLoop()?.__loop?.state();
      if (frameId || !state || state.static) return;
      lastFrame = performance.now();
      frameId = requestAnimationFrame(slowFrame);
    }

    function syncControls() {
      const loop = activeLoop();
      const state = loop?.__loop?.state();
      const isStatic = !state || state.static;
      root.toggleAttribute('data-grade-loop-static', isStatic);
      if (progress) progress.hidden = isStatic;
      if (fill) fill.style.transform = `scaleX(${rotation.progress()})`;
      if (pauseButton) {
        pauseButton.hidden = isStatic;
        const paused = !!loop && !!state &&
          (manuallyPaused(loop) || (!state.playing && !state.done && !rotation.held()));
        pauseButton.dataset.state = paused ? 'paused' : 'playing';
        pauseButton.setAttribute('aria-label', paused ? 'הפעלת ההדגמות' : 'השהיית ההדגמות');
      }
      runSlowClock();
    }

    // Reduced motion shows the static completed frame with no rotation and no
    // ▶ (hidden in CSS); "ללולאה הבאה" still steps between completed frames.
    // A one-shot "▶ פעם אחת" is deferred until the engine supports it (it
    // refuses to play while static).
    pauseButton?.addEventListener('click', () => {
      const loop = activeLoop();
      const card = loop?.querySelector<HTMLElement>('[data-pause-card]');
      const state = loop?.__loop?.state();
      if (!loop || !card || !state || state.static) return;
      // A held loop is paused by the player, so release it first; the second
      // click is then a real, remembered user pause.
      if (rotation.held() && !manuallyPaused(loop)) card.click();
      card.click();
      syncControls();
    });

    if (nextButton) {
      nextButton.hidden = false;
      nextButton.addEventListener('click', () => rotation.next());
    }
    // RTL: the "next" arrow points left.
    root.addEventListener('keydown', (event) => {
      if (event.key !== 'ArrowLeft' || event.altKey || event.ctrlKey || event.metaKey || event.shiftKey) return;
      event.preventDefault();
      rotation.next();
    });

    const queueSync = () => queueMicrotask(() => {
      syncActiveCard();
      syncControls();
    });
    new MutationObserver(queueSync).observe(document.documentElement, { attributes: true, attributeFilter: ['class'] });
    window.matchMedia('(prefers-reduced-motion: reduce)').addEventListener('change', queueSync);
    window.addEventListener('nd:motion-off', queueSync);
    syncControls();
    // One timer drives the rotation clock, the progress bar and the card's ARIA.
    window.setInterval(() => {
      syncActiveCard();
      rotation.tick(TICK_MS);
      syncControls();
    }, TICK_MS);
  }

  // After ConceptLoop's own pause-card setup (DOMContentLoaded + one frame),
  // so no cloned card can receive that adapter as well as this one.
  // noam-accessibility.js holds requestAnimationFrame while animations are
  // stopped, so a frames-only boot never ran and the player stayed unadapted.
  // The same start() also runs from a macrotask if those frames never fire.
  function boot() {
    let started = false;
    const start = () => {
      if (started) return;
      started = true;
      document.querySelectorAll<HTMLElement>('[data-grade-loop]').forEach(bootGradeLoop);
    };
    requestAnimationFrame(() => requestAnimationFrame(start));
    setTimeout(start, 120);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else boot();
</script>

<style>
  .grade-loop__grade {
    display: inline-block;
    margin: 0 0 14px;
    background: #fff;
    border: 1.5px solid #22305a;
    border-radius: 999px;
    padding: 4px 12px;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.4;
    color: #22305a;
  }

  .grade-loop__progress {
    margin-block-start: 14px;
    block-size: 4px;
    background: rgba(42, 124, 122, .15);
    border-radius: 999px;
    overflow: hidden;
  }

  .grade-loop__progress[hidden] {
    display: none;
  }

  /* RTL: the bar fills from the inline start (right). */
  .grade-loop__progress-fill {
    display: block;
    block-size: 100%;
    background: #2a7c7a;
    transform: scaleX(0);
    transform-origin: right center;
    transition: transform 500ms linear;
  }

  .grade-loop__progress-fill:dir(ltr) {
    transform-origin: left center;
  }

  .grade-loop__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: 12px 20px;
    margin-block-start: 16px;
  }

  .grade-loop__text {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    flex: 1 1 280px;
    min-width: 0;
  }

  .grade-loop__text p {
    margin: 0;
  }

  .grade-loop__domain {
    font-size: 14px;
    font-weight: 700;
    color: #5a6588;
  }

  .grade-loop__title {
    font-family: 'Secular One', sans-serif;
    font-weight: 400;
    font-size: clamp(26px, 2.6vw, 32px);
    line-height: 1.2;
    color: #22305a;
  }

  .grade-loop__math {
    font-size: 19px;
    font-weight: 700;
    line-height: 1.5;
    color: #22305a;
  }

  /* :global — swaps rebuild these runs in the script, without the scope attribute. */
  .grade-loop__math :global(bdi) {
    unicode-bidi: isolate;
    font-variant-numeric: tabular-nums;
  }

  .grade-loop__explain {
    font-size: 19px;
    line-height: 1.5;
    color: #3d4870;
  }

  /* 19px bold is large text, so the coral hover (3:1) still meets AA. */
  .grade-loop__link {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    font-size: 19px;
    font-weight: 700;
    color: #1e605e;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .grade-loop__link:hover {
    color: #e5735c;
  }

  .grade-loop__controls {
    display: flex;
    gap: 10px;
    align-items: center;
  }

  .grade-loop__pause,
  .grade-loop__next {
    min-block-size: 44px;
    border: 2px solid #22305a;
    border-radius: 12px;
    background: #fff;
    font: 700 16px Heebo, sans-serif;
    color: #22305a;
    cursor: pointer;
  }

  .grade-loop__next {
    padding-block: 8px;
    padding-inline: 16px;
  }

  .grade-loop__pause {
    display: inline-grid;
    place-items: center;
    inline-size: 44px;
    padding: 0;
  }

  .grade-loop__pause svg {
    inline-size: 16px;
    block-size: 16px;
    fill: currentColor;
  }

  .grade-loop__pause[data-state='playing'] .grade-loop__ic-play,
  .grade-loop__pause[data-state='paused'] .grade-loop__ic-pause {
    display: none;
  }

  .grade-loop__pause:hover,
  .grade-loop__next:hover {
    background: #fdf1d8;
  }

  .grade-loop__pause:focus-visible,
  .grade-loop__next:focus-visible,
  .grade-loop__link:focus-visible {
    outline: 3px solid #2a7c7a;
    outline-offset: 2px;
  }

  .grade-loop__pause[hidden],
  .grade-loop__next[hidden] {
    display: none;
  }

  /* Reduced motion: no ▶ at all, neither the engine's corner toggle nor the
     pause button; "ללולאה הבאה" stays. */
  @media (prefers-reduced-motion: reduce) {
    .grade-loop__progress-fill {
      transition: none;
    }

    .grade-loop :global([data-el='toggle']),
    .grade-loop__pause {
      display: none !important;
    }
  }

  :global(html.nd-motion-off) .grade-loop :global([data-el='toggle']),
  :global(html.noam-a11y-motion) .grade-loop :global([data-el='toggle']),
  :global(html.nd-motion-off) .grade-loop__pause,
  :global(html.noam-a11y-motion) .grade-loop__pause {
    display: none !important;
  }
</style>
