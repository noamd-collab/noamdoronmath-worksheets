---
import { textParts } from '../lib/topicText';
import { lessonMathParts } from '../lib/lessonMath';
import LessonMath from './LessonMath.astro';
interface Props { value: string }
const { value } = Astro.props;
---
{textParts(value).map(part => part.nowrap
  ? <span class="topic-math-nowrap"><LessonMath value={part.text}/></span>
  : lessonMathParts(part.text).map(piece => typeof piece === 'string' ? piece
    : <LessonMath value={`⟨${piece.numerator}¦${piece.denominator}⟩`}/>))}
