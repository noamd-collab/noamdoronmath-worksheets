---
/**
 * Golden-ratio notebook scatter per home section (3–6 webps + scribbles).
 * Absolute φ anchors on desktop AND mobile — never a flex/grid strip.
 * Every doodle bobs + wobbles when motion is allowed.
 */
import manifest from '../data/doodles.manifest.json';
import { selectNotebookScatter } from '../lib/doodles/selectNotebookScatter';
import MathScribbles from './MathScribbles.astro';
import type { DoodleMotif } from '../lib/doodles/selectSiteDoodles';

export interface Props {
  seed: string;
  preferred?: string[];
  count?: number;
  scribbleCount?: number;
}

const { seed, preferred = [], count = 5, scribbleCount = 3 } = Astro.props;
const motifs = (manifest.motifs || []) as DoodleMotif[];
const scatter = selectNotebookScatter(seed, motifs, {
  preferred,
  count,
  scribbleCount,
});
---

{
  scatter.motifs.length > 0 && (
    <div
      class="home-section-notebook"
      aria-hidden="true"
      data-home-section-notebook
      data-notebook-seed={seed}
    >
      {scatter.motifs.map((m) => (
        <img
          class="home-nb-doodle home-nb-doodle--motion"
          src={m.src}
          alt=""
          width={m.sizePx}
          height={m.sizePx}
          decoding="async"
          loading="lazy"
          data-doodle-id={m.id}
          data-home-section-doodle
          data-nb-side={m.side}
          style={[
            `--d-size:${m.sizePx}px`,
            `--m-size:${m.mobileSizePx}px`,
            `--r:${m.rotate}deg`,
            `--d-op:${m.opacity}`,
            `--m-op:${m.mobileOpacity}`,
            `--d-delay:${m.delay}s`,
            `--d-dur:${m.duration}s`,
            `--d-bob:${m.bobPx}px`,
            `--d-wobble:${m.wobbleDeg}deg`,
            `--x:${m.xPct}%`,
            `--y:${m.yPct}%`,
          ].join(';')}
        />
      ))}
      <MathScribbles items={scatter.scribbles} organicMobile />
    </div>
  )
}

<style>
  /*
   * Absolute φ scatter on every viewport — kills the flat flex bottom row.
   * Parent section must be position:relative + overflow-x:clip.
   */
  .home-section-notebook {
    position: absolute;
    inset: 0;
    display: block;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    overflow: visible;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .home-nb-doodle {
    position: absolute;
    display: block;
    /* Physical % — works in RTL; left/top so φ points stay stable */
    left: var(--x, 38.2%);
    top: var(--y, 61.8%);
    width: var(--d-size, 45px);
    max-width: min(120px, 22vw);
    height: auto;
    opacity: var(--d-op, 0.8);
    transform: translate(-50%, -50%) rotate(var(--r, 0deg));
    transform-origin: center center;
    z-index: 0;
  }
  .home-nb-doodle--motion {
    animation: nb-doodle-bob-wobble var(--d-dur, 6.5s) ease-in-out infinite;
    animation-delay: var(--d-delay, 0s);
    will-change: transform;
  }
  @keyframes nb-doodle-bob-wobble {
    0%,
    100% {
      transform: translate(-50%, -50%) translateY(0)
        rotate(calc(var(--r, 0deg) - var(--d-wobble, 4deg)));
    }
    50% {
      transform: translate(-50%, -50%) translateY(calc(-1 * var(--d-bob, 6px)))
        rotate(calc(var(--r, 0deg) + var(--d-wobble, 4deg)));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-nb-doodle--motion {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .home-nb-doodle--motion,
  :global(html.nd-motion-off) .home-nb-doodle--motion {
    animation: none !important;
  }

  @media (max-width: 767px) {
    .home-nb-doodle {
      width: var(--m-size, 36px) !important;
      max-width: 73px !important;
      opacity: var(--m-op, 0.7);
    }
  }
  @media print {
    .home-section-notebook {
      display: none !important;
    }
  }
</style>
