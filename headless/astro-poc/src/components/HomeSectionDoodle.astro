---
/**
 * Golden-ratio notebook marginalia per home section (2–4 webps + scribbles).
 * Absolute edge gutters — never a flex/grid strip, never on cards/text.
 * Diagonal descent; every doodle bobs + wobbles when motion is allowed.
 */
import manifest from '../data/doodles.manifest.json';
import { selectNotebookScatter } from '../lib/doodles/selectNotebookScatter';
import MathScribbles from './MathScribbles.astro';
import type { DoodleMotif } from '../lib/doodles/selectSiteDoodles';

export interface Props {
  seed: string;
  preferred?: string[];
  count?: number;
  scribbleCount?: number;
}

const { seed, preferred = [], count = 3, scribbleCount = 2 } = Astro.props;
const motifs = (manifest.motifs || []) as DoodleMotif[];
const scatter = selectNotebookScatter(seed, motifs, {
  preferred,
  count: Math.min(4, Math.max(2, count)),
  scribbleCount,
});
---

{
  scatter.motifs.length > 0 && (
    <div
      class="home-section-notebook"
      aria-hidden="true"
      data-home-section-notebook
      data-notebook-seed={seed}
    >
      {scatter.motifs.map((m, i) => (
        <img
          class:list={[
            'home-nb-doodle',
            'home-nb-doodle--motion',
            m.side === 'start' ? 'home-nb-doodle--start' : 'home-nb-doodle--end',
            i < 1 ? 'home-nb-doodle--mobile-show' : 'home-nb-doodle--mobile-hide',
          ]}
          src={m.src}
          alt=""
          width={m.sizePx}
          height={m.sizePx}
          decoding="async"
          loading="lazy"
          data-doodle-id={m.id}
          data-home-section-doodle
          data-nb-side={m.side}
          style={[
            `--d-size:${m.sizePx}px`,
            `--m-size:${m.mobileSizePx}px`,
            `--r:${m.rotate}deg`,
            `--d-op:${m.opacity}`,
            `--m-op:${m.mobileOpacity}`,
            `--d-delay:${m.delay}s`,
            `--d-dur:${m.duration}s`,
            `--d-bob:${m.bobPx}px`,
            `--d-wobble:${m.wobbleDeg}deg`,
            `--inline-inset:${m.inlineInsetPct}%`,
            `--y:${m.yPct}%`,
          ].join(';')}
        />
      ))}
      <MathScribbles items={scatter.scribbles} organicMobile />
    </div>
  )
}

<style>
  /*
   * Absolute marginalia — zero layout height. Parent section must be
   * position:relative + overflow:clip. Content stays z-index:1.
   */
  .home-section-notebook {
    position: absolute;
    inset: 0;
    display: block;
    width: auto;
    height: auto;
    margin: 0;
    padding: 0;
    overflow: visible;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .home-nb-doodle {
    position: absolute;
    display: block;
    inset-block-start: var(--y, 38.2%);
    width: var(--d-size, 45px);
    max-width: min(96px, 12vw);
    height: auto;
    opacity: var(--d-op, 0.75);
    transform: translateY(-50%) rotate(var(--r, 0deg));
    transform-origin: center center;
    z-index: 0;
  }
  .home-nb-doodle--start {
    inset-inline-start: var(--inline-inset, 4%);
    inset-inline-end: auto;
  }
  .home-nb-doodle--end {
    inset-inline-end: var(--inline-inset, 4%);
    inset-inline-start: auto;
  }
  .home-nb-doodle--motion {
    animation: nb-doodle-bob-wobble var(--d-dur, 6.5s) ease-in-out infinite;
    animation-delay: var(--d-delay, 0s);
    will-change: transform;
  }
  @keyframes nb-doodle-bob-wobble {
    0%,
    100% {
      transform: translateY(-50%) translateY(0)
        rotate(calc(var(--r, 0deg) - var(--d-wobble, 4deg)));
    }
    50% {
      transform: translateY(-50%) translateY(calc(-1 * var(--d-bob, 6px)))
        rotate(calc(var(--r, 0deg) + var(--d-wobble, 4deg)));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-nb-doodle--motion {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .home-nb-doodle--motion,
  :global(html.nd-motion-off) .home-nb-doodle--motion {
    animation: none !important;
  }

  @media (max-width: 767px) {
    .home-nb-doodle--mobile-hide {
      display: none !important;
    }
    .home-nb-doodle--mobile-show {
      width: var(--m-size, 24px) !important;
      max-width: 39px !important;
      opacity: var(--m-op, 0.7);
      /* Tug toward the thin edge so they never sit on text */
    }
    .home-nb-doodle--mobile-show.home-nb-doodle--start {
      inset-inline-start: -6px;
    }
    .home-nb-doodle--mobile-show.home-nb-doodle--end {
      inset-inline-end: -6px;
    }
  }
  @media print {
    .home-section-notebook {
      display: none !important;
    }
  }
</style>
