---
/**
 * KIMI-ANIM-6 — one restored DOODLES-45 motif per home section.
 * Visual weight matches SiteDoodles margin motifs (~180–240px desktop).
 * Same gentle float as `.site-doodle`; off under reduced-motion /
 * html.noam-a11y-motion. Decorative only (aria-hidden); never captures clicks.
 */
import manifest from '../data/doodles.manifest.json';

export interface Props {
  /** Motif id from doodles.manifest.json */
  motif: string;
  /** Modest tilt in degrees */
  rotate?: number;
  /** Logical corner inside the relatively-positioned section */
  side?: 'start' | 'end';
}

const { motif, rotate = -6, side = 'end' } = Astro.props;
const entry = (manifest.motifs as { id: string; src: string }[]).find(
  (m) => m.id === motif,
);
---

{
  entry && (
    <img
      class:list={['home-section-doodle', `home-section-doodle--${side}`]}
      src={entry.src}
      alt=""
      width="220"
      height="220"
      decoding="async"
      loading="lazy"
      aria-hidden="true"
      data-doodle-id={entry.id}
      data-home-section-doodle
      style={`--doodle-rot:${rotate}deg`}
    />
  )
}

<style>
  .home-section-doodle {
    position: absolute;
    top: -4px;
    /* Match SiteDoodles gutter weight (~180–240px desktop). */
    width: clamp(180px, 16vw, 240px);
    height: auto;
    max-width: 240px;
    opacity: 0.9;
    pointer-events: none;
    user-select: none;
    z-index: 0;
    transform: translateY(0) rotate(var(--doodle-rot, 0deg));
    transform-origin: center center;
    /* Same motion language as SiteDoodles `.site-doodle-float`. */
    animation: site-doodle-float 7.5s ease-in-out infinite;
    will-change: transform;
  }
  .home-section-doodle--end {
    inset-inline-end: -4px;
    animation-duration: 8.2s;
    animation-delay: 0.5s;
  }
  .home-section-doodle--start {
    inset-inline-start: -4px;
    animation-duration: 7.8s;
    animation-delay: 1s;
  }

  @keyframes site-doodle-float {
    0%,
    100% {
      transform: translateY(0) rotate(var(--doodle-rot, 0deg));
    }
    50% {
      transform: translateY(-12px) rotate(var(--doodle-rot, 0deg));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home-section-doodle {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .home-section-doodle {
    animation: none !important;
  }

  /* Sensible mobile downscale; still readable, clears centered copy. */
  @media (max-width: 900px) {
    .home-section-doodle {
      width: clamp(120px, 26vw, 160px);
      max-width: 160px;
      top: 0;
    }
  }
  @media (max-width: 640px) {
    .home-section-doodle {
      width: clamp(96px, 28vw, 128px);
      max-width: 128px;
    }
  }
  @media print {
    .home-section-doodle {
      display: none !important;
    }
  }
</style>
