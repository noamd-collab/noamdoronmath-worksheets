---
/**
 * KIMI-ANIM-6 — dense notebook scatter per home section (3–6 webp motifs
 * + small math scribbles) on desktop. Mobile: 1–2 absolute corner doodles
 * in the section head (no layout push). Subset floats; off under
 * prefers-reduced-motion / noam-a11y-motion / nd-motion-off.
 */
import manifest from '../data/doodles.manifest.json';
import { selectNotebookScatter } from '../lib/doodles/selectNotebookScatter';
import MathScribbles from './MathScribbles.astro';
import type { DoodleMotif } from '../lib/doodles/selectSiteDoodles';

export interface Props {
  /** Section seed for deterministic layout */
  seed: string;
  /** Preferred motif ids (topic-matched); fillers complete the cluster */
  preferred?: string[];
  /** Motif count 3–6 (default 5) */
  count?: number;
}

const { seed, preferred = [], count = 5 } = Astro.props;
const motifs = (manifest.motifs || []) as DoodleMotif[];
const scatter = selectNotebookScatter(seed, motifs, {
  preferred,
  count,
  scribbleCount: 3,
});
---

{
  scatter.motifs.length > 0 && (
    <div
      class="home-section-notebook"
      aria-hidden="true"
      data-home-section-notebook
      data-notebook-seed={seed}
    >
      {scatter.motifs.map((m, i) => (
        <img
          class:list={[
            'home-nb-doodle',
            i === 0 ? 'home-nb-doodle--a' : null,
            i === 1 ? 'home-nb-doodle--b' : null,
            m.float ? 'home-nb-doodle--float' : null,
          ]}
          src={m.src}
          alt=""
          width={m.sizePx}
          height={m.sizePx}
          decoding="async"
          loading="lazy"
          data-doodle-id={m.id}
          data-home-section-doodle
          style={`--d-size:${m.sizePx}px;--d-rot:${m.rotate}deg;--d-op:${m.opacity};--d-delay:${m.delay}s`}
        />
      ))}
      <MathScribbles items={scatter.scribbles} />
    </div>
  )
}

<style>
  .home-section-notebook {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 6px 14px;
    width: 100%;
    margin: 6px 0 14px;
    padding: 4px 8px 8px;
    pointer-events: none;
    user-select: none;
    z-index: 0;
  }
  .home-nb-doodle {
    display: block;
    width: var(--d-size, 100px);
    height: auto;
    max-width: min(180px, 28vw);
    opacity: var(--d-op, 0.9);
    transform: rotate(var(--d-rot, 0deg));
    transform-origin: center center;
    flex: 0 0 auto;
  }
  .home-nb-doodle--float {
    animation: site-doodle-float 7.5s ease-in-out infinite;
    animation-delay: var(--d-delay, 0s);
    will-change: transform;
  }
  @keyframes site-doodle-float {
    0%,
    100% {
      transform: translateY(0) rotate(var(--d-rot, 0deg));
    }
    50% {
      transform: translateY(-10px) rotate(var(--d-rot, 0deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-nb-doodle--float {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .home-nb-doodle--float,
  :global(html.nd-motion-off) .home-nb-doodle--float {
    animation: none !important;
  }

  /*
   * Mobile notebook: 1–2 small absolute corner doodles inside the section
   * head — no in-flow height, no horizontal scroll, never over text.
   */
  @media (max-width: 640px) {
    .home-section-notebook {
      position: absolute;
      inset: 0;
      display: block;
      width: auto;
      height: auto;
      margin: 0;
      padding: 0;
      overflow: visible;
      pointer-events: none;
      z-index: 0;
    }
    .home-nb-doodle {
      position: absolute;
      display: none;
      width: 52px !important;
      max-width: 52px !important;
      opacity: 0.38;
      z-index: 0;
    }
    .home-nb-doodle--a {
      display: block;
      inset-inline-start: -2px;
      top: 0;
    }
    .home-nb-doodle--b {
      display: block;
      inset-inline-end: -2px;
      top: 28px;
    }
    /* Hide dense desktop fillers + scribbles on phone */
    .home-nb-doodle:not(.home-nb-doodle--a):not(.home-nb-doodle--b) {
      display: none !important;
    }
    .home-section-notebook :global(.math-scribble) {
      display: none !important;
    }
  }
  @media print {
    .home-section-notebook {
      display: none !important;
    }
  }
</style>
