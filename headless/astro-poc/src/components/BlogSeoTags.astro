---
/**
 * Blog head tags that neither BaseLayout nor Wix's main-page injection provide
 * (see src/lib/blogSeo.ts). Rendered by the blog pages into BaseLayout's
 * `seo-tags` head slot. The marker lets server middleware retain these authored
 * dimensions if Wix also injects a copy.
 */
import { buildBlogSeoComplement, type BlogSeoInput } from '../lib/blogSeo';

type Props = BlogSeoInput;
const tags = buildBlogSeoComplement(Astro.props);
---
{tags.map((t) => (t.property ? <meta data-noam-seo property={t.property} content={t.content} /> : <meta data-noam-seo name={t.name} content={t.content} />))}
