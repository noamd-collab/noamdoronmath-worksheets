    {rods.map(r=><g class="rod deal" style={`--dx:${r.dx}px;--dy:${r.dy}px;--d:${r.d}s`}>{Array.from({length:10},(_,c)=><rect x={r.x} y={118+c*8} width="12" height="8"/>)}</g>)}
    {units.map(u=><rect class:list={['unit',u.fromRod ? 'deal-late' : 'deal-units']} x={u.x} y={u.y} width="8" height="8" style={`--dx:${u.dx}px;--dy:${u.dy}px;--d:${u.d}s`}/>)}
  </svg>}
  {lesson.picture === 'factortree' && <svg role="img" viewBox="0 0 480 250" aria-label="עץ גורמים: 60 מתפרק ל־2 ול־30, 30 ל־2 ול־15, ו־15 ל־3 ול־5">
    {treeBranches.map(b=><line class={`branch branch-${b.level}`} x1={b.x1} y1={b.y1} x2={b.x2} y2={b.y2} style={`transform-origin:${b.origin}`}/>)}
    {treeNodes.map(n=><g class={`node node-${n.level}`}><circle class:list={[n.prime && 'prime']} cx={n.x} cy={n.y} r="21"/><text x={n.x} y={n.y+8}>{n.v}</text></g>)}
  </svg>}
