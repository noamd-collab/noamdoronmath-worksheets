---
import { LESSON_LOOPS, type Lesson, type LessonLoopVariant } from '../lib/lessonLoops';
import LessonMath from './LessonMath.astro';
import MiddleLessonPicture from './MiddleLessonPicture.astro';
import LessonMathLines from './LessonMathLines.astro';
import { MIDDLE_TOPIC_LESSONS } from '../lib/middleTopicLessons';
interface Props { variant: LessonLoopVariant }
const { variant } = Astro.props;
const lesson: Lesson = LESSON_LOOPS[variant];
const middleLesson = Object.hasOwn(MIDDLE_TOPIC_LESSONS, variant);
const faces = [
  {x:120,y:10,w:90,h:60,pair:0,label:'2 × 3',axis:'y',origin:'50% 100%',delay:0.1},
  {x:60,y:70,w:60,h:120,pair:1,label:'2 × 4',axis:'x',origin:'100% 50%',delay:0.4},
  {x:120,y:70,w:90,h:120,pair:2,label:'3 × 4',axis:'',origin:'',delay:0},
  {x:210,y:70,w:60,h:120,pair:1,label:'2 × 4',axis:'x',origin:'0 50%',delay:0.7},
  {x:270,y:70,w:90,h:120,pair:2,label:'3 × 4',axis:'x',origin:'0 50%',delay:1.4},
  {x:120,y:190,w:90,h:60,pair:0,label:'2 × 3',axis:'y',origin:'50% 0',delay:1.0},
];

/* Place-value blocks are fixed-size boxes, so the result row can start every
   piece exactly on its source piece: rods 12px + 5px gap, ones 9 × 11px on a
   12 × 14px grid, rows 65px + 10px apart. */
type PlaceRow = { value: number; label: string };
const ROW_PITCH = 75;
const onesTop = (n: number) => (65 - (Math.ceil(n / 4) * 14 - 3)) / 2;
const placeAt = (row: PlaceRow, kind: 'ten' | 'one', k: number) => {
  const tens = Math.floor(row.value / 10);
  return kind === 'ten'
    ? { x: k * 17, y: 2.5 }
    : { x: tens * 17 + 5 + (k % 4) * 12, y: onesTop(row.value % 10) + Math.floor(k / 4) * 14 };
};
const placeSource = (rows: PlaceRow[], kind: 'ten' | 'one', k: number) => {
  const take = (v: number) => (kind === 'ten' ? Math.floor(v / 10) : v % 10);
  const subtract = rows[1].label.trim().startsWith('−');
  const first = take(rows[0].value);
  return subtract || k < first ? { row: 0, k } : { row: 1, k: k - first };
};
const placeMove = (rows: PlaceRow[], kind: 'ten' | 'one', k: number, order: number) => {
  const src = placeSource(rows, kind, k);
  const from = placeAt(rows[src.row], kind, src.k);
  const to = placeAt(rows[2], kind, k);
  return `--dx:${from.x - to.x}px;--dy:${from.y - to.y + (src.row - 2) * ROW_PITCH}px;--d:${(order * 0.12).toFixed(2)}s`;
};

/* Rows fill one after another inside one 9s lap; the reset stays together
   because each row start lives in its own keyframes, not in a long delay. */
const ROW_STARTS: Record<number, number[]> = { 1: [0], 2: [0, 33], 3: [0, 33, 66], 4: [0, 22, 44, 66], 5: [0, 16, 33, 49, 66] };
const rowStart = (row: number, rows: number) => (ROW_STARTS[rows] ?? ROW_STARTS[5])[row] ?? 66;
const cellDelay = (j: number, filled: number, rows: number) => (j * Math.min(rows === 1 ? 0.35 : 0.12, (rows === 1 ? 2.4 : 1.2) / filled)).toFixed(2);

const meanValues = [8, 12, 6, 10];
const meanX = (i: number) => 370 - i * 90;
const meanY = (n: number) => 215 - n * 14;
const meanPieces = [{ from: 1, to: 2 }, { from: 3, to: 0 }].map(({ from, to }) => {
  const extra = meanValues[from] - 9;
  return { x: meanX(from), y: meanY(meanValues[from]), h: extra * 14, dx: meanX(to) - meanX(from), dy: meanY(meanValues[to] + extra) - meanY(meanValues[from]) };
});

const dotX = (v: number) => 40 + v * 22;

const tiles = Array.from({ length: 15 }, (_, k) => {
  const x = 46 + k * 26;
  const half = k < 5;
  const src = half ? 60 + k * 24 : 200 + (k - 5) * 24;
  return { x, dx: src - x, half, d: half ? k * 0.12 : (k - 5) * 0.12 };
});

const roundX = (v: number) => 70 + (v - 300000) / 100000 * 340;

const groupX = (g: number) => 20 + g * 150;
const rods = Array.from({ length: 6 }, (_, k) => {
  const g = Math.floor(k / 2);
  const x = groupX(g) + 14 + (k % 2) * 18;
  return { x, dx: 150 + k * 18 - x, dy: 10 - 118, d: k * 0.1 };
});
const brokenRods = [6, 7].map((k) => 150 + k * 18);
const units = Array.from({ length: 24 }, (_, n) => {
  const g = Math.floor(n / 8);
  const u = n % 8;
  const x = groupX(g) + 58 + (u % 4) * 12;
  const y = 140 + Math.floor(u / 4) * 12;
  const sx = n < 10 ? 260 : n < 20 ? 278 : 300 + ((n - 20) % 2) * 12;
  const sy = n < 20 ? 10 + (n % 10) * 8 : 50 + Math.floor((n - 20) / 2) * 12;
  return { x, y, dx: sx - x, dy: sy - y, fromRod: n < 20, d: (u * 0.05).toFixed(2) };
});

const treeNodes = [
  { v: 60, x: 210, y: 30, level: 0, prime: false },
  { v: 2, x: 120, y: 95, level: 1, prime: true },
  { v: 30, x: 300, y: 95, level: 1, prime: false },
  { v: 2, x: 240, y: 160, level: 2, prime: true },
  { v: 15, x: 360, y: 160, level: 2, prime: false },
  { v: 3, x: 300, y: 225, level: 3, prime: true },
  { v: 5, x: 420, y: 225, level: 3, prime: true },
];
const treeBranches = [[0, 1], [0, 2], [2, 3], [2, 4], [4, 5], [4, 6]].map(([p, c]) => {
  const a = treeNodes[p];
  const b = treeNodes[c];
  return { x1: a.x, y1: a.y, x2: b.x, y2: b.y, level: b.level, origin: b.x < a.x ? '100% 0' : '0 0' };
});
---
<div class="lesson" data-lesson={variant} dir="rtl">
  <MiddleLessonPicture variant={variant} lesson={lesson} />
  {lesson.picture === 'reflection' && <svg role="img" viewBox="0 0 480 230" aria-label="שני חצאים משתקפים סביב קו אנכי">
    <line class="mirror-axis" x1="240" y1="10" x2="240" y2="215" stroke-dasharray="7 6"/>
    <path d="M240 35 L130 100 L170 190 L240 155 Z" class="filled"/>
    <g class="mirror"><path d="M240 35 L350 100 L310 190 L240 155 Z" class="gold"/><circle cx="350" cy="100" r="6"/></g>
    <line x1="130" y1="100" x2="350" y2="100" stroke-dasharray="4 4"/>
    <circle cx="130" cy="100" r="6"/>
    <path d="M185 94 V106 M295 94 V106"/>
    <circle class="traveler" cx="130" cy="100" r="8"/>
  </svg>}
  {lesson.picture === 'net' && <svg role="img" viewBox="0 0 420 260" aria-label="פריסה סכמטית של שש פאות תיבה, המידות קובעות את השטחים">
    {faces.map(f=><g class={`pair pair-${f.pair}`}><g class:list={['face',f.axis && `face--${f.axis}`]} style={f.axis ? `transform-origin:${f.origin};--d:${f.delay}s` : undefined}><rect x={f.x} y={f.y} width={f.w} height={f.h} class="filled"/><text x={f.x+f.w/2} y={f.y+f.h/2+7}>{f.label}</text></g></g>)}
  </svg>}
  {lesson.picture === 'chart' && <svg role="img" viewBox="0 0 480 230" aria-label="שלוש עמודות: א שלושה, ב חמישה, ג שניים">
    {[0,1,2,3,4,5].map(n=><><line class="grid" x1="80" x2="430" y1={195-n*32} y2={195-n*32}/><text x="55" y={202-n*32}>{n}</text></>)}
    {[3,5,2].map((n,i)=><g><rect class={`filled bar bar-${i}`} x={320-i*100} y={195-n*32} width="52" height={n*32}/><text x={346-i*100} y="224">{['א','ב','ג'][i]}</text></g>)}
    <line class="read-line" x1="80" x2="320" y1="99" y2="99" stroke-dasharray="6 5"/>
  </svg>}
  {lesson.picture === 'triangles' && <div class="triangle-cards">
    {[{name:'חד־זווית',points:'25,130 75,30 135,130',mark:'',at:'25 130',tester:'M0 -34 L0 0 L34 0'},{name:'ישר־זווית',points:'25,130 25,30 135,130',mark:'M25 114 H41 V130',at:'25 130',tester:'M0 -34 L0 0 L34 0'},{name:'קהה־זווית',points:'10,130 55,85 140,130',mark:'M44 96 Q56 110 69 93',at:'55 85',tester:'M-24 24 L0 0 L24 24'}].map(t=><div><svg role="img" viewBox="0 0 155 155" aria-label={`משולש ${t.name}`}><polygon points={t.points} class="filled"/><path d={t.mark}/><g transform={`translate(${t.at})`}><path class="tester" d={t.tester}/></g></svg><p>{t.name}</p></div>)}
  </div>}
  {lesson.picture === 'linegraph' && <svg role="img" viewBox="0 0 480 260" aria-label="גרף קווי: בשלב א 5, בשלב ב 9 ובשלב ג 10; העלייה הראשונה גדולה יותר">
    {[0,5,10].map(n=><><line class="grid" x1="70" x2="425" y1={210-n*16} y2={210-n*16}/><text x="42" y={217-n*16}>{n}</text></>)}
    <path d="M70 25 V210 H425"/>
    <g transform="translate(110 130) rotate(-24.567)"><line class="graph-line seg seg-1" x1="0" y1="0" x2="153.94" y2="0"/></g>
    <g transform="translate(250 66) rotate(-6.52)"><line class="graph-line seg seg-2" x1="0" y1="0" x2="140.91" y2="0"/></g>
    <rect class="rise rise-1" x="244" y="66" width="12" height="64"/>
    <rect class="rise rise-2" x="384" y="50" width="12" height="16"/>
    {[5,9,10].map((n,i)=><><circle class={`pt pt-${i}`} cx={110+i*140} cy={210-n*16} r="6" style={`--dy:${n*16}px`}/><text x={110+i*140} y={194-n*16}>{n}</text><text x={110+i*140} y="246">{['א','ב','ג'][i]}</text></>)}
  </svg>}
  {lesson.picture === 'table' && <>
    <table><caption>כמות הפריטים בכל קבוצה</caption><thead><tr><th scope="col">קבוצה</th><th scope="col">כמות</th></tr></thead><tbody><tr><th scope="row">א׳</th><td>138</td></tr><tr><th scope="row">ב׳</th><td>161</td></tr></tbody></table>
    <svg class="sum-bars" role="img" viewBox="0 0 480 124" aria-label="פס של 138 ופס של 161 מתחברים לפס של 299; ההפרש בין הפסים הוא 23">
      <rect class="filled grow-x" x="256.8" y="8" width="193.2" height="26"/><text x="353.4" y="28">138</text>
      <rect class="gold grow-x grow-x--late" x="224.6" y="42" width="225.4" height="26"/><text x="337.3" y="62">161</text>
      <rect class="filled gather" x="256.8" y="90" width="193.2" height="26" style="--dx:0px;--dy:-82px;--d:0s"/>
      <rect class="gold gather" x="31.4" y="90" width="225.4" height="26" style="--dx:193.2px;--dy:-48px;--d:.3s"/>
      <text class="late-label" x="240" y="110">299</text>
      <rect class="diff" x="224.6" y="42" width="32.2" height="26"/>
      <text class="diff-label" x="203" y="62">23</text>
    </svg>
  </>}
  {lesson.picture === 'mean' && <svg role="img" viewBox="0 0 480 260" aria-label="ערכי הקבוצות: 8, 12, 6, 10. העודף של 12 ושל 10 עובר אל 6 ואל 8 וכולן בגובה 9, הממוצע">
    {[0,3,6,9,12].map(n=><><line class="grid" x1="65" x2="445" y1={215-n*14} y2={215-n*14}/><text x="40" y={222-n*14}>{n}</text></>)}
    {meanValues.map((n,i)=><><rect class="filled" x={meanX(i)} y={meanY(Math.min(n,9))} width="44" height={Math.min(n,9)*14}/><text x={meanX(i)+22} y={204-n*14}>{n}</text><text x={meanX(i)+22} y="248">{['א','ב','ג','ד'][i]}</text></>)}
    {meanPieces.map(p=><rect class="gold level-piece" x={p.x} y={p.y} width="44" height={p.h} style={`--dx:${p.dx}px;--dy:${p.dy}px`}/>)}
    <line class="mean-line" x1="65" x2="445" y1="89" y2="89" stroke-dasharray="6 5"/>
  </svg>}
  {lesson.picture === 'groups' && <>
    <table><caption>אותו ממוצע, טווחים שונים</caption><thead><tr><th scope="col">קבוצה</th><th scope="col">ערכים</th><th scope="col">ממוצע</th><th scope="col">טווח</th></tr></thead><tbody><tr><th scope="row">א׳</th><td><bdi>8, 9, 10</bdi></td><td>9</td><td>2</td></tr><tr><th scope="row">ב׳</th><td><bdi>1, 9, 17</bdi></td><td>9</td><td>16</td></tr></tbody></table>
    <svg class="dot-plot" role="img" viewBox="0 0 480 182" aria-label="על ישר מ־0 עד 18: ערכי קבוצה א׳ 8, 9, 10 צמודים ל־9, ערכי קבוצה ב׳ 1, 9, 17 מתפזרים; טווח 2 לעומת טווח 16">
      <path d={`M${dotX(0)} 154 H${dotX(18)}`}/>
      {[0,9,18].map(v=><><path d={`M${dotX(v)} 148 V160`}/><text x={dotX(v)} y="180">{v}</text></>)}
      <text x="462" y="57">א׳</text><text x="462" y="129">ב׳</text>
      <path class="range" d={`M${dotX(8)} 22 V34 M${dotX(8)} 28 H${dotX(10)} M${dotX(10)} 22 V34`}/><text class="range-label" x={dotX(9)} y="16">2</text>
      <path class="range" d={`M${dotX(1)} 94 V106 M${dotX(1)} 100 H${dotX(17)} M${dotX(17)} 94 V106`}/><text class="range-label" x={dotX(9)} y="89">16</text>
      {[8,9,10].map(v=><circle class="spread" cx={dotX(v)} cy="50" r="8" style={`--dx:${dotX(9)-dotX(v)}px`}/>)}
      {[1,9,17].map(v=><circle class="spread spread--b" cx={dotX(v)} cy="122" r="8" style={`--dx:${dotX(9)-dotX(v)}px`}/>)}
    </svg>
  </>}
  {lesson.picture === 'numberline' && <div class="numberline" dir="ltr" aria-label="ישר מאפס עד אחד מחולק לשישיות. שליש בשתי שישיות וחצי בשלוש שישיות">
    <div class="numberline-track">{Array.from({length:7},(_,i)=><span class:list={['tick',[2,3].includes(i)&&'chosen',i>0&&i<6&&'tick--mid']} style={`left:${i/6*100}%;--i:${i}`}><span class="tick-label">{i===0?'0':i===6?'1':i===2?<LessonMath value="1/3"/>:i===3?<LessonMath value="1/2"/>:''}</span></span>)}<i class="sixth-hop sixth-hop--half" aria-hidden="true"></i><i class="sixth-hop sixth-hop--third" aria-hidden="true"></i></div>
  </div>}
  {lesson.picture === 'linear' && <>
    <table dir="ltr"><caption>פונקציה קווית: <bdi>y = 3x + 1</bdi></caption><tbody><tr><th scope="row">x</th><td>0</td><td>1</td><td>2</td></tr><tr><th scope="row">y</th><td>1</td><td>4</td><td>7</td></tr></tbody></table>
    <svg role="img" viewBox="0 0 480 255" aria-label="גרף הפונקציה הקווית y שווה 3x ועוד 1, העובר בנקודות אפס ואחת, אחת וארבע, שתיים ושבע">
      <path d="M80 15 V220 H440"/>{[1,4,7].map((n,i)=><><line class="grid" x1="80" x2="410" y1={220-n*25} y2={220-n*25}/><text x="53" y={227-n*25}>{n}</text><text x={80+i*140} y="248">{i}</text><line class="linear-read" x1={80+i*140} x2={80+i*140} y1="220" y2={220-n*25} style={`--d:${i*.3}s`}/><circle class={`pt pt-${i}`} cx={80+i*140} cy={220-n*25} r="6" style={`--dy:${n*25}px`}/></>)}<path class="graph-line" d="M80 195 L388 30"/>
    </svg>
  </>}
  {lesson.picture === 'place' && <div class="place-values">
    <p>כל מוט הוא עשרת; כל ריבוע הוא יחידה.</p>
    {lesson.place?.map((row,r,rows)=><div class="place-row" dir="ltr"><bdi>{row.label}</bdi><div class="place-blocks" role="img" aria-label={`${Math.floor(row.value/10)} עשרות ו־${row.value%10} יחידות`}>
      {Array.from({length:Math.floor(row.value/10)},(_,k)=> <i class:list={['ten',r===2 && 'gather']} style={r===2 ? placeMove(rows,'ten',k,k) : undefined}>{Array.from({length:10},()=> <i></i>)}</i>)}
      <span class="ones">{Array.from({length:row.value%10},(_,k)=> <i class:list={[r===2 && 'gather']} style={r===2 ? placeMove(rows,'one',k,Math.floor(row.value/10)+k) : undefined}></i>)}</span>
    </div></div>)}
  </div>}
  {lesson.picture === 'bars' && <div class="fraction-bars" dir="ltr">
    {lesson.bars?.map((b,i)=><div class="fraction-row"><span class="fraction-label"><LessonMath value={b.label}/></span><div class={`cells cells-${i}`} style={`--parts:${b.total}`}>
      {Array.from({length:b.total},(_,j)=><span class:list={['cell',j<b.filled && 'cell--filled']}>{b.filled > j && <i class={`fill-${rowStart(i,lesson.bars!.length)}`} style={`--d:${cellDelay(j,b.filled,lesson.bars!.length)}s`}></i>}</span>)}
    </div></div>)}
  </div>}
  {lesson.picture === 'shapes' && <svg role="img" viewBox="0 0 480 220" aria-label="ריבוע וקובייה">
    <rect x="55" y="60" width="105" height="105" class="filled"/>
    <g class="solid"><path d="M280 80 L325 40 L425 40 L380 80 Z" class="gold face-top"/><path d="M380 80 L425 40 L425 145 L380 185 Z" class="filled face-side"/><rect x="280" y="80" width="100" height="105" class="filled face-front"/></g>
    <rect x="55" y="60" width="105" height="105" class="filled square-copy"/>
  </svg>}
  {lesson.picture === 'hundred' && <div class="hundred" dir="ltr" aria-label="לוח המאה משמאל לימין, 34 ו־35 באותה שורה ו־44 מתחת ל־34">{Array.from({length:100},(_,i)=><span class:list={[[34,35,44].includes(i+1) && 'selected']}>{i+1}</span>)}<i class="hop hop--right" aria-hidden="true"></i><i class="hop hop--down" aria-hidden="true"></i></div>}
  {lesson.picture === 'rectangles' && <svg role="img" viewBox="0 0 480 220" aria-label="ריבוע ומלבן עם סימני זווית ישרה">
    <rect x="35" y="45" width="120" height="120" class="filled"/><rect x="235" y="65" width="200" height="100" class="gold"/>
    <path d="M35 60 H50 V45 M140 45 V60 H155 M35 150 H50 V165 M140 165 V150 H155 M235 80 H250 V65 M420 65 V80 H435 M235 150 H250 V165 M420 165 V150 H435"/>
  </svg>}
  {lesson.picture === 'weights' && <svg role="img" viewBox="0 0 480 205" aria-label="קילוגרם אחד וחצי קילוגרם מתפרקים ל־15 משקולות של 100 גרם, יחד 1,500 גרם">
    {tiles.map(t=><rect class:list={['filled','gather',!t.half && 'gather--early']} x={t.x} y="125" width="24" height="40" style={`--dx:${t.dx}px;--dy:-105px;--d:${t.d.toFixed(2)}s`}/>)}
    <rect class="gold" x="200" y="20" width="240" height="50"/><text x="320" y="53">1 kg</text>
    <rect class="gold" x="60" y="20" width="120" height="50"/><text x="120" y="53">0.5 kg</text>
    <text class="small-label" x="240" y="198">15 × 100 g = 1,500 g</text>
  </svg>}
  {lesson.picture === 'rounding' && <svg role="img" viewBox="0 0 480 160" aria-label="ישר מספרים מ־300,000 עד 400,000. 347,000 רחוק 47,000 מ־300,000 ו־53,000 מ־400,000, ולכן מתעגל ל־300,000">
    <path d={`M${roundX(300000)} 100 H${roundX(400000)}`}/>
    {Array.from({length:11},(_,k)=><path d={`M${roundX(300000+k*10000)} ${k%5===0?90:95} V${k%5===0?110:105}`}/>)}
    <path class="range range--near" d={`M${roundX(300000)} 50 V62 M${roundX(300000)} 56 H${roundX(347000)} M${roundX(347000)} 50 V62`} style="transform-origin:100% 50%"/>
    <path class="range range--far" d={`M${roundX(347000)} 50 V62 M${roundX(347000)} 56 H${roundX(400000)} M${roundX(400000)} 50 V62`} style="transform-origin:0 50%"/>
    <text class="range-label small-label" x={(roundX(300000)+roundX(347000))/2} y="42">47,000</text>
    <text class="range-label range-label--far small-label" x={(roundX(347000)+roundX(400000))/2} y="42">53,000</text>
    <text class="small-label" x={roundX(300000)} y="136">300,000</text><text class="small-label" x={roundX(347000)} y="136">347,000</text><text class="small-label" x={roundX(400000)} y="136">400,000</text>
    <circle class="drop-in" cx={roundX(347000)} cy="100" r="7"/>
    <circle class="rounded" cx={roundX(300000)} cy="100" r="11" style={`--dx:${roundX(347000)-roundX(300000)}px`}/>
  </svg>}
  {lesson.picture === 'division' && <svg role="img" viewBox="0 0 480 250" aria-label="84 הם 8 עשרות ו־4 יחידות. 6 עשרות מתחלקות לשלוש קבוצות, ו־24 היחידות שנשארו מתחלקות 8 לכל קבוצה: 28 בכל קבוצה">
    <text x="420" y="58">84 ÷ 3</text>
    {[0,1,2].map(g=><><rect class="group-box" x={groupX(g)} y="105" width="135" height="110" rx="10"/><text x={groupX(g)+67} y="240">28</text></>)}
