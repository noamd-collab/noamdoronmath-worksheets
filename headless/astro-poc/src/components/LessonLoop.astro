---
import { LESSON_LOOPS, type Lesson, type LessonLoopVariant } from '../lib/lessonLoops';
import LessonMath from './LessonMath.astro';
interface Props { variant: LessonLoopVariant }
const { variant } = Astro.props;
const lesson: Lesson = LESSON_LOOPS[variant];
const faces = [
  {x:120,y:10,w:90,h:60,pair:0,label:'2 × 3'},
  {x:60,y:70,w:60,h:120,pair:1,label:'2 × 4'},
  {x:120,y:70,w:90,h:120,pair:2,label:'3 × 4'},
  {x:210,y:70,w:60,h:120,pair:1,label:'2 × 4'},
  {x:270,y:70,w:90,h:120,pair:2,label:'3 × 4'},
  {x:120,y:190,w:90,h:60,pair:0,label:'2 × 3'},
];
---
<div class="lesson" data-lesson={variant} dir="rtl">
  {lesson.picture === 'reflection' && <svg role="img" viewBox="0 0 480 230" aria-label="שני חצאים משתקפים סביב קו אנכי">
    <line x1="240" y1="10" x2="240" y2="215" stroke-dasharray="7 6"/>
    <path d="M240 35 L130 100 L170 190 L240 155 Z" class="filled"/>
    <g class="mirror"><path d="M240 35 L350 100 L310 190 L240 155 Z" class="gold"/><circle cx="350" cy="100" r="6"/></g>
    <line x1="130" y1="100" x2="350" y2="100" stroke-dasharray="4 4"/>
    <circle cx="130" cy="100" r="6"/>
    <path d="M185 94 V106 M295 94 V106"/>
  </svg>}
  {lesson.picture === 'net' && <svg role="img" viewBox="0 0 420 260" aria-label="פריסה סכמטית של שש פאות תיבה, המידות קובעות את השטחים">
    {faces.map(f=><g class={`pair pair-${f.pair}`}><rect x={f.x} y={f.y} width={f.w} height={f.h} class="filled"/><text x={f.x+f.w/2} y={f.y+f.h/2+7}>{f.label}</text></g>)}
  </svg>}
  {lesson.picture === 'chart' && <svg role="img" viewBox="0 0 480 230" aria-label="שלוש עמודות: א שלושה, ב חמישה, ג שניים">
    {[0,1,2,3,4,5].map(n=><><line class="grid" x1="80" x2="430" y1={195-n*32} y2={195-n*32}/><text x="55" y={202-n*32}>{n}</text></>)}
    {[3,5,2].map((n,i)=><g><rect class={`filled bar bar-${i}`} x={320-i*100} y={195-n*32} width="52" height={n*32}/><text x={346-i*100} y="224">{['א','ב','ג'][i]}</text></g>)}
  </svg>}
  {lesson.picture === 'triangles' && <div class="triangle-cards">
    {[{name:'חד־זווית',points:'25,130 75,30 135,130',mark:''},{name:'ישר־זווית',points:'25,130 25,30 135,130',mark:'M25 114 H41 V130'},{name:'קהה־זווית',points:'10,130 55,85 140,130',mark:'M44 96 Q56 110 69 93'}].map(t=><div><svg role="img" viewBox="0 0 155 155" aria-label={`משולש ${t.name}`}><polygon points={t.points} class="filled"/><path d={t.mark}/></svg><p>{t.name}</p></div>)}
  </div>}
  {lesson.picture === 'linegraph' && <svg role="img" viewBox="0 0 480 260" aria-label="גרף קווי: בשלב א 5, בשלב ב 9 ובשלב ג 10; העלייה הראשונה גדולה יותר">
    {[0,5,10].map(n=><><line class="grid" x1="70" x2="425" y1={210-n*16} y2={210-n*16}/><text x="42" y={217-n*16}>{n}</text></>)}
    <path d="M70 25 V210 H425"/><path class="graph-line" d="M110 130 L250 66 L390 50"/>
    {[5,9,10].map((n,i)=><><circle cx={110+i*140} cy={210-n*16} r="6"/><text x={110+i*140} y={194-n*16}>{n}</text><text x={110+i*140} y="246">{['א','ב','ג'][i]}</text></>)}
  </svg>}
  {lesson.picture === 'table' && <table><caption>כמות הפריטים בכל קבוצה</caption><thead><tr><th scope="col">קבוצה</th><th scope="col">כמות</th></tr></thead><tbody><tr><th scope="row">א׳</th><td>138</td></tr><tr><th scope="row">ב׳</th><td>161</td></tr></tbody></table>}
  {lesson.picture === 'mean' && <svg role="img" viewBox="0 0 480 260" aria-label="ערכי הקבוצות: 8, 12, 6, 10. קו מקווקו בגובה הממוצע 9">
    {[0,3,6,9,12].map(n=><><line class="grid" x1="65" x2="445" y1={215-n*14} y2={215-n*14}/><text x="40" y={222-n*14}>{n}</text></>)}
    {[8,12,6,10].map((n,i)=><><rect class="filled" x={370-i*90} y={215-n*14} width="44" height={n*14}/><text x={392-i*90} y={204-n*14}>{n}</text><text x={392-i*90} y="248">{['א','ב','ג','ד'][i]}</text></>)}
    <line class="mean-line" x1="65" x2="445" y1="89" y2="89" stroke-dasharray="6 5"/>
  </svg>}
  {lesson.picture === 'groups' && <table><caption>אותו ממוצע, טווחים שונים</caption><thead><tr><th scope="col">קבוצה</th><th scope="col">ערכים</th><th scope="col">ממוצע</th><th scope="col">טווח</th></tr></thead><tbody><tr><th scope="row">א׳</th><td><bdi>8, 9, 10</bdi></td><td>9</td><td>2</td></tr><tr><th scope="row">ב׳</th><td><bdi>1, 9, 17</bdi></td><td>9</td><td>16</td></tr></tbody></table>}
  {lesson.picture === 'numberline' && <div class="numberline" dir="ltr" aria-label="ישר מאפס עד אחד מחולק לשישיות. שליש בשתי שישיות וחצי בשלוש שישיות">
    <div class="numberline-track">{Array.from({length:7},(_,i)=><span class:list={['tick',[2,3].includes(i)&&'chosen']} style={`left:${i/6*100}%`}><span class="tick-label">{i===0?'0':i===6?'1':i===2?<LessonMath value="1/3"/>:i===3?<LessonMath value="1/2"/>:''}</span></span>)}</div>
  </div>}
  {lesson.picture === 'linear' && <>
    <table dir="ltr"><caption>פונקציה קווית: <bdi>y = 3x + 1</bdi></caption><tbody><tr><th scope="row">x</th><td>0</td><td>1</td><td>2</td></tr><tr><th scope="row">y</th><td>1</td><td>4</td><td>7</td></tr></tbody></table>
    <svg role="img" viewBox="0 0 480 255" aria-label="גרף הפונקציה הקווית y שווה 3x ועוד 1, העובר בנקודות אפס ואחת, אחת וארבע, שתיים ושבע">
      <path d="M80 15 V220 H440"/>{[1,4,7].map((n,i)=><><line class="grid" x1="80" x2="410" y1={220-n*25} y2={220-n*25}/><text x="53" y={227-n*25}>{n}</text><text x={80+i*140} y="248">{i}</text><circle cx={80+i*140} cy={220-n*25} r="6"/></>)}<path class="graph-line" d="M80 195 L388 30"/>
    </svg>
  </>}
  {lesson.picture === 'place' && <div class="place-values">
    <p>כל מוט הוא עשרת; כל ריבוע הוא יחידה.</p>
    {lesson.place?.map(row=><div class="place-row" dir="ltr"><bdi>{row.label}</bdi><div class="place-blocks" role="img" aria-label={`${Math.floor(row.value/10)} עשרות ו־${row.value%10} יחידות`}>
      {Array.from({length:Math.floor(row.value/10)},()=> <span class="ten">{Array.from({length:10},()=> <i></i>)}</span>)}
      <span class="ones">{Array.from({length:row.value%10},()=> <i></i>)}</span>
    </div></div>)}
  </div>}
  {lesson.picture === 'bars' && <div class="fraction-bars" dir="ltr">
    {lesson.bars?.map((b,i)=><div class="fraction-row"><span class="fraction-label"><LessonMath value={b.label}/></span><div class={`cells cells-${i}`} style={`--parts:${b.total}`}>
      {Array.from({length:b.total},(_,j)=><span class:list={['cell',j<b.filled && 'cell--filled']}></span>)}
    </div></div>)}
  </div>}
  {lesson.picture === 'shapes' && <svg role="img" viewBox="0 0 480 220" aria-label="ריבוע וקובייה">
    <rect x="55" y="60" width="105" height="105" class="filled"/>
    <g class="solid"><path d="M280 80 L325 40 L425 40 L380 80 Z" class="gold"/><path d="M380 80 L425 40 L425 145 L380 185 Z" class="filled"/><rect x="280" y="80" width="100" height="105" class="filled"/></g>
  </svg>}
  {lesson.picture === 'hundred' && <div class="hundred" dir="ltr" aria-label="לוח המאה משמאל לימין, 34 ו־35 באותה שורה ו־44 מתחת ל־34">{Array.from({length:100},(_,i)=><span class:list={[[34,35,44].includes(i+1) && 'selected']}>{i+1}</span>)}</div>}
  {lesson.picture === 'rectangles' && <svg role="img" viewBox="0 0 480 220" aria-label="ריבוע ומלבן עם סימני זווית ישרה">
    <rect x="35" y="45" width="120" height="120" class="filled"/><rect x="235" y="65" width="200" height="100" class="gold"/>
    <path d="M35 60 H50 V45 M140 45 V60 H155 M35 150 H50 V165 M140 165 V150 H155 M235 80 H250 V65 M420 65 V80 H435 M235 150 H250 V165 M420 165 V150 H435"/>
  </svg>}
  <ol class:list={['steps',lesson.picture === 'equation' ? 'steps--large':'']}>
    {lesson.steps.map((s,i)=><li class={`step step-${i}`}><span class="step-number">{i+1}</span><div><p>{s.text}</p>{s.math && <p class="math" dir="ltr"><LessonMath value={s.math}/></p>}</div></li>)}
  </ol>
</div>
<style>
  table {border-collapse:collapse;width:100%;margin:8px 0 18px;text-align:center;font-size:clamp(12px,3.6cqi,18px);}
  caption {margin-bottom:8px;font-weight:700;direction:rtl;} th,td {border:1px solid #a8b3c7;padding:8px 4px;} th{background:#e3f1ec;}
  .triangle-cards {display:grid;grid-template-columns:repeat(3,1fr);gap:3px;text-align:center;}
  .triangle-cards p {font-size:clamp(12px,3.5cqi,18px);margin:0;}
  svg .graph-line {stroke:#1e605e;stroke-width:4;} svg .mean-line {stroke:#a55700;stroke-width:3;}
  .numberline {padding:30px 15px 68px;}
  .numberline-track {height:2px;background:#22305a;position:relative;}
  .tick {position:absolute;top:-6px;height:14px;border-left:2px solid #22305a;}
  .tick.chosen {border-color:#1e605e;border-width:4px;height:20px;top:-9px;}
  .tick-label {position:absolute;top:22px;left:0;transform:translateX(-50%);font-size:18px;}
  .place-values p {font-size:14px;margin:0 0 10px;}
  .place-row {display:grid;grid-template-columns:44px 1fr;align-items:center;gap:8px;margin:10px 0;}
  .place-blocks {display:flex;align-items:center;gap:5px;min-height:65px;}
  .ten {display:grid;grid-template-rows:repeat(10,1fr);height:60px;width:12px;}
  .ten i {background:#a8d8cc;border:1px solid #22305a;}
  .ones {display:grid;grid-template-columns:repeat(4,9px);gap:3px;margin-left:5px;}
  .ones i {height:9px;background:#f7d489;border:1px solid #22305a;}
  .lesson { padding: 18px 14px; color: #22305a; font-family: Heebo,sans-serif; }
  svg { display:block; width:100%; height:auto; max-height:220px; overflow:visible; }
  svg line,svg path,svg rect,svg polygon { stroke:#22305a; stroke-width:2.5; fill:none; }
  svg .filled { fill:#d7efe8; } svg .gold { fill:#f7d489; }
  svg text { font:700 23px Heebo,sans-serif; fill:#22305a; text-anchor:middle; direction:ltr; unicode-bidi:isolate; }
  svg circle {fill:#1e605e;} svg .grid {stroke:#dce1e9;stroke-width:1;}
  .hundred {display:grid;grid-template-columns:repeat(10,1fr);gap:1px;margin:6px 0;background:#dce1e9;}
  .hundred span {display:grid;place-items:center;min-height:24px;font-size:14px;background:#fff;}
  .hundred .selected {background:#f7d489;font-weight:800;}
  .steps { margin:12px 0 0; padding:0; list-style:none; display:grid; gap:8px; }
  .step {display:flex; gap:10px; align-items:center; padding:10px; border:2px solid #dce1e9; border-radius:12px; background:#fff; }
  .step>div {min-width:0;flex:1;}
  .step p {margin:0;font-size:16px;line-height:1.5;text-wrap:pretty;}
  .step .math {font-size:clamp(14px,3.7cqi,22px);font-weight:800;overflow-wrap:anywhere;text-align:center;}
  .steps--large {margin:0;gap:20px;}
  .steps--large .step {min-height:96px;}
  .step-number {display:grid;place-items:center;border-radius:50%;background:#e3f1ec;min-width:28px;height:28px;font-weight:800;}
  .fraction-bars {display:grid;gap:12px;margin-bottom:20px;}
  .fraction-row {display:grid;grid-template-columns:95px 1fr;align-items:center;gap:8px;}
  .fraction-label {font-size:16px;font-weight:800;text-align:center;}
  .cells {display:grid;grid-template-columns:repeat(var(--parts),1fr);height:32px;border:2px solid #22305a;}
  .cell {border-inline-end:1px solid #22305a;background:#fff;} .cell:last-child {border:0;} .cell--filled {background:#e6a534;}
  .mirror {transform-box:view-box;transform-origin:50% 0;animation:fold 9s ease-in-out infinite;}
  .bar {animation:highlight 9s ease-in-out infinite;}
  .bar-1 {animation-delay:.25s;} .bar-2 {animation-delay:.5s;}
  .step-number,.pair {animation:highlight 9s ease-in-out infinite;}
  .step-1 .step-number,.pair-1 {animation-delay:3s;} .step-2 .step-number,.pair-2 {animation-delay:6s;}
  @keyframes highlight {0%,25% {opacity:1;} 35%,100% {opacity:.65;} }
  @keyframes fold {0%,25%,85%,100% {transform:scaleX(1);opacity:1;} 45%,65% {transform:scaleX(-1);opacity:.45;} }

  @media(prefers-reduced-motion:reduce) {:global(html:not(.nd-motion-enabled)) *,:global(html:not(.nd-motion-enabled)) *::before,:global(html:not(.nd-motion-enabled)) *::after {animation:none!important;} }
  @media(max-width:480px) {.lesson{padding:14px 10px;} .step {padding:8px;gap:6px;} .step p{font-size:15px;}.steps--large{gap:12px;}}
</style>
