---
import LessonMath from './LessonMath.astro';
interface Props { variant: 'similar' | 'similar-area' | 'similar-aa' }
const { variant } = Astro.props;
const area = variant === 'similar-area';
const initialPhase = area ? 6 : 0;
const gridId = `similarity-${crypto.randomUUID()}`;
---
<section class="similarity-film" data-similarity={variant} data-phase={initialPhase} data-beat="0" dir="rtl" aria-label="משפטי דמיון: ז.ז, צ.ז.צ, צ.צ.צ ויחס שטחים">
  <svg viewBox="0 0 360 280" role="img" aria-label="משולשים במנחים שונים. ז.ז: שתי זוויות מתאימות שוות. צ.ז.צ: שתי צלעות ביחס שווה והזווית שביניהן שווה. צ.צ.צ: שלוש צלעות ביחס שווה. לאחר הוכחת הדמיון, ההיקפים והקטעים המתאימים גדלים פי 2, והשטחים פי 4.">
    <g class="triangles-scene">
      <path d="M25 130 L47 85.100111 L125 130 Z" class="small-fill"/>
      <path d="M190 35 L279.799777 79 L190 235 Z" class="large-fill"/>

      <g transform="translate(25 130)" aria-hidden="true"><g class="growing-copy"><path d="M0 0 L22 -44.899889 L100 0 Z"/></g></g>
      <g class="side-lengths"><g class="length-pair length-first"><text x="24" y="98">1</text><text x="242" y="43">2</text></g><g class="length-pair length-second"><text x="77" y="153">2</text><text x="170" y="137">4</text></g><g class="length-pair length-third"><text x="99" y="99">1.8</text><text x="258" y="170">3.6</text></g></g>
      <g class="angle-pair angle-alpha"><path d="M31.6 116.530033 A15 15 0 0 1 40 130 M207.061958 43.36 A19 19 0 0 1 190 54"/><text x="48" y="119">α</text><text x="205" y="66">α</text></g>
      <g class="angle-pair angle-beta"><path d="M58.266667 91.585651 A13 13 0 0 1 41.28 96.774082 M271.318687 93.733333 A17 17 0 0 1 264.533815 71.52"/><text x="53" y="109">β</text><text x="253" y="86">β</text></g>
      <g class="vertices"><text x="17" y="152">A</text><text x="44" y="71">B</text><text x="138" y="137">C</text><text x="180" y="24">D</text><text x="296" y="81">E</text><text x="185" y="252">F</text></g>
      <g class="angle-equations"><text class="alpha-equation" x="95" y="274">α = α</text><text class="beta-equation" x="265" y="274">β = β</text></g>
      <g class="triangle-edges" fill="none"><path class="given-edges" d="M47 85.100111 L25 130 L125 130 M279.799777 79 L190 35 L190 235"/><path class="remaining-edges" d="M47 85.100111 L125 130 M279.799777 79 L190 235"/></g>
      <g class="matching-sides" fill="none">
        <path class="match-leg first-leg" d="M25 130 L47 85.100111 M190 35 L279.799777 79"/>
        <path class="match-leg second-leg" d="M25 130 L125 130 M190 35 L190 235"/>
        <path class="match-leg third-leg" d="M47 85.100111 L125 130 M279.799777 79 L190 235"/>
      </g>
      <g class="perimeters" fill="none">
        <path class="perimeter" pathLength="1" d="M25 130 L47 85.100111 L125 130 Z"/>
        <path class="perimeter" pathLength="1" d="M190 35 L279.799777 79 L190 235 Z"/>
        <text x="76" y="204">P = 4.8</text><text x="260" y="233">P = 9.6</text>
      </g>
      <g class="construction height-pair"><path class="segment" d="M47 85.100111 L47 130 M279.799777 79 L190 79"/><path class="construction-mark" d="M47 125 L52 125 L52 130 M200 79 L200 89 L190 89"/><text x="95" y="274">h</text><text x="265" y="274">2h</text></g>
      <g class="construction bisector-pair"><path class="segment" d="M25 130 L73 100.066741 M190 35 L249.866518 131"/><path class="construction-mark" d="M30.72 118.326029 A13 13 0 0 1 36.030866 123.121047 M39.424978 121.004446 A17 17 0 0 1 42 130 M207.061958 43.36 A19 19 0 0 1 200.053855 51.122035 M202.170456 54.516147 A23 23 0 0 1 190 58"/><text x="95" y="274">b</text><text x="265" y="274">2b</text></g>
      <g class="construction median-pair"><path class="segment" d="M25 130 L86 107.550056 M190 35 L234.899889 157"/><path class="construction-mark" d="M68.495551 92.858417 L64.504449 99.79175 M264.283166 121.991101 L250.4165 114.008899 M107.495551 115.308361 L103.504449 122.241695 M219.383278 199.991101 L205.516611 192.008899"/><circle cx="86" cy="107.550056" r="3"/><circle cx="234.899889" cy="157" r="3"/><text x="95" y="274">m</text><text x="265" y="274">2m</text></g>
    </g>
    <defs>
      <pattern id={`${gridId}-small`} class="square-unit-pattern" width="28" height="28" x="17" y="130" patternUnits="userSpaceOnUse"><path d="M28 0 H0 V28" class="grid-line"/></pattern>
      <pattern id={`${gridId}-large`} class="square-unit-pattern" width="28" height="28" x="190" y="75" patternUnits="userSpaceOnUse"><path d="M28 0 H0 V28" class="grid-line"/></pattern>
    </defs>
    <g class="area-scene">
      <path d="M25 130 L47 85.100111 L125 130 Z" class="area-small"/>
      <path d="M25 130 L47 85.100111 L125 130 Z" class="triangle-unit-grid" fill={`url(#${gridId}-small)`}/>
      <path d="M190 35 L279.799777 79 L190 235 Z" class="area-large"/>
      <path d="M190 35 L279.799777 79 L190 235 Z" class="triangle-unit-grid" fill={`url(#${gridId}-large)`}/>
      <g class="unit-grid">
        <rect class="unit-cell" x="190" y="75" width="28" height="28"/>
        <rect class="unit-cell" x="218" y="75" width="28" height="28"/>
        <rect class="unit-cell" x="190" y="103" width="28" height="28"/>
        <rect class="unit-cell" x="218" y="103" width="28" height="28"/>
      </g>
      <rect class="unit-original" x="45" y="102" width="28" height="28"/>
      <g transform="translate(25 130)" aria-hidden="true"><g class="area-growing">
        <rect class="moving-unit" x="20" y="-28" width="28" height="28"/>
      </g></g>
      <text class="unit-size" x="70" y="160">1 × 1</text><text class="unit-size enlarged-size" x="281" y="150">2 × 2</text>
      <text class="area-total" x="75" y="209">S</text><text class="area-total" x="265" y="258">4S</text>
    </g>
  </svg>
  <div class="scene-caption">
    <p class="caption-0"><span class="aa-proof">שתי זוויות שוות · המשולשים דומים</span><span class="aa-result">הצלעות המתאימות · פי 2</span></p>
    <p class="caption-1"><span class="proof-label">שתי צלעות באותו יחס · הזווית שביניהן שווה</span><span class="result-label">גם ההיקף גדל פי 2</span></p>
    <p class="caption-2">שלושת יחסי הצלעות שווים · המשולשים דומים</p>
    <p class="caption-3">גבהים מתאימים · אותו יחס דמיון</p>
    <p class="caption-4">חוצי זוויות מתאימים · אותו יחס דמיון</p>
    <p class="caption-5">תיכונים מתאימים · אותו יחס דמיון</p>
    <p class="caption-6">1×1 גדל ל־2×2 · ארבע יחידות שטח</p>
    <div class="formula formula-0"><span class="aa-proof"><LessonMath value="△ABC ∼ △DEF"/></span><span class="aa-first"><LessonMath value="2/1 = 2"/></span><span class="aa-second"><LessonMath value="4/2 = 2"/></span></div>
    <div class="formula formula-1"><span class="proof-label"><LessonMath value="2/1 = 4/2 = 2"/></span><span class="result-label"><LessonMath value="9.6/4.8 = 2"/></span></div>
    <div class="formula formula-2"><span class="sss-first"><LessonMath value="2/1"/></span><span class="sss-second"><LessonMath value="= 4/2"/></span><span class="sss-third"><LessonMath value="= 3.6/1.8 = 2"/></span></div>
    <div class="formula formula-3"><LessonMath value="2h/h = 2"/></div>
    <div class="formula formula-4"><LessonMath value="2b/b = 2"/></div>
    <div class="formula formula-5"><LessonMath value="2m/m = 2"/></div>
    <div class="formula formula-6"><LessonMath value="4S/S = 2² = 4"/></div>
  </div>
  <div class="sas-controls" role="group" aria-label="צ.ז.צ והיקף">
    <button type="button" data-sas-beat="0" aria-pressed="true" disabled>צ.ז.צ</button>
    <button type="button" data-sas-beat="2" aria-pressed="false" disabled>היקף</button>
  </div>
  <div class="chapters" role="group" aria-label="בחירת קטע — 10 שניות לכל קטע">
    {['ז.ז','צ.ז.צ','צ.צ.צ','גובה','חוצה זווית','תיכון','שטח'].map((label,i)=><button type="button" data-chapter={i} aria-pressed={initialPhase===i?'true':'false'} disabled>{label}<span aria-hidden="true"></span></button>)}
  </div>
</section>
<script>
  document.querySelectorAll<HTMLElement>('.similarity-film').forEach(film => {
    if(film.dataset.ready) return;
    film.dataset.ready='true';
    const shell=film.closest('.ll');
    const reduced=window.matchMedia('(prefers-reduced-motion: reduce)');
    const buttons=Array.from(film.querySelectorAll<HTMLButtonElement>('[data-chapter]'));
    let phase=Number(film.dataset.phase)||0;
    let elapsed=0;
    let previous=0;
    const duration=10000;
    const sasButtons=Array.from(film.querySelectorAll<HTMLButtonElement>('[data-sas-beat]'));
    const beat=()=> {
      const current=elapsed<3000?0:elapsed<5200?1:elapsed<7400?2:3;
      film.dataset.beat=String(current);
      sasButtons.forEach(button=>button.setAttribute('aria-pressed',String(Number(button.dataset.sasBeat)===(current<2?0:2))));
    };
    const select=(next:number)=>{
      phase=next;elapsed=0;film.dataset.phase=String(next);beat();
      buttons.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===next)));
      film.style.setProperty('--progress','0');
    };
    buttons.forEach((button,i)=>{
      button.addEventListener('click',()=>{
        if(i===phase) return;
        select(i);
        film.toggleAttribute('data-inspect',shell?.classList.contains('ll--paused') ?? false);
      });
      button.disabled=false;
    });
    sasButtons.forEach(button=>{
      button.addEventListener('click',()=>{elapsed=Number(button.dataset.sasBeat)===2?5200:0;beat();film.style.setProperty('--progress',String(elapsed/duration));});
      button.disabled=false;
    });
    reduced.addEventListener('change',()=>{ elapsed=0; previous=0; });
    document.addEventListener('visibilitychange',()=>{ film.toggleAttribute('data-hidden',document.hidden); previous=0; });
    // One clock advances chapters only while the shared pause control, viewport
    // observer and accessibility preferences allow the CSS animation to run.
    const tick=(now:number)=>{
      if(!film.isConnected) return;
      const root=document.documentElement;
      film.toggleAttribute('data-static',reduced.matches || ['nd-motion-off','noam-a11y-motion','noam-a11y-no-motion'].some(c=>root.classList.contains(c)));
      const stopped=reduced.matches || document.hidden || shell?.classList.contains('ll--paused') || shell?.classList.contains('ll--off') || ['nd-motion-off','noam-a11y-motion','noam-a11y-no-motion'].some(c=>root.classList.contains(c));
      if(!stopped && film.hasAttribute('data-inspect')) film.removeAttribute('data-inspect');
      if(!stopped && previous) {
        elapsed+=Math.min(now-previous,100);
        if(elapsed>=duration) select((phase+1)%7);
        beat();
        film.style.setProperty('--progress',String(elapsed/duration));
      }
      previous=now;requestAnimationFrame(tick);
    };
    requestAnimationFrame(tick);
  });
</script>
<style>
  .similarity-film{padding:8px 12px 14px;color:#22305a;font-family:Heebo,sans-serif;--progress:0;}
  svg{display:block;width:100%;height:auto;}
  svg path{stroke-linejoin:round;stroke-linecap:round;}
  svg text{font:700 19px Heebo,sans-serif;text-anchor:middle;direction:ltr;unicode-bidi:isolate;fill:#22305a;paint-order:stroke;stroke:white;stroke-width:3px;stroke-linejoin:round;}
  .small-fill{fill:#dceee8;stroke:none;}
  .large-fill{fill:#fff3d6;stroke:none;}
  .triangle-edges{stroke:#22305a;stroke-width:2.5;}
  .remaining-edges{transition:opacity .5s;}
  [data-phase="1"][data-beat="0"] .remaining-edges,[data-phase="1"][data-beat="1"] .remaining-edges{opacity:.08;}
  .growing-copy{transform-box:view-box;transform-origin:0 0;opacity:0;}
  .growing-copy path{fill:#65b4a63b;stroke:#14635b;stroke-width:2.5;}
  [data-phase='0'][data-ready] .growing-copy{animation:rotate-enlarge 10s ease-in-out both;}
  .angle-pair{fill:none;stroke-width:3;}
  .angle-pair text{font-size:16px;stroke-width:2px;fill:currentColor;}
  .angle-alpha{color:#14635b;stroke:#14635b;}.angle-beta{color:#a44716;stroke:#a44716;}
  [data-phase='0'][data-ready] .angle-alpha,[data-phase='0'][data-ready] .alpha-equation{animation:alpha-focus 10s ease-in-out both;}
  [data-phase='0'][data-ready] .angle-beta,[data-phase='0'][data-ready] .beta-equation{animation:beta-focus 10s ease-in-out both;}
  .alpha-equation{fill:#14635b;}.beta-equation{fill:#a44716;}
  .area-scene,.angle-equations{display:none;}
  [data-phase='0'][data-beat='0'] .angle-equations,[data-phase='0'][data-beat='1'] .angle-equations,[data-phase='6'] .area-scene{display:inline;}
  [data-phase='6'] .triangles-scene{display:none;}
  .area-small,.area-large{fill:#e7f3ed;stroke:#22305a;stroke-width:2;}
  .area-large{fill:#fff3d6;}
  .grid-line{fill:none;stroke:#608b83;stroke-width:1;opacity:.6;}
  .triangle-unit-grid{stroke:#22305a;stroke-width:2;}
  .unit-original,.unit-cell,.moving-unit{fill:#7bb9a8;stroke:#22305a;stroke-width:1;}
  .unit-cell:nth-of-type(2){fill:#f7d489;}.unit-cell:nth-of-type(3){fill:#b9c9e9;}.unit-cell:nth-of-type(4){fill:#efb9a8;}
  .area-growing{transform-box:view-box;transform-origin:0 0;opacity:0;}
  .moving-unit{fill:#7bb9a8;stroke:#14635b;stroke-width:2;}.unit-original{stroke:#14635b;stroke-width:2;}.unit-size{font-size:22px;}
  [data-phase='6'][data-ready] .area-growing{animation:unit-area-grow 10s ease-in-out both;}
  [data-phase='6'][data-ready] .unit-grid{animation:reveal-grid 10s ease-in-out both;}
  [data-phase='6'][data-ready] .enlarged-size{animation:reveal-size 10s ease-in-out both;}
  @keyframes reveal-size{0%,45%{opacity:0;}55%,100%{opacity:1;}}
  .area-total{font-size:24px;}
  .scene-caption{min-height:82px;display:grid;align-content:center;text-align:center;}
  .scene-caption p{font-size:15px;line-height:1.5;margin:0 0 8px;}
  .scene-caption>*{display:none;}
  [data-phase='0'] .caption-0,[data-phase='0'] .formula-0,[data-phase='1'] .caption-1,[data-phase='1'] .formula-1,[data-phase='2'] .caption-2,[data-phase='2'] .formula-2,[data-phase='3'] .caption-3,[data-phase='3'] .formula-3,[data-phase='4'] .caption-4,[data-phase='4'] .formula-4,[data-phase='5'] .caption-5,[data-phase='5'] .formula-5,[data-phase='6'] .caption-6,[data-phase='6'] .formula-6{display:block;}
  .formula{font-size:21px;font-weight:750;direction:ltr;}
  .sas-controls{display:none;gap:8px;margin-bottom:10px;}
  .sas-controls button{flex:1;min-height:44px;border:1px solid #d5dce6;border-radius:9px;background:white;color:#22305a;font:600 14px Heebo,sans-serif;cursor:pointer;pointer-events:auto;}
  .sas-controls button[aria-pressed='true']{background:#e7f3ed;border-color:#14635b;}
  .sas-controls button:focus-visible{outline:3px solid #e6a534;outline-offset:2px;}
  [data-static][data-phase='1'] .sas-controls,:global(.ll--paused) [data-phase='1'] .sas-controls{display:flex;}
  .chapters{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:7px;border-top:1px solid #e0e5e9;padding-top:12px;}
  .chapters button{position:relative;overflow:hidden;min-height:44px;border:1px solid #d5dce6;border-radius:9px;background:white;color:#22305a;font:600 14px Heebo,sans-serif;cursor:pointer;pointer-events:auto;}
  .chapters button[aria-pressed='true']{background:#e7f3ed;border-color:#1e605e;}
  .chapters button:focus-visible{outline:3px solid #e6a534;outline-offset:2px;}
  .chapters span{position:absolute;bottom:0;right:0;height:3px;background:#1e605e;width:100%;transform:scaleX(0);transform-origin:right;}
  .chapters [aria-pressed='true'] span{transform:scaleX(var(--progress));}
  @keyframes rotate-enlarge{0%,5%{transform:translate(0,0) rotate(0deg) scale(1);opacity:0;}12%{transform:translate(0,0) rotate(0deg) scale(1);opacity:1;}22%{transform:translate(0,0) rotate(90deg) scale(1);opacity:1;}43%,47%{transform:translate(165px,-95px) rotate(90deg) scale(2);opacity:1;}52%,100%{transform:translate(165px,-95px) rotate(90deg) scale(2);opacity:0;}}
  @keyframes alpha-focus{0%,45%,100%{opacity:1;stroke-width:5;}55%,85%{opacity:.5;stroke-width:3;}}
  @keyframes beta-focus{0%,40%{opacity:.5;stroke-width:3;}50%,100%{opacity:1;stroke-width:5;}}
  @keyframes unit-area-grow{0%,8%{transform:translate(0,0) rotate(0deg) scale(1);opacity:0;}15%{transform:translate(0,0) rotate(0deg) scale(1);opacity:1;}55%,65%{transform:translate(165px,-95px) rotate(90deg) scale(2);opacity:1;}75%,100%{transform:translate(165px,-95px) rotate(90deg) scale(2);opacity:0;}}
  @keyframes reveal-grid{0%,60%{opacity:0;}75%,100%{opacity:1;}}
  .matching-sides,.perimeters,.construction{display:none;}
  .match-leg{stroke-width:4;stroke:#14635b;}
  [data-ready] .matching-sides .match-leg{stroke-dasharray:300;animation:draw-side .7s ease-out both;}
  [data-ready] .matching-sides .second-leg{animation-delay:.7s;}
  [data-ready] .matching-sides .third-leg{animation-delay:1.4s;}
  @keyframes draw-side{from{stroke-dashoffset:300;}to{stroke-dashoffset:0;}}
  .second-leg{stroke:#a44716;}.third-leg{stroke:#5d54a4;}
  [data-phase='1'] .matching-sides,[data-phase='2'] .matching-sides{display:inline;}
  [data-phase='1'] .third-leg,[data-phase='1'] .angle-beta,[data-phase='2'] .angle-pair,[data-phase='3'] .angle-pair,[data-phase='4'] .angle-pair,[data-phase='5'] .angle-pair{display:none;}
  [data-phase='1'] .angle-alpha{stroke-width:5;}
  [data-phase='1'][data-beat='0'] .length-third,[data-phase='1'][data-beat='1'] .length-third{display:none;}
  [data-phase='1'][data-beat='2'] .matching-sides,[data-phase='1'][data-beat='3'] .matching-sides{display:none;}
  [data-phase='1'][data-beat='2'] .perimeters,[data-phase='1'][data-beat='3'] .perimeters{display:inline;}
  .perimeter{stroke:#14635b;stroke-width:4;stroke-dasharray:1;}
  [data-ready][data-phase='1'] .perimeter{animation:trace-perimeter 4.8s linear both;}
  @keyframes trace-perimeter{0%{stroke-dashoffset:1;}60%,100%{stroke-dashoffset:0;}}
  [data-phase='0'] .length-pair{display:none;}
  [data-phase='0'][data-beat='2'] .length-first,[data-phase='0'][data-beat='3'] .length-second{display:inline;}
  [data-phase='0'][data-beat='2'] .matching-sides,[data-phase='0'][data-beat='3'] .matching-sides{display:inline;}
  [data-phase='0'] .match-leg{display:none;}
  [data-phase='0'][data-beat='2'] .first-leg,[data-phase='0'][data-beat='3'] .second-leg{display:inline;animation-delay:0s;}
  [data-phase='2'][data-beat='0'] .length-second,[data-phase='2'][data-beat='0'] .length-third,[data-phase='2'][data-beat='1'] .length-third,[data-phase='2'][data-beat='0'] .second-leg,[data-phase='2'][data-beat='0'] .third-leg,[data-phase='2'][data-beat='1'] .third-leg{display:none;}
  [data-phase='2'] .match-leg{animation-delay:0s!important;}
  [data-phase='2'][data-beat='3'][data-ready] .growing-copy{animation:proof-fit 2.6s ease-in-out both;}
  @keyframes proof-fit{0%{transform:translate(0,0) rotate(0deg) scale(1);opacity:0;}10%{opacity:.8;}85%,100%{transform:translate(165px,-95px) rotate(90deg) scale(2);opacity:.65;}}
  [data-phase='3'] .side-lengths,[data-phase='4'] .side-lengths,[data-phase='5'] .side-lengths{display:none;}
  [data-phase='3'] .height-pair,[data-phase='4'] .bisector-pair,[data-phase='5'] .median-pair{display:inline;}
  .construction{color:#14635b;}.bisector-pair{color:#a44716;}.median-pair{color:#5d54a4;}
  .segment{fill:none;stroke:currentColor;stroke-width:3;stroke-dasharray:240;}
  [data-ready] .construction .segment{animation:draw-segment .8s ease-out both;}
  .construction-mark{fill:none;stroke:currentColor;stroke-width:1.6;}
  .construction circle{fill:currentColor;}.construction text{fill:currentColor;}
  @keyframes draw-segment{from{stroke-dashoffset:240;}to{stroke-dashoffset:0;}}
  .result-label,.aa-result,.aa-first,.aa-second{display:none;}
  [data-phase='0'][data-beat='2'] .aa-proof,[data-phase='0'][data-beat='3'] .aa-proof{display:none;}
  [data-phase='0'][data-beat='2'] .aa-result,[data-phase='0'][data-beat='3'] .aa-result,[data-phase='0'][data-beat='2'] .aa-first,[data-phase='0'][data-beat='3'] .aa-second{display:inline;}
  [data-phase='1'][data-beat='2'] .proof-label,[data-phase='1'][data-beat='3'] .proof-label{display:none;}
  [data-phase='1'][data-beat='2'] .result-label,[data-phase='1'][data-beat='3'] .result-label{display:inline;}
  [data-phase='2'][data-beat='0'] .sss-second,[data-phase='2'][data-beat='0'] .sss-third,[data-phase='2'][data-beat='1'] .sss-third{visibility:hidden;}
  .formula-2{display:none;direction:ltr;white-space:nowrap;font-size:19px;}
