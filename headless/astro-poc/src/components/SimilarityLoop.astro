---
import LessonMath from './LessonMath.astro';
interface Props { variant: 'similar' | 'similar-area' | 'similar-aa' }
const { variant } = Astro.props;
const area = variant === 'similar-area';
const aa = variant === 'similar-aa';
const steps = area ? [
  {text:'כל צלע במשולש הגדול ארוכה פי שניים',math:'6/3 = 8/4 = 10/5 = 2'},
  {text:'ארבעה משולשים קטנים מכסים את הגדול',math:'4 × 6 = 24'},
  {text:'יחס השטחים הוא ריבוע יחס הדמיון',math:'24/6 = 2² = 4'},
] : aa ? [
  {text:'זווית A שווה לזווית D — שתיהן ישרות',math:'∠A = ∠D = 90°'},
  {text:'גם הזוויות B ו־E שוות, לפי סימון הקשת',math:'∠B = ∠E'},
  {text:'לכן המשולשים דומים לפי זווית–זווית',math:'△ABC ∼ △DEF'},
] : [
  {text:'מתאימים קודקודים באותו סדר',math:'A ↔ D; B ↔ E; C ↔ F'},
  {text:'אותו גורם הגדלה בכל שלוש הצלעות',math:'6/3 = 8/4 = 10/5 = 2'},
  {text:'הצורה נשמרת: הזוויות המתאימות שוות',math:'△ABC ∼ △DEF'},
];
---
<section class:list={['similarity',area&&'similarity--area',aa&&'similarity--aa']} data-similarity={variant} dir="rtl" aria-label={area?'דמיון משולשים ויחס שטחים':aa?'דמיון לפי שתי זוויות שוות':'התאמת צלעות במשולשים דומים'}>
  <h2>{area?'פי 2 בצלעות, פי 4 בשטח':aa?'שתי זוויות שוות — משולשים דומים':'אותה צורה, גודל אחר'}</h2>
  <p class="intro">{aa?'משווים שני זוגות של זוויות מתאימות.':<>משולש של <bdi>3, 4, 5</bdi> מול משולש של <bdi>6, 8, 10</bdi>.</>}</p>
  <svg viewBox="0 0 360 280" role="img" aria-label={aa?'משולשים ABC ו־DEF. הזוויות A ו־D ישרות; קשתות זהות מסמנות זוויות שוות B ו־E.':area?'משולש קטן בעל שטח 6. במשולש הגדול ארבעה עותקים חופפים של הקטן ושטחו 24.':'משולש ABC עם צלעות 3, 4, 5 ומשולש DEF עם צלעות 6, 8, 10, מצוירים באותו קנה מידה. כל צלע בגדול כפולה מהצלע המתאימה בקטן.'}>
    <path d="M35 115 V55 L115 115 Z" class="small-fill"/>
    <path d="M165 230 V110 L325 230 Z" class="large-fill"/>
    {area && <g class="area-tiles">
      <path d="M165 170 V110 L245 170 Z" class="tile-one"/>
      <path d="M165 230 V170 L245 230 Z" class="tile-two"/>
      <path d="M245 230 V170 L325 230 Z" class="tile-three"/>
      <path d="M165 170 H245 V230 Z" class="tile-four"/>
    </g>}
    {!aa && !area && <g transform="translate(35 115)" aria-hidden="true"><g class="growing-copy"><path d="M0 0 V-60 L80 0 Z"/></g></g>}
    {!aa && <g class="correspondence" aria-hidden="true"><path class="focus-one" d="M35 115 V55 M165 230 V110"/><path class="focus-two" d="M35 115 H115 M165 230 H325"/><path class="focus-three" d="M35 55 L115 115 M165 110 L325 230"/></g>}
    <g class="side side-one"><path d="M35 115 V55 M165 230 V110"/>{!aa&&<><text x="17" y="91">3</text><text x="143" y="176">6</text></>}</g>
    <g class="side side-two"><path d="M35 115 H115 M165 230 H325"/>{!aa&&<><text x="77" y="139">4</text><text x="247" y="255">8</text></>}</g>
    <g class="side side-three"><path d="M35 55 L115 115 M165 110 L325 230"/>{!aa&&<><text x="91" y="79">5</text><text x="266" y="163">10</text></>}</g>
    <g class="angle-marks"><path d="M35 105 H45 V115 M165 216 H179 V230"/><path d="M35 73 A18 18 0 0 0 49.4 65.8 M165 134 A24 24 0 0 0 184.2 124.4"/></g>
    <g class="vertices"><text x="28" y="138">A</text><text x="31" y="39">B</text><text x="130" y="121">C</text><text x="157" y="254">D</text><text x="161" y="94">E</text><text x="342" y="238">F</text></g>
  </svg>
  <div class="scale-key">{area?'שטח הקטן: 6 · שטח הגדול: 24':aa?'התאמה: A ל־D, B ל־E, C ל־F':'כל האורכים באותה יחידת מידה · הגדלה פי 2'}</div>
  <ol>{steps.map((step,i)=><li class={`explanation explanation-${i}`}><span class="number">{i+1}</span><div><p>{step.text}</p><p class="math"><LessonMath value={step.math}/></p></div></li>)}</ol>
</section>
<style>
  .similarity {padding:12px 12px 16px;color:#22305a;font-family:Heebo,sans-serif;}
  h2 {font-size:clamp(19px,5cqi,26px);line-height:1.3;margin:0 0 6px;}
  .intro {font-size:15px;line-height:1.6;margin:0;}
  svg {display:block;width:100%;height:auto;overflow:visible;}
  svg path {stroke-linejoin:round;stroke-linecap:round;}
  .small-fill {fill:#e1f1eb;stroke:#22305a;stroke-width:2;}
  .large-fill {fill:#fff4da;stroke:#22305a;stroke-width:2;}
  svg text {font:700 20px Heebo,sans-serif;text-anchor:middle;direction:ltr;unicode-bidi:isolate;fill:#22305a;paint-order:stroke;stroke:white;stroke-width:4px;stroke-linejoin:round;}
  .side path {fill:none;stroke-width:3;}
  .side-one path {stroke:#1e605e;} .side-two path {stroke:#b94732;} .side-three path {stroke:#22305a;}
  .correspondence path {fill:none;stroke:#e6a534;stroke-width:9;opacity:0;animation:side-focus 18s ease-in-out infinite;}
  .correspondence .focus-two{animation-delay:3s;} .correspondence .focus-three{animation-delay:6s;}
  .similarity--aa .angle-marks {animation:angle-focus 12s ease-in-out infinite;}
  .angle-marks {fill:none;stroke:#22305a;stroke-width:2;}
  .growing-copy {transform-box:view-box;transform-origin:0 0;animation:enlarge 18s ease-in-out infinite;opacity:0;}
  .growing-copy path {fill:#e6a53433;stroke:#a55700;stroke-width:2;stroke-dasharray:4 3;}
  .area-tiles path {stroke:#22305a;stroke-width:1.5;}
  .tile-one{fill:#b7dfd2;} .tile-two{fill:#f7d489;} .tile-three{fill:#b9c9e9;} .tile-four{fill:#efb9a8;}
  .area-tiles path {animation:tiles 18s ease-in-out infinite;}
  .area-tiles .tile-two{animation-delay:4.5s;} .area-tiles .tile-three{animation-delay:9s;} .area-tiles .tile-four{animation-delay:13.5s;}
  .scale-key {border-radius:8px;background:#f1f5f6;padding:8px;font-size:14px;line-height:1.5;text-align:center;}
  ol{padding:0;margin:12px 0 0;list-style:none;display:grid;gap:8px;}
  li{display:flex;gap:8px;align-items:center;padding:10px 8px;border:1px solid #dce1e9;border-radius:12px;background:white;}
  li>div{flex:1;min-width:0;} li p{margin:0;font-size:15px;line-height:1.6;}
  .number{display:grid;place-items:center;min-width:26px;height:26px;border-radius:50%;background:#e3f1ec;font-weight:700;}
  .math{text-align:center;direction:ltr;font-size:clamp(15px,4cqi,21px);font-weight:700;margin-top:5px;}
  @keyframes enlarge {0%,8%{transform:translate(0,0) scale(1);opacity:0;} 12%{transform:translate(0,0) scale(1);opacity:1;} 32%,40%{transform:translate(130px,115px) scale(2);opacity:1;} 45%,100%{transform:translate(130px,115px) scale(2);opacity:0;}}
  @keyframes side-focus {0%,44%,62%,100%{opacity:0;} 48%,58%{opacity:.6;}}
  @keyframes angle-focus {0%,40%,100%{opacity:1;} 50%,65%{opacity:.45;}}
  @keyframes tiles {0%,20%{opacity:1;} 30%,90%{opacity:.5;} 100%{opacity:1;}}
  @media(prefers-reduced-motion:reduce){*{animation:none!important;}.growing-copy{display:none;}}
</style>
