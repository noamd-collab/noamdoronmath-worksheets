---
/**
 * Hand-drawn math scribbles — stars, spirals, arrows, underlines, formulas.
 * Formulas force LTR. When organicMobile: absolute φ placement + draw-once
 * for a²+b²=c². Every scribble bobs/wobbles when motion is allowed.
 */
import type { ScribbleItem } from '../lib/doodles/selectNotebookScatter';

export interface Props {
  items: ScribbleItem[];
  /** Absolute φ layout (with HomeSectionDoodle / MobileNotebookCorners). */
  organicMobile?: boolean;
}

const { items, organicMobile = false } = Astro.props;

const FORMULAS = ['a²+b²=c²', 'πr²', 'y=mx+b'] as const;
---

{
  items.map((s, i) => (
    <span
      class:list={[
        'math-scribble',
        `math-scribble--${s.kind}`,
        'math-scribble--motion',
        organicMobile ? 'math-scribble--organic' : null,
        s.kind === 'formula' ? 'math-scribble--draw' : null,
      ]}
      style={[
        `--s-rot:${s.rotate}deg`,
        `--s-size:${s.sizePx}px`,
        `--s-delay:${s.delay}s`,
        `--d-dur:${s.duration}s`,
        `--d-bob:${s.bobPx}px`,
        `--d-wobble:${s.wobbleDeg}deg`,
        `--inline-inset:${s.inlineInsetPct}%`,
        `--y:${s.yPct}%`,
        `--m-op:${s.mobileOpacity}`,
        s.kind === 'formula' ? 'direction:ltr;unicode-bidi:isolate' : '',
      ]
        .filter(Boolean)
        .join(';')}
      data-scribble={s.kind}
      data-scribble-i={i}
      data-nb-side={s.side}
      dir={s.kind === 'formula' ? 'ltr' : undefined}
      aria-hidden="true"
    >
      {
        s.kind === 'star' && (
          <svg viewBox="0 0 40 40" focusable="false">
            <path
              d="M20 4 L24 15 L36 15 L26 23 L30 35 L20 28 L10 35 L14 23 L4 15 L16 15 Z"
              fill="none"
              stroke="var(--cobalt, #2a5db0)"
              stroke-width="2.2"
              stroke-linejoin="round"
            />
          </svg>
        )
      }
      {
        s.kind === 'spiral' && (
          <svg viewBox="0 0 40 40" focusable="false">
            <path
              d="M20 32 C 10 32, 8 22, 14 16 C 20 10, 30 12, 30 20 C 30 26, 24 28, 20 26 C 16 24, 16 20, 19 19"
              fill="none"
              stroke="var(--navy, #1a3358)"
              stroke-width="2.4"
              stroke-linecap="round"
            />
          </svg>
        )
      }
      {
        s.kind === 'arrow' && (
          <svg viewBox="0 0 48 28" focusable="false">
            <path
              d="M4 18 C 16 6, 28 6, 40 14"
              fill="none"
              stroke="var(--cobalt, #2a5db0)"
              stroke-width="2.4"
              stroke-linecap="round"
            />
            <path
              d="M34 8 L42 14 L34 20"
              fill="none"
              stroke="var(--cobalt, #2a5db0)"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        )
      }
      {
        s.kind === 'underline' && (
          <svg viewBox="0 0 56 20" focusable="false">
            <path
              d="M4 12 C 14 4, 22 18, 32 10 S 46 6, 52 12"
              fill="none"
              stroke="var(--red, #c45c4a)"
              stroke-width="2.6"
              stroke-linecap="round"
            />
          </svg>
        )
      }
      {
        s.kind === 'formula' && (
          <svg
            class="math-scribble__formula-svg"
            viewBox="0 0 112 32"
            focusable="false"
          >
            <text
              class="math-scribble__formula-text"
              x="4"
              y="22"
              direction="ltr"
              unicode-bidi="isolate"
              fill="var(--navy, #1a3358)"
              font-family="Heebo, Assistant, 'Segoe Print', 'Comic Sans MS', cursive"
              font-size="17"
              font-weight="800"
              font-style="italic"
              letter-spacing="0.5"
            >
              {FORMULAS[i % FORMULAS.length]}
            </text>
          </svg>
        )
      }
      {
        s.kind === 'dots' && (
          <svg viewBox="0 0 40 16" focusable="false">
            <circle cx="6" cy="8" r="2.4" fill="var(--cobalt, #2a5db0)" />
            <circle cx="20" cy="8" r="2.4" fill="var(--muted, #6b7c93)" />
            <circle cx="34" cy="8" r="2.4" fill="var(--red, #c45c4a)" />
          </svg>
        )
      }
    </span>
  ))
}

<style>
  .math-scribble {
    display: inline-flex;
    width: var(--s-size, 40px);
    height: auto;
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
    transform: rotate(var(--s-rot, 0deg));
    flex: 0 0 auto;
  }
  .math-scribble--formula {
    width: max(88px, calc(var(--s-size, 40px) * 1.8));
    direction: ltr;
    unicode-bidi: isolate;
  }
  .math-scribble__formula-svg {
    direction: ltr;
  }
  .math-scribble svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .math-scribble--motion {
    animation: scribble-bob-wobble var(--d-dur, 6.5s) ease-in-out infinite;
    animation-delay: var(--s-delay, 0s);
    will-change: transform;
  }
  @keyframes scribble-bob-wobble {
    0%,
    100% {
      transform: translateY(0) rotate(calc(var(--s-rot, 0deg) - var(--d-wobble, 4deg)));
    }
    50% {
      transform: translateY(calc(-1 * var(--d-bob, 6px)))
        rotate(calc(var(--s-rot, 0deg) + var(--d-wobble, 4deg)));
    }
  }

  /* Formula draws itself once (LTR clip reveal), then keeps bobbing */
  .math-scribble--draw .math-scribble__formula-svg {
    animation: formula-draw 2.6s ease forwards;
    animation-delay: var(--s-delay, 0.2s);
  }
  @keyframes formula-draw {
    from {
      clip-path: inset(0 100% 0 0);
    }
    to {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .math-scribble--motion,
    .math-scribble--draw .math-scribble__formula-svg {
      animation: none;
    }
    .math-scribble--draw .math-scribble__formula-svg {
      clip-path: none;
    }
  }
  :global(html.noam-a11y-motion) .math-scribble--motion,
  :global(html.nd-motion-off) .math-scribble--motion,
  :global(html.noam-a11y-motion) .math-scribble--draw .math-scribble__formula-svg,
  :global(html.nd-motion-off) .math-scribble--draw .math-scribble__formula-svg {
    animation: none !important;
  }
  :global(html.noam-a11y-motion) .math-scribble--draw .math-scribble__formula-svg,
  :global(html.nd-motion-off) .math-scribble--draw .math-scribble__formula-svg {
    clip-path: none !important;
  }

  /* Absolute margin placement inside section scatter wrappers */
  .math-scribble--organic {
    position: absolute;
    display: block;
    inset-block-start: var(--y, 38.2%);
    opacity: var(--m-op, 0.7);
    flex: none;
    z-index: 0;
    max-width: 110px;
    transform: translateY(-50%) rotate(var(--s-rot, 0deg));
  }
  .math-scribble--organic[data-nb-side='start'] {
    inset-inline-start: var(--inline-inset, 4%);
    inset-inline-end: auto;
  }
  .math-scribble--organic[data-nb-side='end'] {
    inset-inline-end: var(--inline-inset, 4%);
    inset-inline-start: auto;
  }
  .math-scribble--organic.math-scribble--motion {
    animation-name: scribble-bob-wobble-abs;
  }
  @keyframes scribble-bob-wobble-abs {
    0%,
    100% {
      transform: translateY(-50%) translateY(0)
        rotate(calc(var(--s-rot, 0deg) - var(--d-wobble, 4deg)));
    }
    50% {
      transform: translateY(-50%) translateY(calc(-1 * var(--d-bob, 6px)))
        rotate(calc(var(--s-rot, 0deg) + var(--d-wobble, 4deg)));
    }
  }
  .math-scribble--organic.math-scribble--formula {
    width: min(110px, max(72px, calc(var(--s-size, 40px) * 1.6)));
  }
  /* Mobile: hide section scribbles — thin edge motifs carry the density budget */
  @media (max-width: 767px) {
    .math-scribble--organic {
      display: none !important;
    }
  }
</style>
