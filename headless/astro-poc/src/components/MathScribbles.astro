---
/**
 * Small hand-drawn math scribbles (SVG) — stars, spirals, arrows,
 * underlines, readable formulas (a²+b²=c²). Notebook ink language.
 * NOT the thin grey HomeMarginArt icon set.
 * Formulas force LTR so they stay readable on RTL pages.
 */
import type { ScribbleItem } from '../lib/doodles/selectNotebookScatter';

export interface Props {
  items: ScribbleItem[];
}

const { items } = Astro.props;

/** Alternate readable formulas (picked by item index). Always LTR. */
const FORMULAS = ['a²+b²=c²', 'πr²', 'y=mx+b'] as const;
---

{
  items.map((s, i) => (
    <span
      class:list={[
        'math-scribble',
        `math-scribble--${s.kind}`,
        s.float ? 'math-scribble--float' : null,
      ]}
      style={`--s-rot:${s.rotate}deg;--s-size:${s.sizePx}px;--s-delay:${s.delay}s`}
      data-scribble={s.kind}
      data-scribble-i={i}
      aria-hidden="true"
    >
      {
        s.kind === 'star' && (
          <svg viewBox="0 0 40 40" focusable="false">
            <path
              d="M20 4 L24 15 L36 15 L26 23 L30 35 L20 28 L10 35 L14 23 L4 15 L16 15 Z"
              fill="none"
              stroke="var(--cobalt, #2a5db0)"
              stroke-width="2.2"
              stroke-linejoin="round"
            />
          </svg>
        )
      }
      {
        s.kind === 'spiral' && (
          <svg viewBox="0 0 40 40" focusable="false">
            <path
              d="M20 32 C 10 32, 8 22, 14 16 C 20 10, 30 12, 30 20 C 30 26, 24 28, 20 26 C 16 24, 16 20, 19 19"
              fill="none"
              stroke="var(--navy, #1a3358)"
              stroke-width="2.4"
              stroke-linecap="round"
            />
          </svg>
        )
      }
      {
        s.kind === 'arrow' && (
          <svg viewBox="0 0 48 28" focusable="false">
            <path
              d="M4 18 C 16 6, 28 6, 40 14"
              fill="none"
              stroke="var(--cobalt, #2a5db0)"
              stroke-width="2.4"
              stroke-linecap="round"
            />
            <path
              d="M34 8 L42 14 L34 20"
              fill="none"
              stroke="var(--cobalt, #2a5db0)"
              stroke-width="2.4"
              stroke-linecap="round"
              stroke-linejoin="round"
            />
          </svg>
        )
      }
      {
        s.kind === 'underline' && (
          <svg viewBox="0 0 56 20" focusable="false">
            <path
              d="M4 12 C 14 4, 22 18, 32 10 S 46 6, 52 12"
              fill="none"
              stroke="var(--red, #c45c4a)"
              stroke-width="2.6"
              stroke-linecap="round"
            />
          </svg>
        )
      }
      {
        s.kind === 'formula' && (
          <svg
            class="math-scribble__formula-svg"
            viewBox="0 0 112 32"
            focusable="false"
          >
            {/* Readable hand-ink formula; explicit LTR for RTL pages */}
            <text
              x="4"
              y="22"
              direction="ltr"
              unicode-bidi="isolate"
              fill="var(--navy, #1a3358)"
              font-family="Heebo, Assistant, 'Segoe Print', 'Comic Sans MS', cursive"
              font-size="17"
              font-weight="800"
              font-style="italic"
              letter-spacing="0.5"
            >
              {FORMULAS[i % FORMULAS.length]}
            </text>
          </svg>
        )
      }
      {
        s.kind === 'dots' && (
          <svg viewBox="0 0 40 16" focusable="false">
            <circle cx="6" cy="8" r="2.4" fill="var(--cobalt, #2a5db0)" />
            <circle cx="20" cy="8" r="2.4" fill="var(--muted, #6b7c93)" />
            <circle cx="34" cy="8" r="2.4" fill="var(--red, #c45c4a)" />
          </svg>
        )
      }
    </span>
  ))
}

<style>
  .math-scribble {
    display: inline-flex;
    width: var(--s-size, 40px);
    height: auto;
    opacity: 0.85;
    pointer-events: none;
    user-select: none;
    transform: rotate(var(--s-rot, 0deg));
    flex: 0 0 auto;
  }
  .math-scribble--formula {
    /* Wider so a²+b²=c² / πr² stay readable; force LTR in RTL doc */
    width: max(88px, calc(var(--s-size, 40px) * 1.8));
    direction: ltr;
    unicode-bidi: isolate;
  }
  .math-scribble__formula-svg {
    direction: ltr;
  }
  .math-scribble svg {
    width: 100%;
    height: auto;
    display: block;
    overflow: visible;
  }
  .math-scribble--float {
    animation: site-doodle-float 7.8s ease-in-out infinite;
    animation-delay: var(--s-delay, 0s);
    will-change: transform;
  }
  @keyframes site-doodle-float {
    0%,
    100% {
      transform: translateY(0) rotate(var(--s-rot, 0deg));
    }
    50% {
      transform: translateY(-8px) rotate(var(--s-rot, 0deg));
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .math-scribble--float {
      animation: none;
    }
  }
  :global(html.noam-a11y-motion) .math-scribble--float {
    animation: none !important;
  }
</style>
