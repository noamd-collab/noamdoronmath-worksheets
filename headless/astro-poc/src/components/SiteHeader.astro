---
import SiteBrand from './SiteBrand.astro';
import {
  resolveActiveNav,
  resolveWorksheetsNavBand,
  type ActiveNavKey,
  type WorksheetsNavBand,
} from '../lib/activeNav';

interface Props {
  /** Optional override; default derives from the request pathname. */
  active?: ActiveNavKey | null;
  compactBrand?: boolean;
}

const pathname = Astro.url.pathname;
const active: ActiveNavKey | null =
  Astro.props.active !== undefined ? Astro.props.active : resolveActiveNav(pathname);
const { compactBrand = false } = Astro.props;
const worksheetsBand: WorksheetsNavBand | null =
  active === 'worksheets'
    ? resolveWorksheetsNavBand(pathname, Astro.url.searchParams)
    : null;

function navProps(key: ActiveNavKey) {
  const isActive = active === key;
  return {
    class: ['site-nav__link', isActive ? 'is-active' : undefined].filter(Boolean).join(' '),
    'aria-current': isActive ? ('page' as const) : undefined,
  };
}

function worksheetsNavProps(band: WorksheetsNavBand) {
  const isActive = worksheetsBand === band;
  return {
    class: ['site-nav__link', isActive ? 'is-active' : undefined].filter(Boolean).join(' '),
    'aria-current': isActive ? ('page' as const) : undefined,
  };
}

const learnActive = active === 'learning';
---
<div class="basad" lang="he" data-basad>בס״ד</div>
<header class="site-header">
  <div class="site-header__inner">
    <div class="site-header__brand">
      <SiteBrand href="/" compact={compactBrand} />
    </div>
    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="primary-nav"
      data-nav-toggle
    >
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span class="nav-toggle__label">תפריט</span>
    </button>
    <nav class="site-nav" id="primary-nav" aria-label="ניווט ראשי" data-nav-panel>
      <a {...navProps('home')} href="/" data-peek="home">בית</a>
      <a {...navProps('about')} href="/aboutus" data-peek="about">אודותינו</a>
      <a {...worksheetsNavProps('ysodi')} href="/worksheets?level=ysodi" data-peek="ws-ysodi">
        דפי עבודה ליסודי
      </a>
      <a {...worksheetsNavProps('hatzava')} href="/worksheets?level=hatzava" data-peek="ws-hatzava">
        דפי עבודה לחטיבת הביניים
      </a>
      <a {...navProps('blog')} href="/blog" data-peek="blog">בלוג</a>
      <a {...navProps('tools')} href="/math-tools" data-peek="tools">תוספים</a>
      <a {...navProps('highschool')} href="/high-school-math" data-peek="hs">
        מתמטיקה לתיכון (חיצוני)
      </a>
      <a
        class:list={['site-nav__link', 'site-nav__learn-mobile', learnActive && 'is-active']}
        href="/learning.html"
        data-peek="learn"
        aria-current={learnActive ? 'page' : undefined}
      >
        הלמידה שלי
      </a>
    </nav>
    <a
      class:list={['site-header__learn', learnActive && 'is-active']}
      href="/learning.html"
      data-peek="learn"
      aria-current={learnActive ? 'page' : undefined}
    >
      הלמידה שלי
    </a>
  </div>
</header>

<script>
  // Mobile nav toggle: aria-expanded, Esc/outside/resize close, focus moves.
  (function () {
    var toggle = document.querySelector('[data-nav-toggle]');
    var panel = document.getElementById('primary-nav');
    if (!toggle || !panel) return;
    function isOpen() { return panel.hasAttribute('data-open'); }
    function setOpen(open) {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        panel.setAttribute('data-open', '');
        var first = panel.querySelector('a');
        if (first) first.focus();
      } else {
        panel.removeAttribute('data-open');
        if (document.activeElement && panel.contains(document.activeElement)) toggle.focus();
      }
    }
    toggle.addEventListener('click', function () { setOpen(!isOpen()); });
    document.addEventListener('keydown', function (e) {
      if (e.key === 'Escape' && isOpen()) setOpen(false);
    });
    document.addEventListener('click', function (e) {
      if (isOpen() && !e.target.closest('.site-header')) setOpen(false);
    });
    var mq = window.matchMedia('(min-width: 768px)');
    (mq.addEventListener ? mq.addEventListener.bind(mq, 'change') : mq.addListener.bind(mq))(function (e) {
      if (e.matches && isOpen()) setOpen(false);
    });
  })();

  // Logo land + periodic wiggle (honors motion-off flags).
  (function () {
    var brand = document.querySelector('.site-brand');
    if (!brand) return;
    function motionOk() {
      var html = document.documentElement;
      return (
        !window.matchMedia('(prefers-reduced-motion: reduce)').matches &&
        !html.classList.contains('noam-a11y-motion') &&
        !html.classList.contains('nd-motion-off') &&
        !document.hidden
      );
    }
    if (motionOk()) {
      brand.classList.add('is-landing');
      setTimeout(function () { brand.classList.remove('is-landing'); }, 950);
    }
    function wiggle() {
      if (!motionOk()) return;
      brand.classList.remove('is-wiggling');
      void brand.offsetWidth;
      brand.classList.add('is-wiggling');
      setTimeout(function () { brand.classList.remove('is-wiggling'); }, 850);
    }
    setInterval(wiggle, 7000);
    brand.addEventListener('mouseenter', function () {
      if (window.matchMedia('(hover: hover)').matches) wiggle();
    });
    brand.addEventListener('click', wiggle);
  })();
</script>
