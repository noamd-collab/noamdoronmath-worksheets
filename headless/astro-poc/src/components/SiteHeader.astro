---
import {
  resolveActiveNav,
  resolveWorksheetsNavBand,
  type ActiveNavKey,
  type WorksheetsNavBand,
} from '../lib/activeNav';
interface Props { active?: ActiveNavKey | null; compactBrand?: boolean; }
const active=Astro.props.active !== undefined ? Astro.props.active : resolveActiveNav(Astro.url.pathname);
const worksheetsBand: WorksheetsNavBand | null =
  active === 'worksheets' ? resolveWorksheetsNavBand(Astro.url.pathname, Astro.url.searchParams) : null;
---
  <header class="exact-header" style="position:sticky;top:0;z-index:20;background:rgba(251,250,245,.92);backdrop-filter:blur(6px);border-bottom:2px solid #22305a;">
    <div class="exact-header__row" style="max-width:1200px;margin:0 auto;padding:10px 24px;display:flex;align-items:center;gap:24px;flex-wrap:wrap;">
      <a href="/" style="display:flex;align-items:center;gap:10px;">
        <img data-exact-logo src="/design-exact/assets/logo.png" alt="נועם דורון מתמטיקה" style="height:68px;width:auto;display:block;transform-origin:30% 80%;">
      </a>
      <button class="exact-nav-toggle" type="button" aria-expanded="false" aria-controls="primary-nav" data-nav-toggle>
        <span class="exact-nav-toggle__bars" aria-hidden="true"></span>
        <span>תפריט</span>
      </button>
      <nav id="primary-nav" aria-label="ניווט ראשי" data-nav-panel style="gap:4px;flex-wrap:wrap;flex:1;font-weight:500;font-size:15px;">
        <a aria-current={active === 'home' ? 'page' : undefined} data-peek="home" href="/" style="padding:8px 12px;border-radius:999px;color:#22305a;" data-exact-hover="exact-hover-13">בית</a>
        <a aria-current={active === 'about' ? 'page' : undefined} data-peek="about" href="/aboutus" style="padding:8px 12px;border-radius:999px;color:#22305a;" data-exact-hover="exact-hover-14">אודותינו</a>
        <a aria-current={worksheetsBand === 'ysodi' ? 'page' : undefined} data-peek="ws-ysodi" href="/worksheets?level=ysodi" style="padding:8px 12px;border-radius:999px;color:#22305a;" data-exact-hover="exact-hover-15">דפי עבודה ליסודי</a>
        <a aria-current={worksheetsBand === 'hatzava' ? 'page' : undefined} data-peek="ws-hatzava" href="/worksheets?level=hatzava" style="padding:8px 12px;border-radius:999px;color:#22305a;" data-exact-hover="exact-hover-15">דפי עבודה לחטיבת הביניים</a>
        <a aria-current={active === 'blog' ? 'page' : undefined} data-peek="blog" href="/blog" style="padding:8px 12px;border-radius:999px;color:#22305a;" data-exact-hover="exact-hover-16">בלוג</a>
        <a aria-current={active === 'tools' ? 'page' : undefined} data-peek="tools" href="/math-tools" style="padding:8px 12px;border-radius:999px;color:#22305a;" data-exact-hover="exact-hover-17">תוספים</a>
        <a aria-current={active === 'highschool' ? 'page' : undefined} data-peek="hs" href="/high-school-math" style="padding:8px 12px;border-radius:999px;color:#22305a;" data-exact-hover="exact-hover-18">מתמטיקה לתיכון ↗</a>
        <a class="exact-nav-learn-mobile" aria-current={active === 'learning' ? 'page' : undefined} data-peek="learn" href="/learning.html" style="padding:8px 12px;border-radius:999px;color:#22305a;font-weight:700;" data-exact-hover="exact-hover-13">הלמידה שלי</a>
      </nav>
      <a class="exact-header__learn" aria-current={active === 'learning' ? 'page' : undefined} data-peek="learn" href="/learning.html" style="display:flex;align-items:center;gap:8px;padding:9px 18px;background:#fff;border:2px solid #22305a;border-radius:18px 6px 20px 8px / 8px 20px 6px 18px;box-shadow:3px 3px 0 #22305a;color:#22305a;font-weight:700;font-size:15px;" data-exact-hover="exact-hover-19">הלמידה שלי</a>
      <span style="font-size:12px;color:#5a6588;">בס״ד</span>
    </div>
  </header>

<script>
  // Mobile nav toggle: aria-expanded, Esc/outside/resize close, focus moves.
  function initExactNavToggle() {
    const toggle = document.querySelector<HTMLButtonElement>('[data-nav-toggle]');
    const panel = document.getElementById('primary-nav');
    if (!toggle || !panel || toggle.dataset.navReady) return;
    toggle.dataset.navReady = '1';
    const isOpen = () => panel.hasAttribute('data-open');
    // Focus (and its link peek) moves into the panel only for keyboard activation.
    const setOpen = (open: boolean, fromKeyboard = false) => {
      toggle.setAttribute('aria-expanded', String(open));
      if (open) {
        panel.setAttribute('data-open', '');
        if (fromKeyboard) panel.querySelector<HTMLAnchorElement>('a')?.focus();
      } else {
        panel.removeAttribute('data-open');
        if (document.activeElement && panel.contains(document.activeElement)) toggle.focus();
      }
    };
    toggle.addEventListener('click', (e) => setOpen(!isOpen(), e.detail === 0));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && isOpen()) setOpen(false);
    });
    document.addEventListener('click', (e) => {
      if (isOpen() && !(e.target as Element | null)?.closest?.('.exact-header')) setOpen(false);
    });
    window.matchMedia('(min-width: 900px)').addEventListener('change', (e) => {
      if (e.matches && isOpen()) setOpen(false);
    });
  }
  initExactNavToggle();
  document.addEventListener('astro:page-load', initExactNavToggle);
</script>
