---
/* Homepage hero (Noam to Copilot, 4.11.2026): open on a random animation from
   the WHOLE site, not only the nine HERO_ROTATION films, and keep playing them
   in a random order. ExactHeroControls.astro and heroRotation.ts stay unchanged.

   5.11.2026: the hero is no longer hidden while the random loop loads. Hiding
   it (up to 2.5 s) left an empty box on slow phones and delayed the page's
   largest paint. Now:
   1. As soon as this script runs, it picks the opening loop (uniform over the
      whole pool, triangle included) and starts fetching it, so it is usually
      in the browser cache by the time the controls boot.
   2. Before the controls boot, the rotation JSON ([data-hero-rotation]) is
      replaced by a shuffled copy of HERO_SITE_POOL, so the clock and the
      shuffle button use the whole site.
   3. When the controls are ready, the existing shuffle button is pressed once
      for the chosen loop, with a short fade around the swap.
   The server-rendered triangle stays visible for first paint, no-JS and SEO. */
import { HERO_SITE_POOL } from '../lib/heroSitePool';
---
<script type="application/json" data-hero-site-pool set:html={JSON.stringify(HERO_SITE_POOL)} />
<script is:inline>
  (function () {
    var hero = document.querySelector('[data-hero-loop]');
    var host = hero && hero.querySelector('[data-hero-loop-current]');
    if (!hero || !host || hero.dataset.randomOpening) return;
    hero.dataset.randomOpening = '1';

    function readList(node) {
      try {
        var list = JSON.parse((node && node.textContent) || '[]');
        return Array.isArray(list) ? list : [];
      } catch (e) {
        return [];
      }
    }

    function shuffled(list) {
      var copy = list.slice();
      for (var i = copy.length - 1; i > 0; i--) {
        var j = Math.floor(Math.random() * (i + 1));
        var t = copy[i]; copy[i] = copy[j]; copy[j] = t;
      }
      return copy;
    }

    var DEFAULT = 'triangle';
    var pool = shuffled(readList(document.querySelector('[data-hero-site-pool]')));
    var variants = pool.map(function (entry) { return entry && entry.variant; }).filter(Boolean);
    var chosen = variants.length ? variants[Math.floor(Math.random() * variants.length)] : DEFAULT;

    // Warm the browser cache for the chosen loop now, instead of after boot.
    if (chosen !== DEFAULT) {
      try {
        fetch('/hero-loops/' + encodeURIComponent(chosen), {
          credentials: 'same-origin',
          headers: { Accept: 'text/html' },
        }).catch(function () { /* The controls fetch it again. */ });
      } catch (e) { /* Optional. */ }
    }

    var written = null;
    function shuffleRotation() {
      var node = document.querySelector('[data-hero-rotation]');
      if (!node || node.dataset.shuffled) return;
      var list = pool.length >= 2 ? pool : shuffled(readList(node));
      if (!list.length) return;
      node.textContent = JSON.stringify(list);
      node.dataset.shuffled = '1';
      written = list.map(function (entry) { return entry && entry.variant; });
    }

    function fadeIn() {
      host.style.opacity = '';
    }

    function openChosen() {
      if (chosen === DEFAULT) return;
      var tries = 0;
      (function wait() {
        var button = document.querySelector('[data-exact-shuffle]');
        if (!button || hero.dataset.exactControls !== 'ready') {
          if (++tries < 80) setTimeout(wait, 50);
          return;
        }
        var onScreen = host.querySelector('[data-loop]');
        var currentVariant = (onScreen && onScreen.getAttribute('data-loop')) || DEFAULT;
        // The shuffle button picks Math.random() over the rotation minus the
        // loop on screen. Steer that one pick to the loop chosen (and fetched)
        // above, then restore Math.random immediately.
        var candidates = (written || []).filter(function (v) { return v && v !== currentVariant; });
        var at = candidates.indexOf(chosen);
        var original = Math.random;
        if (at >= 0) {
          Math.random = function () {
            Math.random = original;
            return (at + 0.5) / candidates.length;
          };
        }
        host.style.transition = 'opacity .15s ease';
        host.style.opacity = '0';
        try {
          button.click();
        } finally {
          Math.random = original;
        }
        var checks = 0;
        (function settle() {
          var loop = host.querySelector('[data-loop]');
          var moved = loop && loop.getAttribute('data-loop') !== currentVariant;
          if ((moved && !button.hasAttribute('aria-busy')) || ++checks > 30) {
            host.style.transition = 'opacity .3s ease';
            fadeIn();
            return;
          }
          setTimeout(settle, 50);
        })();
      })();
    }

    // The controls are a deferred module and read the rotation JSON when they
    // boot, right after parsing ends. Shuffle as readyState leaves "loading".
    if (document.readyState === 'loading') {
      document.addEventListener('readystatechange', function once() {
        if (document.readyState === 'loading') return;
        document.removeEventListener('readystatechange', once);
        shuffleRotation();
      });
      document.addEventListener('DOMContentLoaded', openChosen, { once: true });
    } else {
      shuffleRotation();
      setTimeout(openChosen, 0);
    }
  })();
</script>
