---
import BaseLayout from '../layouts/BaseLayout.astro';
import { readPublicGenerationTrial } from '../lib/teacherGenerationStore';
import TeacherComingSoon from '../components/TeacherComingSoon.astro';
import {
  TEACHER_LANDING_TITLE,
  TEACHER_LANDING_DESCRIPTION,
  TEACHER_FAQ,
  legacyTeacherToolRedirect,
} from '../lib/teacherLandingContent';

export const prerender = false;

const teacherFaqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: TEACHER_FAQ.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: { '@type': 'Answer', text: item.answer },
  })),
};

// Existing /teachers?grade=... links remain direct entries to the wizard.
// Keep the full query, including pick/minutes, rather than rebuilding a subset.
const legacyTarget = legacyTeacherToolRedirect(Astro.url);
if (legacyTarget) {
  // A returned Response does not inherit Astro.response headers.
  return new Response(null, {
    status: 307,
    headers: { location: legacyTarget, 'cache-control': 'no-store' },
  });
}
const trial = await readPublicGenerationTrial();
Astro.response.headers.set('Cache-Control', 'no-store');
---
<BaseLayout
  title={TEACHER_LANDING_TITLE}
  description={TEACHER_LANDING_DESCRIPTION}
  activeNav="teachers"
  skipHref="#teacher-start"
>
  <script type="application/ld+json" set:html={JSON.stringify(teacherFaqJsonLd)} />
  <TeacherComingSoon trial={trial} />
</BaseLayout>
