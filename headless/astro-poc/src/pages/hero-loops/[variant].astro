---
/**
 * One existing hero loop, fetched when ↻ נושא אחר needs it.
 * angle-sum is the vertex-descent film, not a ConceptLoop drawing.
 * Not a site page: no layout, noindex, and absent from the page sitemap
 * (that glob is only src/pages/*.astro).
 */
import ConceptLoop from '../../components/ConceptLoop.astro';
import type { Props as ConceptLoopProps } from '../../components/ConceptLoop.astro';
import TriangleAngleSumLoop from '../../components/TriangleAngleSumLoop.astro';
import { heroRotationVariant } from '../../lib/heroRotation';

export const prerender = false;

const variant = heroRotationVariant(Astro.params.variant);
if (!variant) {
  return new Response('Not Found', {
    status: 404,
    headers: {
      'content-type': 'text/plain; charset=utf-8',
      'x-robots-tag': 'noindex',
      'cache-control': 'no-store',
    },
  });
}

Astro.response.headers.set('X-Robots-Tag', 'noindex');
Astro.response.headers.set('Cache-Control', 'public, max-age=86400');
const loopVariant = variant as ConceptLoopProps['variant'];
---
{
  variant === 'angle-sum' ? (
    <TriangleAngleSumLoop
      src="/loops/triangle-angle-sum-vertex-descent.html"
      marker="triangle-angle-sum-vertex-descent"
      variant="angle-sum"
      card
    />
  ) : (
    <ConceptLoop variant={loopVariant} />
  )
}
