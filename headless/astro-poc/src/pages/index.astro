---
import BaseLayout from '../layouts/BaseLayout.astro';
import HeroLoop from '../components/HeroLoop.astro';
import ExactHeroControls from '../components/ExactHeroControls.astro';
import { HERO_DEFAULT, heroChip, heroPanel } from '../lib/heroRotation';
import { homePageJsonLd, loadHomePage } from '../lib/homePage';
import { organizationJsonLd } from '../lib/structuredData';
const home = loadHomePage();
const homeJsonLd = [...homePageJsonLd(), organizationJsonLd()];
const images = ['paper-boat','snail','curious-cat','kite','geometry-fish','cube-plant'];
const letters = ['א׳','ב׳','ג׳','ד׳','ה׳','ו׳','ז׳','ח׳','ט׳'];
const elemGrades = home.grades.slice(0,6).map((grade,i)=>({ ...grade,l:letters[i],img:'/design-exact/assets/doodles/'+images[i]+'.webp',delay:i*70,isSnail:i===1,isCat:i===2,isFish:i===4,isBoat:i===0,isCube:i===5 }));
const midGrades = home.grades.slice(6).map((grade,i)=>({...grade,l:letters[i+6],delay:420+i*70}));
---
<BaseLayout title={home.title} description={home.description} crumbs={[{ name: 'בית', path: '/' }]} activeNav="home" skipHref="#home-main">
  {homeJsonLd.map(block=>(<script type="application/ld+json" set:html={JSON.stringify(block)} />))}
    <main id="home-main" class="exact-home" data-family="home" data-home-page data-screen-label="בית">

      <!-- HERO -->
      <section style="position:relative;max-width:1200px;margin:0 auto;padding:64px 24px 80px;display:flex;flex-direction:row-reverse;flex-wrap:wrap;gap:48px;align-items:center;">

        <div data-doodle="kite" style="position:absolute;top:18px;left:47%;width:120px;pointer-events:none;z-index:1;"><img src="/design-exact/assets/doodles/kite.webp" alt="" width="400" height="400" loading="eager" fetchpriority="high" decoding="async" style="width:100%;height:auto;display:block;mix-blend-mode:multiply;pointer-events:auto;cursor:pointer;"></div>
        <div data-trail="snail" aria-hidden="true" style="position:absolute;bottom:14px;right:calc(30% - 4px);width:98px;height:7px;z-index:0;pointer-events:none;transform-origin:left center;transform:scaleX(0);border-radius:6px 999px 999px 6px;background:linear-gradient(180deg,rgba(255,255,255,.75) 0 25%,rgba(168,214,140,.55) 45%,rgba(112,178,98,.45) 100%);box-shadow:0 0 0 1px rgba(112,178,98,.25),0 1px 3px rgba(112,178,98,.35);filter:blur(.3px);"></div>
        <div data-doodle="snail" style="position:absolute;bottom:8px;right:30%;width:110px;z-index:1;"><img src="/design-exact/assets/doodles/snail.webp" alt="" width="400" height="400" loading="eager" decoding="async" style="width:100%;height:auto;display:block;mix-blend-mode:multiply;cursor:pointer;"></div>

        <div style="position:relative;z-index:2;flex:1 1 440px;min-width:0;">
          <div data-exact-hero-panel style={`background:${heroPanel(HERO_DEFAULT.gradeNum)};border-radius:28px;padding:56px 28px 20px;`}>
            <HeroLoop />
            <div style="display:flex;align-items:center;gap:10px;flex-wrap:wrap;margin-top:14px;">
              <span data-exact-hero-label style="background:#fff;border:1.5px solid #22305a;border-radius:999px;padding:4px 12px;font-size:14px;font-weight:700;">{heroChip(HERO_DEFAULT)}</span>
              <span style="flex:1;"></span>
              <button type="button" data-exact-shuffle style="border:1.5px solid #22305a;background:#fff;border-radius:999px;padding:6px 14px;font:700 14px Heebo;color:#22305a;cursor:pointer;" data-exact-hover="exact-hover-0">↻ נושא אחר</button>
              <a href={HERO_DEFAULT.href} data-peek="topic" data-exact-hero-topic style="font-weight:700;font-size:14px;color:#1e605e;text-decoration:underline;text-underline-offset:4px;" data-exact-hover="exact-hover-1">לדף הנושא ←</a>
            </div>
          </div>
        </div>

        <div style="position:relative;z-index:2;flex:1 1 360px;min-width:0;">
          <div data-pop="0" style="font-family:'Amatic SC','Amatic SC Fallback',cursive;font-size:30px;color:#2a7c7a;margin-bottom:4px;">מאגר המשימות של נועם דורון</div>
          <h1 data-pop="120" data-lcp style="font-family:'Secular One','Secular One Fallback',sans-serif;font-weight:400;font-size:clamp(40px,5.4vw,68px);line-height:1.05;margin:0 0 20px;text-wrap:balance;">דפי עבודה שעושים <span style="position:relative;display:inline-block;">חשק<svg viewBox="0 0 200 20" preserveAspectRatio="none" style="position:absolute;right:-4%;bottom:-10px;width:108%;height:16px;overflow:visible;"><path data-draw="700" data-dur="700" pathLength="1" d="M4 12 C 50 4, 120 18, 196 8" fill="none" stroke="#e5735c" stroke-width="5" stroke-linecap="round" stroke-dasharray="1"></path></svg></span> לפתור</h1>
          <p data-pop="240" style="font-size:20px;line-height:1.55;color:#3d4870;margin:0 0 32px;max-width:32ch;">מתרגלים עכשיו ומשפרים את הישגי המתמטיקה בקלות ובצורה חופשית</p>
          <div data-pop="360" style="display:flex;gap:12px;flex-wrap:wrap;">
            <a data-home-search-cta href={home.hero.searchCta.href} data-peek="ws"  style="padding:14px 26px;background:#22305a;color:#fbfaf5;font-weight:700;font-size:17px;border:2px solid #22305a;border-radius:18px 6px 20px 8px / 8px 20px 6px 18px;box-shadow:4px 4px 0 #e6a534;" data-exact-hover="exact-hover-2">למציאת משימת תרגול</a>
            <a href="/worksheets?grade=1" data-peek="elem"  style="padding:14px 22px;background:#fff;color:#22305a;font-weight:700;font-size:17px;border:2px solid #22305a;border-radius:6px 18px 8px 20px / 20px 8px 18px 6px;" data-exact-hover="exact-hover-3">יסודי א׳–ו׳</a>
            <a href="/worksheets?grade=7" data-peek="mid"  style="padding:14px 22px;background:#fff;color:#22305a;font-weight:700;font-size:17px;border:2px solid #22305a;border-radius:6px 18px 8px 20px / 20px 8px 18px 6px;" data-exact-hover="exact-hover-4">חטיבה ז׳–ט׳</a>
          </div>
  <div data-exact-zig aria-hidden="true" style="position:relative;width:150px;height:188px;margin-top:28px;z-index:1;pointer-events:none;will-change:transform;">
    <svg viewBox="0 0 120 150" style="width:100%;height:100%;overflow:visible;"><g data-exact-zig-path><g data-axes="1" opacity="0" stroke="#22305a" stroke-width="2" stroke-linecap="round" fill="none"><path d="M2 138 H116 M110 133 L117 138 L110 143"></path><path d="M60 152 V8 M55 14 L60 7 L65 14"></path><path d="M34 134 V142 M86 134 V142 M8 134 V142 M112 134 V142 M56 108 H64 M56 79 H64 M56 50 H64 M56 21 H64" stroke-width="1.5"></path><text x="112" y="130" stroke="none" style="font:italic 800 13px Heebo;fill:#22305a;">x</text><text x="68" y="14" stroke="none" style="font:italic 800 13px Heebo;fill:#22305a;">y</text></g><path pathLength="1" fill="none" stroke="#e0483e" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1" stroke-dashoffset="1"></path><path pathLength="1" fill="none" stroke="#e0483e" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1" stroke-dashoffset="1"></path><path pathLength="1" fill="none" stroke="#e0483e" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1" stroke-dashoffset="1"></path><path pathLength="1" fill="none" stroke="#e6a534" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1" stroke-dashoffset="1"></path><path pathLength="1" fill="none" stroke="#e6a534" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1" stroke-dashoffset="1"></path><path pathLength="1" fill="none" stroke="#e0483e" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1" stroke-dashoffset="1"></path><path pathLength="1" fill="none" stroke="#e6a534" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" stroke-dasharray="1" stroke-dashoffset="1"></path><g data-tri="1" opacity="0" style="font:italic 800 14px Heebo;"><text x="40" y="120" text-anchor="middle" style="fill:#c98a1a;font-size:13px;">α</text><text x="86" y="120" text-anchor="middle" style="fill:#c98a1a;font-size:13px;">β</text><text x="65.5" y="50" text-anchor="middle" style="fill:#c98a1a;font-size:13px;">γ</text><text x="60" y="152" text-anchor="middle" direction="ltr" style="font:800 14px Heebo;fill:#22305a;">α+β+γ=180°</text></g><g data-play="1" opacity="0"><circle cx="60" cy="22" r="4.5" fill="#e6a534" stroke="#22305a" stroke-width="1.5"></circle></g><g data-play-s="1" opacity="0"><path d="M0 22 H120" stroke="#22305a" stroke-width="1.5" stroke-dasharray="3 4" opacity=".5"></path><text x="60" y="152" text-anchor="middle" direction="ltr" style="font:800 14px Heebo;fill:#22305a;">S = a·h/2</text></g><g data-circ="1"><g data-th="1" opacity="0"><path d="M92.1 113.3 A50 50 0 0 1 27.9 113.3" fill="none" stroke="#e5735c" stroke-width="4" stroke-linecap="round"></path><line x1="31.3" y1="34" x2="92.1" y2="113.3" stroke="#2a7c7a" stroke-width="2.5" stroke-linecap="round"></line><line x1="31.3" y1="34" x2="27.9" y2="113.3" stroke="#2a7c7a" stroke-width="2.5" stroke-linecap="round"></line><path d="M37.4 41.9 A10 10 0 0 1 30.9 44" fill="none" stroke="#e6a534" stroke-width="2.5" stroke-linecap="round"></path><text x="36.4" y="54" text-anchor="middle" direction="ltr" style="font:italic 800 12px Heebo;fill:#c98a1a;">α</text><line x1="85" y1="31.7" x2="92.1" y2="113.3" stroke="#2a7c7a" stroke-width="2.5" stroke-linecap="round"></line><line x1="85" y1="31.7" x2="27.9" y2="113.3" stroke="#2a7c7a" stroke-width="2.5" stroke-linecap="round"></line><path d="M85.9 41.7 A10 10 0 0 1 79.3 39.9" fill="none" stroke="#e6a534" stroke-width="2.5" stroke-linecap="round"></path><text x="80.6" y="52" text-anchor="middle" direction="ltr" style="font:italic 800 12px Heebo;fill:#c98a1a;">α</text><circle cx="92.1" cy="113.3" r="3" fill="#22305a"></circle><circle cx="27.9" cy="113.3" r="3" fill="#22305a"></circle><circle cx="31.3" cy="34" r="3" fill="#22305a"></circle><circle cx="85" cy="31.7" r="3" fill="#22305a"></circle><text x="60" y="146" text-anchor="middle" direction="ltr" style="font:italic 800 12px Heebo;fill:#22305a;">α = α</text></g><g data-th="2" opacity="0"><path d="M92.1 113.3 A50 50 0 0 1 27.9 113.3" fill="none" stroke="#e5735c" stroke-width="4" stroke-linecap="round"></path><line x1="31.3" y1="34" x2="92.1" y2="113.3" stroke="#2a7c7a" stroke-width="2.5" stroke-linecap="round"></line><line x1="31.3" y1="34" x2="27.9" y2="113.3" stroke="#2a7c7a" stroke-width="2.5" stroke-linecap="round"></line><path d="M37.4 41.9 A10 10 0 0 1 30.9 44" fill="none" stroke="#e6a534" stroke-width="2.5" stroke-linecap="round"></path><text x="36.4" y="54" text-anchor="middle" direction="ltr" style="font:italic 800 12px Heebo;fill:#c98a1a;">α</text><line x1="60" y1="75" x2="92.1" y2="113.3" stroke="#22305a" stroke-width="2.5" stroke-linecap="round"></line><line x1="60" y1="75" x2="27.9" y2="113.3" stroke="#22305a" stroke-width="2.5" stroke-linecap="round"></line><path d="M67.7 84.2 A12 12 0 0 1 52.3 84.2" fill="none" stroke="#e6a534" stroke-width="2.5" stroke-linecap="round"></path><text x="60" y="101" text-anchor="middle" direction="ltr" style="font:italic 800 12px Heebo;fill:#c98a1a;">2α</text><circle cx="60" cy="75" r="3" fill="#22305a"></circle><circle cx="92.1" cy="113.3" r="3" fill="#22305a"></circle><circle cx="27.9" cy="113.3" r="3" fill="#22305a"></circle><circle cx="31.3" cy="34" r="3" fill="#22305a"></circle><text x="60" y="146" text-anchor="middle" direction="ltr" style="font:italic 800 12px Heebo;fill:#22305a;">∠O = 2α</text></g><g data-th="3" opacity="0"><line x1="85.8" y1="19.7" x2="120.8" y2="80.3" stroke="#2a7c7a" stroke-width="2.5" stroke-linecap="round"></line><line x1="60" y1="75" x2="103.3" y2="50" stroke="#22305a" stroke-width="3" stroke-linecap="round"></line><path d="M97.2 53.5 L100.7 59.6 L106.8 56.1" fill="none" stroke="#e6a534" stroke-width="2" stroke-linecap="round"></path><circle cx="60" cy="75" r="3" fill="#22305a"></circle><circle cx="103.3" cy="50" r="3" fill="#e6a534"></circle><text x="80" y="58" text-anchor="middle" direction="ltr" style="font:italic 800 13px Heebo;fill:#22305a;">r</text><text x="60" y="146" text-anchor="middle" direction="ltr" style="font:italic 800 12px Heebo;fill:#22305a;">r ⊥ משיק</text></g></g><g data-rad="1" opacity="0"><line x1="60" y1="75" x2="110" y2="75" stroke="#22305a" stroke-width="3" stroke-linecap="round"></line><circle cx="60" cy="75" r="3.5" fill="#22305a"></circle><circle cx="110" cy="75" r="4" fill="#e6a534" stroke="#22305a" stroke-width="1.5"></circle><text x="82" y="68" style="font:italic 800 14px Heebo;fill:#22305a;">r</text></g><text x="58" y="58" opacity="0" style="font:italic 800 15px Heebo;fill:#c98a1a;">α</text><text x="54" y="104" opacity="0" style="font:italic 800 15px Heebo;fill:#c98a1a;">α</text></g><g data-bot="1" opacity="0"><line x1="60" y1="40" x2="60" y2="26" stroke="#22305a" stroke-width="3" stroke-linecap="round"></line><circle cx="60" cy="22" r="5" fill="#e6a534" stroke="#22305a" stroke-width="2"></circle><rect x="20" y="56" width="8" height="18" rx="3" fill="#e6a534" stroke="#22305a" stroke-width="2"></rect><rect x="92" y="56" width="8" height="18" rx="3" fill="#e6a534" stroke="#22305a" stroke-width="2"></rect><rect x="28" y="40" width="64" height="52" rx="14" fill="#eaf4f3" stroke="#22305a" stroke-width="3"></rect><circle data-beye="1" cx="46" cy="62" r="5.5" fill="#22305a"></circle><circle data-beye="1" cx="74" cy="62" r="5.5" fill="#22305a"></circle><path d="M49 76 Q60 85 71 76" fill="none" stroke="#22305a" stroke-width="3" stroke-linecap="round"></path><text x="60" y="118" text-anchor="middle" style="font:400 17px 'Secular One';fill:#22305a;">נועם AI</text></g></svg>
  </div>
        </div>
      </section>

      <!-- GRADES -->
      <section data-home-grades style="position:relative;max-width:1200px;margin:0 auto;padding:56px 24px 72px;">
        <div data-doodle="cat" style="position:absolute;top:-20px;left:36%;width:120px;height:90px;"><img src="/design-exact/assets/doodles/sleeping-cat.svg" alt="" width="140" height="92" loading="lazy" decoding="async" style="position:absolute;left:0;bottom:0;width:120px;height:auto;display:block;cursor:pointer;"><span data-zzz="0" style="position:absolute;left:86px;top:6px;font:700 18px 'Amatic SC','Amatic SC Fallback',cursive;color:#2a7c7a;opacity:0;pointer-events:none;">Z</span><span data-zzz="1" style="position:absolute;left:98px;top:-10px;font:700 24px 'Amatic SC','Amatic SC Fallback',cursive;color:#2a7c7a;opacity:0;pointer-events:none;">Z</span><span data-zzz="2" style="position:absolute;left:112px;top:-30px;font:700 30px 'Amatic SC','Amatic SC Fallback',cursive;color:#2a7c7a;opacity:0;pointer-events:none;">Z</span></div>
        <div style="margin-bottom:28px;">
          <h2 data-pop="0" style="font-family:'Secular One','Secular One Fallback',sans-serif;font-weight:400;font-size:clamp(30px,3.6vw,44px);margin:0 0 6px;display:flex;flex-wrap:wrap;align-items:baseline;gap:0 .28em;"><span style="display:inline-block;transform:rotate(-3deg) translateY(2px);">בחרו</span><span style="display:inline-block;transform:rotate(2deg) translateY(-3px);color:#2a7c7a;">כיתה</span><span style="display:inline-block;transform:rotate(-1.5deg);">והתחילו</span><span style="position:relative;display:inline-block;transform:rotate(3deg) translateY(-2px);color:#e5735c;">לתרגל<svg viewBox="0 0 120 16" preserveAspectRatio="none" aria-hidden="true" style="position:absolute;right:-4%;bottom:-8px;width:108%;height:12px;overflow:visible;"><path data-draw="500" data-dur="700" pathLength="1" d="M3 9 Q 18 2, 33 9 T 63 9 T 93 9 T 117 7" fill="none" stroke="#e6a534" stroke-width="4" stroke-linecap="round" stroke-dasharray="1"></path></svg></span><span style="display:inline-block;transform:rotate(-8deg) translateY(-6px);color:#e6a534;font-size:.8em;">!</span></h2>
          <p data-pop="100" style="margin:0;font-size:18px;color:#4a5478;">דפי עבודה בחינם לכיתות א׳–ט׳</p>
        </div>
        <div style="font-family:'Amatic SC','Amatic SC Fallback',cursive;font-size:26px;color:#2a7c7a;margin-bottom:8px;">יסודי</div>
        <div style="display:grid;grid-template-columns:repeat(auto-fill,minmax(max(190px,calc((100% - 28px) / 3)),1fr));gap:14px;margin-bottom:28px;">
          {elemGrades.map(g => (
            <a href={g.href} data-peek="elem" data-tl={g.l}  data-pop={g.delay} style="position:relative;display:flex;flex-direction:column;align-items:flex-start;gap:4px;padding:18px 18px 16px;background:#fff;border:2px solid #22305a;border-radius:16px 6px 18px 8px / 8px 18px 6px 16px;color:#22305a;min-height:140px;transition:transform .2s,box-shadow .2s;" data-exact-hover="exact-hover-5">
              <span style="font-size:14px;color:#5a6588;">כיתה</span>
              <span style="font-family:'Secular One','Secular One Fallback',sans-serif;font-size:44px;line-height:1;">{g.l}</span>
              <span data-tileimg="1" aria-hidden="true" style="position:absolute;left:4px;bottom:4px;width:112px;height:112px;mix-blend-mode:multiply;opacity:.9;display:block;"><img src={g.img} alt="" width="400" height="400" loading="lazy" decoding="async" style="position:absolute;inset:0;width:100%;height:100%;object-fit:contain;">
                {g.isSnail && (<span data-wink="1" style="position:absolute;left:calc(67.6% - 6px);top:calc(28.3% - 6px);width:12px;height:12px;border-radius:50%;background:#f6ead4;box-shadow:inset 0 -2px 0 #22305a;transform:scaleY(0);transform-origin:center top;"></span>)}
                {g.isBoat && (
                  <span data-water="1" style="position:absolute;left:8%;right:6%;top:73%;height:14%;overflow:hidden;-webkit-mask-image:linear-gradient(90deg,transparent,#000 20%,#000 80%,transparent);mask-image:linear-gradient(90deg,transparent,#000 20%,#000 80%,transparent);">
                    <svg viewBox="0 0 200 20" preserveAspectRatio="none" style="display:block;width:200%;height:100%;"><path d="M0 6 q5 -4 10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0" fill="none" stroke="#2a7c7a" stroke-width="2" stroke-linecap="round" stroke-dasharray="12 8" opacity=".75"></path><path d="M5 15 q5 -4 10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0 t10 0" fill="none" stroke="#2a7c7a" stroke-width="1.6" stroke-linecap="round" stroke-dasharray="6 14" opacity=".55"></path></svg>
                  </span>
                )}
                {g.isCube && (
                  <svg data-ice="1" viewBox="0 0 100 100" preserveAspectRatio="none" style="position:absolute;inset:0;width:100%;height:100%;opacity:0;overflow:visible;">
                    <polygon points="46,30.7 65.4,32.7 57,39.3 37.1,36.7" fill="rgba(200,232,248,.8)"></polygon>
                    <polygon points="37.1,36.7 57,39.3 58.6,59.2 39.2,56.4" fill="rgba(160,212,240,.7)"></polygon>
                    <polygon points="57,39.3 65.4,32.7 66.6,52.6 58.6,59.2" fill="rgba(120,190,230,.7)"></polygon>
                    <polygon points="39,56.4 65.4,57.8 55.6,65 30.9,62.2" fill="rgba(200,232,248,.8)"></polygon>
                    <polygon points="30.9,62.2 55.6,65 55.6,88 31.9,83.7" fill="rgba(160,212,240,.7)"></polygon>
                    <polygon points="55.6,65 65.4,57.8 65.6,80 55.6,88" fill="rgba(120,190,230,.7)"></polygon>
                    <path d="M40 41 L44 41.6 M40 44 L42 44.3 M34 67 L39 67.6 M34 70.5 L36.5 70.8" stroke="#fff" stroke-width="1.4" stroke-linecap="round"></path>
                  </svg>
                  <span data-drop="1" style="position:absolute;left:calc(33% - 2px);top:84%;width:4px;height:6px;border-radius:50% 50% 50% 50% / 65% 65% 35% 35%;background:#5fb2de;opacity:0;"></span>
                  <span data-drop="1" style="position:absolute;left:calc(55.6% - 2px);top:87.5%;width:4px;height:6px;border-radius:50% 50% 50% 50% / 65% 65% 35% 35%;background:#5fb2de;opacity:0;"></span>
                  <span data-drop="1" style="position:absolute;left:calc(65.6% - 2px);top:79.5%;width:4px;height:6px;border-radius:50% 50% 50% 50% / 65% 65% 35% 35%;background:#5fb2de;opacity:0;"></span>
                  <span data-puddle="1" style="position:absolute;left:calc(48% - 22px);top:93%;width:44px;height:5px;border-radius:50%;background:rgba(95,178,222,.45);opacity:0;transform:scaleX(0);"></span>
                )}
                {g.isFish && (
                  <span data-wink="1" style="position:absolute;left:calc(35.1% - 6.5px);top:calc(53% - 6.5px);width:13px;height:13px;border-radius:50%;background:#fff;box-shadow:inset 0 -2px 0 #22305a;transform:scaleY(0);transform-origin:center top;"></span>
                  <span data-bub="1" style="position:absolute;left:calc(22% - 4px);top:calc(55% - 4px);width:8px;height:8px;border-radius:50%;border:1.5px solid #2a7c7a;opacity:0;"></span>
                  <span data-bub="1" style="position:absolute;left:calc(22% - 5px);top:calc(55% - 5px);width:10px;height:10px;border-radius:50%;border:1.5px solid #2a7c7a;opacity:0;"></span>
