---
/**
 * Side-by-side: the old ConceptLoop film and the PR71 CSS loop.
 * Not linked from nav, noindex, absent from the sitemap.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptLoop from '../components/ConceptLoop.astro';
import LandingLoop from '../components/LandingLoop.astro';
import { SLUG_FILM, topicCssVariant, type FilmVariant } from '../lib/landingLoops';
import { TOPIC_PAGE_SLUGS, loadTopicPage } from '../lib/topicPages';

export const prerender = false;

Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');

const pairs = TOPIC_PAGE_SLUGS.flatMap((slug) => {
  const film = SLUG_FILM[slug];
  if (!film) return [];
  const page = loadTopicPage(slug);
  return [{ slug, path: page.path, film, css: topicCssVariant(page) }];
});

const keptCss = TOPIC_PAGE_SLUGS.filter((slug) => !SLUG_FILM[slug]);
---

<BaseLayout
  title="השוואת לולאות"
  description="השוואה בין סרט ישן ללולאת נחיתה"
  activeNav={null}
  robots="noindex, nofollow"
>
  <main class="cmp" dir="rtl">
    <h1>השוואת לולאות</h1>
    <p class="cmp-lead">ישן: סרט ConceptLoop. חדש: לולאת ה־CSS שנשארת בקוד להשוואה. העמוד עצמו מציג את הסרט הישן.</p>
    {pairs.map((pair) => (
      <section class="cmp-pair">
        <h2><a href={pair.path}>{pair.path}</a> · {pair.film}</h2>
        <div class="cmp-cols">
          <figure>
            <figcaption>ישן · {pair.film}</figcaption>
            <ConceptLoop variant={pair.film as FilmVariant} />
          </figure>
          <figure>
            <figcaption>חדש · {pair.css ?? 'אין לולאת CSS'}</figcaption>
            {pair.css && <LandingLoop variant={pair.css} />}
          </figure>
        </div>
      </section>
    ))}
    <h2>ערך מוחלט — סרט חדש</h2>
    <p class="cmp-lead">סופרים 4 צעדים מ־−4 עד 0, ואז 4 צעדים מ־4 עד 0. הערך המוחלט של שניהם הוא 4.</p>
    <LandingLoop variant="absolute" />
    <h2>נשארו על לולאת CSS — אין סרט ישן מתאים</h2>
    <ul>
      {keptCss.map((slug) => <li><a href={`/${slug}`}>{slug}</a></li>)}
    </ul>
  </main>
</BaseLayout>

<style>
  .cmp { max-width: 1100px; margin: 0 auto; padding: 24px 16px 64px; }
  .cmp-lead { color: #5a6588; }
  .cmp-pair { margin: 28px 0; padding-top: 12px; border-top: 2px solid #22305a; }
  .cmp-pair h2 { font-size: 18px; }
  .cmp-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  .cmp figure { margin: 0; }
  .cmp figcaption { font-weight: 800; margin-bottom: 8px; }
  @media (max-width: 800px) {
    .cmp-cols { grid-template-columns: 1fr; }
  }
</style>
