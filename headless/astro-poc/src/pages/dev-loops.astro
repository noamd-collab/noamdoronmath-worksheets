---
/**
 * DEV/QA ONLY — loop preview page for family variants that have no topic
 * page in this POC (F07–F09, F11–F13 live only in grades 1–6, which have no
 * topic pages here). Not linked from anywhere; excluded from the sitemap.
 * Used by scripts/check-loops-k3.mjs for bbox/behaviour checks and screenshots.
 *
 * Gated with `import.meta.env.DEV`: available under `astro dev` (local QA);
 * any production / preview *build* returns 404 (does not ship as a public page).
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import ConceptLoop from '../components/ConceptLoop.astro';

export const prerender = false;

if (!import.meta.env.DEV) {
  return new Response('Not Found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const groups: Array<{ title: string; variants: Array<{ v: any; name: string }> }> = [
  {
    title: 'L01–L08 (B1)',
    variants: [
      { v: 'angle-sum', name: 'L01 סכום זוויות במשולש' },
      { v: 'para-rect', name: 'L02 מקבילית למלבן' },
      { v: 'angle-kinds', name: 'L03 סוגי זוויות' },
      { v: 'frac-product', name: 'L04 חצי של שליש' },
      { v: 'slope', name: 'L05 שיפוע' },
      { v: 'add-within', name: 'L06 3+4 בתחום 10' },
      { v: 'similar', name: 'L07 דמיון משולשים' },
      { v: 'order-ops', name: 'L08 סדר פעולות' },
    ],
  },
  {
    title: 'L09–L16 (B2)',
    variants: [
      { v: 'sup-angles', name: 'L09 זוויות צמודות לקו ישר' },
      { v: 'share-12', name: 'L10 חילוק שווה' },
      { v: 'corr-angles', name: 'L11 זוויות בין מקבילים' },
      { v: 'mean-cols', name: 'L12 ממוצע' },
      { v: 'pct-25', name: 'L13 25 אחוז' },
      { v: 'diff-sq', name: 'L14 הפרש ריבועים' },
      { v: 'clock-3', name: 'L15 שעה שלמה' },
      { v: 'peri-rect', name: 'L16 היקף מלבן' },
    ],
  },
  {
    title: 'L17–L24 (B3)',
    variants: [
      { v: 'signed-jump', name: 'L17 קפיצה מ־2−' },
      { v: 'prime-rect', name: 'L18 6 מלבן, 7 לא' },
      { v: 'sas-snap', name: 'L19 חפיפה צלע־זווית־צלע' },
      { v: 'obtuse-ht', name: 'L20 גובה מחוץ למשולש' },
      { v: 'box-vol', name: 'L21 נפח תיבה' },
      { v: 'trap-area', name: 'L22 שטח טרפז' },
      { v: 'odd-pair', name: 'L23 אי־זוגי' },
      { v: 'birds-sub', name: 'L24 6−2 ציפורים' },
    ],
  },
  {
    title: 'F07–F14 (B2)',
    variants: [
      { v: 'ruler', name: 'F07 מדידה ויחידות' },
      { v: 'array', name: 'F08 כפל — מערך' },
      { v: 'polygon', name: 'F09 צורות ומצולעים' },
      { v: 'data', name: 'F10 נתונים' },
      { v: 'baseten', name: 'F11 חיבור רב־ספרתי' },
      { v: 'cookies', name: 'F12 חילוק' },
      { v: 'fraction', name: 'F13 שבר כחלק משלם' },
      { v: 'transform', name: 'F14 טרנספורמציות' },
    ],
  },
];
---

<BaseLayout title="DEV loop previews" description="dev only" activeNav={null} skipHref="#dev-loops-main">
  <main class="wrap" id="dev-loops-main">
    <h1>DEV — loop previews</h1>
    {
      groups.map((g) => (
        <section>
          <h2>{g.title}</h2>
          <div class="dev-loops-grid">
            {g.variants.map((x) => (
              <figure class="dev-loops-cell">
                <ConceptLoop variant={x.v} />
                <figcaption>{x.name}</figcaption>
              </figure>
            ))}
          </div>
        </section>
      ))
    }
  </main>
</BaseLayout>

<style>
  .dev-loops-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(380px, 1fr));
    gap: 26px;
    margin: 18px 0 40px;
  }
  .dev-loops-cell {
    margin: 0;
  }
  .dev-loops-cell figcaption {
    text-align: center;
    color: var(--muted);
    font-weight: 600;
    margin-top: 6px;
  }
</style>
