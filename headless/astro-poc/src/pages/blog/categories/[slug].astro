---
import BlogArchivePage from '../../../components/BlogArchivePage.astro';
import {
  loadBuiltArchiveByCategorySlug,
  parseArchivePageParam,
} from '../../../lib/blogArchiveBuild';

export const prerender = false;

const slug = Astro.params.slug;
if (!slug || typeof slug !== 'string') {
  return new Response('Missing category', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}

const page = parseArchivePageParam(Astro.url.searchParams.get('page'));
const archive = loadBuiltArchiveByCategorySlug(slug, page);
if (!archive) {
  return new Response('Blog category not in M26 archives', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}
if (page > archive.pageCount) {
  return new Response('Blog category page not found', {
    status: 404,
    headers: { 'content-type': 'text/plain; charset=utf-8' },
  });
}
---
<BlogArchivePage archive={archive} />
