---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  ALL_GAMES,
  GAMES_INDEX_DESCRIPTION,
  GAMES_INDEX_H1,
  GAMES_INDEX_PATH,
  GAMES_INDEX_TITLE,
  gamePath,
} from '../../lib/eliyahuGames';
import { hasSpec } from '../../lib/eliyahuGameDocument';

export const prerender = false;

/* A game appears here only once it is playable. */
const games = ALL_GAMES.filter((game) => game.kind === 'legacy' || hasSpec(game.slug));
---
<BaseLayout
  title={GAMES_INDEX_TITLE}
  description={GAMES_INDEX_DESCRIPTION}
  activeNav="tools"
  skipHref="#games-corner"
  crumbs={[{ name: 'בית', path: '/' }, { name: 'פינת המשחקים', path: GAMES_INDEX_PATH }]}
>
  <main id="games-corner" class="games-corner">
    <header class="games-corner__head">
      <p class="games-corner__eyebrow">משחקים אינטראקטיביים</p>
      <h1>{GAMES_INDEX_H1}</h1>
      <p class="games-corner__lead">{GAMES_INDEX_DESCRIPTION}</p>
      <p class="games-corner__meta">
        {games.length} משחקים · כל אחד כרבע שעה · בלי הרשמה ובלי התקנה
      </p>
    </header>

    <ul class="games-corner__grid">
      {games.map((game) => (
        <li class="games-corner__item" style={`--card-main:${game.theme.main};--card-soft:${game.theme.mainSoft};--card-line:${game.theme.mainLine}`}>
          <a class="games-corner__card" href={gamePath(game)}>
            <span class="games-corner__emoji" aria-hidden="true">{game.emoji}</span>
            <span class="games-corner__grade">{game.grade}</span>
            <h2 class="games-corner__title">{game.h1}</h2>
            <p class="games-corner__short">{game.short}</p>
            <span class="games-corner__go">למשחק</span>
          </a>
        </li>
      ))}
    </ul>

    <section class="games-corner__note">
      <h2>איך המשחקים עובדים</h2>
      <p>
        בכל משחק אליהו מלווה את התלמיד שלב אחר שלב: קודם רואים את הרעיון בעיניים,
        גוררים, בונים ומסובבים, ורק אחר כך עונים על שאלה. על כל שאלה יש רמזים
        מדורגים, ובסוף מתקבל דף סיכום שמראה במה התלמיד חזק ובמה כדאי להתאמן עוד.
      </p>
      <p>
        המשחקים רצים בדפדפן, גם בטלפון, ואין בהם פרסומות, הרשמה או איסוף נתונים.
        אפשר לשחק שוב ושוב, והשאלות נשארות אותן שאלות כדי שתהיה אפשרות להשתפר.
      </p>
    </section>
  </main>
</BaseLayout>
<style>
  .games-corner {
    max-width: 1100px;
    margin-inline: auto;
    padding: 18px 16px 48px;
    color: #22305a;
  }
  .games-corner__head {
    text-align: center;
    max-width: 720px;
    margin-inline: auto;
    margin-bottom: 26px;
  }
  .games-corner__eyebrow {
    margin: 0 0 6px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: #1e605e;
  }
  .games-corner h1 {
    margin: 0 0 10px;
    font-family: 'Secular One', sans-serif;
    font-weight: 400;
    font-size: clamp(28px, 5vw, 44px);
    line-height: 1.2;
  }
  .games-corner__lead {
    margin: 0 0 8px;
    font-size: clamp(15px, 2.4vw, 18px);
    line-height: 1.6;
    color: #44506f;
  }
  .games-corner__meta {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    color: #6b7694;
  }
  .games-corner__grid {
    list-style: none;
    margin: 0 0 36px;
    padding: 0;
    display: grid;
    gap: 16px;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
  }
  .games-corner__item { display: flex; }
  .games-corner__card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 8px;
    width: 100%;
    padding: 18px 18px 54px;
    box-sizing: border-box;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 2px solid #dfe3ef;
    border-radius: 20px 7px 22px 9px / 9px 22px 7px 20px;
    box-shadow: 0 2px 0 #e7eaf3;
    transition: transform 0.18s ease, border-color 0.18s ease, box-shadow 0.18s ease;
  }
  .games-corner__card:hover,
  .games-corner__card:focus-visible {
    transform: translateY(-3px);
    border-color: var(--card-main, #1e605e);
    box-shadow: 0 10px 22px rgba(34, 48, 90, 0.12);
  }
  .games-corner__card:focus-visible {
    outline: 3px solid var(--card-main, #2a7c7a);
    outline-offset: 3px;
  }
  .games-corner__emoji {
    font-size: 30px;
    line-height: 1;
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    border-radius: 14px;
    background: var(--card-soft, #eef2f8);
    border: 1.5px solid var(--card-line, #cfd6e6);
  }
  .games-corner__grade {
    font-size: 12.5px;
    font-weight: 800;
    color: var(--card-main, #1e605e);
  }
  .games-corner__title {
    margin: 0;
    font-family: 'Secular One', sans-serif;
    font-weight: 400;
    font-size: 20px;
    line-height: 1.3;
  }
  .games-corner__short {
    margin: 0;
    font-size: 14.5px;
    line-height: 1.55;
    color: #4d5874;
  }
  .games-corner__go {
    position: absolute;
    inset-inline-start: 18px;
    bottom: 16px;
    font-weight: 800;
    font-size: 14px;
    color: var(--card-main, #1e605e);
  }
  .games-corner__go::after {
    content: ' ←';
  }
  .games-corner__note {
    max-width: 760px;
    margin-inline: auto;
    padding: 18px 20px;
    background: #f7f8fc;
    border: 1.5px solid #e2e6f1;
    border-radius: 18px 6px 20px 8px / 8px 20px 6px 18px;
  }
  .games-corner__note h2 {
    margin: 0 0 8px;
    font-family: 'Secular One', sans-serif;
    font-weight: 400;
    font-size: 22px;
  }
  .games-corner__note p {
    margin: 0 0 10px;
    font-size: 15px;
    line-height: 1.7;
    color: #44506f;
  }
  .games-corner__note p:last-child { margin-bottom: 0; }
  @media (max-width: 640px) {
    .games-corner { padding: 14px 12px 36px; }
    .games-corner__grid { grid-template-columns: 1fr; }
  }
</style>
