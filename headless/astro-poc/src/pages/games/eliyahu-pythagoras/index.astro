---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import {
  PYTHAGORAS_GAME_DESCRIPTION,
  PYTHAGORAS_GAME_H1,
  PYTHAGORAS_GAME_PLAY_PATH,
  PYTHAGORAS_GAME_TITLE,
} from '../../../lib/pythagorasGame';

export const prerender = false;
---
<BaseLayout
  title={PYTHAGORAS_GAME_TITLE}
  description={PYTHAGORAS_GAME_DESCRIPTION}
  activeNav="tools"
  skipHref="#eliyahu-game"
>
  <main id="eliyahu-game" class="eliyahu-game">
    <h1>{PYTHAGORAS_GAME_H1}</h1>
    <p class="eliyahu-game__links">
      <a href="/pythagorean-theorem-grade-8">משפט פיתגורס לכיתה ח׳</a>
      <span aria-hidden="true"> · </span>
      <a href="/pythagorean-theorem-grade-9">משפט פיתגורס לכיתה ט׳</a>
    </p>
    <div class="eliyahu-game__frame">
      <iframe title={PYTHAGORAS_GAME_H1} src={PYTHAGORAS_GAME_PLAY_PATH}></iframe>
    </div>
    <div class="eliyahu-game__dock" data-eliyahu-dock></div>
  </main>
</BaseLayout>
<style>
  .eliyahu-game {
    max-width: 1200px;
    margin-inline: auto;
    padding: 12px 16px 0;
    color: #22305a;
  }
  .eliyahu-game h1 {
    margin: 0 0 6px;
    font-family: 'Secular One', sans-serif;
    font-weight: 400;
    font-size: clamp(26px, 4vw, 40px);
    line-height: 1.2;
  }
  .eliyahu-game__links {
    margin: 0 0 10px;
    font-size: 16px;
    line-height: 1.5;
  }
  .eliyahu-game__links a {
    color: #1e605e;
    font-weight: 700;
  }
  .eliyahu-game__links a:focus-visible {
    outline: 3px solid #2a7c7a;
    outline-offset: 3px;
  }
  .eliyahu-game__frame {
    min-height: 320px;
  }
  .eliyahu-game__frame iframe {
    display: block;
    box-sizing: border-box;
    width: 100%;
    height: 100%;
    border: 2px solid #22305a;
    border-radius: 18px 6px 20px 8px / 8px 20px 6px 18px;
    background: #fbfaf5;
  }
  .eliyahu-game__dock {
    position: relative;
    height: calc(76px + env(safe-area-inset-bottom, 0px));
  }
  /* Closed launchers live in the dock, under the iframe, and scroll with it. */
  :global(html:not(.noam-ai-engaged) .eliyahu-game__dock #noam-accessibility) {
    position: absolute !important;
    left: 8px !important;
    right: auto !important;
    bottom: 8px !important;
    top: auto !important;
  }
  :global(html:not(.noam-ai-engaged) .eliyahu-game__dock #noam-site-companion) {
    position: absolute !important;
    right: 8px !important;
    left: auto !important;
    bottom: 8px !important;
    top: auto !important;
  }
  @media (max-width: 800px) {
    .eliyahu-game { padding: 10px 12px 0; }
  }
</style>
<script is:inline>
  var eliyahuFitRaf = 0;
  var eliyahuCardObserver;
  function scheduleEliyahuFit() {
    if (eliyahuFitRaf) return;
    eliyahuFitRaf = requestAnimationFrame(function () {
      eliyahuFitRaf = 0;
      fitEliyahuGame();
    });
  }
  function fitEliyahuGame() {
    var frame = document.querySelector('.eliyahu-game__frame');
    var dock = document.querySelector('[data-eliyahu-dock]');
    var iframe = frame && frame.querySelector('iframe');
    if (!frame || !dock) return;
    var dockH = dock.getBoundingClientRect().height || 76;
    var top = frame.getBoundingClientRect().top;
    if (top < 0) top = 0;
    var viewportH = Math.max(320, Math.round(window.innerHeight - top - dockH));
    var h = viewportH;
    // Size to the card at every width so the outer page can scroll.
    // Its height is intrinsic; its bottom position depends on the iframe
    // viewport because #app centers the card, causing a resize feedback loop.
    if (iframe && iframe.contentDocument) {
      var card = iframe.contentDocument.querySelector('#card');
      var app = iframe.contentDocument.querySelector('#app');
      if (card && app) {
        var appStyle = iframe.contentWindow.getComputedStyle(app);
        var frameStyle = window.getComputedStyle(iframe);
        var inner = card.getBoundingClientRect().height
          + parseFloat(appStyle.paddingTop) + parseFloat(appStyle.paddingBottom)
          + parseFloat(frameStyle.borderTopWidth) + parseFloat(frameStyle.borderBottomWidth);
        h = Math.max(viewportH, Math.ceil(inner));
      }
    }
    if (frame.style.height !== h + 'px') frame.style.height = h + 'px';
  }
  function observeEliyahuGame() {
    if (eliyahuCardObserver) eliyahuCardObserver.disconnect();
    var iframe = document.querySelector('.eliyahu-game__frame iframe');
    var doc = iframe && iframe.contentDocument;
    var card = doc && doc.querySelector('#card');
    if (card && typeof ResizeObserver === 'function') {
      eliyahuCardObserver = new ResizeObserver(scheduleEliyahuFit);
      eliyahuCardObserver.observe(card);
    }
    if (doc && doc.fonts) doc.fonts.ready.then(scheduleEliyahuFit);
    scheduleEliyahuFit();
  }
  function parkEliyahuLaunchers() {
    var dock = document.querySelector('[data-eliyahu-dock]');
    if (!dock) return;
    var a11y = document.getElementById('noam-accessibility');
    var buddy = document.getElementById('noam-site-companion');
    if (a11y && a11y.parentElement !== dock) dock.appendChild(a11y);
    if (buddy && buddy.parentElement !== dock) dock.appendChild(buddy);
    fitEliyahuGame();
  }
  parkEliyahuLaunchers();
  fitEliyahuGame();
  window.addEventListener('resize', scheduleEliyahuFit);
  window.addEventListener('load', function () {
    parkEliyahuLaunchers();
    observeEliyahuGame();
  });
  var gameFrame = document.querySelector('.eliyahu-game__frame iframe');
  if (gameFrame) {
    gameFrame.addEventListener('load', observeEliyahuGame);
    observeEliyahuGame();
  }
  if (typeof MutationObserver === 'function') {
    var mo = new MutationObserver(parkEliyahuLaunchers);
    mo.observe(document.body, { childList: true });
    setTimeout(function () { mo.disconnect(); }, 4000);
  }
</script>
