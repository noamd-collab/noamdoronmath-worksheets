---
import BaseLayout from '../layouts/BaseLayout.astro';
import { WorksheetsClient } from '../components/WorksheetsClient';
import { loadCatalog } from '../lib/catalog/loadCatalog';
import { familyOf, resolveWorksheetsGrade, worksheetsHref, type GradeNum } from '../lib/grades';
import { parseWorksheetsUrlState, trackForPinnedTopic } from '../lib/worksheetsUrlState';
import { educationalLevelForGrade, learningResourceJsonLd } from '../lib/structuredData';

export const prerender = false;

const catalog = loadCatalog();
const parsed = resolveWorksheetsGrade({
  grade: Astro.url.searchParams.get('grade'),
  level: Astro.url.searchParams.get('level'),
});
const invalid = parsed.invalid || !parsed.grade;
const grade = parsed.grade;
const gradeEntry = !invalid && grade ? catalog.grades.find((g) => g.grade === grade) : undefined;
const missingEntry = !invalid && !!grade && !gradeEntry;
// The explicit error page keeps its copy, but answers 404 so `?grade=12` is not a soft 404.
if (invalid || missingEntry) Astro.response.status = 404;
const familyGrades =
  gradeEntry && grade
    ? familyOf(grade).map((g) => {
        const entry = catalog.grades.find((x) => x.grade === g);
        if (!entry) throw new Error('Missing catalog grade in family: ' + g);
        return entry;
      })
    : [];
const urlState = parseWorksheetsUrlState(Astro.url.searchParams, grade || 7);
const highlightTopicId = urlState.topic;
const initialUrlState = {
  q: urlState.q,
  group: urlState.group,
  cross: urlState.cross,
  track: trackForPinnedTopic(urlState, gradeEntry),
};
---

{
  invalid ? (
    <BaseLayout title="כיתה לא חוקית" activeNav="worksheets">
      <main class="wrap" data-grade="7">
        <header class="banner">
          <h1>כיתה לא חוקית</h1>
          <p>
            הפרמטר <code>grade={parsed.raw || '(ריק)'}</code> אינו כיתה במערכת (מותר 1–9 בלבד).
            לא מוצג תוכן של כיתה אחרת תחת התווית הזו.
          </p>
          <ul class="invalid-grade-list">
            {
              catalog.grades.map((g) => (
                <li>
                  <a href={worksheetsHref(g.grade as GradeNum)}>
                    {(g.emoji || '') + ' '}
                    {g.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </header>
      </main>
    </BaseLayout>
  ) : missingEntry ? (
    <BaseLayout title="כיתה חסרה" activeNav="worksheets">
      <main class="wrap" data-grade="7">
        <header class="banner">
          <h1>כיתה לא נמצאה בקטלוג</h1>
          <p>
            <a href="/worksheets?grade=7">חזרה לכיתה ז׳</a>
          </p>
        </header>
      </main>
    </BaseLayout>
  ) : (
    <BaseLayout
      title={`דפי עבודה · ${gradeEntry!.label}`}
      crumbs={[
        { name: 'בית', path: '/' },
        { name: 'דפי עבודה', path: '/worksheets' },
        { name: gradeEntry!.label, path: `/worksheets?grade=${grade}` },
      ]}
      seoPath={
        highlightTopicId
          ? `/worksheets?grade=${grade}&topic=${highlightTopicId}`
          : `/worksheets?grade=${grade}`
      }
      activeNav="worksheets"
      compactBrand={true}
    >
      <script
        type="application/ld+json"
        set:html={JSON.stringify(
          learningResourceJsonLd({
            name: `דפי עבודה · ${gradeEntry!.label}`,
            path: `/worksheets?grade=${grade}`,
            description: `דפי עבודה במתמטיקה ל${gradeEntry!.label}, בחינם וללא הרשמה.`,
            educationalLevel: educationalLevelForGrade(grade!),
          })
        )}
      />
      <main>
        <WorksheetsClient
          client:load
          catalog={catalog}
          grade={grade!}
          gradeEntry={gradeEntry!}
          familyGrades={familyGrades}
          highlightTopicId={highlightTopicId}
          initialUrlState={initialUrlState}
        />
      </main>
    </BaseLayout>
  )
}
