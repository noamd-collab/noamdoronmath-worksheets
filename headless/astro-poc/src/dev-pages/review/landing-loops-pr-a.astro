---
import ReviewGallery from './parts/ReviewGallery.astro';
import type { ReviewEntry } from './parts/reviewTypes';

const entries: ReviewEntry[] = [
  { slug: 'frequency-chance-grade-5', section: '1 + 5', note: 'מטבע סטטי P = ½ בדף על שכיחות. עכשיו סרט data: סימני ספירה, עמודות ועוגה, 8 + 5 + 3 = 16.' },
  { slug: 'fraction-decimal-percent-grade-6', section: '1', note: 'פס סטטי. עכשיו הרבע נצבע, הנקודה הולכת ל־0.25 על הישר, ונכתב ¼ = 0.25 = 25% כמו בדוגמה בדף.' },
  { slug: 'coordinate-plane-applications-grade-7', section: '1', note: 'הציג 3, 4, 5 של פיתגורס, נושא של כיתה ט׳. עכשיו סופרים יחידה אחר יחידה את AB = 5 − (−2) = 7 ואת BC = 3, המלבן מתמלא, P = 20 ו־S = 21.' },
  { slug: 'circle-area-circumference-grade-8', section: '1 + 5', note: 'עיגול סטטי. עכשיו סרט circ-unroll: גלגל בקוטר d מתגלגל סיבוב שלם ופורש את ההיקף לקו, C = πd ≈ 3.14d. בסרט המקורי הקטעים רק הופיעו.' },
  { slug: 'cone-grade-8', section: '1', note: 'חרוט וגליל סטטיים. עכשיו החרוט נשפך לגליל שלוש פעמים, כל שפיכה ממלאת שליש: V = ⅓ × S × h.' },
  { slug: 'exterior-angle-triangle-grade-8', section: '1 + 5', note: 'סקיצה סטטית. עכשיו סרט exterior: זווית 90° עולה מהקודקוד שלה וזווית 60° נוסעת ומסתובבת אל הקודקוד העליון, ויחד הן ממלאות את הזווית החיצונית 150°. בסרט המקורי הזוויות רק הופיעו.' },
  { slug: 'linear-function-grade-8', section: '1 + 5', note: 'ישר סטטי. עכשיו סרט slope: נקודה צועדת 1 ימינה ו־2 למעלה פעמיים ומשרטטת את המדרגות על הישר.' },
  { slug: 'percentage-problems-grade-8', section: '1', note: 'פס רבע סטטי (נושא של כיתה ו׳). עכשיו 250 בחמישה חלקים של 50, חלק ה־20% יוצא ונשאר 200, כמו הדוגמה בדף.' },
  { slug: 'coordinate-plane-applications-grade-9', section: '1', note: 'משולש סטטי. עכשיו הולכים 4 ימינה ו־3 למעלה, ואז נמתח היתר: √(4² + 3²) = 5.' },
  { slug: 'linear-function-grade-9', section: '1 + 5', note: 'ישר סטטי. עכשיו סרט slope: נקודה צועדת 1 ימינה ו־2 למעלה פעמיים.' },
  { slug: 'probability-grade-9', section: '1 + 5', note: 'מטבע סטטי. עכשיו סרט two-coins: ארבעת הכרטיסים עע, עפ, פע, פפ מחולקים מהמטבעות, והמסגרת נסגרת על אחד מהם: P = ¼.' },
  { slug: 'rhombus-grade-9', section: '1', note: 'מעוין סטטי. עכשיו האלכסונים צומחים מהמרכז, נפגשים ב־90°, חוצים זה את זה, וחצי המעוין מתקפל על האלכסון.' },
  { slug: 'square-grade-9', section: '1', note: 'ריבוע סטטי. עכשיו סרט quad-tree: המלבן והמעוין יוצאים מהמקבילית לאורך הקווים, והריבוע יורד משניהם.' },
  { slug: 'trapezoid-grade-9', section: '1 + 5', note: 'טרפז סטטי. עכשיו סרט trap-area: הבסיס 6 והבסיס 2 נעים לאמצע הגובה ונפגשים בקטע האמצעים 4, ואז (6 + 2) : 2 × 3 = 12.' },
  { slug: 'triangle-30-60-90-grade-9', section: '1 + 5', note: 'משולש סטטי. עכשיו סרט half-eq: הגובה נשרטט, החצי השמאלי מתקפל על החצי הימני, והניצב מול 30° הוא חצי מהיתר.' },
  { slug: 'square-rectangle-grade-1', section: '5', note: 'פעימת תגיות בלבד. עכשיו סרט sq-stretch: ריבוע נמתח למלבן ונשארות לו ארבע צלעות.' },
  { slug: 'numbers-to-1000-grade-2', section: '5', note: 'היה סרט ערך המקום place-123. הדף עוסק בישר המספרים עד 1000, ולכן סרט mark-250: הנקודה קופצת 0, 100, 200, הקטע 200 עד 300 נצבע, וחצי קפיצה מגיעה ל־250.' },
  { slug: 'unit-fractions-part-of-whole-grade-3', section: '5', note: 'היה סרט fraction כללי. עכשיו סרט unit-frac: כל חלק צועד לאורך השלם, החצי נכנס פעמיים, השליש שלוש והרבע ארבע, ולכן ½ > ⅓ > ¼.' },
  { slug: 'collecting-data-grade-3', section: '5', note: 'פעימת תגיות בלבד. עכשיו סרט data: איסוף בסימני ספירה ואז עמודות.' },
  { slug: 'long-division-remainder-grade-4', section: '5', note: 'פעימת תגיות בלבד. עכשיו סרט cookies: 14 = 4 × 3 + 2.' },
  { slug: 'box-volume-grade-6', section: '5', note: 'קו אחד מהבהב. עכשיו סרט box-vol: 12 קוביות יחידה נופלות למקומן, 3 × 2 × 2 = 12.' },
  { slug: 'scaling-dimensions-grade-6', section: '5', note: 'הביקורת פספסה (הגדלה אחת). עכשיו סרט area-x4: הצלע גדלה פי 2 ושלושה עותקים של הריבוע הקטן מחליקים וממלאים אותו, השטח פי 4.' },
  { slug: 'angles-review-grade-7', section: '5', note: 'הביקורת פספסה (פעימה בלבד). עכשיו סרט sup-angles: זוויות צמודות משלימות ל־180°.' },
  { slug: 'equations-basics-grade-7', section: '5', note: 'הציג סרט pattern שאינו על משוואות. עכשיו סרט balance: המאזניים נשארים מאוזנים.' },
  { slug: 'signed-numbers-grade-7', section: '5', note: 'נקודה אחת זזה. עכשיו סרט signed-jump: −2 + 5 = 3 על ישר המספרים.' },
  { slug: 'solids-box-cube-prism-grade-7', section: '5', note: 'קו אחד מהבהב. עכשיו סרט cube-8: השכבה העליונה של 4 קוביות מתרוממת מעל השכבה התחתונה וחוזרת, 2³ = 8.' },
  { slug: 'coordinate-plane-grade-8', section: '5', note: 'נקודה אחת זזה. עכשיו סרט coord-walk: הליכה ל־(3, 2) ברביע הראשון.' },
  { slug: 'cylinder-volume-grade-8', section: '5', note: 'דיסקית אחת זזה. עכשיו סרט cyl-stack: V = S × h, ארבע שכבות בסיס.' },
  { slug: 'similar-triangles-grade-8', section: '5', note: 'הביקורת פספסה (הגדלה אחת). עכשיו סרט similar: 3, 4 הופכים ל־6, 8, וסימני הזוויות החדות נוסעים עם הקודקודים ונשארים באותו גודל.' },
  { slug: 'statistics-grade-8', section: '5', note: 'קובייה אחת זזה. עכשיו סרט mean-cols: (2 + 4 + 6) : 3 = 4.' },
  { slug: 'triangle-congruence-grade-8', section: '5', note: 'הזזה אחת. עכשיו סרט sas-snap: העותק המסומן מחליק ומתלכד עם המשולש. בסרט המקורי העותק היה מוסתר ולא נראה בכלל.' },
  { slug: 'parallelogram-trapezoid-area-grade-9', section: '5', note: 'הציג סרט triangle (סכום זוויות). עכשיו סרט para-rect: המקבילית נמתחת למלבן, גובה כתום רוכב על הפינה ונשאר באותו אורך, והשטח לא משתנה.' },
  { slug: 'quadratic-function-grade-9', section: '5', note: 'נקודה מהבהבת. עכשיו סרט parab: y = x² + 3.' },
  { slug: 'similar-triangles-grade-9', section: '5', note: 'הביקורת פספסה (הגדלה אחת). עכשיו סרט similar: הצלעות מוכפלות והזוויות נוסעות עם הקודקודים בלי להשתנות.' },
  { slug: 'statistics-grade-9', section: '5', note: 'קובייה אחת זזה. עכשיו סרט mean-cols.' },
  { slug: 'frequency-grade-7', section: 'שילוב הדפים החדשים', note: 'סימני ספירה מתורגמים לעמודות ולייצוג יחסי של אותן שכיחויות.' },
  { slug: 'equations-introduction-equivalence-grade-7', section: 'שילוב הדפים החדשים', note: 'המאזניים מדגימים שמירה על שוויון בין שני אגפי המשוואה.' },
  { slug: 'annual-review-grade-7', section: 'שילוב הדפים החדשים', note: 'דוגמת חזרה: חיבור מספרים מכוונים בהליכה על ישר המספרים.' },
  { slug: 'mean-grade-8', section: 'שילוב הדפים החדשים', note: 'עודפים עוברים בין העמודות עד שכולן בגובה הממוצע.' },
  { slug: 'slope-line-through-origin-grade-8', section: 'שילוב הדפים החדשים', note: 'הנקודה צועדת יחידה ימינה ושתי יחידות למעלה על הישר.' },
  { slug: 'midyear-diagnostic-grade-8', section: 'שילוב הדפים החדשים', note: 'דוגמת אבחון: מאזן מדגים שוויון בין אגפי משוואה.' },
  { slug: 'percent-change-grade-8', section: 'שילוב הדפים החדשים', note: 'חלק של 20 אחוזים יוצא מתוך 250 ונשארים 200.' },
];
---
<ReviewGallery
  title="סקירת אנימציות: PR A, סעיפים 5 ו־1"
  intro="כל כרטיס מציג את דף הנושא לפני השינוי (הקוד שבאתר) ואחריו. הקישור פותח את הדף עצמו. כפתור העצירה מפעיל את מצב עצירת האנימציות של האתר."
  entries={entries}
/>
