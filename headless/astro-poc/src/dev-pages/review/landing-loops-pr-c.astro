---
import ReviewGallery from './parts/ReviewGallery.astro';
import type { ReviewEntry } from './parts/reviewTypes';

const MISSED = '3 (הביקורת פספסה)';
const entries: ReviewEntry[] = [
  { slug: 'subtraction-to-20-grade-1', section: '3', note: 'הנקודות שנלקחות רק דהו. עכשיו 5 הנקודות ואחריהן 2 מהעשר מתכווצות ונעלמות בזמן שהן נלקחות: 15 − 7 = 15 − 5 − 2 = 8.' },
  { slug: 'subtraction-two-digit-borrowing-grade-2', section: '3', note: 'המוט רק דהה והקוביות הופיעו. עכשיו עשר קוביות יחידה יוצאות מהמוט שנפרט ויורדות לשורות שלהן: 52 − 27 = 25.' },
  { slug: 'column-subtraction-borrowing-grade-3', section: '3', note: 'כמו בכיתה ב׳: עשר הקוביות יוצאות מהמוט שנפרט.' },
  { slug: 'multi-digit-subtraction-grade-4', section: '3', note: 'כמו בכיתה ב׳: עשר הקוביות יוצאות מהמוט שנפרט.' },
  { slug: 'number-bonds-10-20-grade-2', section: '3', note: 'התאים הריקים רק נצבעו. עכשיו 4 מונים מחליקים אל המסגרת של 6, ואחר כך 7 מונים אל המסגרת של 13.' },
  { slug: 'quadrilaterals-properties-grade-3', section: '3', note: 'הציג גזירה ושטח, לא תכונות. עכשיו עותק של הצלע העליונה יורד אל הצלע שמולה ועותק של הצלע השמאלית עובר אל הימנית: צלעות נגדיות שוות ומקבילות.' },
  { slug: 'multiplication-multi-digit-grade-4', section: '3', note: 'הספרות רק הופיעו. עכשיו כל ספרת העברה עולה בעיגול מהעמודה שלה אל העמודה הבאה: 175 × 5 = 875.' },
  { slug: 'multiplication-multi-digit-grade-5', section: '3', note: 'הספרות רק הופיעו. עכשיו ה־0 בשורה השנייה גדל למקומו, וקו הסכום נמתח מתחת לשתי השורות: 257 × 23 = 5,911.' },
  { slug: 'mean-data-inquiry-grade-5', section: '3', note: 'רק הקובייה זזה. עכשיו קו הממוצע נמתח אחרי שה־8 נותנת 2 ל־4, והעמודות מתיישרות על 6.' },
  { slug: 'solids-explore-grade-6', section: '3', note: 'הקווים הבהבו. עכשיו שלוש הצלעות a, b, c צומחות מהפינה המשותפת שלהן.' },
  { slug: 'area-rectangle-perimeter-grade-7', section: '3', note: 'המשבצות הבהבו. עכשיו 5 שורות של 3 משבצות מחליקות למקומן, שורה אחר שורה: 15.' },
  { slug: 'rectangle-square-area-grade-9', section: '3', note: 'כמו בכיתה ז׳: 5 שורות של 3 משבצות מחליקות למקומן.' },
  { slug: 'area-parallelogram-trapezoid-composite-grade-7', section: '3', note: 'המקבילית רק נטתה. עכשיו הגובה המאונך נמתח, המשולש שבצד שמאל נחתך לאורכו ועובר ימינה, ומתקבל מלבן b × h.' },
  { slug: 'composite-polygons-area-grade-9', section: '3', note: 'החלק השני רק הופיע. עכשיו שני המלבנים 6 ו־4 מחליקים זה אל זה ונסגרים לצורה אחת: 6 + 4 = 10.' },
  { slug: 'parallelogram-grade-9', section: '3', note: 'המלבן רק נטה. עכשיו הגובה נמתח, והמשולש הכתום עובר משמאל המלבן לימינו: אותו בסיס, אותו גובה, אותו שטח.' },
  { slug: 'rectangle-grade-9', section: '3', note: 'הסימנים הופיעו. עכשיו סימני הזווית הישרה נכנסים לארבע הפינות, והאלכסון השני מסתובב סביב המרכז מעל הראשון: האלכסונים שווים.' },
  { slug: 'cylinder-surface-area-grade-8', section: '3', note: 'רק המעטפת נפרשה. עכשיו גם שני הבסיסים יוצאים מהגליל ונפתחים לעיגולים מעל המלבן ומתחתיו.' },
  { slug: 'triangular-prism-surface-area-grade-9', section: '3', note: 'הפאות הופיעו, והמשולשים היו מחוברים לצלע הלא נכונה. עכשיו הפריסה נפתחת: המלבנים מתקפלים החוצה, והמשולשים נפתחים מעל ומתחת למלבן האמצעי.' },
  { slug: 'triangular-prism-volume-grade-9', section: '3', note: 'רק הבסיס זז. עכשיו שתי שכבות ביניים מחליקות לאורך המנסרה, והצלעות הצדדיות נמתחות איתן: V = S × ℓ.' },
  { slug: 'coordinate-plane-four-quadrants-grade-7', section: '3', note: 'רק הנקודה זזה. עכשיו שני סמנים על הצירים זזים איתה ומראים את סימן x ואת סימן y בכל רביע.' },
  { slug: 'coordinate-plane-quadrants-grade-7', section: '3', note: 'כמו הדף הקודם: הנקודה והסמנים על הצירים.' },
  { slug: 'patterns-and-graphs-grade-7', section: '3', note: 'הנקודות הופיעו. עכשיו צעד 1 ימינה ו־2 למעלה נשרטט פעמיים, והנקודות עולות איתו אל (1, 2) ואל (2, 4).' },
  { slug: 'coordinate-plane-scale-grade-7', section: '3', note: 'הקטע הארוך רק הופיע. עכשיו שני עותקים של יחידה אחת (5) עולים ונצמדים זה לזה: שתי יחידות הן 10.' },
  { slug: 'isosceles-triangle-grade-8', section: '3', note: 'הקשתות הופיעו. עכשיו ציר הסימטריה נמתח והחצי הימני מתקפל על השמאלי: זוויות הבסיס שוות.' },
  { slug: 'isosceles-triangle-properties-grade-8', section: '3', note: 'כמו isosceles-triangle-grade-8.' },
  { slug: 'isosceles-triangle-grade-9', section: '3', note: 'כמו isosceles-triangle-grade-8.' },
  { slug: 'special-triangles-grade-7-new', section: '3', note: 'כמו isosceles-triangle-grade-8.' },
  { slug: 'triangle-area-grade-7', section: '3', note: 'רק התוצאה הופיעה. עכשיו הגובה 4 נמתח, ועותק של המשולש מסתובב 180° ומשלים את המלבן: השטח הוא חצי מ־6 × 4.' },
  { slug: 'triangle-calculations-grade-9', section: '3', note: 'הקשתות הבהבו. עכשיו שלוש זוויות המשולש עצמן נוסעות מהקודקודים אל הישר, והזווית העליונה מסתובבת: יחד 180°.' },
  { slug: 'triangle-sides-angles-grade-9', section: '3', note: 'הקשת הופיעה. עכשיו הצלע הארוכה נמתחת, והזווית שמולה נפתחת מהקודקוד: היא הגדולה ביותר.' },
  { slug: 'congruence-theorems-grade-8', section: '3', note: 'הטענה בביקורת לא מדויקת: העותק החליק גם קודם. אבל הוא לא היה חופף (בסיס 140 מול 130). עכשיו עותק מדויק של המשולש השמאלי מחליק למקומו.' },
  { slug: 'triangle-congruence-proofs-grade-8', section: '3', note: 'כמו congruence-theorems-grade-8.' },
  { slug: 'triangle-median-grade-8', section: '3', note: 'התיכון הופיע. עכשיו נקודה הולכת לאורך הצלע עד האמצע, והתיכון יורד אליה מהקודקוד; סימני החצאים באמצע כל חצי.' },
  { slug: 'inequalities-grade-8', section: '3', note: 'רק הקרן נמתחה. עכשיו גם נקודות יוצאות מ־2 ימינה לאורך הקרן: כל מספר גדול מ־2.' },
  { slug: 'quadratic-inequalities-systems-grade-9', section: '3', note: 'שתי הקרניים נמתחו, בלי שום דבר עליהן. עכשיו נקודות יוצאות מ־3 ומ־(−3) החוצה לאורך שתי הקרניים.' },
  { slug: 'quadratic-equations-grade-9', section: '3', note: 'הנקודות הופיעו. עכשיו שני הפתרונות מחליקים מציר הסימטריה אל נקודות החיתוך x = −2 ו־x = 2.' },
  { slug: 'reading-graphs-grade-9', section: '3', note: 'הקווים הופיעו. עכשיו עולים מ־x = 2 אל הגרף, הנקודה עולה איתם, ואז הולכים שמאלה אל y = 4.' },
  { slug: 'systems-of-equations-grade-8', section: '3', note: 'הנקודה הופיעה. עכשיו שני הישרים נשרטטים, והנקודה מחליקה לאורך אחד מהם אל החיתוך (2, 2).' },
  { slug: 'congruent-polygons-transformations-grade-9', section: '3', note: 'רק המשולש זז. עכשיו חץ ההזזה נמתח יחד איתו.' },
  { slug: 'precalculus-functions-graphs-grade-9', section: '3', note: 'הקטע הופיע. עכשיו החצי השמאלי של הפרבולה מתהפך סביב ציר y על החצי הימני, והנקודה (−2, 4) עוברת ל־(2, 4).' },
  { slug: 'number-line-absolute-value-grade-7', section: MISSED, note: 'פעימה בלבד. עכשיו שתי נקודות יוצאות מ־0 אל −4 ואל 4, והמרחקים נמתחים איתן: שניהם 4.' },
  { slug: 'similar-triangles-area-ratio-grade-8', section: MISSED, note: 'רק התווית הופיעה. עכשיו שלושה עותקים של המשולש הקטן מחליקים ומסתובבים וממלאים את הגדול: פי 4 בשטח.' },
  { slug: 'triangle-similarity-aa-grade-9', section: MISSED, note: 'הקשתות הופיעו, והמשולש הגדול לא היה דומה לקטן (גובה 130 במקום 150). עכשיו המשולש הקטן גדל פי 1.5 יחד עם הזוויות שלו ונוחת על הגדול.' },
  { slug: 'triangle-similarity-proof-grade-8', section: MISSED, note: 'כמו triangle-similarity-aa-grade-9.' },
  { slug: 'powers-grade-7', section: '4', note: 'טקסט בלבד. עכשיו ליד הנוסחה: זוג מינוסים הופך לפלוס, −3² נשאר מינוס ליד ריבוע 3 × 3, ובחזקה השלישית מינוס אחד נשאר.' },
  { slug: 'exponent-rules-grade-9', section: '4', note: 'טקסט בלבד. עכשיו שני ה־2 של 2² עולים ומצטרפים לשלושת ה־2 של 2³: שורה של חמישה, 2⁵.' },
  { slug: 'square-root-grade-7', section: '4', note: 'המשבצות הבהבו. עכשיו 9 המשבצות מתקפלות משורה אחת לריבוע 3 × 3: הצלע היא √9 = 3.' },
  { slug: 'square-roots-grade-9', section: '4', note: 'כמו square-root-grade-7.' },
  { slug: 'order-of-operations-signed-numbers-grade-7', section: '4', note: 'טקסט בלבד. עכשיו שלוש קבוצות של 4 אסימוני מינוס מתאחדות קודם ל־12, ורק אחר כך מצטרפים 2: 14 אסימוני מינוס.' },
  { slug: 'multiplying-signed-numbers-grade-7', section: '4', note: 'טקסט בלבד. עכשיו שלוש קפיצות של −2 מגיעות ל־−6, ואז מתהפכות סביב 0 אל 6.' },
  { slug: 'dividing-signed-numbers-grade-7', section: '4', note: 'טקסט בלבד. עכשיו ארבעה חלקים של −2 יוצאים מ־−8 (ארבעה, חיובי), ו־−8 מתחלק לשני חצאים של −4.' },
  { slug: 'geometric-proof-grade-8', section: '4', note: 'טקסט בלבד. עכשיו הקרן עולה, ו־β היא העתק של α שמתהפך לצדה: שתיהן יחד 180°, וסימן הזווית הישרה נכנס.' },
  { slug: 'transition-to-high-school-grade-9', section: '4', note: 'טקסט בלבד. עכשיו הפרבולה y = (x − 2)(x − 3) יורדת, ושני השורשים מחליקים מהקודקוד אל 2 ואל 3.' },
  { slug: 'fraction-division-algorithm-grade-6', section: '4', note: 'רק הספרות התחלפו. עכשיו שני רבעים עולים ונכנסים לחצי: ½ : ¼ = 2.' },
];
---
<ReviewGallery
  title="סקירת אנימציות: PR C, סעיפים 3 ו־4"
  intro="כל כרטיס מציג את דף הנושא לפני השינוי (הקוד שבאתר) ואחריו. הקישור פותח את הדף עצמו. כפתור העצירה מפעיל את מצב עצירת האנימציות של האתר."
  entries={entries}
/>
