7,"labelLine":{"page":2,"y":0.8507,"h":0.0357},"row":{"page":2,"x":0,"y":0.8507,"w":1,"h":0.1093},"rows":[{"page":2,"x":0,"y":0.8507,"w":1,"h":0.1093}],"stem":{"page":2,"x":0,"y":0.4234,"w":1,"h":0.0371}},{"id":"3א","q":3,"part":"א","page":3,"label":"שאלה 3 סעיף א","text":"קבעו מהי הקטגוריה השכיחה. מצאו את שיעורה וכתבו גם עשרוני וגם אחוז.","scrambled":true,"box":{"x":0.694,"y":0.4091,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.4201,"labelLine":{"page":3,"y":0.4201,"h":0.0357},"row":{"page":3,"x":0,"y":0.4201,"w":1,"h":0.0962},"rows":[{"page":3,"x":0,"y":0.4201,"w":1,"h":0.0962}],"stem":{"page":3,"x":0,"y":0.3831,"w":1,"h":0.037}},{"id":"3ב","q":3,"part":"ב","page":3,"label":"שאלה 3 סעיף ב","text":"חברו את שיעורי המסלול הקצר והארוך. הסבירו מדוע אפשר גם להשתמש במשלים.","scrambled":true,"box":{"x":0.694,"y":0.5052,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.5163,"labelLine":{"page":3,"y":0.5163,"h":0.0357},"row":{"page":3,"x":0,"y":0.5163,"w":1,"h":0.0847},"rows":[{"page":3,"x":0,"y":0.5163,"w":1,"h":0.0847}],"stem":{"page":3,"x":0,"y":0.3831,"w":1,"h":0.037}},{"id":"3ג","q":3,"part":"ג","page":3,"label":"שאלה 3 סעיף ג","text":"איזה מסלול או מסלולים עומדים בתנאי: לפחות רבע מהנשאלים בחרו בו? אילו עומדים בתנאי החזק יותר, גדול ממש מרבע? הסבירו את ההבדל בקצה.","scrambled":true,"box":{"x":0.694,"y":0.6014,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.601,"labelLine":{"page":3,"y":0.601,"h":0.0357},"row":{"page":3,"x":0,"y":0.601,"w":1,"h":0.1229},"rows":[{"page":3,"x":0,"y":0.601,"w":1,"h":0.1229}],"stem":{"page":3,"x":0,"y":0.3831,"w":1,"h":0.037}},{"id":"3ד","q":3,"part":"ד","page":3,"label":"שאלה 3 סעיף ד","text":"מישהו מוסיף לדוח קטגוריה רביעית בשם ״קצר או ארוך״ ואז מחבר את כל השיעורים. מדוע הסכום החדש אינו מבחן תקינות של חלוקה?","scrambled":true,"box":{"x":0.694,"y":0.7168,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.7239,"labelLine":{"page":3,"y":0.7239,"h":0.0357},"row":{"page":3,"x":0,"y":0.7239,"w":1,"h":0.1576},"rows":[{"page":3,"x":0,"y":0.7239,"w":1,"h":0.1576}],"stem":{"page":3,"x":0,"y":0.3831,"w":1,"h":0.037}},{"id":"4א","q":4,"part":"א","page":3,"label":"שאלה 4 סעיף א","text":"שחזרו את מספר משתתפי המוזיקה וכתבו את שיעורם כשבר מצומצם.","scrambled":true,"box":{"x":0.694,"y":0.8706,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.8815,"labelLine":{"page":3,"y":0.8815,"h":0.0357},"row":{"page":3,"x":0,"y":0.8815,"w":1,"h":0.0831},"rows":[{"page":3,"x":0,"y":0.8815,"w":1,"h":0.0831}],"stem":{"page":3,"x":0,"y":0.8446,"w":1,"h":0.0369}},{"id":"4ב","q":4,"part":"ב","page":4,"label":"שאלה 4 סעיף ב","text":"רכז טוען שצילום מהווה שליש מהקבוצה. אבחנו את הטעות ובדקו אם המספר שמצאתם מחייב שרוב הקבוצה במוזיקה.","scrambled":true,"box":{"x":0.694,"y":0.1599,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.171,"labelLine":{"page":4,"y":0.171,"h":0.0357},"row":{"page":4,"x":0,"y":0.171,"w":1,"h":0.2607},"rows":[{"page":4,"x":0,"y":0.171,"w":1,"h":0.2607}],"stem":{"page":3,"x":0,"y":0.8446,"w":1,"h":0.0369}},{"id":"4ג","q":4,"part":"ג","page":4,"label":"שאלה 4 סעיף ג","text":"שרטטו דיאגרמת עמודות של כל הסדנאות. בחרו קנה מידה מתאים, סמנו כותרות ובדקו שסכום הכמויות נשמר.","scrambled":true,"box":{"x":0.694,"y":0.4208,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.4317,"labelLine":{"page":4,"y":0.4317,"h":0.0357},"row":{"page":4,"x":0,"y":0.4317,"w":1,"h":0.261},"rows":[{"page":4,"x":0,"y":0.4317,"w":1,"h":0.261}],"stem":{"page":3,"x":0,"y":0.8446,"w":1,"h":0.0369}},{"id":"4ד","q":4,"part":"ד","page":4,"label":"שאלה 4 סעיף ד","text":"לקבוצה נוספת יש אותו שיעור בוחרי צילום, אך רק $28$ משתתפים. האם אפשר שמספר בוחרי הצילום בה יהיה שלם? נמקו.","scrambled":true,"box":{"x":0.694,"y":0.6817,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.6927,"labelLine":{"page":4,"y":0.6927,"h":0.0357},"row":{"page":4,"x":0,"y":0.6927,"w":1,"h":0.171},"rows":[{"page":4,"x":0,"y":0.6927,"w":1,"h":0.171}],"stem":{"page":3,"x":0,"y":0.8446,"w":1,"h":0.0369}},{"id":"5א","q":5,"part":"א","page":5,"label":"שאלה 5 סעיף א","text":"באיזה מוקד יותר קולות להצעה a? האם אותו מוקד גם מעניק