{"case":"catalog-7-26-a","grade":7,"topicId":26,"topic":"שכיחות יחסית חלק 1 — היכרות","level":"a","levelLabel":"רמה א׳","pdfId":"e585ae1140a64626b85a5ff1523077c1","pdfUrl":"https://static.wixstatic.com/ugd/d8e7ad_e585ae1140a64626b85a5ff1523077c1.pdf","title":"שכיחות יחסית חלק 1 — היכרות · רמה א׳","pageCount":20,"sourceSha256":"455b106bc9a93697a9f7ce177c1f3f71b4ccab9ecf7175acc73582fd1cb9600f","mode":"exercise","headerCrop":{"page":1,"x":0,"y":0,"w":1,"h":0.42},"footerCrop":{"page":20,"x":0,"y":0.945,"w":1,"h":0.055},"questions":[{"id":"1א","q":1,"part":"א","page":1,"label":"שאלה 1 סעיף א","text":"האם נכון שרוב הביקורים היו לשאילת מחבט? קראו את המספרים מן התרשים והכריעו.","scrambled":true,"box":{"x":0.694,"y":0.7091,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.7182,"labelLine":{"page":1,"y":0.7182,"h":0.0357},"row":{"page":1,"x":0,"y":0.7182,"w":1,"h":0.0787},"rows":[{"page":1,"x":0,"y":0.7182,"w":1,"h":0.0787}],"stem":{"page":1,"x":0,"y":0.6831,"w":1,"h":0.0351}},{"id":"1ב","q":1,"part":"ב","page":1,"label":"שאלה 1 סעיף ב","text":"איזה חלק מהביקורים היה לשאילת חבל? כתבו כשבר מצומצם וכאחוז. מצאו גם את מספר הביקורים לציוד שאינו חבל ואת חלקם כשבר מצומצם.","scrambled":true,"box":{"x":0.694,"y":0.786,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.7969,"labelLine":{"page":1,"y":0.7969,"h":0.0357},"row":{"page":1,"x":0,"y":0.7969,"w":1,"h":0.0924},"rows":[{"page":1,"x":0,"y":0.7969,"w":1,"h":0.0924}],"stem":{"page":1,"x":0,"y":0.6831,"w":1,"h":0.0351}},{"id":"1ג","q":1,"part":"ג","page":1,"label":"שאלה 1 סעיף ג","text":"למחרת הגיעו יותר מבקרים, אך שיעור שאילת החבלים נשמר. אם היו $60$ ביקורים, כמה מהם לחבלים? מצאו גם את מספר הביקורים לציוד אחר ואת שיעורם.","scrambled":true,"box":{"x":0.694,"y":0.8783,"w":0.16,"h":0.028},"line":0.0357,"inkTop":0.8893,"labelLine":{"page":1,"y":0.8893,"h":0.0357},"row":{"page":1,"x":0,"y":0.8893,"w":1,"h":0.083},"rows":[{"page":1,"x":0,"y":0.8893,"w":1,"h":0.083}],"stem":{"page":1,"x":0,"y":0.6831,"w":1,"h":0.0351}},{"id":"1ד","q":1,"part":"ד","p