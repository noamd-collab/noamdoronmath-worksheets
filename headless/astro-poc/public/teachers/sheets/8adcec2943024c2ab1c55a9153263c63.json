","scrambled":true,"box":{"x":0.694,"y":0.4011,"w":0.16,"h":0.028},"line":0.0424,"inkTop":0.4121,"labelLine":{"page":3,"y":0.4121,"h":0.0424},"row":{"page":3,"x":0,"y":0.4121,"w":1,"h":0.1698},"rows":[{"page":3,"x":0,"y":0.4121,"w":1,"h":0.1698}],"stem":{"page":3,"x":0,"y":0.1675,"w":1,"h":0.0371}},{"id":"5א","q":5,"part":"א","page":3,"label":"שאלה 5 סעיף א","text":"חשבו איזה חלק מן המכל מלא לאחר ההוספה, וצמצמו.","scrambled":true,"box":{"x":0.694,"y":0.5709,"w":0.16,"h":0.028},"line":0.0424,"inkTop":0.5819,"labelLine":{"page":3,"y":0.5819,"h":0.0424},"row":{"page":3,"x":0,"y":0.5819,"w":1,"h":0.074},"rows":[{"page":3,"x":0,"y":0.5819,"w":1,"h":0.074}],"stem":{"page":3,"x":0,"y":0.5449,"w":1,"h":0.037}},{"id":"5ב","q":5,"part":"ב","page":3,"label":"שאלה 5 סעיף ב","text":"נשארה להוספה כמות השווה ל־$\\f{1}{4}$ מנפח המכל. האם כולה תיכנס? חשבו את החסר או את העודף ביחס לנפח המכל.","scrambled":true,"box":{"x":0.694,"y":0.6652,"w":0.16,"h":0.028},"line":0.0424,"inkTop":0.6559,"labelLine":{"page":3,"y":0.6559,"h":0.0424},"row":{"page":3,"x":0,"y":0.6559,"w":1,"h":0.1713},"rows":[{"page":3,"x":0,"y":0.6559,"w":1,"h":0.1713}],"stem":{"page":3,"x":0,"y":0.5449,"w":1,"h":0.037}},{"id":"5ג","q":5,"part":"ג","page":3,"label":"שאלה 5 סעיף ג","text":"עורך חיבר מונים ומכנים וקיבל $\\f{8}{20}$. הסבירו כיצד אפשר לפסול תשובה זו גם בלי להשלים מחדש את החיבור.","scrambled":true,"box":{"x":0.694,"y":0.8162,"w":0.16,"h":0.028},"line":0.0424,"inkTop":0.8272,"labelLine":{"page":3,"y":0.8272,"h":0.0424},"row":{"page":3,"x":0,"y":0.8272,"w":1,"h":0.1328},"rows":[{"page":3,"x":0,"y":0.8272,"w":1,"h":0.1328}],"stem":{"page":3,"x":0,"y":0.5449,"w":1,"h":0.037}},{"id":"6א","q":6,"part":"א","page":4,"label":"שאלה 6 סעיף א","text":"פתרו את המשוואה תוך שמירת שקילות.","scrambled":true,"box":{"x":0.694,"y":0.0924,"w":0.16,"h":0.028},"line":0.0424,"inkTop":0.1033,"labelLine":{"page":4,"y":0.1033,"h":0.0424},"row":{"page":4,"x":0,"y":0.1033,"w":1,"h":0.1063},"rows":[{"page":4,"x":0,"y":0.1033,"w":1,"h":0.1