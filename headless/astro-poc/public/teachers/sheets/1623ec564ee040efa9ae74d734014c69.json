":1,"h":0.2052}},{"id":"2א","q":2,"part":"א","page":1,"label":"שאלה 2 סעיף א","text":"פתרו את המערכת בדרך של שחר. כתבו את שתי המשוואות אחרי הכפל ואת המשוואה שמתקבלת אחרי החיסור.","scrambled":true,"box":{"x":0.6914,"y":0.7995,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.8073,"labelLine":{"page":1,"y":0.8073,"h":0.0253},"row":{"page":1,"x":0,"y":0.8073,"w":1,"h":0.0825},"rows":[{"page":1,"x":0,"y":0.8073,"w":1,"h":0.0825}],"stem":{"page":1,"x":0,"y":0.6914,"w":1,"h":0.1159}},{"id":"2ב","q":2,"part":"ב","page":1,"label":"שאלה 2 סעיף ב","text":"פתרו את המערכת בדרך של יעל, באותו אופן.","scrambled":true,"box":{"x":0.6941,"y":0.8818,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.8898,"labelLine":{"page":1,"y":0.8898,"h":0.0253},"row":{"page":1,"x":0,"y":0.8898,"w":1,"h":0.0769},"rows":[{"page":1,"x":0,"y":0.8898,"w":1,"h":0.0769},{"page":2,"x":0,"y":0.0321,"w":1,"h":0.0282}],"stem":{"page":1,"x":0,"y":0.6914,"w":1,"h":0.1159}},{"id":"2ג","q":2,"part":"ג","page":2,"label":"שאלה 2 סעיף ג","text":"אילו שחר ויעל היו מקבלים זוגות שונים, איך הייתם מכריעים מי צודק בלי לפתור מחדש? הדגימו על הזוג שהתקבל בפועל.","scrambled":true,"box":{"x":0.6967,"y":0.0522,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.0603,"labelLine":{"page":2,"y":0.0603,"h":0.0253},"row":{"page":2,"x":0,"y":0.0603,"w":1,"h":0.0778},"rows":[{"page":2,"x":0,"y":0.0603,"w":1,"h":0.0778}],"stem":{"page":1,"x":0,"y":0.6914,"w":1,"h":0.1159}},{"id":"3א","q":3,"part":"א","page":2,"label":"שאלה 3 סעיף א","text":"$5x + 6y = 21$ ו־$7x + 4y = 25$","scrambled":true,"box":{"x":0.6914,"y":0.2099,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.2185,"labelLine":{"page":2,"y":0.2185,"h":0.0253},"row":{"page":2,"x":0,"y":0.2185,"w":1,"h":0.06},"rows":[{"page":2,"x":0,"y":0.2185,"w":1,"h":0.06}],"stem":{"page":2,"x":0,"y":0.1393,"w":1,"h":0.0792}},{"id":"3ב","q":3,"part":"ב","page":2,"label":"שאלה 3 סעיף ב","text":"$2x + 7y = 20$ ו־$8x + 3y = 30$","scrambled":true,"box":{"x":0.6941,"y":0.2699,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.2785,"labelLine":{"page":2,"y":0.2785,"h":0.0253},"row":{"page":2,"x":0,"y":0.2785,"w":1,"h":0.0647},"rows":[{"page":2,"x":0,"y":0.2785,"w":1,"h":0.0647}],"stem":{"page":2,"x":0,"y":0.1393,"w":1,"h":0.0792}},{"id":"3ג","q":3,"part":"ג","page":2,"label":"שאלה 3 סעיף ג","text":"$5x + 4y = 26$ ו־$4x + 5y = 19$","scrambled":true,"box":{"x":0.6967,"y":0.3347,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.3432,"labelLine":{"page":2,"y":0.3432,"h":0.0253},"row":{"page":2,"x":0,"y":0.3432,"w":1,"h":0.0642},"rows":[{"page":2,"x":0,"y":0.3432,"w":1,"h":0.0642}],"stem":{"page":2,"x":0,"y":0.1393,"w":1,"h":0.0792}},{"id":"3ד","q":3,"part":"ד","page":2,"label":"שאלה 3 סעיף ד","text":"ירון מבטל תמיד את $x$, בכל מערכת, בלי להשוות. באיזה סעיף ההחלטה הזאת מייקרת את החישוב יותר מכול, ומדוע?","scrambled":true,"box":{"x":0.6956,"y":0.3995,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.4074,"labelLine":{"page":2,"y":0.4074,"h":0.0253},"row":{"page":2,"x":0,"y":0.4074,"w":1,"h":0.0732},"rows":[{"page":2,"x":0,"y":0.4074,"w":1,"h":0.0732}],"stem":{"page":2,"x":0,"y":0.1393,"w":1,"h":0.0792}},{"id":"4א","q":4,"part":"א","page":2,"label":"שאלה 4 סעיף א","text":"בדקו את השורות של תמר אחת אחת, מצאו את השורה הראשונה שבה היא טעתה ותארו את הטעות.","scrambled":true,"box":{"x":0.6914,"y":0.7475,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.7553,"labelLine":{"page":2,"y":0.7553,"h":0.0253},"row":{"page":2,"x":0,"y":0.7553,"w":1,"h":0.0826},"rows":[{"page":2,"x":0,"y":0.7553,"w":1,"h":0.0826}],"stem":{"page":2,"x":0,"y":0.4818,"w":1,"h":0.2735}},{"id":"4ב","q":4,"part":"ב","page":2,"label":"שאלה 4 סעיף ב","text":"המשיכו מהשורה האחרונה הנכונה עד לפתרון המערכת.","scrambled":true,"box":{"x":0.6941,"y":0.8298,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.8379,"labelLine":{"page":2,"y":0.8379,"h":0.0253},"row":{"page":2,"x":0,"y":0.8379,"w":1,"h":0.1288},"rows":[{"page":2,"x":0,"y":0.8379,"w":1,"h":0.1288},{"page":3,"x":0,"y":0.0321,"w":1,"h":0.0282}],"stem":{"page":2,"x":0,"y":0.4818,"w":1,"h":0.2735}},{"id":"4ג","q":4,"part":"ג","page":3,"label":"שאלה 4 סעיף ג","text":"אורי פתר את אותה מערכת, ושורה 1 שלו זהה לזו של תמר. הוא כתב: שורה 2: $14x − 12y = 17$ (אחרי שהכפיל את $7x − 6y = 17$ ב־$2$) ; שורה 3: $29x = 128$ ; שורה 4: $x = 128 − 29$. לכל אחת משלוש השורות קבעו אם היא נכונה, ואם לא — תארו את הטעות.","scrambled":true,"box":{"x":0.6967,"y":0.0522,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.0603,"labelLine":{"page":3,"y":0.0603,"h":0.0253},"row":{"page":3,"x":0,"y":0.0603,"w":1,"h":0.0481},"rows":[{"page":3,"x":0,"y":0.0603,"w":1,"h":0.0481}],"stem":{"page":2,"x":0,"y":0.4818,"w":1,"h":0.2735}},{"id":"5א","q":5,"part":"א","page":3,"label":"שאלה 5 סעיף א","text":"בדקו אם הזוג של מאיה מקיים את שתי המשוואות.","scrambled":true,"box":{"x":0.6914,"y":0.2099,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.2179,"labelLine":{"page":3,"y":0.2179,"h":0.0253},"row":{"page":3,"x":0,"y":0.2179,"w":1,"h":0.0505},"rows":[{"page":3,"x":0,"y":0.2179,"w":1,"h":0.0505}],"stem":{"page":3,"x":0,"y":0.1616,"w":1,"h":0.0563}},{"id":"5ב","q":5,"part":"ב","page":3,"label":"שאלה 5 סעיף ב","text":"מי צודקת, מאיה או נועה? נמקו בעזרת ההגדרה של פתרון.","scrambled":true,"box":{"x":0.6941,"y":0.2604,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.2684,"labelLine":{"page":3,"y":0.2684,"h":0.0253},"row":{"page":3,"x":0,"y":0.2684,"w":1,"h":0.06},"rows":[{"page":3,"x":0,"y":0.2684,"w":1,"h":0.06}],"stem":{"page":3,"x":0,"y":0.1616,"w":1,"h":0.0563}},{"id":"5ג","q":5,"part":"ג","page":3,"label":"שאלה 5 סעיף ג","text":"נועה שואלת אם אולי יש למערכת עוד פתרון. פתרו את המערכת בביטול והסבירו מדוע הזוג של מאיה הוא הפתרון היחיד.","scrambled":true,"box":{"x":0.6967,"y":0.3204,"w":0.16,"h":0.028},"line":0.0253,"inkTop":0.3284,"labelLine":{"page":3,"y":0.3284,"h":0.0253},"row":{"page":3,"x":0,"y":0.3284,"w":1,"h":0.0779},"rows":[{"page":3,"x":0,"y":0.3284,"w":1,"h":0.0779}],"stem":{"page":3,"x":0,"y":0.1616,"w":1,"h":0.0563}},{"id":"6א","q":6,"part":"א","page":3,"label":"שאלה 6 סעיף א","text":"בדקו את הזוג של דנה בשתי המ