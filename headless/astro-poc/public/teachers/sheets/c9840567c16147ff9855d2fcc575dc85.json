.","scrambled":true,"box":{"x":0.6956,"y":0.6852,"w":0.16,"h":0.028},"line":0.0419,"inkTop":0.6933,"labelLine":{"page":1,"y":0.6933,"h":0.0419},"row":{"page":1,"x":0,"y":0.6933,"w":1,"h":0.2734},"rows":[{"page":1,"x":0,"y":0.6933,"w":1,"h":0.2734}]},{"id":"2א","q":2,"part":"א","page":2,"label":"שאלה 2 סעיף א","text":"בחרו שיפוע תקף ל־$g$ וחשבו את הקבוע הדרוש. הסבירו מדוע המפגש יחיד.","scrambled":true,"box":{"x":0.6914,"y":0.1216,"w":0.16,"h":0.028},"line":0.0419,"inkTop":0.0579,"labelLine":{"page":2,"y":0.0579,"h":0.0419},"row":{"page":2,"x":0,"y":0.0579,"w":1,"h":0.2613},"rows":[{"page":2,"x":0,"y":0.0579,"w":1,"h":0.2613}]},{"id":"2ב","q":2,"part":"ב","page":2,"label":"שאלה 2 סעיף ב","text":"כתבו תנאי כללי על $a,b$ השומר את כל דרישות ההזמנה.","scrambled":true,"box":{"x":0.6941,"y":0.3119,"w":0.16,"h":0.028},"line":0.0419,"inkTop":0.3192,"labelLine":{"page":2,"y":0.3192,"h":0.0419},"row":{"page":2,"x":0,"y":0.3192,"w":1,"h":0.0882},"rows":[{"page":2,"x":0,"y":0.3192,"w":1,"h":0.0882}]},{"id":"2ג","q":2,"part":"ג","page":2,"label":"שאלה 2 סעיף ג","text":"בכל בחירה תקפה, באיזה צד של המפגש $f$ גבוה יותר? הוכיחו מן ההפרש.","scrambled":true,"box":{"x":0.6967,"y":0.4005,"w":0.16,"h":0.028},"line":0.0419,"inkTop":0.4074,"labelLine":{"page":2,"y":0.4074,"h":0.0419},"row":{"page":2,"x":0,"y":0.4074,"w":1,"h":0.0896},"rows":[{"page":2,"x":0,"y":0.4074,"w":1,"h":0.0896}]},{"id":"2ד","q":2,"part":"ד","page":2,"label":"שאלה 2 סעיף ד","text":"האם אפשר לשמור אותו מפגש יחיד ולבחור $a=3$? נמקו גם במקרה של קבוע מתאים וגם בקבוע אחר.","scrambled":true,"box":{"x":0.6956,"y":0.489,"w":0.16,"h":0.028},"line":0.0419,"inkTop":0.497,"labelLine":{"page":2,"y":0.497,"h":0.0419},"row":{"page":2,"x":0,"y":0.497,"w":1,"h":0.0497},"rows":[{"page":2,"x":0,"y":0.497,"w":1,"h":0.0497}]},{"id":"3א","q":3,"part":"א","page":2,"label":"שאלה 3 סעיף א","text":"קראו את המפגש ואת סדר הענפים בתחום הנתון.","scrambled":true,"box":{"x":0.6914,"y":0.6704,"w":0.16,"h":0.028},"line":0.0419,"inkTop":0.6078,"labelLi