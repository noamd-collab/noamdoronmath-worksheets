        {
          "label": "ב",
          "text": "חשבו את שטח הפנים של הגליל.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q10_head.svg",
            "sha256": "1c9596e2d33a4f85ba6e197589bde58b06b0d4661afb945c79cfcf6512f309ee"
