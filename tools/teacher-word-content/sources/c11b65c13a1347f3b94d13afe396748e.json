  "questions": {
    "1": {
      "id": "c11b65c13a1347f3b94d13afe396748e:1",
      "q": 1,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "לפניכם כרטיס מידות של גליל סגור. הפרידו בין אורכים לשטחים.",
      "table": {
        "head": [
          "גודל",
          "נתון"
        ],
        "rows": [
          [
            "רדיוס",
            "2 ס״מ"
          ],
          [
            "גובה",
            "4 ס״מ"
          ]
        ]
      },
      "example": {
        "title": "דוגמה נפרדת",
        "lines": [
          "דוגמה נפרדת: גליל ברדיוס $1$ ס״מ ובגובה $3$ ס״מ. היקף הבסיס $6$ ס״מ, שטח בסיס $3$ סמ״ר, מעטפת $18$ סמ״ר ושטח כולל $24$ סמ״ר. מחברים שטחים בלבד."
        ]
      },
      "items": [
        {
          "label": "א",
          "text": "חשבו את היקף הבסיס.",
          "answer": "$2·3·2=12$ ס״מ."
        },
        {
          "label": "ב",
          "text": "חשבו את שטח בסיס יחיד ואת שטח הבסיסים יחד.",
          "answer": "$12$ סמ״ר לבסיס; $24$ סמ״ר יחד."
        },
        {
          "label": "ג",
          "text": "חשבו את שטח המעטפת.",
          "answer": "$12·4=48$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "חשבו את שטח הפנים והסבירו אילו רכיבים חיברתם.",
          "answer": "$48+24=72$ סמ״ר; מעטפת ושני בסיסים."
        }
      ]
    },
    "2": {
      "id": "c11b65c13a1347f3b94d13afe396748e:2",
      "q": 2,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "רדיוס הגליל $3$ ס״מ וגובהו $7$ ס״מ. בכרטיס עבודה נכתב שהיקף הבסיס נמדד בסמ״ר.",
      "figure": {
        "url": "/noam-ai/native/G8-T52/b/figures/q2_head.svg",
        "sha256": "4c2b7ffceeb2a1edf24442e29649fb3ac5b026bc1d12f4a63c44eeebe4944997"
      },
      "items": [
        {
          "label": "א",
          "text": "תקנו את יחידת ההיקף וחשבו אותו.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q2_head.svg",
            "sha256": "4c2b7ffceeb2a1edf24442e29649fb3ac5b026bc1d12f4a63c44eeebe4944997"
          },
          "answer": "היחידה ס״מ; ההיקף $18$ ס״מ."
        },
        {
          "label": "ב",
          "text": "חשבו את שטח שני הבסיסים.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q2_head.svg",
            "sha256": "4c2b7ffceeb2a1edf24442e29649fb3ac5b026bc1d12f4a63c44eeebe4944997"
          },
          "answer": "$2·3·3 ^2=54$ סמ״ר."
        },
        {
          "label": "ג",
          "text": "חשבו את שטח הפנים הכולל.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q2_head.svg",
            "sha256": "4c2b7ffceeb2a1edf24442e29649fb3ac5b026bc1d12f4a63c44eeebe4944997"
          },
          "answer": "$18·7+54=180$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "מה נמדד בסמ״ק, והאם חישבתם אותו כאן?",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q2_head.svg",
            "sha256": "4c2b7ffceeb2a1edf24442e29649fb3ac5b026bc1d12f4a63c44eeebe4944997"
          },
          "answer": "נפח נמדד בסמ״ק; כאן חושב שטח ולא נפח."
        }
      ]
    },
    "3": {
      "id": "c11b65c13a1347f3b94d13afe396748e:3",
      "q": 3,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "המעגל הוא בסיס גליל. הקטע $OR$ הוא רדיוס באורך $5$ ס״מ. הגובה $2$ ס״מ.",
      "figure": {
        "url": "/noam-ai/native/G8-T52/b/figures/q3_head.svg",
        "sha256": "bf4ff3d0e3397947180d2fb1bf9b0d11be46e9573a938a02ff1557c07df4f15c"
      },
      "items": [
        {
          "label": "א",
          "text": "רשמו מה מתאים לאורך העטיפה: היקף הבסיס או שטחו. נמקו.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q3_head.svg",
            "sha256": "bf4ff3d0e3397947180d2fb1bf9b0d11be46e9573a938a02ff1557c07df4f15c"
          },
          "answer": "ההיקף, כי העטיפה נסגרת סביב שפת המעגל."
        },
        {
          "label": "ב",
          "text": "חשבו את שני הגדלים והבחינו ביחידות.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q3_head.svg",
            "sha256": "bf4ff3d0e3397947180d2fb1bf9b0d11be46e9573a938a02ff1557c07df4f15c"
          },
          "answer": "היקף $30$ ס״מ; שטח $75$ סמ״ר."
        },
        {
          "label": "ג",
          "text": "חשבו את שטח מלבן העטיפה.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q3_head.svg",
            "sha256": "bf4ff3d0e3397947180d2fb1bf9b0d11be46e9573a938a02ff1557c07df4f15c"
          },
          "answer": "$30·2=60$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "כמה שטח יתווסף למעטפת כדי לסגור את שני הקצוות?",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q3_head.svg",
            "sha256": "bf4ff3d0e3397947180d2fb1bf9b0d11be46e9573a938a02ff1557c07df4f15c"
          },
          "answer": "$2·75=150$ סמ״ר."
        },
        {
          "label": "ה",
          "text": "מצאו גם את קוטר הבסיס והסבירו את הקשר לרדיוס המסומן.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q3_head.svg",
            "sha256": "bf4ff3d0e3397947180d2fb1bf9b0d11be46e9573a938a02ff1557c07df4f15c"
          },
          "answer": "הקוטר $10$ ס״מ, והוא מורכב משני רדיוסים על קו ישר דרך המרכז."
        }
      ]
    },
    "4": {
      "id": "c11b65c13a1347f3b94d13afe396748e:4",
      "q": 4,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "בפריסה רדיוס כל מעגל הוא $2$ ס״מ, וגובה המלבן $3$ ס״מ. רוחבו מסומן $w$.",
      "figure": {
        "url": "/noam-ai/native/G8-T52/b/figures/q4_head.svg",
        "sha256": "f461f6740560b6af1d1a41bf702d3234e3579e53522933b1c6e8ca912794b0f6"
      },
      "items": [
        {
          "label": "א",
          "text": "רשמו אילו חלקים הופכים לבסיסים ואיזה חלק הופך למעטפת.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q4_head.svg",
            "sha256": "f461f6740560b6af1d1a41bf702d3234e3579e53522933b1c6e8ca912794b0f6"
          },
          "answer": "המעגלים הם בסיסים; המלבן הוא מעטפת."
        },
        {
          "label": "ב",
          "text": "חשבו את רוחב המלבן.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q4_head.svg",
            "sha256": "f461f6740560b6af1d1a41bf702d3234e3579e53522933b1c6e8ca912794b0f6"
          },
          "answer": "$w=2·3·2=12$ ס״מ."
        },
        {
          "label": "ג",
          "text": "חשבו את שטח המלבן ואת השטח של שני המעגלים.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q4_head.svg",
            "sha256": "f461f6740560b6af1d1a41bf702d3234e3579e53522933b1c6e8ca912794b0f6"
          },
          "answer": "שטח המלבן $12·3=36$ סמ״ר; שטח שני המעגלים $2·3·2 ^2=24$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "חשבו את שטח הפריסה והסבירו מדוע אין לחבר כאן את היקפי המעגלים.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q4_head.svg",
            "sha256": "f461f6740560b6af1d1a41bf702d3234e3579e53522933b1c6e8ca912794b0f6"
          },
          "answer": "$60$ סמ״ר. נדרש סכום שטחים; היקפים הם אורכים."
        }
      ]
    },
    "5": {
      "id": "c11b65c13a1347f3b94d13afe396748e:5",
      "q": 5,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "שרטטו גליל סגור ברדיוס $4$ ס״מ ובגובה $5$ ס״מ ופריסה מתאימה. שטח פנוי לציור בתחתית השאלה.",
      "items": [
        {
          "label": "א",
          "text": "חשבו את אורך העטיפה.",
          "answer": "$24$ ס״מ."
        },
        {
          "label": "ב",
          "text": "חשבו את שטח המעטפת.",
          "answer": "$24·5=120$ סמ״ר."
        },
        {
          "label": "ג",
          "text": "חשבו את שטח הפנים הכולל.",
          "answer": "$120+2·3·4 ^2=216$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "השלימו שרטוט ובו כל חלק מופיע פעם אחת. הסבירו מה מתקפל סביב הבסיס.",
          "answer": "מלבן $24$ על $5$ ושני מעגלים רדיוס $4$. המלבן נגלל סביב שפת הבסיס."
        }
      ]
    },
    "6": {
      "id": "c11b65c13a1347f3b94d13afe396748e:6",
      "q": 6,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "השלימו טבלת רכיבים. כל המידות בס״מ; כל שטח בסמ״ר.",
      "table": {
        "head": [
          "רדיוס",
          "גובה",
          "היקף",
          "בסיס",
          "מעטפת",
          "כולל"
        ],
        "rows": [
          [
            "1",
            "4",
            "?",
            "?",
            "?",
            "?"
          ],
          [
            "2",
            "3",
            "?",
            "?",
            "?",
            "?"
          ]
        ]
      },
      "items": [
        {
          "label": "א",
          "text": "השלימו את עמודת היקף הבסיס בשתי השורות.",
          "answer": "שורה ראשונה (רדיוס $1$): $6$ ס״מ; שורה שנייה (רדיוס $2$): $12$ ס״מ."
        },
        {
          "label": "ב",
          "text": "השלימו את עמודת שטח בסיס יחיד.",
          "answer": "שורה ראשונה: $3$ סמ״ר; שורה שנייה: $12$ סמ״ר."
        },
        {
          "label": "ג",
          "text": "השלימו את עמודת שטח המעטפת.",
          "answer": "שורה ראשונה: $24$ סמ״ר; שורה שנייה: $36$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "השלימו את השטח הכולל והסבירו את פעולת החיבור.",
          "answer": "שורה ראשונה: $24+2·3=30$ סמ״ר; שורה שנייה: $36+2·12=60$ סמ״ר. החיבור: מעטפת ועוד שני בסיסים."
        }
      ]
    },
    "7": {
      "id": "c11b65c13a1347f3b94d13afe396748e:7",
      "q": 7,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "המלבן הוא מעטפת גליל לאחר פתיחה. אורכו $24$ ס״מ וגובהו $3$ ס״מ. תלמיד קורא לאורך המלבן רדיוס.",
      "figure": {
        "url": "/noam-ai/native/G8-T52/b/figures/q7_head.svg",
        "sha256": "9da14f85823bb29dc978be1b12bb891ffdefac932074e5c4eec648b141e0a667"
      },
      "items": [
        {
          "label": "א",
          "text": "הסבירו מה מייצג האורך באמת.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q7_head.svg",
            "sha256": "9da14f85823bb29dc978be1b12bb891ffdefac932074e5c4eec648b141e0a667"
          },
          "answer": "זהו היקף הבסיס, ולא רדיוסו."
        },
        {
          "label": "ב",
          "text": "מצאו את הרדיוס.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q7_head.svg",
            "sha256": "9da14f85823bb29dc978be1b12bb891ffdefac932074e5c4eec648b141e0a667"
          },
          "answer": "$6r=24$, לכן $r=4$ ס״מ."
        },
        {
          "label": "ג",
          "text": "חשבו את שטח בסיס יחיד.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q7_head.svg",
            "sha256": "9da14f85823bb29dc978be1b12bb891ffdefac932074e5c4eec648b141e0a667"
          },
          "answer": "$3·4 ^2=48$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "חשבו את שטח הגליל הסגור באמצעות המלבן והבסיסים.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q7_head.svg",
            "sha256": "9da14f85823bb29dc978be1b12bb891ffdefac932074e5c4eec648b141e0a667"
          },
          "answer": "$24·3+2·48=168$ סמ״ר."
        }
      ]
    },
    "8": {
      "id": "c11b65c13a1347f3b94d13afe396748e:8",
      "q": 8,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "רדיוס הגליל הסגור $2$ ס״מ וגובהו $8$ ס״מ. בהזמנה שכחו את הבסיס התחתון.",
      "figure": {
        "url": "/noam-ai/native/G8-T52/b/figures/q8_head.svg",
        "sha256": "71e9a618b993044de0a5c0509f6eb66381b988a9dd089b405f8ad4fb03e80ba2"
      },
      "items": [
        {
          "label": "א",
          "text": "חשבו את שטח הבסיס שנשכח.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q8_head.svg",
            "sha256": "71e9a618b993044de0a5c0509f6eb66381b988a9dd089b405f8ad4fb03e80ba2"
          },
          "answer": "$3·2 ^2=12$ סמ״ר."
        },
        {
          "label": "ב",
          "text": "חשבו את שטח המעטפת.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q8_head.svg",
            "sha256": "71e9a618b993044de0a5c0509f6eb66381b988a9dd089b405f8ad4fb03e80ba2"
          },
          "answer": "$2·3·2·8=96$ סמ״ר."
        },
        {
          "label": "ג",
          "text": "כמה שטח נרשם בטעות וכמה נדרש באמת?",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q8_head.svg",
            "sha256": "71e9a618b993044de0a5c0509f6eb66381b988a9dd089b405f8ad4fb03e80ba2"
          },
          "answer": "נרשמו (מעטפת ובסיס עליון) $96+12=108$ סמ״ר; נדרשים $96+2·12=120$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "האם בסיס נסתר בשרטוט מפסיק להיות חלק מהשטח? נמקו.",
          "figure": {
            "url": "/noam-ai/native/G8-T52/b/figures/q8_head.svg",
            "sha256": "71e9a618b993044de0a5c0509f6eb66381b988a9dd089b405f8ad4fb03e80ba2"
          },
          "answer": "לא; בסיס נסתר עדיין משטח של הגליל הסגור, ולכן נכלל בשטח הפנים."
        }
      ]
    },
    "9": {
      "id": "c11b65c13a1347f3b94d13afe396748e:9",
      "q": 9,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "קוטר גליל סגור הוא $8$ ס״מ וגובהו $2$ ס״מ. הכינו שרטוט מסומן ופריסה. שטח פנוי לציור בתחתית השאלה.",
      "items": [
        {
          "label": "א",
          "text": "מצאו את הרדיוס.",
          "answer": "$4$ ס״מ."
        },
        {
          "label": "ב",
          "text": "חשבו את שטח המעטפת.",
          "answer": "$2·3·4·2=48$ סמ״ר."
        },
        {
          "label": "ג",
          "text": "חשבו את שטח הפנים.",
          "answer": "$48+2·3·4 ^2=144$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "ציירו קטע רדיוס וקטע קוטר והבחינו ביניהם. ציירו פריסה וסמנו בה מידות מתאימות.",
          "answer": "קוטר עובר דרך המרכז בין קצות המעגל; רדיוס מהמרכז לשפה. המלבן $24$ על $2$ והמעגלים רדיוס $4$."
        }
      ]
    },
    "10": {
      "id": "c11b65c13a1347f3b94d13afe396748e:10",
      "q": 10,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "$AB$ הוא קוטר בסיס באורך $6$ ס״מ. גובה הגליל הסגור $5$ ס״מ.",
      "figure": {
        "url": "/noam-ai/native/G8-T52/b/figures/q10_head.svg",
        "sha256": "1c9596e2d33a4f85ba6e197589bde58b06b0d4661afb945c79cfcf6512f309ee"
      },
      "items": [
        {
          "label": "א",
          "text": "חשבו את היקף הבסיס ואת שטחו.",
