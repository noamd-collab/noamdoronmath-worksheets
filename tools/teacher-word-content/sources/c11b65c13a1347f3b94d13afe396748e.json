    },
    "11": {
      "id": "c11b65c13a1347f3b94d13afe396748e:11",
      "q": 11,
      "grade": 8,
      "topic": "גליל — שטח פנים",
      "levelLabel": "רמה ב׳",
      "text": "רדיוס כל בסיס בפריסה $4$ ס״מ, וגובה המלבן $2$ ס״מ. בדקו כרטיס שאינו מבחין בין היקף לשטח.",
