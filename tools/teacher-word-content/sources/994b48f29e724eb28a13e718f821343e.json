      ]
    },
    "17": {
      "id": "994b48f29e724eb28a13e718f821343e:17",
      "q": 17,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "פשטו כל ביטוי, ואז בדקו את הקשר בין התוצאות.",
