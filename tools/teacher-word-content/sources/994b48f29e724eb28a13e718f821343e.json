        }
      ]
    },
    "19": {
      "id": "994b48f29e724eb28a13e718f821343e:19",
      "q": 19,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "מכונת חישוב מקבלת $x$, מוסיפה לו $14$, ובנפרד מחסרת ממנו $14$. היא מכפילה את התוצאות.",
      "items": [
