  "questions": {
    "1": {
      "id": "994b48f29e724eb28a13e718f821343e:1",
      "q": 1,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "תחילה דוגמה: $(x+6)(x+11)=x^2+11x+6x+66=x^2+17x+66$. כעת עבדו במכפלה $(x+8)(x+13)$.",
      "items": [
        {
          "label": "א",
          "text": "כתבו את שתי המכפלות המעורבות.",
          "answer": "$13x; 8x$"
        },
        {
          "label": "ב",
          "text": "כתבו את מכפלת הקבועים.",
          "answer": "$104$"
        },
        {
          "label": "ג",
          "text": "כנסו את כל המכפלות לביטוי אחד.",
          "answer": "$x^2+21x+104$"
        },
        {
          "label": "ד",
          "text": "הסבירו מדוע אין די בחיבור ריבוע המשתנה ומכפלת הקבועים.",
          "answer": "חסרות שתי המכפלות המעורבות — גם $x$ מוכפל בקבוע וגם הקבוע מוכפל ב־$x$"
        }
      ]
    },
    "2": {
      "id": "994b48f29e724eb28a13e718f821343e:2",
      "q": 2,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "בוחרים דרך לבדוק סימנים בלי להתחיל בכל פעם מחדש.",
      "items": [
        {
          "label": "א",
          "text": "במכפלה $(x−7)(x+11)$, האם האיבר החופשי חיובי או שלילי? נמקו לפני הפילוג.",
          "answer": "שלילי — הוא מכפלת קבוע שלילי בקבוע חיובי"
        },
        {
          "label": "ב",
          "text": "פשטו את המכפלה ובדקו את תחזיתכם.",
          "answer": "$x^2 + 4x − 77$"
        },
        {
          "label": "ג",
          "text": "מחליפים את שני סימני הקבועים ומקבלים $(x+7)(x−11)$. מה נשמר ומה משתנה בפולינום?",
          "answer": "$x^2−4x−77$ — הריבוע והאיבר החופשי נשמרים $;$ האיבר הלינארי מחליף סימן"
        },
        {
          "label": "ד",
          "text": "במכפלה $(3y−2)(y+6)$ נתון שהאיבר המוביל הוא $3y^2$. מצאו רק את שני האיברים הנותרים.",
          "answer": "$16y−12$ — מכנסים $18y−2y$ ומכפילים מינוס $2$ ב־$6$"
        }
      ]
    },
    "3": {
      "id": "994b48f29e724eb28a13e718f821343e:3",
      "q": 3,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "על לוח משחק מצויר מלבן מחולק. כל המספרים מציינים אורכים בס״מ. נתוני הקטעים: בצלע העליונה, משמאל לימין, $5$, $4$; בצלע השמאלית, מלמעלה למטה, $3$, $2$.",
      "figure": {
        "url": "/noam-ai/native/G9-T02/b/figures/q3_head.svg",
        "sha256": "79536615f92c17d58384d0d05121504eb6efafbcf016d7ddca9ed6c6995e9c42"
      },
      "items": [
        {
          "label": "א",
          "text": "חשבו את שטח התא השמאלי העליון.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q3_head.svg",
            "sha256": "79536615f92c17d58384d0d05121504eb6efafbcf016d7ddca9ed6c6995e9c42"
          },
          "answer": "$15$ סמ״ר"
        },
        {
          "label": "ב",
          "text": "חשבו את שטח התא הימני התחתון.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q3_head.svg",
            "sha256": "79536615f92c17d58384d0d05121504eb6efafbcf016d7ddca9ed6c6995e9c42"
          },
          "answer": "$8$ סמ״ר"
        },
        {
          "label": "ג",
          "text": "כתבו חיבור של כל ארבעת שטחי התאים וחשבו את השטח הכולל.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q3_head.svg",
            "sha256": "79536615f92c17d58384d0d05121504eb6efafbcf016d7ddca9ed6c6995e9c42"
          },
          "answer": "$45$ סמ״ר — סכום ארבעת התאים הוא $15+12+10+8=45$"
        },
        {
          "label": "ד",
          "text": "בדקו את התוצאה במכפלת האורך הכולל ברוחב הכולל.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q3_head.svg",
            "sha256": "79536615f92c17d58384d0d05121504eb6efafbcf016d7ddca9ed6c6995e9c42"
          },
          "answer": "$45$ סמ״ר — האורך $9$ והרוחב $5$"
        }
      ]
    },
    "4": {
      "id": "994b48f29e724eb28a13e718f821343e:4",
      "q": 4,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "הנתונים בטבלה הם כותרות של טבלת כפל. התאים ריקים להשלמה.",
      "table": {
        "head": [
          "×",
          "$x$",
          "$−2$"
        ],
        "rows": [
          [
            "$2x$",
            "?",
            "?"
          ],
          [
            "$3$",
            "?",
            "?"
          ]
        ]
      },
      "items": [
        {
          "label": "א",
          "text": "השלימו את התא שבשורה $2x$ ובעמודה $x$.",
          "answer": "$2x^2$"
        },
        {
          "label": "ב",
          "text": "השלימו את התא שבשורה $2x$ ובעמודה $−2$.",
          "answer": "$−4x$"
        },
        {
          "label": "ג",
          "text": "השלימו את שני התאים בשורה $3$.",
          "answer": "$3x; −6$"
        },
        {
          "label": "ד",
          "text": "מהו הביטוי המתקבל מחיבור כל התאים?",
          "answer": "$2x^2−x−6$ — מכנסים את $−4x$ ו־$3x$ ל־$−x$"
        },
        {
          "label": "ה",
          "text": "בנו טבלת כפל חדשה עבור $(3x+7)(x−8)$: בחרו כותרות, השלימו את כל התאים וכנסו.",
          "answer": "$3x^2−17x−56$ — למשל כותרות $3x,7$ מול $x,−8$ והמכפלות $3x^2,−24x,7x,−56$ — גם החלפת שורות ועמודות מתאימה ונותנת אותה תוצאה"
        }
      ]
    },
    "5": {
      "id": "994b48f29e724eb28a13e718f821343e:5",
      "q": 5,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "יש שתי דרכים לכתוב ריבוע: $(x+13)^2$ או $(x+13)(x+13)$.",
      "items": [
        {
          "label": "א",
          "text": "מדוע שני הביטויים שווים?",
          "answer": "ריבוע הוא כפל הביטוי בעצמו"
        },
        {
          "label": "ב",
          "text": "פשטו $(x+13)^2$",
          "answer": "$x^2 + 26x + 169$"
        },
        {
          "label": "ג",
          "text": "פשטו $(3x−8)^2$",
          "answer": "$9x^2 − 48x + 64$"
        },
        {
          "label": "ד",
          "text": "הסבירו מדוע האיבר החופשי חיובי גם בביטוי שבסעיף ג׳.",
          "answer": "מינוס כפול מינוס הוא פלוס — הקבוע השלילי מוכפל בעצמו"
        }
      ]
    },
    "6": {
      "id": "994b48f29e724eb28a13e718f821343e:6",
      "q": 6,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "בכל מכפלה יש שני גורמים צמודים.",
      "items": [
        {
          "label": "א",
          "text": "פשטו $(3x+11)(3x−11)$",
          "answer": "$9x^2 − 121$"
        },
        {
          "label": "ב",
          "text": "פשטו $(2x+3)(2x−3)$",
          "answer": "$4x^2 − 9$"
        },
        {
          "label": "ג",
          "text": "חשבו $18·22$ בעזרת גורמים צמודים.",
          "answer": "$396$ — $(20)^2−(2)^2$"
        },
        {
          "label": "ד",
          "text": "אילו איברים מתבטלים בפתיחת הביטוי הראשון?",
          "answer": "$33x$ ו־$−33x$ — אלה איברים נגדיים"
        }
      ]
    },
    "7": {
      "id": "994b48f29e724eb28a13e718f821343e:7",
      "q": 7,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "מודל השטח מציג מלבן המחולק לארבעה חלקים. נתון $v>0$ והמידות בס״מ. נתוני הקטעים: בצלע העליונה, משמאל לימין, $v$, $2$; בצלע השמאלית, מלמעלה למטה, $v$, $5$.",
      "figure": {
        "url": "/noam-ai/native/G9-T02/b/figures/q7_head.svg",
        "sha256": "836ec3dfa3d2dc9fc490349a671dc1294adca7c4698d69ef8bd16d886809d546"
      },
      "items": [
        {
          "label": "א",
          "text": "כתבו את סכום אורכי הקטעים לאורך הצלע העליונה.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q7_head.svg",
            "sha256": "836ec3dfa3d2dc9fc490349a671dc1294adca7c4698d69ef8bd16d886809d546"
          },
          "answer": "$v+2$ ס״מ"
        },
        {
          "label": "ב",
          "text": "כתבו מכפלה המבטאת את שטח המלבן כולו.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q7_head.svg",
            "sha256": "836ec3dfa3d2dc9fc490349a671dc1294adca7c4698d69ef8bd16d886809d546"
          },
          "answer": "$(v+2)(v+5)$ סמ״ר"
        },
        {
          "label": "ג",
          "text": "רשמו את ארבעת שטחי התאים וחשבו את סכומם.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q7_head.svg",
            "sha256": "836ec3dfa3d2dc9fc490349a671dc1294adca7c4698d69ef8bd16d886809d546"
          },
          "answer": "$v^2; 2v; 5v; 10$ — והסכום $v^2+7v+10$ סמ״ר"
        },
        {
          "label": "ד",
          "text": "מדוע חיבור שטחי התאים הוא בדיקה של פתיחת הסוגריים?",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q7_head.svg",
            "sha256": "836ec3dfa3d2dc9fc490349a671dc1294adca7c4698d69ef8bd16d886809d546"
          },
          "answer": "התאים מכסים בדיוק את המלבן — אין חפיפה ואין חלק חסר"
        }
      ]
    },
    "8": {
      "id": "994b48f29e724eb28a13e718f821343e:8",
      "q": 8,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "לפני הפישוט סמנו לעצמכם אילו מכפלות מחוברים ואילו מחוסרים.",
      "items": [
        {
          "label": "א",
          "text": "פשטו $(x+2)(x+6)−x(x+8)$",
          "answer": "$12$"
        },
        {
          "label": "ב",
          "text": "פשטו $(x−3)(x+1)+2x$",
          "answer": "$x^2 − 3$"
        },
        {
          "label": "ג",
          "text": "בביטוי הראשון, האם התוצאה תלויה ב־$x$? נמקו.",
          "answer": "לא $;$ היא $12$ — כל האיברים הכוללים $x$ מתבטלים"
        },
        {
          "label": "ד",
          "text": "מצאו את ערך הביטוי השני כאשר $x=3$.",
          "answer": "$6$ — מציבים בביטוי המצומצם $x^2−3$"
        }
      ]
    },
    "9": {
      "id": "994b48f29e724eb28a13e718f821343e:9",
      "q": 9,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "לדוגמה: $4(x+3)(x+7)=(4x+12)(x+7)$. מכניסים את הגורם החיצוני לאחד הגורמים בלבד.",
      "items": [
        {
          "label": "א",
          "text": "פשטו $3(x+8)(x+2)$",
          "answer": "$3x^2 + 30x + 48$"
        },
        {
          "label": "ב",
          "text": "פשטו $x(x−1)(x+2)$",
          "answer": "$x^3 + x^2 − 2x$"
        },
        {
          "label": "ג",
          "text": "תקנו: $2(x+4)(x−1)=(2x+8)(2x−2)$.",
          "answer": "$2(x+4)(x−1)=(2x+8)(x−1)$ — בפתרון השגוי הוכנסה ההכפלה ב־$2$ פעמיים — גם $(x+4)(2x−2)$ מתאים"
        },
        {
          "label": "ד",
          "text": "כתבו את הביטוי שבסעיף א׳ כמכפלה שבה $3$ הוכנס דווקא לגורם השני.",
          "answer": "$(x+8)(3x+6)$"
        }
      ]
    },
    "10": {
      "id": "994b48f29e724eb28a13e718f821343e:10",
      "q": 10,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "מחפשים שני שלמים חיוביים שסכומם $13$ ומכפלתם $36$.",
      "items": [
        {
          "label": "א",
          "text": "רשמו את זוגות הגורמים החיוביים של $36$, בלי לחזור על סדר הפוך.",
          "answer": "$(1,36); (2,18); (3,12); (4,9); (6,6)$"
        },
        {
          "label": "ב",
          "text": "בחרו את הזוג שסכומו מתאים.",
          "answer": "$4$ ו־$9$"
        },
        {
          "label": "ג",
          "text": "השלימו: $x^2+13x+36=(x+___)(x+___)$.",
          "answer": "$4$ ו־$9$"
        },
        {
          "label": "ד",
          "text": "בדקו את הפירוק בפילוג.",
          "answer": "$x^2+9x+4x+36=x^2+13x+36$"
        }
      ]
    },
    "11": {
      "id": "994b48f29e724eb28a13e718f821343e:11",
      "q": 11,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "המלבן בשרטוט נתון במידות בס״מ, ו־$x>0$. נתוני הקטעים: בצלע העליונה, משמאל לימין, $x+1$; בצלע השמאלית, מלמעלה למטה, $x+6$.",
      "figure": {
        "url": "/noam-ai/native/G9-T02/b/figures/q11_head.svg",
        "sha256": "69cb34b4f7c9eaefabb6596c95ffc6782f81a78de0583d1d9213f9ab4f5eb59d"
      },
      "items": [
        {
          "label": "א",
          "text": "כתבו ביטוי לשטח.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q11_head.svg",
            "sha256": "69cb34b4f7c9eaefabb6596c95ffc6782f81a78de0583d1d9213f9ab4f5eb59d"
          },
          "answer": "$(x+1)(x+6)$ סמ״ר"
        },
        {
          "label": "ב",
          "text": "כתבו את השטח בלי סוגריים.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q11_head.svg",
            "sha256": "69cb34b4f7c9eaefabb6596c95ffc6782f81a78de0583d1d9213f9ab4f5eb59d"
          },
          "answer": "$x^2+7x+6$ סמ״ר"
        },
        {
          "label": "ג",
          "text": "כתבו ביטוי להיקף.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q11_head.svg",
            "sha256": "69cb34b4f7c9eaefabb6596c95ffc6782f81a78de0583d1d9213f9ab4f5eb59d"
          },
          "answer": "$4x+14$ ס״מ"
        },
        {
          "label": "ד",
          "text": "חשבו שטח והיקף כאשר $x=2$.",
          "figure": {
            "url": "/noam-ai/native/G9-T02/b/figures/q11_head.svg",
            "sha256": "69cb34b4f7c9eaefabb6596c95ffc6782f81a78de0583d1d9213f9ab4f5eb59d"
          },
          "answer": "שטח $24$ סמ״ר והיקף $22$ ס״מ — צלעות המלבן הן $3$ ו־$8$"
        }
      ]
    },
    "12": {
      "id": "994b48f29e724eb28a13e718f821343e:12",
      "q": 12,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "החליטו בכל פעם אם השוויון נכון לכל $x$. נמקו או תקנו.",
      "items": [
        {
          "label": "א",
          "text": "$(x+1)(x−1)=x^2−1$",
          "answer": "נכון — המכפלות המעורבות מתבטלות"
        },
        {
          "label": "ב",
          "text": "$(x+14)^2=x^2+196$",
          "answer": "לא — $x^2+28x+196$ כי חסר האיבר המעורב"
        },
        {
          "label": "ג",
          "text": "$(x−2)(x−4)=x^2−6x+8$",
          "answer": "נכון — $x^2−4x−2x+8=x^2−6x+8$"
        },
        {
          "label": "ד",
          "text": "אם שוויון נכון בהצבה $x=0$, האם הוא נכון בהכרח לכל $x$?",
          "answer": "לא — למשל $x=x^2$ נכון באפס אך לא בהצבת $2$"
        }
      ]
    },
    "13": {
      "id": "994b48f29e724eb28a13e718f821343e:13",
      "q": 13,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "פתחו סוגריים והעבירו איברים דומים כדי לפתור.",
      "items": [
        {
          "label": "א",
          "text": "פתרו $(x+3)(x−1)=x^2+9$.",
          "answer": "$x=6$"
        },
        {
          "label": "ב",
          "text": "פתרו $(x−4)(x+2)=x^2−18$.",
          "answer": "$x=5$"
        },
        {
          "label": "ג",
          "text": "בדקו את הפתרון של המשוואה הראשונה.",
          "answer": "$45=45$ — מציבים $x=6$ בשני האגפים"
        },
        {
          "label": "ד",
          "text": "מה קרה לאיברי $x^2$ בעת הפתרון?",
          "answer": "הם התבטלו — אותו איבר הופיע בשני אגפים ונחסר משניהם"
        }
      ]
    },
    "14": {
      "id": "994b48f29e724eb28a13e718f821343e:14",
      "q": 14,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "שלט מציג שני ניסוחים לחישוב: $a=(x+8)(x+11)$ ו־$b=x^2+19x+88$.",
      "items": [
        {
          "label": "א",
          "text": "הראו בפילוג שהניסוחים שקולים.",
          "answer": "$a=b$ לכל $x$ — הפתיחה נותנת $x^2+11x+8x+88=x^2+19x+88$"
        },
        {
          "label": "ב",
          "text": "באיזה ניסוח קל יותר לחשב כאשר $x=−8$? נמקו וחשבו.",
          "answer": "הביטוי $a$ — ערכו $0$ כי הגורם הראשון מתאפס"
        },
        {
          "label": "ג",
          "text": "חשבו את הערך כאשר $x=1$.",
          "answer": "$108$"
        },
        {
          "label": "ד",
          "text": "האם שתי ההצבות לבדן היו מוכיחות את השקילות? הסבירו מה כן מוכיח.",
          "answer": "לא — הפילוג הכללי מוכיח $;$ מספר מוגבל של דוגמאות אינו הוכחה כללית"
        }
      ]
    },
    "15": {
      "id": "994b48f29e724eb28a13e718f821343e:15",
      "q": 15,
      "grade": 9,
      "topic": "חוק הפילוג המורחב",
      "levelLabel": "רמה ב׳",
      "text": "השלימו את הקבוע החסר וכתבו בדיקה קצרה.",
      "items": [
        {
          "label": "א",
          "text": "$(x+7)(x+___)=x^2+16x+63$",
