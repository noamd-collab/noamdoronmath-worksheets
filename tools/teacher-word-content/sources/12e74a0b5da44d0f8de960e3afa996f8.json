          [
            "רדיוס",
            "3 ס״מ"
          ],
          [
            "גובה",
            "4 ס״מ"
          ]
        ]
      },
      "example": {
        "title": "דוגמה פתורה",
        "lines": [
          "רדיוס $2$ ס״מ וגובה $5$ ס״מ נותנים שטח בסיס $3·2 ^2=12$ סמ״ר.",
          "הנפח $12·5=60$ סמ״ק."
