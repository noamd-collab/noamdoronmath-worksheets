    "5": {
      "id": "12e74a0b5da44d0f8de960e3afa996f8:5",
      "q": 5,
      "grade": 8,
      "topic": "גליל — נפח",
      "levelLabel": "רמה ב׳",
      "text": "תכננו ושרטטו גליל ברדיוס $2$ ס״מ שנפחו $180$ סמ״ק. שטח פנוי לציור בתחתית השאלה. בחישוב זה השתמשו בקירוב $π=3$.",
      "items": [
        {
          "label": "א",
          "text": "מצאו את שטח הבסיס.",
