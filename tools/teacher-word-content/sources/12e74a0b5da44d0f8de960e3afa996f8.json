      "items": [
        {
          "label": "א",
          "text": "חשבו את שטח הבסיס.",
          "answer": "$3·3 ^2=27$ סמ״ר."
        },
        {
          "label": "ב",
          "text": "השתמשו בו לחישוב הנפח.",
          "answer": "$27·4=108$ סמ״ק."
        },
        {
          "label": "ג",
          "text": "כמה מיליליטרים ימלאו את המכל?",
          "answer": "$108$ מ״ל."
        },
        {
          "label": "ד",
          "text": "למה משתמשים בשטח הבסיס ולא בהיקפו?",
          "answer": "נפח הוא שטח הבסיס כפול הגובה; היקף הבסיס הוא אורך בלבד ואינו מודד את החלל שבתוכו."
        }
      ]
    },
    "2": {
