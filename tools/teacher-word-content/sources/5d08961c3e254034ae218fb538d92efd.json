      "q": 20,
      "grade": 7,
      "topic": "משולשים מיוחדים",
      "levelLabel": "רמה ב׳",
      "text": "במשולש $△ABC$ נתון $AB=AC$ וזווית הראש $∠BAC=80°$.",
