    },
    "4": {
      "id": "f9d6d1792f96415f935554ec4c5d843c:4",
      "q": 4,
      "grade": 8,
      "topic": "פונקציה קווית",
      "levelLabel": "רמה א׳",
      "text": "גנרטור פועל ברציפות, והדלק במכל שלו נצרך בקצב קבוע. הגרף מראה כמה ליטרים של דלק יש במכל לפי מספר השעות שעברו מאז שהגנרטור הופעל.",
      "figure": {
        "url": "/noam-ai/native/G8-T15/a/figures/q4_head.svg",
        "sha256": "266df8f5008cb435060877281c8efc71180b53446390d7903bcec88a320f0388"
      },
      "items": [
        {
          "label": "א",
          "text": "כמה ליטרים של דלק היו במכל כשהגנרטור הופעל?",
          "figure": {
            "url": "/noam-ai/native/G8-T15/a/figures/q4_head.svg",
            "sha256": "266df8f5008cb435060877281c8efc71180b53446390d7903bcec88a320f0388"
          },
          "answer": "$56$ ליטר"
        },
        {
          "label": "ב",
          "text": "כמה דלק נשאר במכל כעבור $2$ שעות?",
          "figure": {
            "url": "/noam-ai/native/G8-T15/a/figures/q4_head.svg",
            "sha256": "266df8f5008cb435060877281c8efc71180b53446390d7903bcec88a320f0388"
          },
          "answer": "$42$ ליטר"
        },
        {
          "label": "ג",
          "text": "בכמה משתנה כמות הדלק בכל שעה? כתבו את השיפוע של הגרף, עם סימן ועם יחידות.",
          "figure": {
            "url": "/noam-ai/native/G8-T15/a/figures/q4_head.svg",
            "sha256": "266df8f5008cb435060877281c8efc71180b53446390d7903bcec88a320f0388"
          },
          "answer": "$−7$ ליטר לשעה"
        },
        {
          "label": "ד",
          "text": "כעבור כמה שעות יישארו במכל $21$ ליטר?",
          "figure": {
            "url": "/noam-ai/native/G8-T15/a/figures/q4_head.svg",
            "sha256": "266df8f5008cb435060877281c8efc71180b53446390d7903bcec88a320f0388"
