    "5": {
      "id": "f9d6d1792f96415f935554ec4c5d843c:5",
      "q": 5,
      "grade": 8,
      "topic": "פונקציה קווית",
      "levelLabel": "רמה א׳",
      "text": "יעל קיבלה את המשוואה $y = −4x + 3$ וסרטטה ישר לפיה. בשרטוט: הישר שיעל סרטטה.",
