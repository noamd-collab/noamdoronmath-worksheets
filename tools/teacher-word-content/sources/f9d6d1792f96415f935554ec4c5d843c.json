  "questions": {
    "1": {
      "id": "f9d6d1792f96415f935554ec4c5d843c:1",
      "q": 1,
      "grade": 8,
      "topic": "פונקציה קווית",
      "levelLabel": "רמה א׳",
      "text": "נגה רוכבת על אופניים. כשהיא עוברת ליד תחנת הדלק היא כבר במרחק $6$ ק״מ מהבית, ומשם היא ממשיכה במהירות קבועה של $18$ ק״מ בשעה, הלאה מהבית.\nנסמן ב־$x$ את מספר השעות מאז שעברה ליד תחנת הדלק, וב־$y$ את המרחק שלה מהבית בק״מ.",
      "example": {
        "title": "דוגמה מודרכת",
        "lines": [
          "במעבדה נמדדו בתחילה 11 ס״מ, ובכל יום נוספו 3 ס״מ. אפשר לרשום את המדידה ביום כלשהו כסכום של מה שהיה בתחילה ושל התוספת שהצטברה. שתי התרומות מופיעות בנפרד בחוק $y = 3x + 11$."
        ]
      },
      "items": [
        {
          "label": "א",
          "text": "כתבו את החוק של $y$ לפי $x$.",
          "answer": "$y = 18x + 6$"
        },
        {
          "label": "ב",
          "text": "באיזה מרחק מהבית תהיה נגה כעבור שעתיים וחצי?",
          "answer": "$51$ ק״מ"
        },
        {
          "label": "ג",
          "text": "סרטטו סקיצה המתארת את המרחק כתלות בזמן. סמנו בה מתי המרחק מהבית מגיע ל־$60$ ק״מ, וחשבו את הזמן הזה.",
          "answer": "קרן הישר $y=18x+6$ דרך $(0,6)$ ו־$(3,60)$; המרחק 60 ק״מ מתקבל אחרי 3 שעות."
        }
      ]
    },
    "2": {
