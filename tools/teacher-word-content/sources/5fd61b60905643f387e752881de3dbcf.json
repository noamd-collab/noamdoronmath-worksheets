      ]
    },
    "15": {
      "id": "5fd61b60905643f387e752881de3dbcf:15",
      "q": 15,
      "grade": 9,
      "topic": "משולש שווה־שוקיים",
      "levelLabel": "רמה א׳",
      "text": "$PK ∥ QR$, והקטע $PQ$ מחבר בין שני הישרים. $S$ היא נקודה על $PK$, בין $P$ ל־$K$, כך ש־$QS$ חוצה את $\\angle{PQR}$.",
      "figure": {
        "url": "/noam-ai/native/G9-T15/a/figures/q15_head.svg",
        "sha256": "3294ae6cc004606ad5f45ccc784ec25572453e0713a84f68d34933738119455c"
      },
      "items": [
        {
          "label": "א",
          "text": "ידוע ש־$\\angle{PQR} = 82°$. מצאו את הזוויות של $\\tri PQS$.",
          "figure": {
            "url": "/noam-ai/native/G9-T15/a/figures/q15_head.svg",
            "sha256": "3294ae6cc004606ad5f45ccc784ec25572453e0713a84f68d34933738119455c"
          },
          "answer": "$\\angle{PQS}=\\angle{PSQ}=41°$, $\\angle{QPS}=98°$."
        },
        {
          "label": "ב",
          "text": "הוכיחו: $PQ = PS$.",
          "figure": {
            "url": "/noam-ai/native/G9-T15/a/figures/q15_head.svg",
            "sha256": "3294ae6cc004606ad5f45ccc784ec25572453e0713a84f68d34933738119455c"
          },
          "answer": "$\\angle{PQS}=\\angle{SQR}$ מחוצה הזווית, ו־$\\angle{SQR}=\\angle{PSQ}$ מתחלפות. לכן $PQ=PS$."
        }
      ]
    },
    "16": {
