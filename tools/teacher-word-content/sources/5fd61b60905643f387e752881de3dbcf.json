          "figure": {
            "url": "/noam-ai/native/G9-T15/a/figures/q1_head.svg",
            "sha256": "c772780362cbe721ff833b3e2a1089dfdaf40537d06ff3560c4e6131dcf94b82"
          },
          "answer": "$\\angle{FTR}=47°$."
        },
        {
          "label": "ג",
          "text": "חשבו את $\\angle{ETF}$.",
          "figure": {
            "url": "/noam-ai/native/G9-T15/a/figures/q1_head.svg",
            "sha256": "c772780362cbe721ff833b3e2a1089dfdaf40537d06ff3560c4e6131dcf94b82"
