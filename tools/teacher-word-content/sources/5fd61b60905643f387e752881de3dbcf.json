        {
          "label": "ג",
          "text": "חשבו את $\\angle{GKL}$.",
          "figure": {
            "url": "/noam-ai/native/G9-T15/a/figures/q10_head.svg",
            "sha256": "c4690c3d8aef24ba36f2a5a3bd6ad1d25f6d11c03c268744e32a5be610486ef6"
