          "figure": {
            "url": "/noam-ai/native/G7-T45/b/figures/q6_head.svg",
            "sha256": "f2d45c4d801227d6d90a293dcf5f68a6a822ea93ce0a8684bb7e9b16f43b52b2"
          },
          "answer": "$\\f{6·3}{2}=9$ סמ״ר."
