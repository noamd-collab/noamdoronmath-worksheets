      "levelLabel": "רמת מצוינות",
      "text": "קבעו את הסדר והצדיקו אותו ללא קירובים.",
      "items": [
        {
          "label": "א",
          "text": "סדרו את $\\sqrt{65}+\\sqrt{5}$ ואת $\\sqrt{120}$.",
