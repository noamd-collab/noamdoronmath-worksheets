      "q": 17,
      "grade": 9,
      "topic": "שורשים",
      "levelLabel": "רמת מצוינות",
      "text": "מספרים שלמים בתנאי שורש.",
      "items": [
        {
          "label": "א",
          "text": "כמה שלמים לא־שליליים $n$ מקיימים $\\sqrt{n}<6$?",
