    "3": {
      "id": "6f0f427e9c5646bba9ae56a0d00aa3d2:3",
      "q": 3,
      "grade": 9,
      "topic": "שורשים",
      "levelLabel": "רמת מצוינות",
      "text": "נתונים $a=\\sqrt{31}+\\sqrt{15}$ ו־$b=\\sqrt{31}−\\sqrt{15}$.",
      "items": [
        {
          "label": "א",
          "text": "חשבו $ab$ ואת $a ^2+b ^2$.",
          "answer": "$ab=16$ וגם $a ^2+b ^2=92$"
        },
        {
          "label": "ב",
          "text": "חשבו $\\f{a}{b}+\\f{b}{a}$.",
          "answer": "$\\f{a ^2+b ^2}{ab}=\\f{23}{4}$"
        },
        {
          "label": "ג",
          "text": "מצאו את $a ^4+b ^4$.",
          "answer": "$92 ^2−2·16 ^2=7952$"
        }
      ]
    },
    "4": {
