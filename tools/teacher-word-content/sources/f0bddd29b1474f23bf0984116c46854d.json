      },
      "items": [
        {
          "label": "א",
          "text": "חשבו את שני ההיקפים.",
          "figure": {
            "url": "/noam-ai/native/G7-T18/b/figures/q11_head.svg",
            "sha256": "9518fc34c4cde696fc244904d4d5699257c223460b48a7a8587158e49721499d"
          },
          "answer": "שניהם $20$ ס״מ."
        },
        {
          "label": "ב",
          "text": "חשבו את שני השטחים ובחרו דגם.",
          "figure": {
            "url": "/noam-ai/native/G7-T18/b/figures/q11_head.svg",
            "sha256": "9518fc34c4cde696fc244904d4d5699257c223460b48a7a8587158e49721499d"
