      ]
    },
    "15": {
      "id": "f0bddd29b1474f23bf0984116c46854d:15",
      "q": 15,
      "grade": 7,
      "topic": "שטח מלבן וריבוע — העמקה",
      "levelLabel": "רמה ב׳",
      "text": "באיור לוח ישר־זוויות בעל פינה חסרה. המידות בס״מ: $AB=9$, $BC=5$, $CD=5$, $FA=10$. המידות הנתונות: $AB=9$ ס״מ, $BC=5$ ס״מ, $CD=5$ ס״מ, $FA=10$ ס״מ.",
      "figure": {
        "url": "/noam-ai/native/G7-T18/b/figures/q15_head.svg",
