      "q": 2,
      "grade": 7,
      "topic": "שטח מלבן וריבוע — העמקה",
      "levelLabel": "רמה ב׳",
      "text": "בטבלה מידות בס״מ של שתי תוויות מלבניות. ההוראות מתייחסות לשטח הנייר בלבד.",
      "table": {
