    },
    "12": {
      "id": "f0bddd29b1474f23bf0984116c46854d:12",
      "q": 12,
      "grade": 7,
      "topic": "שטח מלבן וריבוע — העמקה",
      "levelLabel": "רמה ב׳",
      "text": "הטבלה מציגה לוחות בס״מ. בדוגמה אחרת: בלוח ששטחו $15$ סמ״ר ורוחבו $3$ ס״מ, האורך הוא $5$ ס״מ כי $3·5=15$.",
      "table": {
        "head": [
          "דגם",
          "אורך בס״מ",
          "רוחב בס״מ"
        ],
        "rows": [
          [
            "$U$",
            "?",
            "$4$"
          ],
          [
            "$V$",
            "$8$",
            "$4$"
          ]
        ]
      },
      "items": [
        {
          "label": "א",
          "text": "שטח לוח $U$ הוא $28$ סמ״ר. מצאו את האורך החסר.",
          "answer": "$7$ ס״מ."
        },
        {
          "label": "ב",
          "text": "חשבו את שטח לוח $V$.",
          "answer": "$32$ סמ״ר."
        },
        {
          "label": "ג",
          "text": "מהו סכום שטחי הלוחות?",
          "answer": "$60$ סמ״ר."
        },
        {
          "label": "ד",
          "text": "האם ״אורכו של $V$ הוא $8$ ס״מ״ הוא נתון או מסקנה?",
