        "sha256": "dc835996792aa40dc3a253e3e798ec4d04a0f9caac238e01064b170e6e84c343"
      },
      "items": [
        {
          "label": "א",
          "text": "באיזה סוג זוויות מדובר? כתבו משוואה ומצאו את $x$.",
