    "12": {
      "id": "d11f2f0d17b3432a92571f3b2bb805d4:12",
      "q": 12,
      "grade": 9,
      "topic": "משולש שווה־שוקיים",
      "levelLabel": "רמה ב׳",
      "text": "$AB ∥ CD$, והקטע $GH$ עובר דרך $E$ שעל $AB$ ודרך $F$ שעל $CD$. ידוע ש־$\\angle{GEB} = (4x + 3)°$ ו־$\\angle{EFD} = (2x + 37)°$.",
      "figure": {
