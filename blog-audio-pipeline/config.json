  "verify": {
    "asrModel": "gemini-3.6-flash",
    "minCoverage": 0.93,
    "maxExtraRatio": 0.12,
    "charsPerSecondRange": [
      8,
      22
    ]
  },
  "storage": {
    "backend": "github-pages",
    "github": {
      "repoDir": "/Users/noamdoron/Desktop/noamdoronmath-worksheets",
