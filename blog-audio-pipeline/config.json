    "voice": "Charon",
    "language": null,
    "styleInstruction": "הקרא את הטקסט בעברית ישראלית טבעית וברורה, בקצב נינוח, עם הפסקות מתאימות בין משפטים ופסקאות. הקרא את הטקסט במלואו, בלי לסכם, להוסיף פתיח או להקריא את הוראות הסגנון.",
    "chunkTargetChars": 1200,
    "chunkMaxChars": 1800,
    "interChunkSilenceMs": 350
