  "audio": {
    "pcmSampleRate": 24000,
    "pcmChannels": 1,
    "pcmBytesPerSample": 2,
    "mp3Bitrate": "128k",
    "mp3SampleRate": 24000,
    "mp3Channels": 1
  },
  "pricing": {
    "note": "USD per 1M tokens, from https://ai.google.dev/gemini-api/docs/pricing (checked 2026-09-10).",
    "gemini-3.1-flash-tts-preview": {
      "inputTextPerMTok": 1,
      "outputAudioPerMTok": 20
    },
    "gemini-2.5-pro-preview-tts": {
      "inputTextPerMTok": 1,
      "outputAudioPerMTok": 20
    },
    "gemini-2.5-flash-preview-tts": {
      "inputTextPerMTok": 0.5,
      "outputAudioPerMTok": 10
    },
    "gemini-2.5-flash": {
      "inputTextPerMTok": 0.3,
      "outputTextPerMTok": 2.5,
      "inputAudioPerMTok": 1
    },
    "assumedAudioTokensPerSecond": 32,
    "assumedHebrewCharsPerSecond": 10,
    "assumedHebrewCharsPerToken": 2.5,
    "gemini-3.6-flash": {
      "inputTextPerMTok": 0.3,
      "outputTextPerMTok": 2.5,
      "inputAudioPerMTok": 1,
      "note": "assumed same as gemini-2.5-flash; not confirmed against the pricing page"
    }
  },
  "limits": {
    "maxConcurrentPosts": 1,
    "maxRetriesPerChunk": 3,
    "retryBaseDelayMs": 4000,
    "requestTimeoutMs": 180000,
