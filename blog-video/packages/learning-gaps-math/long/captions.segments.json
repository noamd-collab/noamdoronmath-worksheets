{
  "timing": "ESTIMATE ONLY — spread by word count over an unmeasured duration. Not a final SRT. Re-time against the rendered video before upload.",
  "estTotalSeconds": 97.4,
  "segments": [
    {
      "id": "hook",
      "estStart": 0,
      "estEnd": 5.7,
      "cues": [
        {
          "text": "ילד או ילדה יכולים לפתור דף שלם נכון,",
          "estStart": 0,
          "estEnd": 3.2
        },
        {
          "text": "ועדיין להיתקע בשאלה מעט שונה במבחן.",
          "estStart": 3.2,
          "estEnd": 5.7
        }
      ]
    },
    {
      "id": "gap",
      "estStart": 5.7,
      "estEnd": 16.2,
      "cues": [
        {
          "text": "במקרים רבים זה הסימן הראשון לפער לימודי.",
          "estStart": 5.7,
          "estEnd": 8.5
        },
        {
          "text": "לא בהכרח חוסר רצון להשקיע, אלא שלב בסיסי",
          "estStart": 8.5,
          "estEnd": 11.7
        },
        {
          "text": "שלא הובן עד הסוף. ופער הוא לא תווית.",
          "estStart": 11.7,
          "estEnd": 15
        },
        {
          "text": "הוא צילום מצב.",
          "estStart": 15,
          "estEnd": 16.2
        }
      ]
    },
    {
      "id": "relief",
      "estStart": 16.2,
      "estEnd": 24.7,
      "cues": [
        {
          "text": "והחדשות הטובות: לא צריך להתחיל הכול מחדש.",
          "estStart": 16.2,
          "estEnd": 19
        },
        {
          "text": "אפשר לזהות את נקודת הקושי, לבחור תרגול",
          "estStart": 19,
          "estEnd": 21.8
        },
        {
          "text": "מדויק וברמה נכונה, ולהתקדם בצעדים קטנים",
          "estStart": 21.8,
          "estEnd": 24.2
        },
        {
          "text": "ועקביים.",
          "estStart": 24.2,
          "estEnd": 24.7
        }
      ]
    },
    {
      "id": "signs",
      "estStart": 24.7,
      "estEnd": 38.8,
      "cues": [
        {
          "text": "לא תמיד הילד יגיד: אני לא מבין.",
          "estStart": 24.7,
          "estEnd": 27.5
        },
        {
          "text": "לפעמים הוא יגיד שהחומר משעמם, או יבקש עזרה",
          "estStart": 27.5,
          "estEnd": 30.7
        },
        {
          "text": "מיד בתחילת כל תרגיל. כדאי לשים לב גם",
          "estStart": 30.7,
          "estEnd": 33.9
        },
        {
          "text": "לטעויות שחוזרות באותו שלב, ולתרגיל מוכר",
          "estStart": 33.9,
          "estEnd": 36.4
        },
        {
          "text": "שנפתר נכון, לצד קושי כשהמספרים משתנים.",
          "estStart": 36.4,
          "estEnd": 38.8
        }
      ]
    },
    {
      "id": "diagnose",
      "estStart": 38.8,
      "estEnd": 58.6,
      "cues": [
        {
          "text": "איך בודקים? נותנים כמה תרגילים קצרים מאותו",
          "estStart": 38.8,
          "estEnd": 41.6
        },
        {
          "text": "נושא, מהקל אל המורכב, ומבקשים להסביר בקול.",
          "estStart": 41.6,
          "estEnd": 44.5
        },
        {
          "text": "אם הוא נעצר כבר בתחילת התרגיל, ייתכן",
          "estStart": 44.5,
          "estEnd": 47.3
        },
        {
          "text": "שהבסיס חסר. אם הוא מגיע כמעט לסוף וטועה",
          "estStart": 47.3,
          "estEnd": 50.5
        },
        {
          "text": "בחישוב, ייתכן שההבנה קיימת, ונדרש תרגול של",
          "estStart": 50.5,
          "estEnd": 53.3
        },
        {
          "text": "דיוק. ואם הוא פותר רק לפי דוגמה אחת קבועה,",
          "estStart": 53.3,
          "estEnd": 57
        },
        {
          "text": "צריך לעבוד על גמישות.",
          "estStart": 57,
          "estEnd": 58.6
        }
      ]
    },
    {
      "id": "graded",
      "estStart": 58.6,
      "estEnd": 69.9,
      "cues": [
        {
          "text": "ולא סוגרים פער עם דף קשה מדי.",
          "estStart": 58.6,
          "estEnd": 61.4
        },
        {
          "text": "רצף של כישלונות רק מחזק את התחושה שמתמטיקה",
          "estStart": 61.4,
          "estEnd": 64.7
        },
        {
          "text": "מאיימת. מתחילים ברמה שבה אפשר להצליח עם",
          "estStart": 64.7,
          "estEnd": 67.5
        },
        {
          "text": "מעט הדרכה, ומתקדמים צעד אחרי צעד.",
          "estStart": 67.5,
          "estEnd": 69.9
        }
      ]
    },
    {
      "id": "routine",
      "estStart": 69.9,
      "estEnd": 80,
      "cues": [
        {
          "text": "וצריך רצף, לא מרתון. לרוב התלמידים עדיף",
          "estStart": 69.9,
          "estEnd": 73
        },
        {
          "text": "לתרגל 15 עד 25 דקות, שלוש או ארבע פעמים",
          "estStart": 73,
          "estEnd": 76.9
        },
        {
          "text": "בשבוע, מאשר לשבת ערב שלם לפני מבחן.",
          "estStart": 76.9,
          "estEnd": 80
        }
      ]
    },
    {
      "id": "parents",
      "estStart": 80,
      "estEnd": 87.7,
      "cues": [
        {
          "text": "ואתם לא צריכים להיות מורים למתמטיקה כדי",
          "estStart": 80,
          "estEnd": 82.9
        },
        {
          "text": "לעזור. במקום לומר: זה קל, עדיף לומר:",
          "estStart": 82.9,
          "estEnd": 85.7
        },
        {
          "text": "בוא נמצא את הצעד הראשון.",
          "estStart": 85.7,
          "estEnd": 87.7
        }
      ]
    },
    {
      "id": "cta",
      "estStart": 87.7,
      "estEnd": 97.4,
      "cues": [
        {
          "text": "במאגר באתר אפשר לבחור כיתה ונושא, ולהוריד",
          "estStart": 87.7,
          "estEnd": 90.5
        },
        {
          "text": "דפי עבודה בחינם ובלי הרשמה, ברמה א׳, ברמה",
          "estStart": 90.5,
          "estEnd": 93.8
        },
        {
          "text": "ב׳ וברמת אתגר. הפוסט המלא, עם הדוגמאות,",
          "estStart": 93.8,
          "estEnd": 96.6
